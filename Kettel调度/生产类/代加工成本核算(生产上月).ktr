  <step>
    <name>临时表输入上月</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT A.GSBM,A.GSMC,A.CPBM,A.CPMC,A.CPYLCB,B.CPDZCB,
(CASE WHEN (C.RLCB IS NULL AND A.CPBM NOT LIKE '2102%')
THEN 'N'
ELSE 'Y'
END)SFQZ,
--(CASE WHEN C.RLCB IS NULL THEN 0.00001 else C.RLCB end) RLCB,
--round (c.rlcb,2)
NULL rlcb,
D.bzshl,ROUND(nvl(A.CPYLCB,0)*nvl(D.bzshl,0),2) SHJE,
to_number(case when D.jglv is null or D.jglv='~' then '0' else D.jglv end) jglv,
to_number(case when D.zzfy is null or D.zzfy='~' then '0' else D.zzfy end) zzfy,
to_number(case when D.xljjgf is null or D.xljjgf='~' then '0' else D.xljjgf end) xljjgf,
to_char(add_months(trunc(sysdate),-1),'yyyy-mm') ZCQJ FROM 
(
SELECT GSBM,GSMC,CPBM,CPMC,ROUND(SUM(nvl(DWCB,0)),2)CPYLCB FROM
(SELECT A.GSBM,A.GSMC,A.CPBM,A.CPMC,A.CPCL,A.CLBM,A.CLZSL,B.qypjdj,(A.CLZSL*B.QYPJDJ/A.CPCL) DWCB FROM
(
---------               取BOM层次结构

SELECT DISTINCT GSBM,
                GSMC,
                BSWLBM CPBM,
                BSWLMC CPMC,
                BSZSL CPCL,
                (CASE
                  WHEN DLBM IS NULL and DZ IS NOT NULL THEN   --袋子
                   DZ
                  WHEN DLBM IS NULL and DZ IS NULL and xlbm is not null THEN  --添加剂小料
                   XLBM
                  WHEN DLBM IS NULL and DZ IS NULL and xlbm is null THEN  --小料中的小料
                   CLBM
                  else
                   dlbm                                                   --大料配方材料
                end) CLBM,
                
                (CASE
                  WHEN DLZSL IS NULL and DZSL IS NOT NULL THEN           --袋子数量
                   DZSL
                  WHEN DLZSL IS NULL and DZSL IS NULL AND XLZSL IS NOT NULL THEN 
                   (XLZSL * DLBXZSL / XLBSZSL)*(BSZSL/DLBSZSL)    ---计算添加剂原料用量
                  WHEN DLZSL IS NULL and DZSL IS NULL AND XLZSL IS NULL THEN
                   CLZSL * XLBXZSL / CLBSZSL
                  else
                   dlZSL*BSZSL/DLBSZSL
                end) clZSL

  from (
  
  
  SELECT distinct A.GSBM,
                        A.GSMC,
                        A.BSWLBM,
                        A.BSWLMC,
                        A.BSZSL,
                        B.BSZSL DLBSZSL,
                        (CASE
                          WHEN (B.WLBM LIKE '32%' OR B.WLBM LIKE '39%' OR
                               B.WLBM LIKE '33%') THEN
                           B.BXZSL
                          WHEN (B.WLBM IN ('3100000013',
                                           '3100000001',
                                           '3100000017',
                                           '3100000009',
                                           '3100000018') AND B.GSBM = '1007') THEN
                           B.BXZSL
                        
                          WHEN (B.WLBM = '3100000001' AND B.GSBM = '1008') THEN
                           B.BXZSL
                        
                          WHEN (B.WLBM IN ('3100000013', '3100000001') AND
                               B.GSBM = '1002') THEN
                           B.BXZSL
                        
                          WHEN (B.WLBM IN ('3100000001', '3100000002') AND
                               B.GSBM = '1001') THEN
                           B.BXZSL
                        
                          ELSE
                           NULL
                        END) DLBXZSL,
                        
                        C.BSZSL XLBSZSL,
                        
                        (CASE
                          WHEN (C.WLBM LIKE '32%' OR C.WLBM LIKE '39%' OR
                               C.WLBM LIKE '33%' OR C.WLBM LIKE '34%') THEN
                           C.BXZSL
                          ELSE
                           NULL
                        END) XLBXZSL,
                        
                        D.BSZSL CLBSZSL,
                        
                        (CASE
                          WHEN A.WLBM LIKE '5%' THEN
                           NULL
                          ELSE
                           A.WLBM
                        END) DZ,
                        
                        (CASE
                          WHEN A.WLBM LIKE '5%' THEN
                           NULL
                          ELSE
                           A.BXZSL
                        END) DZSL,
                        
                        (CASE
                          WHEN (B.WLBM LIKE '32%' OR B.WLBM LIKE '39%' OR
                               B.WLBM LIKE '33%') THEN
                           NULL
                          WHEN (B.WLBM IN ('3100000013',
                                           '3100000001',
                                           '3100000017',
                                           '3100000009',
                                           '3100000018') AND B.GSBM = '1007') THEN
                           NULL
                        
                          WHEN (B.WLBM = '3100000001' AND B.GSBM = '1008') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000013', '3100000001') AND
                               B.GSBM = '1002') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000001', '3100000002') AND
                               B.GSBM = '1001') THEN
                           NULL
                          ELSE
                           B.WLBM
                        END) DLBM,
                        
                        (CASE
                          WHEN (B.WLBM LIKE '32%' OR B.WLBM LIKE '39%' OR
                               B.WLBM LIKE '33%') THEN
                           NULL
                          WHEN (B.WLBM IN ('3100000013',
                                           '3100000001',
                                           '3100000017',
                                           '3100000009',
                                           '3100000018') AND B.GSBM = '1007') THEN
                           NULL
                          WHEN (B.WLBM = '3100000001' AND B.GSBM = '1008') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000013', '3100000001') AND
                               B.GSBM = '1002') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000001', '3100000002') AND
                               B.GSBM = '1001') THEN
                           NULL
                          ELSE
                           B.BXZSL
                        END) DLZSL,
                        
                          (CASE
                          WHEN C.WLBM LIKE '3%' AND C.WLBM NOT LIKE '34%' and C.WLBM NOT LIKE '39%' THEN
                           NULL
                          ELSE
                           C.WLBM
                        END) XLBM,
                        
                        (CASE 
                          WHEN C.WLBM LIKE '3%' AND C.WLBM NOT LIKE '34%'AND  C.WLBM NOT LIKE '39%' THEN
                           NULL
                          ELSE
                           C.BXZSL
                        END) XLZSL,
                        
                        D.WLBM  CLBM,
                        D.BXZSL CLZSL
          FROM (select a2.code          gsbm,
                       A2.NAME          GSMC, --计划组织编码
                       a2.shortname     gsjc, --计划组织姓名
                       a1.code          bswlbm, --主表物料编码
                       a1.name          bswlmc, --主表物料名称
                       a4.hnparentnum   bszsl, --bom主表主数量
                       a4.hversion      bsbm, --bom主表版本
                       a3.name          bszdw, --bom主表物料主单位
                       b1.code          wlbm, --bom附表物料编码
                       b1.name          wlmc, --bom附表物料名称
                       b1.materialtype  wlxh, -- 型号
                       b2.nitemnum      bxzsl, --bom附表主数量
                       a4.hfversiontype, --版本类型
                       a4.hbdefault --是否默认
                
                  from bd_bom a4 --bom主表
                  left join org_orgs_v a2 --计划组织
                    on a4.pk_org = a2.pk_org
                  left join bd_material a1 --物料信息
                    on a4.hcmaterialid = a1.pk_material
                  left join bd_measdoc a3 --单位
                    on a4.hcmeasureid = a3.pk_measdoc
                  left join bd_bom_b b2 --bom附表
                    on a4.cbomid = b2.cbomid
                  left join bd_material b1 --物料信息
                    on b2.cmaterialid = b1.pk_material
                 where a4.dr = '0'
                   AND B2.DR='0'
                   AND a4. hvdef3='1001A2100000007TZY0S'
                   AND A4.fbillstatus='1'
                AND A4.hfversiontype='1'
                   AND a1.code LIKE '2%'
                   AND   b1.code NOT LIKE '38%'
                   AND A4.hbdefault='Y'
           --     AND A1.CODE='2202030010'
             --    AND a2.code='1012'
                ) A
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                     AND B2.DR='0'
                       AND a4. hvdef3='1001A2100000007TZY0S'
                       AND A4.fbillstatus='1'
                   AND A4.hfversiontype='1'
                       AND a1.code LIKE '5%'
                --     AND A1.CODE='5202030014'
                       AND A4.cbomid&lt;&gt;'1001A2100000007UV4YR'
                       AND A4.hbdefault='Y'
                    ) B
            ON A.WLBM = B.BSWLBM
           AND A.GSBM = B.GSBM
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码         
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                        AND a4. hvdef3='1001A2100000007TZY0S'
                          AND A4.hbdefault='Y'
                       AND A4.fbillstatus='1'
                   AND A4.hfversiontype='1'
                       AND a1.code LIKE '3%'
                       ) C
            ON B.WLBM = C.BSWLBM
           AND B.GSBM = C.GSBM
           AND A.GSBM = C.GSBM
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码        
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                        AND a4. hvdef3='1001A2100000007TZY0S'
                       AND A4.fbillstatus='1'
                   AND A4.hfversiontype='1'
                       AND a1.code LIKE '3%'
                          AND A4.hbdefault='Y'
                       ) D
            ON C.WLBM = D.BSWLBM
           AND C.GSBM = D.GSBM
         
           )
 where (CASE
         WHEN DLBM IS NULL and DZ IS NOT NULL THEN
          DZ
         WHEN DLBM IS NULL and DZ IS NULL and xlbm is not null THEN
          XLBM
         WHEN DLBM IS NULL and DZ IS NULL and xlbm is null THEN
          CLBM
         else
          dlbm
       end) is not null
       AND 
       (CASE
         WHEN DLBM IS NULL and DZ IS NOT NULL THEN
          DZ
         WHEN DLBM IS NULL and DZ IS NULL and xlbm is not null THEN
          XLBM
         WHEN DLBM IS NULL and DZ IS NULL and xlbm is null THEN
          CLBM
         else
          dlbm
       end) NOT LIKE '4%'
   
 --ORDER BY GSBM,GSMC,BSWLBM
 
UNION ALL



  ----------------------------------------------------------------------------------
SELECT DISTINCT GSBM,GSMC,BSWLBM CPBM,BSWLMC CPMC,BSZSL CPCL,
CASE WHEN BXZSL IS NOT NULL
THEN WLBM  ---2开头的材料
WHEN DLBXZSL1 IS NOT NULL
THEN WLBM1 --3开头的材料
WHEN XLBXZSL2 IS NOT NULL
THEN WLBM2 --5开头的材料
WHEN BXZSL3 IS NOT NULL
THEN WLBM3 --32开头的材料
END CLBM,

CASE WHEN BXZSL IS NOT NULL
THEN BXZSL  ---2开头的材料
WHEN DLBXZSL1 IS NOT NULL
THEN DLBXZSL1 --3开头的材料
WHEN XLBXZSL2 IS NOT NULL
THEN XLBXZSL2 --5开头的材料
WHEN BXZSL3 IS NOT NULL
THEN BXZSL3 --32开头的材料
END CLZSL


  FROM
  
(  
  SELECT 
A.GSBM,A.GSMC,A.GSJC,A.BSWLBM,A.BSWLMC,A.BSZSL,
  A.WLBM,A.WLMC,
  CASE WHEN A.WLBM LIKE '38%'
    THEN NULL
      ELSE A.BXZSL
       END BXZSL,
       
       B.BSWLBM BSWLBM1,
       B.BSWLMC BSWLMC1,
       B.BSZSL BSZSL1,
       B.WLBM WLBM1,
       B.WLMC WLMC1,
       CASE WHEN B.WLBM LIKE '5%'
         THEN NULL
           ELSE B.BXZSL
             END DLBXZSL1,
           
            --------------- 
               B1.BSWLBM BSWLBM2,
               B1.BSWLMC BSWLMC2,
               B1.BSZSL BSZSL2,
               B1.WLBM WLBM2,
               B1.WLMC WLMC2,
       CASE WHEN B1.WLBM LIKE '32%'
         THEN NULL
           ELSE B1.BXZSL
             END XLBXZSL2,
       ------------------      
               C.BSWLBM BSWLBM3,
               C.BSWLMC BSWLMC3,
               C.BSZSL BSZSL3,
               C.WLBM WLBM3,
               C.WLMC WLMC3,
               C.BXZSL BXZSL3
             
          FROM (
          select a2.code          gsbm,
                       A2.NAME          GSMC, --计划组织编码
                       a2.shortname     gsjc, --计划组织姓名
                       a1.code          bswlbm, --主表物料编码
                       a1.name          bswlmc, --主表物料名称
                       
                       a4.hnparentnum   bszsl, --bom主表主数量
                       a4.hversion      bsbm, --bom主表版本
                       a3.name          bszdw, --bom主表物料主单位
                       b1.code          wlbm, --bom附表物料编码
                       b1.name          wlmc, --bom附表物料名称
                       b1.materialtype  wlxh, -- 型号
                       b2.nitemnum      bxzsl, --bom附表主数量
                       a4.hfversiontype, --版本类型
                       a4.hbdefault --是否默认
                
                  from bd_bom a4 --bom主表
                  left join org_orgs_v a2 --计划组织
                    on a4.pk_org = a2.pk_org
                  left join bd_material a1 --物料信息
                    on a4.hcmaterialid = a1.pk_material
                  left join bd_measdoc a3 --单位
                    on a4.hcmeasureid = a3.pk_measdoc
                  left join bd_bom_b b2 --bom附表
                    on a4.cbomid = b2.cbomid
                  left join bd_material b1 --物料信息
                    on b2.cmaterialid = b1.pk_material
                 where a4.dr = '0'
                   AND B2.DR='0'
                   AND a4. hvdef3='1001A2100000007TZY0S'
                   AND A4.fbillstatus='1'
                   AND a1.code LIKE '2%'
                  AND A4.hfversiontype='1'
                     AND A4.hbdefault='Y'
             --   AND A1.CODE='2102030075'
            --    AND a2.code='1013'
                AND   b1.code  LIKE '38%'
                ) A
          LEFT JOIN (
          
          select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           case when  a1.code like '38%'
                             THEN a4.hnparentnum/1000
                               ELSE
                           a4.hnparentnum END   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           case when  a1.code like '38%'
                             THEN '吨'
                               ELSE
                           a3.name   end       bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                       AND a4. hvdef3='1001A2100000007TZY0S'
                       AND A4.fbillstatus='1'
                      AND A4.hfversiontype='1'
                          AND A4.hbdefault='Y'
                       AND (a1.code LIKE '5%' OR a1.code LIKE '38%')
               --      AND A1.CODE='3800000003'
                    ) B
            ON A.WLBM = B.BSWLBM
           AND A.GSBM = B.GSBM
             LEFT JOIN (
          
          select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name         bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                       AND a4. hvdef3='1001A2100000007TZY0S'
                       AND A4.fbillstatus='1'
                      AND A4.hbdefault='Y'
                      AND A4.hfversiontype='1'
                       AND (a1.code LIKE '5%')
             --        AND A1.CODE='5204020039'
                    ) B1
            ON B.WLBM = B1.BSWLBM
           AND B.GSBM = B1.GSBM
           
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码         
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                       AND a4. hvdef3='1001A2100000007TZY0S'
                       AND A4.fbillstatus='1'
                          AND A4.hbdefault='Y'
                       AND A4.hfversiontype='1'
                                AND (a1.code LIKE '3%' OR  a1.code LIKE '5%')
                       ) C
            ON B1.WLBM = C.BSWLBM
           AND B1.GSBM = C.GSBM
           AND A.GSBM = C.GSBM
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码        
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                       AND a4. hvdef3='1001A2100000007TZY0S'
                       AND A4.fbillstatus='1'
                          AND A4.hbdefault='Y'
                       AND A4.hfversiontype='1'
                       AND a1.code LIKE '3%'
                       ) D
            ON C.WLBM = D.BSWLBM
           AND C.GSBM = D.GSBM
         )
        WHERE CASE WHEN BXZSL IS NOT NULL
THEN WLBM  ---2开头的材料
WHEN DLBXZSL1 IS NOT NULL
THEN WLBM1 --3开头的材料
WHEN XLBXZSL2 IS NOT NULL
THEN WLBM2 --5开头的材料
WHEN BXZSL3 IS NOT NULL
THEN WLBM3 --32开头的材料
END NOT LIKE '4%'


-------------
)A
LEFT JOIN (
SELECT A.GSBM,A.WLBM,
( A.DJ+NVL(B.ZZCB,0)) QYPJDJ FROM 

(
----------
SELECT GSBM,WLBM,
CASE WHEN DJ&lt;&gt;'0'
THEN DJ
  ELSE JCDJ
    END DJ
   FROM (
   
   
SELECT gsbm,wlbm,sum(nvl(jcdj,0))jcdj,sum(nvl(dj,0))dj
FROM(
 (select distinct b.gsbm,C.CODE wlbm,
A.nmonthprice jcDJ,0 dj 
from ia_generalnab a
left join (SELECT A.pk_costregion,B.CODE GSBM FROM org_costregion A
LEFT JOIN org_financeorg B
ON A.  pk_org=B. pk_financeorg) b
on a.pk_org=b. pk_costregion
LEFT JOIN bd_material C
ON A. cinventoryid =C.pk_material
where a.dr='0'
and c.code not  like '4%'--原料结存成本
)

union ALL

(
select gsbm,wlbm,0 jcdj,round(dj,3)DJ from (
select distinct gsbm,wlbm,substr(djrq,0,7) qj,decode(sum(nvl(zsl,0)),0,0,sum(nvl(ckje,0))/sum(nvl(zsl,0))) dj from 
(
SELECT DISTINCT
       A.CGENERALHID               CGENERALHID,  --材料出库单主键
       A.CORPOID                   GSZJ,         --公司主键
       SUBSTR(A.DBILLDATE,1,10)    DJRQ,         --单据日期
       C.CODE                      GSBM,         --公司编码
       C.NAME                      GSMC,         --公司名称
       C.SHORTNAME                 GSJC,         --公司简称
       M.NAME                      BMMC,         --部门名称
       D.CODE                      WLBM,         --物料编码
       D.NAME                      WLMC,         --物料名称
       B.NNUM                      ZSL,          --主数量
       B.NCOSTPRICE                DJ,           --单价
       B.NCOSTMNY                  CKJE,         --出库金额
       P.CODE                      WLFLBM,       --物料分类编码
       P.NAME                      WLFLMC,       --物料分类名称
       B.CROWNO                    CROWNO        --行号
FROM IC_MATERIAL_H A
LEFT JOIN org_dept M
ON A.cdptid=M.pk_dept
LEFT JOIN IC_MATERIAL_B B
ON A.CGENERALHID=B.CGENERALHID
LEFT JOIN ORG_STOCKORG C
ON A.CDRAWCALBODYOID=C.PK_STOCKORG
LEFT JOIN BD_MATERIAL D
ON B.CMATERIALVID=D.PK_MATERIAL
LEFT JOIN BD_MARBASCLASS P
ON D.PK_MARBASCLASS=P.PK_MARBASCLASS

WHERE SUBSTR(A.DBILLDATE,1,7)=(to_char(add_months(trunc(sysdate),-1),'yyyy-mm'))
AND A.DR = 0
AND B.DR = 0
)
group by gsbm,wlbm,substr(djrq,0,7)
order by gsbm,wlbm,substr(djrq,0,7)
)
where wlbm not like '4%'

  --原料材料成本
)
)
group by gsbm,wlbm
ORDER BY GSBM,WLBM

 
)
)A


LEFT JOIN

(
SELECT B.QJ,B.GSBM,B.WLBM,A.JFSE/B.ZCL ZZCB FROM 
(SELECT NF,KJQJ,NF||'-'||KJQJ QJ,GSBM,GSMC,SUM(nvl(LJJFSE,0)) JFSE
FROM V_CWPZ
WHERE 
KJKMBM LIKE '5101%'
AND pk_systemv &lt;&gt;'PLCF'      --排除掉汇总数据
and nf=(to_char(add_months(trunc(sysdate),-1),'yyyy'))
and kjqj=(to_char(add_months(trunc(sysdate),-1),'mm'))
AND BMMC LIKE '%发酵豆粕车间%'
GROUP BY NF,KJQJ,GSBM,GSMC    --取制造费用
)A

LEFT JOIN 


(select distinct qj,gsbm,gsmc,WLBM,sum(nvl(zsl,0))OVER(PARTITION BY QJ,GSBM)ZCL from
(
select substr(a.dbilldate,0,7)qj,c.code gsbm,c.name gsmc,d.code WLBM,d.name WLMC,
(case when d.code like '7%'
  then b.nassistnum
    else b.nnum
      end) zsl
 from ic_finprodin_h a
left join ic_finprodin_b b
on a.cgeneralhid=b.cgeneralhid
left join org_stockorg c
on a.pk_org=c.pk_stockorg
left join bd_material d
on b.cmaterialvid=d.pk_material
left join org_dept e
on a.cdptid =e.pk_dept 
left join bd_measdoc f
on b.cunitid=f.pk_measdoc
where a.dr='0'
and b.dr='0'
and substr(a.dbilldate,0,7)=(to_char(add_months(trunc(sysdate),-1),'yyyy-mm'))
and D.CODE='3100000018'
)
)B

ON A.GSBM=B.GSBM
AND A.QJ=B.QJ
) B
ON A.GSBM=B.GSBM
AND A.WLBM=B.WLBM
---------------------------------
LEFT JOIN
(
SELECT B.QJ,B.GSBM,B.WLBM,A.JFSE/B.ZCL ZZCB FROM 
(SELECT NF,KJQJ,NF||'-'||KJQJ QJ,GSBM,GSMC,SUM(nvl(LJJFSE,0)) JFSE
FROM V_CWPZ
WHERE 
KJKMBM LIKE '5101%'
AND pk_systemv &lt;&gt;'PLCF'      --排除掉汇总数据
and nf=(to_char(add_months(trunc(sysdate),-1),'yyyy'))
and kjqj=(to_char(add_months(trunc(sysdate),-1),'mm'))
AND BMMC LIKE '%原料加工车间%'
GROUP BY NF,KJQJ,GSBM,GSMC    --取制造费用
)A

LEFT JOIN 


(select distinct qj,gsbm,gsmc,WLBM,sum(nvl(zsl,0))OVER(PARTITION BY QJ,GSBM)ZCL from
(
select substr(a.dbilldate,0,7)qj,c.code gsbm,c.name gsmc,d.code WLBM,d.name WLMC,
(case when d.code like '7%'
  then b.nassistnum
    else b.nnum
      end) zsl
 from ic_finprodin_h a
left join ic_finprodin_b b
on a.cgeneralhid=b.cgeneralhid
left join org_stockorg c
on a.pk_org=c.pk_stockorg
left join bd_material d
on b.cmaterialvid=d.pk_material
left join org_dept e
on a.cdptid =e.pk_dept 
left join bd_measdoc f
on b.cunitid=f.pk_measdoc
where a.dr='0'
and b.dr='0'
and substr(a.dbilldate,0,7)=(to_char(add_months(trunc(sysdate),-1),'yyyy-mm'))
and D.CODE IN ('3100000001','3100000013')
)
)B
ON A.GSBM=B.GSBM
AND A.QJ=B.QJ
) C
ON A.GSBM=C.GSBM
AND A.WLBM=C.WLBM       
         )B
         
         
         
         ON A.GSBM=B.GSBM
         AND A.CLBM=B.WLBM
        )
         GROUP BY GSBM,GSMC,CPBM,CPMC
         ORDER BY ROUND(SUM(nvl(DWCB,0)),2)
        )A
        
  LEFT JOIN      
        
        
        
(
SELECT GSBM,GSMC,CPBM,CPMC,ROUND(SUM(nvl(DWCB,0)),2)CPDZCB FROM
(SELECT A.GSBM,A.GSMC,A.CPBM,A.CPMC,A.CPCL,A.CLBM,A.CLZSL,B.dj,(A.CLZSL*B.DJ/A.CPCL) DWCB FROM
(
SELECT DISTINCT GSBM,
                GSMC,
                BSWLBM CPBM,
                BSWLMC CPMC,
                BSZSL CPCL,
                (CASE
                  WHEN DLBM IS NULL and DZ IS NOT NULL THEN
                   DZ
                  WHEN DLBM IS NULL and DZ IS NULL and xlbm is not null THEN
                   XLBM
                  WHEN DLBM IS NULL and DZ IS NULL and xlbm is null THEN
                   CLBM
                  else
                   dlbm
                end) CLBM,
                
                (CASE
                  WHEN DLZSL IS NULL and DZSL IS NOT NULL THEN
                   DZSL
                  WHEN DLZSL IS NULL and DZSL IS NULL AND XLZSL IS NOT NULL THEN
                   XLZSL * DLBXZSL / XLBSZSL
                  WHEN DLZSL IS NULL and DZSL IS NULL AND XLZSL IS NULL THEN
                   CLZSL * XLBXZSL / CLBSZSL
                  else
                   dlZSL*BSZSL/DLBSZSL
                end) clZSL

  from (
  SELECT distinct A.GSBM,
                        A.GSMC,
                        A.BSWLBM,
                        A.BSWLMC,
                        A.BSZSL,
                        B.BSZSL DLBSZSL,
                        (CASE
                          WHEN (B.WLBM LIKE '32%' OR B.WLBM LIKE '39%' OR
                               B.WLBM LIKE '33%') THEN
                           B.BXZSL
                          WHEN (B.WLBM IN ('3100000013',
                                           '3100000001',
                                           '3100000017',
                                           '3100000009',
                                           '3100000018') AND B.GSBM = '1007') THEN
                           B.BXZSL
                        
                          WHEN (B.WLBM = '3100000001' AND B.GSBM = '1008') THEN
                           B.BXZSL
                        
                          WHEN (B.WLBM IN ('3100000013', '3100000001') AND
                               B.GSBM = '1002') THEN
                           B.BXZSL
                        
                          WHEN (B.WLBM IN ('3100000001', '3100000002') AND
                               B.GSBM = '1001') THEN
                           B.BXZSL
                        
                          ELSE
                           NULL
                        END) DLBXZSL,
                        
                        C.BSZSL XLBSZSL,
                        
                        (CASE
                          WHEN (C.WLBM LIKE '32%' OR C.WLBM LIKE '39%' OR
                               C.WLBM LIKE '33%' OR C.WLBM LIKE '34%') THEN
                           C.BXZSL
                          ELSE
                           NULL
                        END) XLBXZSL,
                        
                        D.BSZSL CLBSZSL,
                        
                        (CASE
                          WHEN A.WLBM LIKE '5%' THEN
                           NULL
                          ELSE
                           A.WLBM
                        END) DZ,
                        
                        (CASE
                          WHEN A.WLBM LIKE '5%' THEN
                           NULL
                          ELSE
                           A.BXZSL
                        END) DZSL,
                        
                        (CASE
                          WHEN (B.WLBM LIKE '32%' OR B.WLBM LIKE '39%' OR
                               B.WLBM LIKE '33%') THEN
                           NULL
                          WHEN (B.WLBM IN ('3100000013',
                                           '3100000001',
                                           '3100000017',
                                           '3100000009',
                                           '3100000018') AND B.GSBM = '1007') THEN
                           NULL
                        
                          WHEN (B.WLBM = '3100000001' AND B.GSBM = '1008') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000013', '3100000001') AND
                               B.GSBM = '1002') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000001', '3100000002') AND
                               B.GSBM = '1001') THEN
                           NULL
                          ELSE
                           B.WLBM
                        END) DLBM,
                        
                        (CASE
                          WHEN (B.WLBM LIKE '32%' OR B.WLBM LIKE '39%' OR
                               B.WLBM LIKE '33%') THEN
                           NULL
                          WHEN (B.WLBM IN ('3100000013',
                                           '3100000001',
                                           '3100000017',
                                           '3100000009',
                                           '3100000018') AND B.GSBM = '1007') THEN
                           NULL
                          WHEN (B.WLBM = '3100000001' AND B.GSBM = '1008') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000013', '3100000001') AND
                               B.GSBM = '1002') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000001', '3100000002') AND
                               B.GSBM = '1001') THEN
                           NULL
                          ELSE
                           B.BXZSL
                        END) DLZSL,
                        
                        (CASE
                          WHEN C.WLBM LIKE '3%' AND C.WLBM NOT LIKE '34%' THEN
                           NULL
                          ELSE
                           C.WLBM
                        END) XLBM,
                        
                        (CASE
                          WHEN C.WLBM LIKE '3%'  AND C.WLBM NOT LIKE '34%' THEN
                           NULL
                          ELSE
                           C.BXZSL
                        END) XLZSL,
                        
                        D.WLBM  CLBM,
                        D.BXZSL CLZSL
          FROM (select a2.code          gsbm,
                       A2.NAME          GSMC, --计划组织编码
                       a2.shortname     gsjc, --计划组织姓名
                       a1.code          bswlbm, --主表物料编码
                       a1.name          bswlmc, --主表物料名称
                       a4.hnparentnum   bszsl, --bom主表主数量
                       a4.hversion      bsbm, --bom主表版本
                       a3.name          bszdw, --bom主表物料主单位
                       b1.code          wlbm, --bom附表物料编码
                       b1.name          wlmc, --bom附表物料名称
                       b1.materialtype  wlxh, -- 型号
                       b2.nitemnum      bxzsl, --bom附表主数量
                       a4.hfversiontype, --版本类型
                       a4.hbdefault --是否默认
                
                  from bd_bom a4 --bom主表
                  left join org_orgs_v a2 --计划组织
                    on a4.pk_org = a2.pk_org
                  left join bd_material a1 --物料信息
                    on a4.hcmaterialid = a1.pk_material
                  left join bd_measdoc a3 --单位
                    on a4.hcmeasureid = a3.pk_measdoc
                  left join bd_bom_b b2 --bom附表
                    on a4.cbomid = b2.cbomid
                  left join bd_material b1 --物料信息
                    on b2.cmaterialid = b1.pk_material
                 where a4.dr = '0'
                  AND B2.DR='0'
                    AND a4. hvdef3='1001A2100000007TZY0S'
                   AND A4.fbillstatus='1'
                   AND a1.code LIKE '2%'
                   AND   b1.code NOT LIKE '38%'
                      AND A4.hbdefault='Y'
                   AND A4.hfversiontype='1'
                --AND A1.CODE='2102030177'
                -- AND a2.code='1007'
                ) A
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                        AND a4. hvdef3='1001A2100000007TZY0S'
                       AND A4.fbillstatus='1'
                      AND A4.hfversiontype='1'
                      AND A4.hbdefault='Y'
                       AND a1.code LIKE '5%'
                       ) B
            ON A.WLBM = B.BSWLBM
           AND A.GSBM = B.GSBM
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码         
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                        AND a4. hvdef3='1001A2100000007TZY0S'
                       AND A4.hbdefault='Y'
                       AND A4.fbillstatus='1'
AND A4.hfversiontype='1'
                       AND a1.code LIKE '3%'
                       ) C
            ON B.WLBM = C.BSWLBM
           AND B.GSBM = C.GSBM
           AND A.GSBM = C.GSBM
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码        
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                        AND a4. hvdef3='1001A2100000007TZY0S'
                      AND A4.hbdefault='Y'
                       AND A4.fbillstatus='1'
                           AND A4.hfversiontype='1'
                       AND a1.code LIKE '3%'
                       ) D
            ON C.WLBM = D.BSWLBM
           AND C.GSBM = D.GSBM
           )
 where (CASE
         WHEN DLBM IS NULL and DZ IS NOT NULL THEN
          DZ
         WHEN DLBM IS NULL and DZ IS NULL and xlbm is not null THEN
          XLBM
         WHEN DLBM IS NULL and DZ IS NULL and xlbm is null THEN
          CLBM
         else
          dlbm
       end) is not null
       AND 
       (CASE
         WHEN DLBM IS NULL and DZ IS NOT NULL THEN
          DZ
         WHEN DLBM IS NULL and DZ IS NULL and xlbm is not null THEN
          XLBM
         WHEN DLBM IS NULL and DZ IS NULL and xlbm is null THEN
          CLBM
         else
          dlbm
       end) LIKE '4%'
-- ORDER BY GSBM, GSMC, BSWLBM

UNION ALL


  ----------------------------------------------------------------------------------
SELECT DISTINCT GSBM,GSMC,BSWLBM CPBM,BSWLMC CPMC,BSZSL CPCL,
CASE WHEN BXZSL IS NOT NULL
THEN WLBM  ---2开头的材料
WHEN DLBXZSL1 IS NOT NULL
THEN WLBM1 --3开头的材料
WHEN XLBXZSL2 IS NOT NULL
THEN WLBM2 --5开头的材料
WHEN BXZSL3 IS NOT NULL
THEN WLBM3 --32开头的材料
END CLBM,

CASE WHEN BXZSL IS NOT NULL
THEN BXZSL  ---2开头的材料
WHEN DLBXZSL1 IS NOT NULL
THEN DLBXZSL1 --3开头的材料
WHEN XLBXZSL2 IS NOT NULL
THEN XLBXZSL2 --5开头的材料
WHEN BXZSL3 IS NOT NULL
THEN BXZSL3 --32开头的材料
END CLZSL


  FROM
  
(  
  SELECT 
A.GSBM,A.GSMC,A.GSJC,A.BSWLBM,A.BSWLMC,A.BSZSL,
  A.WLBM,A.WLMC,
  CASE WHEN A.WLBM LIKE '38%'
    THEN NULL
      ELSE A.BXZSL
       END BXZSL,
       
       B.BSWLBM BSWLBM1,
       B.BSWLMC BSWLMC1,
       B.BSZSL BSZSL1,
       B.WLBM WLBM1,
       B.WLMC WLMC1,
       CASE WHEN B.WLBM LIKE '5%'
         THEN NULL
           ELSE B.BXZSL
             END DLBXZSL1,
           
            --------------- 
               B1.BSWLBM BSWLBM2,
               B1.BSWLMC BSWLMC2,
               B1.BSZSL BSZSL2,
               B1.WLBM WLBM2,
               B1.WLMC WLMC2,
       CASE WHEN B1.WLBM LIKE '32%'
         THEN NULL
           ELSE B1.BXZSL
             END XLBXZSL2,
       ------------------      
               C.BSWLBM BSWLBM3,
               C.BSWLMC BSWLMC3,
               C.BSZSL BSZSL3,
               C.WLBM WLBM3,
               C.WLMC WLMC3,
               C.BXZSL BXZSL3
             
          FROM (
          select a2.code          gsbm,
                       A2.NAME          GSMC, --计划组织编码
                       a2.shortname     gsjc, --计划组织姓名
                       a1.code          bswlbm, --主表物料编码
                       a1.name          bswlmc, --主表物料名称
                       
                       a4.hnparentnum   bszsl, --bom主表主数量
                       a4.hversion      bsbm, --bom主表版本
                       a3.name          bszdw, --bom主表物料主单位
                       b1.code          wlbm, --bom附表物料编码
                       b1.name          wlmc, --bom附表物料名称
                       b1.materialtype  wlxh, -- 型号
                       b2.nitemnum      bxzsl, --bom附表主数量
                       a4.hfversiontype, --版本类型
                       a4.hbdefault --是否默认
                
                  from bd_bom a4 --bom主表
                  left join org_orgs_v a2 --计划组织
                    on a4.pk_org = a2.pk_org
                  left join bd_material a1 --物料信息
                    on a4.hcmaterialid = a1.pk_material
                  left join bd_measdoc a3 --单位
                    on a4.hcmeasureid = a3.pk_measdoc
                  left join bd_bom_b b2 --bom附表
                    on a4.cbomid = b2.cbomid
                  left join bd_material b1 --物料信息
                    on b2.cmaterialid = b1.pk_material
                 where a4.dr = '0'
                   AND B2.DR='0'
                   AND a4. hvdef3='1001A2100000007TZY0S'
                   AND A4.fbillstatus='1'
                   AND a1.code LIKE '2%'
                  AND A4.hfversiontype='1'
                  AND A4.hbdefault='Y'
             --   AND A1.CODE='2102030075'
            --    AND a2.code='1013'
                AND   b1.code  LIKE '38%'
                ) A
          LEFT JOIN (
          
          select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           case when  a1.code like '38%'
                             THEN a4.hnparentnum/1000
                               ELSE
                           a4.hnparentnum END   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           case when  a1.code like '38%'
                             THEN '吨'
                               ELSE
                           a3.name   end       bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                       AND a4. hvdef3='1001A2100000007TZY0S'
                       AND A4.fbillstatus='1'
                      AND A4.hfversiontype='1'
                      AND A4.hbdefault='Y'
                       AND (a1.code LIKE '5%' OR a1.code LIKE '38%')
               --      AND A1.CODE='3800000003'
                    ) B
            ON A.WLBM = B.BSWLBM
           AND A.GSBM = B.GSBM
             LEFT JOIN (
          
          select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name         bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                       AND a4. hvdef3='1001A2100000007TZY0S'
                       AND A4.fbillstatus='1'
                      AND A4.hfversiontype='1'
                      AND A4.hbdefault='Y'
                       AND (a1.code LIKE '5%')
             --        AND A1.CODE='5204020039'
                    ) B1
            ON B.WLBM = B1.BSWLBM
           AND B.GSBM = B1.GSBM
           
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码         
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                       AND a4. hvdef3='1001A2100000007TZY0S'
                          AND A4.hbdefault='Y'
                       AND A4.fbillstatus='1'
                       AND A4.hfversiontype='1'
                                AND (a1.code LIKE '3%' OR  a1.code LIKE '5%')
                       ) C
            ON B1.WLBM = C.BSWLBM
           AND B1.GSBM = C.GSBM
           AND A.GSBM = C.GSBM
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码        
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                       AND a4. hvdef3='1001A2100000007TZY0S'
                       AND A4.fbillstatus='1'
                         AND A4.hbdefault='Y'
                       AND A4.hfversiontype='1'
                       AND a1.code LIKE '3%'
                       ) D
            ON C.WLBM = D.BSWLBM
           AND C.GSBM = D.GSBM
         )
        WHERE CASE WHEN BXZSL IS NOT NULL
THEN WLBM  ---2开头的材料
WHEN DLBXZSL1 IS NOT NULL
THEN WLBM1 --3开头的材料
WHEN XLBXZSL2 IS NOT NULL
THEN WLBM2 --5开头的材料
WHEN BXZSL3 IS NOT NULL
THEN WLBM3 --32开头的材料
END LIKE '4%'

)A
---------取BOM中的袋子

LEFT JOIN (
----------
SELECT GSBM,WLBM,
CASE WHEN DJ&lt;&gt;'0'
THEN DJ
  ELSE JCDJ
    END DJ
   FROM (
   
   
SELECT gsbm,wlbm,sum(nvl(jcdj,0))jcdj,sum(nvl(dj,0))dj
FROM(
 (select distinct b.gsbm,C.CODE wlbm,
A.nmonthprice jcDJ,0 dj 
from ia_generalnab a
left join (SELECT A.pk_costregion,B.CODE GSBM FROM org_costregion A
LEFT JOIN org_financeorg B
ON A.  pk_org=B. pk_financeorg) b
on a.pk_org=b. pk_costregion
LEFT JOIN bd_material C
ON A. cinventoryid =C.pk_material
where a.dr='0'
and c.code  like '4%'--原料结存成本
)

union ALL

(
select gsbm,wlbm,0 jcdj,round(dj,3)DJ from (
select distinct gsbm,wlbm,substr(djrq,0,7) qj,decode(sum(nvl(zsl,0)),0,0,sum(nvl(ckje,0))/sum(nvl(zsl,0))) dj from 
(
SELECT DISTINCT
       A.CGENERALHID               CGENERALHID,  --材料出库单主键
       A.CORPOID                   GSZJ,         --公司主键
       SUBSTR(A.DBILLDATE,1,10)    DJRQ,         --单据日期
       C.CODE                      GSBM,         --公司编码
       C.NAME                      GSMC,         --公司名称
       C.SHORTNAME                 GSJC,         --公司简称
       M.NAME                      BMMC,         --部门名称
       D.CODE                      WLBM,         --物料编码
       D.NAME                      WLMC,         --物料名称
       B.NNUM                      ZSL,          --主数量
       B.NCOSTPRICE                DJ,           --单价
       B.NCOSTMNY                  CKJE,         --出库金额
       P.CODE                      WLFLBM,       --物料分类编码
       P.NAME                      WLFLMC,       --物料分类名称
       B.CROWNO                    CROWNO        --行号
FROM IC_MATERIAL_H A
LEFT JOIN org_dept M
ON A.cdptid=M.pk_dept
LEFT JOIN IC_MATERIAL_B B
ON A.CGENERALHID=B.CGENERALHID
LEFT JOIN ORG_STOCKORG C
ON A.CDRAWCALBODYOID=C.PK_STOCKORG
LEFT JOIN BD_MATERIAL D
ON B.CMATERIALVID=D.PK_MATERIAL
LEFT JOIN BD_MARBASCLASS P
ON D.PK_MARBASCLASS=P.PK_MARBASCLASS

WHERE SUBSTR(A.DBILLDATE,1,7)=(to_char(add_months(trunc(sysdate),-1),'yyyy-mm'))
AND A.DR = 0
AND B.DR = 0
)
group by gsbm,wlbm,substr(djrq,0,7)
order by gsbm,wlbm,substr(djrq,0,7)
)
where wlbm  like '4%'
  --原料材料成本
)
)
group by gsbm,wlbm
ORDER BY GSBM,WLBM

 
)
) B

         ON A.GSBM=B.GSBM
         AND A.CLBM=B.WLBM
         )
         GROUP BY GSBM,GSMC,CPBM,CPMC
         ORDER BY ROUND(SUM(nvl(DWCB,0)),2)
         )
         B
         
         ON A.GSBM=B.GSBM
         AND A.CPBM=B.CPBM
        
------------------------------
LEFT JOIN 

(
SELECT DISTINCT QJ,GSBM,GSMC,WLBM,SUM(nvl(RLCB,0))RLCB FROM
(
SELECT B.QJ,B.GSBM,B.GSMC,B.BMMC,B.WLBM,b.ZCL,
decode(B.ZCL,0,0,A.JFSE/B.ZCL)
RLCB FROM 
(SELECT NF,KJQJ,NF||'-'||KJQJ QJ,GSBM,GSMC,KJKMBM,KJKM,BMMC,SUM(nvl(LJJFSE,0)) JFSE
FROM V_CWPZ
WHERE 
KJKMBM='510120'
AND pk_systemv &lt;&gt;'PLCF'      --排除掉汇总数据
and nf=(to_char(add_months(trunc(sysdate),-1),'yyyy'))
and kjqj=(to_char(add_months(trunc(sysdate),-1),'mm'))
AND BMMC LIKE '%成品%'
GROUP BY NF,KJQJ,GSBM,GSMC,KJKMBM,KJKM,BMMC
) A

RIGHT JOIN 

(select distinct qj,gsbm,gsmc,bmmc,WLBM,sum(nvl(zsl,0))OVER(PARTITION BY QJ,GSBM,BMMC)ZCL from
(
select substr(a.dbilldate,0,7)qj,c.code gsbm,c.name gsmc,c.shortname gsjc,e.name bmmc,d.code WLBM,d.name WLMC,
(case when d.code like '7%'
  then b.nassistnum
    else b.nnum
      end) zsl
 from ic_finprodin_h a
left join ic_finprodin_b b
on a.cgeneralhid=b.cgeneralhid
left join org_stockorg c
on a.pk_org=c.pk_stockorg
left join bd_material d
on b.cmaterialvid=d.pk_material
left join org_dept e
on a.cdptid =e.pk_dept 
left join bd_measdoc f
on b.cunitid=f.pk_measdoc
where a.dr='0'
and b.dr='0'
and substr(a.dbilldate,0,7)=(to_char(add_months(trunc(sysdate),-1),'yyyy-mm'))
and (d.code like '2%' or d.code like '7%')
and d.code not like '2102%'
)
)
B
ON A.GSBM=B.GSBM
AND A.BMMC=B.BMMC
AND A.NF||'-'||A.KJQJ=B.QJ
)
GROUP BY QJ,GSBM,GSMC,WLBM
)C
 ON A.GSBM=C.GSBM
         AND A.CPBM=C.WLBM


 LEFT JOIN 
(
select DISTINCT code wlbm,name wlmc,NVL(def1,0) bzshl,NVL(def2,0) jglv,NVL(def3,0) zzfy,NVL(def4,0) xljjgf from bd_defdoc
where pk_defdoclist =
(select pk_defdoclist from bd_defdoclist 
where name = '代加工费用系数')
)D
ON A.CPBM=D.WLBM
</sql>
