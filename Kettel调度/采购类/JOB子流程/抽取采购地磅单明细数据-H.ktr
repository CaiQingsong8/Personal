    <connection>nc65_ncread</connection>
    <sql>SELECT
D.CODE GSBM, --公司编码
D.NAME GSMC,--公司名称
D.PK_ORG GSZJ,--公司主键
'采购地磅单' DJLX,--单据类型
A.BILLNO DJH,--单据号
SUBSTR(A.DBILLDATE,0,10) DJRQ,--单据日期
F.VEHICLELICENSE CPH,--车牌号
F. VDEF6 SJXM,--司机姓名
F.VDEF1 SJHM,--手机号码
E.CODE GYSBM,--供应商编码
E.NAME GYSMC,--供应商名称
C.CODE WLBM, --物料编码
C.NAME WLMC, --物料名称
A.EMPTYWEIGHT PZ,  --皮重
A.FULLWEIGHT MZ, --毛重
B.PUTINWEIGHT JZ, --净重
B.OTHERWEIGHT DFBZ, --对方重量
A.FULLTIME JMSJ,--进门时间
A.EMPTYTIME CMSJ,--出门时间
A.DIFFERENCE CYBZ,--差异磅重
G.USER_NAME ZDR,--制单人
CASE WHEN A.APPROVESTATUS='1'
THEN '审批'
ELSE '自由'
END DJZT,--单据状态
A.ADDRECORD SFBL,--是否补录
A.TS --最后更新时间
FROM DB_CGDB_H A
LEFT JOIN  DB_CGDB_B B
ON A.PK_CGDB_H=B.PK_CGDB_H
LEFT JOIN  BD_MATERIAL C
ON B.PK_MATERIAL=C.PK_MATERIAL
LEFT JOIN ORG_ORGS D
ON A.PK_ORG=D.PK_ORG 
LEFT JOIN BD_SUPPLIER E
ON B.PK_SUPPLIER=E.PK_SUPPLIER
LEFT JOIN DM_VEHICLE F
ON A.CARNO=F.CVEHICLEID 
LEFT JOIN SM_USER G
ON A.BILLMAKER=G.CUSERID 
LEFT JOIN BD_DEFDOC H
ON A.REASON=H.PK_DEFDOC
WHERE A.DR='0'
AND B.DR='0'
AND SUBSTR(A.TS,1,10) >= TO_CHAR(SYSDATE-30,'YYYY-MM-DD')
ORDER BY SUBSTR(A.DBILLDATE,0,10) DESC</sql>
