  <step>
    <name>临时表输入</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>SELECT A.KHBM,A.KHMC,B.JE,C.QKJE,J.JNZSL,D.JNXSJE,K.QNZSL,E.QNXSJE,F.JNQKJE,G.QNQKJE FROM (
SELECT KHBM,KHMC FROM DA_KH)A
LEFT JOIN 
(
SELECT KHBM,KHMC,SUM(JSHJ)JE FROM XS_XSDD
WHERE SUBSTR(DJRQ,1,4)=to_char(sysdate, 'yyyy')
GROUP BY KHBM,KHMC
)B
ON A.KHBM=B.KHBM
LEFT JOIN
(
select KHBM,KHMC,
       SUM(YSJE)- SUM(SKJE) QKJE
  from CW_YSDZ
  GROUP BY KHBM,KHMC
  )C
ON A.KHBM=C.KHBM
LEFT JOIN (
SELECT KHBM,KHMC,SUM(ZSL) JNZSL,SUM(KPJE-ZKE) JNXSJE FROM XS_XSDD 
WHERE SUBSTR(DJRQ,1,4)=to_char(sysdate, 'yyyy')
GROUP BY KHBM,KHMC
)D
ON A.KHBM=D.KHBM
LEFT JOIN (
SELECT KHBM,KHMC,SUM(ZSL) QNZSL,SUM(KPJE-ZKE) QNXSJE FROM XS_XSDD 
WHERE SUBSTR(DJRQ,1,4)=to_char(ADD_MONTHS(sysdate,-12), 'yyyy')
GROUP BY KHBM,KHMC
)E
ON A.KHBM=E.KHBM
LEFT JOIN (
select KHBM,KHMC,
       SUM(YSJE)- SUM(SKJE) JNQKJE
  from CW_YSDZ
  WHERE SUBSTR(DJRQ,1,4)&lt;=TO_CHAR(SYSDATE,'YYYY')
  GROUP BY KHBM,KHMC
)F
ON A.KHBM=F.KHBM
LEFT JOIN (
  select KHBM,KHMC,
       SUM(YSJE)- SUM(SKJE) QNQKJE
  from CW_YSDZ
  WHERE SUBSTR(DJRQ,1,4)&lt;=TO_CHAR(ADD_MONTHS(SYSDATE,-12),'YYYY')
  GROUP BY KHBM,KHMC
)G
ON A.KHBM=G.KHBM
LEFT JOIN (
SELECT A.KHBM,A.KHMC,SUM(A.ZSL) JNZSL,SUM(A.KPJE-A.ZKE) JNXSJE 
FROM XS_XSDD A
LEFT JOIN DA_WL C
ON A.WLPK = C.WLPK
LEFT JOIN DA_WLJBFL D
ON C.FLPK = D.FLZJ
LEFT JOIN DA_BM F
ON A.BMMC=F.BMMC
LEFT JOIN DA_KH E
ON A.KHPK = E.KHPK
WHERE SUBSTR(A.DJRQ,1,4)=to_char(sysdate, 'yyyy')
AND A.SFZP = 'N'
AND D.FLBM3 not LIKE '23%'
AND E.KHJBFL = 'K1'
AND F.GSMC = '江门市澳保生物科技有限公司'
GROUP BY A.KHBM,A.KHMC
)J
ON A.KHBM=J.KHBM
LEFT JOIN (
SELECT A.KHBM,A.KHMC,SUM(A.ZSL) QNZSL,SUM(A.KPJE-A.ZKE) QNXSJE 
FROM XS_XSDD A
LEFT JOIN DA_WL C
ON A.WLPK = C.WLPK
LEFT JOIN DA_WLJBFL D
ON C.FLPK = D.FLZJ
LEFT JOIN DA_BM F
ON A.BMMC=F.BMMC
LEFT JOIN DA_KH E
ON A.KHPK = E.KHPK
WHERE SUBSTR(A.DJRQ,1,4)=to_char(ADD_MONTHS(sysdate,-12), 'yyyy')
AND A.SFZP = 'N'
AND D.FLBM3 not LIKE '23%'
AND E.KHJBFL = 'K1'
AND F.GSMC = '江门市澳保生物科技有限公司'
GROUP BY A.KHBM,A.KHMC
)K
ON A.KHBM=K.KHBM
WHERE 1=1
AND ABS(NVL(B.JE,0)) + ABS(C.QKJE)+ABS(NVL(D.JNZSL,0))+ABS(NVL(D.JNXSJE,0))+ABS(NVL(E.QNZSL,0))+ABS(NVL(E.QNXSJE,0))+ABS(NVL(JNQKJE,0))+ABS(NVL(QNQKJE,0)) &lt;&gt; 0</sql>
    <limit>0</limit>
