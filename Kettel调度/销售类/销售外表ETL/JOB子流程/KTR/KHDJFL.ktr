      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>SELECT  DISTINCT PK_KH,GSBM,
case 
when
hsdw like '%事业部%'
then HSDW
ELSE GSMC
END GSMC,HSDW,QJ,GSDQ
FROM BD_GSKH
WHERE TO_CHAR(ADD_MONTHS(SYSDATE,-0),'YYYY-MM')=QJ
ORDER BY PK_KH

</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
