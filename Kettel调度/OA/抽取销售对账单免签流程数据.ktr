    <connection>OA</connection>
    <sql>SELECT * FROM
(
SELECT
C.LASTNAME SHENQR,--申请人
E.SUBCOMPANYNAME GSJC,--公司简称
E.SUBCOMPANYDESC GSMC,--公司全称
CASE WHEN A.KEHSSGS IS NULL THEN E.SUBCOMPANYDESC ELSE G.SUBCOMPANYDESC END KHSSGS,--客户所属公司
D.DEPARTMENTNAME SHENQBM,--申请部门
F.JOBTITLENAME ZHIW,--职务
A.SHENQRQ,--申请日期
REPLACE(REPLACE(REPLACE(REPLACE(A.MIANQKH,chr(9),''),' ',''),'(','（'),')','）') KHMC,--客户名称
CASE WHEN A.MIANQLX = 0 THEN '当期免签' WHEN A.MIANQLX = 1 THEN '长期免签' ELSE ''END MIANQLX,--免签类型
CASE WHEN A.SHENQMQLY = 0 THEN '连续三个月未有发生额且三个月前的对账单有签订（12月份除外）' 
WHEN A.SHENQMQLY = 1 THEN '客户已不合作，待销户' 
WHEN A.SHENQMQLY = 2 THEN '呆死账客户，已无法联系到客户本人签字' 
WHEN A.SHENQMQLY = 3 THEN '已进入诉讼或法院执行流程' 
WHEN A.SHENQMQLY = 4 THEN '无专人跟进的边远地区客户' 
WHEN A.SHENQMQLY = 5 THEN '连续三个月未有发生额且三个月内的对账单有签订（12月份除外）' 
WHEN A.SHENQMQLY = 6 THEN '客户已不合作，待销户（1个月内须销户）' 
WHEN A.SHENQMQLY = 7 THEN '无专人跟进的边远地区客户(三个月内有签回对账单）' 
ELSE '未知原因'END SHENQMQLY,--免签理由
A.MIANQSM,--免签说明
A.MIANQQSRQ,--免签起始日期
A.MIANQJZRQ,--免签截止日期
A.BIANH,--流程编号
B.STATUS --流程当前节点
FROM formtable_main_159 A --对账单免签流程
LEFT JOIN workflow_requestbase B --工作流请求基本信息表
ON A.REQUESTID = B.REQUESTID
LEFT JOIN HrmResource C --人力资源表
ON C.ID = A.SHENQR
LEFT JOIN hrmdepartment D --部门表
ON D.ID = A.SHENQBM
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = A.SUOSGS
LEFT JOIN hrmjobtitles F --岗位表
ON F.ID = A.ZHIW
LEFT JOIN hrmsubcompany G --分部表
ON G.ID = A.KEHSSGS
WHERE 1=1
AND B.CREATEDATE &lt; '2020-04-30'

UNION ALL

SELECT 
C.LASTNAME SHENQR,--申请人
E.SUBCOMPANYNAME GSJC,--公司简称
E.SUBCOMPANYDESC GSMC,--公司全称
CASE WHEN B.KEHSSGS IS NULL THEN E.SUBCOMPANYDESC ELSE G.SUBCOMPANYDESC END KHSSGS,--客户所属公司
D.DEPARTMENTNAME SHENQBM,--申请部门
F.JOBTITLENAME ZHIW,--职务
B.SHENQRQ,--申请日期
REPLACE(REPLACE(REPLACE(REPLACE(A.KHMC,chr(9),''),' ',''),'(','（'),')','）') KHMC,--客户名称
CASE WHEN A.MQLX = 0 THEN '当期免签' WHEN A.MQLX = 1 THEN '长期免签' ELSE ''END MIANQLX,--免签类型
CASE WHEN A.SQMQLY = 0 THEN '呆死账客户，已无法联系到客户本人签字' 
WHEN A.SQMQLY = 1 THEN '已进入诉讼或法院执行流程' 
WHEN A.SQMQLY = 2 THEN '连续三个月未有发生额且三个月内的对账单有签订（12月份除外）' 
WHEN A.SQMQLY = 3 THEN '客户已不合作，待销户（1个月内须销户）' 
WHEN A.SQMQLY = 4 THEN '无专人跟进的边远地区客户(三个月内有签回对账单）' 
ELSE '未知原因'END SHENQMQLY,--免签理由
A.MQSM MIANQSM,--免签说明
A.MQQSRQ MIANQQSRQ,--免签起始日期
A.MQJZRQ MIANQJZRQ,--免签截止日期
B.BIANH,--流程编号
H.STATUS --流程当前节点
FROM formtable_main_159_dt1 A
LEFT JOIN formtable_main_159 B
ON A.MAINID = B.ID
LEFT JOIN HrmResource C --人力资源表
ON C.ID = B.SHENQR
LEFT JOIN hrmdepartment D --部门表
ON D.ID = B.SHENQBM
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = B.SUOSGS
LEFT JOIN hrmjobtitles F --岗位表
ON F.ID = B.ZHIW
LEFT JOIN hrmsubcompany G --分部表
ON G.ID = B.KEHSSGS
LEFT JOIN workflow_requestbase H--工作流基本信息表
ON B.REQUESTID = H.REQUESTID
WHERE 1=1
AND H.CREATEDATE >= '2020-04-30'
AND H.STATUS = '归档'
AND A.SFTY = 0 --只同步意见为“同意”的数据，0表示同意
)</sql>
    <limit>0</limit>
