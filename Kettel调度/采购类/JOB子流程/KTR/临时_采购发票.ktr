  <step>
    <name>抽取主数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT A.PK_INVOICE,                     --发票主键
       A.VBILLCODE                FPDH,  --发票单号
       SUBSTR(A.CREATIONTIME,1,10) CJRQ, --创建日期
       SUBSTR(A.DBILLDATE,1,10)   FPRQ,  --发票日期
       SUBSTR(A.DARRIVEDATE,1,10) PDRQ,  --票到日期
       B.VORDERCODE               CGDDH, --采购订单号
       C.CODE                     GSBM,  --公司编码
       C.NAME                     GSMC,  --公司名称
       B.VSOURCECODE              RKDH,  --入库单号
       E.CODE                     GYSBM, --供应商编码
       E.NAME                     GYSMC, --供应商名称
       D.CODE                     WLBM,  --物料编码
       D.NAME                     WLMC,  --物料名称
       B.NNUM                     ZSL,   --主数量
       B.NORIGPRICE               DJ,    --单价
       B.NORIGTAXMNY              JSHJ,  --价税合计
	   F.CODE                     WLFLBM,--物料分类编码
	   F.NAME                     WLFLMC,--物料分类名称
	   G.CODE                     SJWLFLBM,--上级物料分类编码
	   G.NAME                     SJWLFLMC --上级无聊分类名称
FROM PO_INVOICE A
LEFT JOIN PO_INVOICE_B B
     ON A.PK_INVOICE = B.PK_INVOICE
LEFT JOIN ORG_FINANCEORG_V C
     ON A.PK_ORG_V = C.PK_VID
LEFT JOIN BD_MATERIAL D
     ON B.PK_MATERIAL=D.PK_MATERIAL
LEFT JOIN BD_SUPPLIER E
     ON B.PK_SUPPLIER=E.PK_SUPPLIER
LEFT JOIN BD_MARBASCLASS F
     ON D.PK_MARBASCLASS=F.PK_MARBASCLASS
LEFT JOIN BD_MARBASCLASS G
     ON F.PK_PARENT=G.PK_MARBASCLASS
WHERE B.DR= 0
AND B.VSOURCECODE LIKE 'CR0%'
AND A.CREATIONTIME >= '${cgupdtime}'</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
