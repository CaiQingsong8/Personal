  <step>
    <name>输入资产负债表</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>WITH AA AS 
(SELECT NF,GSBM,GSMC,KJKMBM,KJKM,KJQJ,SUM(JFSE)JFSE,SUM(DFSE)DFSE,SUM(JDFSE)JDFSE FROM CW_DCSJ
 WHERE KJKMBM&lt;&gt;'1122'
 GROUP BY NF,GSBM,GSMC,KJKMBM,KJKM,KJQJ ),
BB AS    --单独处理应付、预收账款，需要先按客户进行累计，再选出每月累计额大于0的进行累加，作为应收账款，小于0的进行累加，作为预收账款                                                      这个可以不用了，因为1122科目单独输出在CW_YSZKB,但加了也没事
( SELECT NF,GSBM,GSMC,KJKMBM,KJKM,KHBM,KHMC,KJQJ,JFSE,DFSE,JDFSE,SUM(JDFSE) over(partition by NF,GSBM,GSMC,KJKMBM,KJKM,KHBM,KHMC order by KJQJ)LJJDFSE
   FROM CW_DCSJ
  WHERE KJKMBM='1122'
),
CC AS 
(SELECT * FROM CW_SHHXLSCFY)
SELECT NF,GSBM,GSMC,SUBSTR(KJKMBM,1,4) KJKMBM,KJKM,KJQJ,JFSE,DFSE,JDFSE,sum(JDFSE) over(partition by NF,GSBM,GSMC,SUBSTR(KJKMBM,1,4),KJKM order by KJQJ)LJJDFSE FROM AA
UNION 
SELECT NF,GSBM,GSMC, KJKMBM,KJKM,KJQJ,JFSE,DFSE,JDFSE,sum(JDFSE) over(partition by NF,GSBM,GSMC,KJKMBM,KJKM order by KJQJ)LJJDFSE FROM AA
UNION
SELECT NF,GSBM,GSMC,KJKMBM,KJKM,KJQJ,SUM(JFSE) JFSE,SUM(DFSE) DFSE,SUM(JDFSE) JDFSE,SUM(LJJDFSE) LJJDFSE FROM BB   --应收账款
WHERE LJJDFSE>0
GROUP BY NF,GSBM,GSMC,KJKMBM,KJKM,KJQJ
UNION                                                                                                         --预收账款
SELECT NF,GSBM,GSMC,KJKMBM,KJKM,KJQJ,SUM(JFSE) JFSE,SUM(DFSE) DFSE,SUM(JDFSE) JDFSE,SUM(LJJDFSE) LJJDFSE FROM BB
WHERE LJJDFSE&lt;0
GROUP BY NF,GSBM,GSMC,KJKMBM,KJKM,KJQJ
UNION 
SELECT NF,GSBM,GSMC,KJKMBM,KJKM,KJQJ,-SUM(JFSE) JFSE,NULL DFSE,NULL JDFSE,NULL LJJDFSE FROM CC
GROUP BY NF,GSBM,GSMC,KJKMBM,KJKM,KJQJ


</sql>
    <limit>0</limit>
