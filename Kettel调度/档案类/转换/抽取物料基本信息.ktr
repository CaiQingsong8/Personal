  <step>
    <name>抽取物料基本数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread_master</connection>
    <sql>WITH TEMP AS(
SELECT 
       a.pk_material WLPK,--物料主键 
       a.enablestate wlzt, --物料状态
       a.code wlbm,  --物料编码
       a.name wlmc,  --物料名称
       a.materialshortname wljc,--物料简称
       b.pk_marbasclass FLPK, --物料分类PK
       b.code flbm,--物料分类编码
       b.name flmc,--物料分类名称
       c.name zdw, --主单位
       d.name fdw, --辅单位
       d.measrate dwhsl, --物料单位换算率,
       e.pk_brand PPPK, --物料品牌PK
       e.name wlpp, --物料品牌
       a.materialspec wlgg, --物料规格
       a.materialtype wlxh, --物料型号
       a.materialmnecode wlzjm, --物料助记码
       f1.name zlfl, --物料战略分类名称
       f1.pk_defdoc zlflpk, --战略分类PK
       substr(f1.name,1,instr(f1.name,'-')-1) sjzlfl， --上级战略分类名称
       f3.name xddxs, --销售吨系数
       f4.name scdxs, --生产吨系数
       f5.name pzscdxs,--品种生产吨系数
       f6.name lj,--粒径
       f7.name wlsx,--物料属性
       f8.name cpbq,--产品标签
       a.creationtime as cjsj, --系统建档时间   
       ROW_NUMBER()OVER(PARTITION BY A.CODE ORDER BY INSTR(2,A.ENABLESTATE),A.TS DESC,A.PK_MATERIAL DESC) AS RN --已启用，修改时间晚，主键排序靠后的排序靠前
    
  from bd_material a
  left join bd_marbasclass b
    on a.pk_marbasclass = b.pk_marbasclass
  left join bd_measdoc c
    on c.pk_measdoc=a.pk_measdoc
  left join (select d.pk_material,d1.name,d.measrate from bd_materialconvert d
  left join bd_measdoc d1
    on d.pk_measdoc=d1.pk_measdoc)d
   on a.pk_material=d.pk_material
  left join bd_branddoc e
    on a.pk_brand=e.pk_brand
  left join bd_defdoc f1
    on a.def1=f1.pk_defdoc
  left join bd_defdoc f3
    on a.def3=f3.pk_defdoc
  left join bd_defdoc f4
    on a.def4=f4.pk_defdoc
  left join bd_defdoc f5
    on a.def8=f5.pk_defdoc
  left join bd_defdoc f6
    on a.def9=f6.pk_defdoc
  left join bd_defdoc f7
    on a.def6=f7.pk_defdoc
  left join bd_defdoc f8
    on a.def14=f8.pk_defdoc

WHERE A.DR = '0'
AND B.DR='0'
)
SELECT * FROM TEMP WHERE RN=1</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
