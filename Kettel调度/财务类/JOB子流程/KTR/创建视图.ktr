    <execute_each_row>Y</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>CREATE OR REPLACE VIEW V_CWPZ(PZBM,FLH,NF,KJQJ,FZYEBS,GSBM,GSMC,KJKMBM,KJKM,LJJFSE,LJDFSE,F1,F2,F11,F13,F5,F4,F14,F18,BMMC, RYXM,YHBM,YHMC,YHJC, KHBM, KHMC,NBKSBM,NBKSMC,WBKSBM,WBKSMC,GYSBM,GYSMC,pk_systemv,XJZHBM,XJZHMC,SFHSDW)
 AS
select distinct            
       a.nov            PZBM, --凭证编码,
       a.detailindex    FLH, --分录号,    
       a.yearv         NF, --年份,
       a.periodv       KJQJ, -- 会计期间                      /*00表示期初*/  
       a.assid        FZYEBS,-- 辅助余额标识, 
       b.code         GSBM,  --公司编码 
       b.name         GSMC, --公司名称
       d.code         KJKMBM,-- 会计科目编码,
       d.name         KJKM,-- 会计科目,
       NVL(a.debitamount,'0')  LJJFSE,-- 累计借发生额,
       NVL(a.creditamount,'0') LJDFSE,-- 累计贷发生额,
       gl_docfree1.F1,
       gl_docfree1.F2,
       gl_docfree1.F11,
       gl_docfree1.F13,
       gl_docfree1.F5,
       gl_docfree1.F4,
       gl_docfree1.F14,
       gl_docfree1.F18,
       org_dept.NAME   BMMC,--部门名称
       bd_psndoc.NAME  RYXM,--人员姓名
       bd_bankaccsub.CODE  YHBM,--银行编码
       bd_bankaccsub.NAME  YHMC,--银行名称
       bd_bankaccsub.mnecode  YHJC,--银行名称
       bd_customer.CODE      KHBM, --客户编码 
       bd_customer.NAME      KHMC,  --客户名称
       bd_cust_supplier.CODE NBKSBM,--内部客商编码
       bd_cust_supplier.NAME NBKSMC,--内部客商名称
       X.CODE WBKSBM,--内部客商编码
       X.NAME WBKSMC,--内部客商名称
       bd_supplier.CODE      GYSBM,--供应商编码
       bd_supplier.NAME      GYSMC, --供应商名称
       a.pk_systemv          pk_systemv,--制单系统
       bd_cashaccount.CODE XJZHBM, --现金账户编码
       bd_cashaccount.name XJZHMC,  --现金账户名称
       org_dept.def3 SFHSDW   --是否是核算单位
  from gl_detail a
  left join org_corp b
    on a.pk_unit = b.pk_corp
  left join (select a.code, b.name, b.pk_accasoa,c.pk_accchart
               from bd_account a
              right join bd_accasoa b
                 on a.pk_account = b.pk_account
              right join bd_accchart c
                 on b.pk_accchart = c.pk_accchart
              right join bd_accsystem d
                 on c.pk_accsystem = d.pk_accsystem
              right join bd_accass k
                 on c.pk_accchart=k.pk_accchart
              right join bd_accassitem j
                 on j.pk_accassitem=k.pk_entity
              where d.code = '0004'
                and a.code is not null) d
    on a.pk_accasoa = d.pk_accasoa 
    left join gl_docfree1
    on gl_docfree1.ASSID= a.assid 
   LEFT JOIN org_dept 
    ON org_dept.PK_DEPT = gl_docfree1.F1
   LEFT JOIN bd_psndoc
    ON bd_psndoc.pk_psndoc = gl_docfree1.F2

    LEFT JOIN (select a.code,a.name,a.pk_bankaccsub,b.mnecode from bd_bankaccsub a left join bd_bankaccbas b
    on a.pk_bankaccbas=b.pk_bankaccbas )  bd_bankaccsub
    ON bd_bankaccsub.pk_bankaccsub = gl_docfree1.F11

     LEFT JOIN bd_customer
    ON bd_customer.pk_customer = gl_docfree1.F13

    LEFT JOIN bd_cust_supplier
    ON bd_cust_supplier.pk_cust_sup = gl_docfree1.F5
    
    LEFT JOIN bd_cust_supplier X
    ON X.pk_cust_sup = gl_docfree1.F4
     
     LEFT JOIN bd_supplier 
    ON bd_supplier.pk_supplier = gl_docfree1.F14

    LEFT JOIN bd_cashaccount
    on bd_cashaccount.PK_cashaccount=GL_Docfree1.F18

    where  a.yearv>=SUBSTR('${CW_UPD_TIME}',1,4)    
  --AND a.periodv&lt;&gt;'00'--不加查询期间查询的数据会很多
      AND a.dr='0'</sql>
    <set_params>N</set_params>
    <insert_field />
    <update_field />
    <delete_field />
    <read_field />
    <arguments>
      <argument>
        <name>CW_UPD_TIME</name>
      </argument>
    </arguments>
    <cluster_schema />
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>640</xloc>
      <yloc>192</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>财务期初视图</name>
    <type>ExecSQL</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread_master</connection>
    <execute_each_row>Y</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>CREATE OR REPLACE VIEW V_CWQC(NF,KJQJ,FZYEBS, GSBM,GSMC,KJKMBM,KJKM,LJJFSE,LJDFSE,F1,F2,F11,F13,F5,F4,F14,F18,BMMC,RYXM,YHBM,YHMC,YHJC,KHBM, KHMC,NBKSBM,NBKSMC,WBKSBM,WBKSMC,GYSBM,GYSMC,XJZHBM,XJZHMC)
AS 
(

select distinct a.year          NF,--年份
       a.period        KJQJ,      --会计期间
       a.assid         FZYEBS,--辅助余额标识
       b.code          GSBM,--公司编码
       b.name          GSMC, --公司名称
       d.code          KJKMBM,--会计科目编码
       d.name          KJKM,  --会计科目
       NVL(a.debitamount,'0')   LJJFSE,--累计借发生额
       NVL(a.creditamount,'0')  LJDFSE,--累计贷发生额
      
       gl_docfree1.F1,
       gl_docfree1.F2,
       gl_docfree1.F11,
       gl_docfree1.F13,
       gl_docfree1.F5,
       gl_docfree1.F4,
       gl_docfree1.F14,
       gl_docfree1.F18,


       org_dept.NAME   BMMC,--部门名称
       bd_psndoc.NAME  RYXM,--人员姓名
       bd_bankaccsub.CODE  YHBM,--银行编码
       bd_bankaccsub.NAME  YHMC,--银行名称
       bd_bankaccsub.mnecode  YHJC,--银行名称
       bd_customer.CODE      KHBM, --客户编码 
       bd_customer.NAME      KHMC,  --客户名称
       bd_cust_supplier.CODE NBKSBM,--内部客商编码
       bd_cust_supplier.NAME NBKSMC,--内部客商名称
       X.CODE WBKSBM,--外部客商编码
       X.NAME WBKSMC,--外部客商名称
       bd_supplier.code, --供应商编码
       bd_supplier.name, --供应商名称
       bd_cashaccount.CODE XJZHBM, --现金账户编码
       bd_cashaccount.name XJZHMC--现金账户名称
       
    --   sum(a.debitamount) as 原币累计借发生额,
    --   sum(a.creditamount) as 原币累计贷发生额
  from gl_balance a
  left join org_corp b
    on a.pk_unit = b.pk_corp
  left join gl_docfree1 h --此表里面F选项中的顺序判断是什么辅助核算。
    on a.assid=h.assid 
  left join (select a.code, b.name, b.pk_accasoa,c.pk_accchart
               from bd_account a
              right join bd_accasoa b
                 on a.pk_account = b.pk_account
              right join bd_accchart c
                 on b.pk_accchart = c.pk_accchart
              right join bd_accsystem d
                 on c.pk_accsystem = d.pk_accsystem
              right join bd_accass k
                 on c.pk_accchart=k.pk_accchart
              right join bd_accassitem j
                 on j.pk_accassitem=k.pk_entity
              where d.code = '0004'
                and a.code is not null) d
    on a.pk_accasoa = d.pk_accasoa 
   left join gl_docfree1
    on gl_docfree1.ASSID= a.assid 
   LEFT JOIN org_dept 
    ON org_dept.PK_DEPT = gl_docfree1.F1
   LEFT JOIN bd_psndoc
    ON bd_psndoc.pk_psndoc = gl_docfree1.F2

    LEFT JOIN (select a.code,a.name,a.pk_bankaccsub,b.mnecode from bd_bankaccsub a left join bd_bankaccbas b
    on a.pk_bankaccbas=b.pk_bankaccbas )bd_bankaccsub
    ON bd_bankaccsub.pk_bankaccsub = gl_docfree1.F11
    
     LEFT JOIN bd_customer
    ON bd_customer.pk_customer = gl_docfree1.F13

    LEFT JOIN bd_cust_supplier
    ON bd_cust_supplier.pk_cust_sup = gl_docfree1.F5
     
    LEFT JOIN bd_cust_supplier X
    ON X.pk_cust_sup = gl_docfree1.F4

    LEFT JOIN bd_supplier
    ON bd_supplier.pk_supplier = gl_docfree1.F14
   
    LEFT JOIN bd_cashaccount
    on bd_cashaccount.PK_cashaccount=GL_Docfree1.F18
    where a.year>=SUBSTR('${CW_UPD_TIME}',1,4)
    AND a.period='00'--不加查询期间查询的数据会很多
    --AND A.ASSID &lt;&gt; '~'
   
   --group by  a.year,b.name,d.code,d.name,bd_customer.CODE,a.period
)</sql>
