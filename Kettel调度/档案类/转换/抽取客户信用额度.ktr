  <step>
    <name>临时表输入</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>ncread</connection>
    <sql>select distinct d.code XYKZYBM,
       d.name XYKZYMC,
       A.nlimitmny  XYED,
       b.pk_customer KHPK,
       b.code KHBM,
       b.name KHMC,
       b.shortname KHJC,
       SUBSTR(a.dfromdate,0,10)YXQKS,
       SUBSTR(a.dtodate,0,10)YXQJS,
       e.name BZ,
       (SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD') FROM DUAL) TJRQ, --在册期间
       P.vlimittypename  EDLX,
       A1.SPRQ,
CASE WHEN SUBSTR(a.dfromdate,0,4)=TO_CHAR(SYSDATE,'YYYY')
AND (SUBSTR(a.dtodate,0,4)>TO_CHAR(SYSDATE,'YYYY')) OR (SUBSTR(a.dtodate,6,2)='12')
THEN '永久额度'
ELSE '临时额度' END EDZL
  from so_creditamount a
  left join bd_customer b
    on a.ccustomerid = b.pk_customer
  left join org_crectlregion d
    on a.pk_org = d.pk_ccregion
  left join bd_currtype e
    on a.ccurrencyid = e.pk_currtype
  LEFT JOIN (SELECT ccustomerid,climittypeid,MAX(SUBSTR(taudittime,0,10))SPRQ FROM so_creditamount WHERE dr='0'
AND SUBSTR(dfromdate,0,10)&lt;=TO_CHAR(SYSDATE,'YYYY-MM-DD') 
AND substr(dtodate,0,10)>=TO_CHAR(SYSDATE,'YYYY-MM-DD')
AND taudittime IS NOT NULL
GROUP BY ccustomerid,climittypeid)A1
ON A.ccustomerid=A1.ccustomerid
AND A.climittypeid=A1.climittypeid
AND SUBSTR(A.taudittime,0,10)=A1.SPRQ
LEFT JOIN so_limittype P
ON A.climittypeid =P.climittypeid 
where a.dr='0'
AND SUBSTR(dfromdate,0,10)&lt;=TO_CHAR(SYSDATE,'YYYY-MM-DD') 
AND substr(dtodate,0,10)>=TO_CHAR(SYSDATE,'YYYY-MM-DD')
AND SPRQ IS NOT NULL
AND d.code &lt;&gt;'1030'
AND D.CODE &lt;&gt;'1018'
ORDER BY SUBSTR(a.dtodate,0,10)</sql>
    <limit>0</limit>
    <lookup />
