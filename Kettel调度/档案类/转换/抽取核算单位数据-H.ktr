      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT 
'未知' DWZT, --单位状态
CASE WHEN A.enablestate = 2 THEN 'Y'
ELSE 'N' END JYZT,--经营状态
C.NAME DQMC, --集团大区
A.CODE DWBM,--单位编码
A.name DWMC,--单位名称
A.SHORTNAME DWJC,--单位简称
CASE WHEN A.DEF2='~' THEN NULL ELSE A.DEF2 END AS DWLX,--单位类型
A.pk_defdoc DWPK,--单位PK，暂时无法获取
A.DEF1 BBPX,--报表排序
A.DEF3 XSZZ,
A.DEF5 DWQC,
D.CODE XSZZBM,
D.NAME XSZZMC,
D.SHORTNAME XSZZJC,
--case when A.DEF5 = '深圳水产料事业部' then '1024'
--when A.DEF5 = '深圳海特料事业部' then '1011'
--else D.CODE end as GSZZBM,
--case when A.DEF5 = '深圳水产料事业部' then '江门市澳华生物科技有限公司'
--when A.DEF5 = '深圳海特料事业部' then '福建澳华农牧科技有限公司'
--else D.NAME end as GSZZMC
D.CODE as GSZZBM,
D.NAME as GSZZMC


FROM bd_defdoc A --自定义档案
LEFT JOIN BD_DEFDOCLIST B --自定义档案列表
ON A.PK_DEFDOCLIST = B.PK_DEFDOCLIST
LEFT JOIN bd_defdoc C --自定义档案
ON A.DEF4 = C.PK_DEFDOC
LEFT JOIN org_salesorg D
ON A.DEF3 = D.pk_salesorg
WHERE 1=1
AND B.NAME = '核算单位'
AND D.NAME IS NOT NULL
AND A.DR = 0
</sql>
    <limit>0</limit>
