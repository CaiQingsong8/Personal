  <step>
    <name>获取上个月BOM拆分</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT GSBM,GSMC,to_char(add_months(trunc(sysdate),-0),'yyyy-mm') QJ,
CPBM,CPMC,CPCL/CPCL CPCL,
CLBM,CLZSL/CPCL CLZSL
FROM
(
SELECT DISTINCT GSBM,
                GSMC,
                BSWLBM CPBM,
                BSWLMC CPMC,
                BSZSL CPCL,
                (CASE
                  WHEN DLBM IS NULL and xlbm is not null THEN  --添加剂小料
                   XLBM
                  WHEN DLBM IS NULL  and xlbm is null THEN  --小料中的小料
                   CLBM
                  else
                   dlbm                                                   --大料配方材料
                end) CLBM,
                
                (CASE
                  WHEN DLZSL IS NULL  AND XLZSL IS NOT NULL THEN 
                   (XLZSL * DLBXZSL / XLBSZSL)
                  WHEN DLZSL IS NULL  AND XLZSL IS NULL THEN
                   CLZSL * XLBXZSL / CLBSZSL
                  else
                   dlZSL*BSZSL/DLBSZSL
                end) clZSL
  from (
  SELECT distinct B.GSBM,
                        B.GSMC,
                        B.BSWLBM,
                        B.BSWLMC,
                        B.BSZSL,
                       B.BSZSL DLBSZSL,
                        (CASE
                          WHEN (B.WLBM LIKE '32%' OR B.WLBM LIKE '39%' OR
                               B.WLBM LIKE '33%') THEN
                           B.BXZSL
                          WHEN (B.WLBM IN ('3100000013',
                                           '3100000001',
                                           '3100000017',
                                           '3100000009',
                                           '3100000018') AND B.GSBM = '1007') THEN
                           B.BXZSL
                        
                          WHEN (B.WLBM = '3100000001' AND B.GSBM = '1008') THEN
                           B.BXZSL
                        
                          WHEN (B.WLBM IN ('3100000013', '3100000001') AND
                               B.GSBM = '1002') THEN
                           B.BXZSL
                        
                          WHEN (B.WLBM IN ('3100000001', '3100000002') AND
                               B.GSBM = '1001') THEN
                           B.BXZSL
                        
                          ELSE
                           NULL
                        END) DLBXZSL,
                        
                        C.BSZSL XLBSZSL,
                        
                        (CASE
                          WHEN (C.WLBM LIKE '32%' OR C.WLBM LIKE '39%' OR
                               C.WLBM LIKE '33%' OR C.WLBM LIKE '34%') THEN
                           C.BXZSL
                          ELSE
                           NULL
                        END) XLBXZSL,
                        
                        D.BSZSL CLBSZSL,
                        
                       
                        (CASE
                          WHEN (B.WLBM LIKE '32%' OR B.WLBM LIKE '39%' OR
                               B.WLBM LIKE '33%') THEN
                           NULL
                          WHEN (B.WLBM IN ('3100000013',
                                           '3100000001',
                                           '3100000017',
                                           '3100000009',
                                           '3100000018') AND B.GSBM = '1007') THEN
                           NULL
                        
                          WHEN (B.WLBM = '3100000001' AND B.GSBM = '1008') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000013', '3100000001') AND
                               B.GSBM = '1002') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000001', '3100000002') AND
                               B.GSBM = '1001') THEN
                           NULL
                          ELSE
                           B.WLBM
                        END) DLBM,
                        
                        (CASE
                          WHEN (B.WLBM LIKE '32%' OR B.WLBM LIKE '39%' OR
                               B.WLBM LIKE '33%') THEN
                           NULL
                          WHEN (B.WLBM IN ('3100000013',
                                           '3100000001',
                                           '3100000017',
                                           '3100000009',
                                           '3100000018') AND B.GSBM = '1007') THEN
                           NULL
                          WHEN (B.WLBM = '3100000001' AND B.GSBM = '1008') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000013', '3100000001') AND
                               B.GSBM = '1002') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000001', '3100000002') AND
                               B.GSBM = '1001') THEN
                           NULL
                          ELSE
                           B.BXZSL
                        END) DLZSL,
                        
                        (CASE
                          WHEN C.WLBM LIKE '3%' AND C.WLBM NOT LIKE '34%' THEN
                           NULL
                          ELSE
                           C.WLBM
                        END) XLBM,
                        
                        (CASE
                          WHEN C.WLBM LIKE '3%' AND C.WLBM NOT LIKE '34%' THEN
                           NULL
                          ELSE
                           C.BXZSL
                        END) XLZSL,
                        
                        D.WLBM  CLBM,
                        D.BXZSL CLZSL
          FROM (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                     AND B2.DR='0'
                   -- AND a4. hvdef3='1001A2100000007TZY0S' --代工
                       AND a4.hbdefault='Y'
                       AND A4.fbillstatus='1'
                       AND A4.hfversiontype='1'
                       AND a1.code LIKE '5%'
                --     AND A1.CODE='5202030014'
                    ) B
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码         
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                      --  AND a4. hvdef3='1001A2100000007TZY0S' --代工
                       AND  a4.hbdefault='Y'
                       AND A4.fbillstatus='1'
                       AND A4.hfversiontype='1'
                       AND a1.code LIKE '3%'
                       ) C
            ON B.WLBM = C.BSWLBM
           AND B.GSBM = C.GSBM
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码        
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                     --  AND a4. hvdef3='1001A2100000007TZY0S' --代工
                       AND  a4.hbdefault='Y'
                       AND A4.fbillstatus='1'
                       AND A4.hfversiontype='1'
                       AND a1.code LIKE '3%'
                       ) D
            ON C.WLBM = D.BSWLBM
           AND C.GSBM = D.GSBM
      --     WHERE B.BSZSL>1
         -- AND B.BSWLBM='5202030012'
           )
           )
           WHERE CLBM IS NOT NULL</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema />
    <remotesteps>
      <input>
      </input>
      <output>
