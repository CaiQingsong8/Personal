  <step>
    <name>抽取销售对账单汇总数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>SELECT
A.ORGNAME,
A.KHBM KH,
A.CUSTNAME KHMC,
A.YWRYPK,
A.YWRY,
A.BMMC,
B.GSBM,
B.GSDH,
NVL(m.QCJE,0) QCJE,
NVL(m.SKJE,0) SKJE,
p.DJRQ,
NVL(n.BS,0) BS,
NVL(n.DS,0) DS,
NVL(y.xssl,0) xssl,
NVL(n.JSJE,0) JSJE,
NVL(n.FKJE,0) FKJE
FROM
(SELECT DISTINCT CORP_NAME AS ORGNAME,CLIENT_CODE AS KHBM,CLIENT_NAME AS CUSTNAME,SALESMAN_NAME AS YWRY,DEPT_NAME AS BMMC,SALESMAN_PK AS YWRYPK
FROM F_XSDZD_DEPT ) A
--公司电话
LEFT JOIN 
(SELECT DISTINCT GSBM,GSDH,GSMC FROM BD_GSDH) B
ON A.ORGNAME = B.GSMC
--期初收款
LEFT JOIN (
     SELECT DISTINCT AA.ORGNAME  ORGNAME,
                     AA.KHBM KHBM,
                     BB.QCJE QCJE,
                     CC.SKJE SKJE
     FROM F_XSDZD_AB AA
     LEFT JOIN (
          SELECT DISTINCT ORGNAME,
                          KHBM,
                          (SUM(JSJE) OVER(PARTITION BY ORGNAME,KHBM)-SUM(SKJE) OVER(PARTITION BY ORGNAME,KHBM)) AS QCJE
          FROM F_XSDZD_AB
          WHERE SUBSTR(F_XSDZD_AB.DJRQ,1,7) &lt; TO_CHAR(ADD_MONTHS(SYSDATE,-1),'yyyy-mm')
                ) BB
     ON AA.ORGNAME=BB.ORGNAME AND AA.KHBM=BB.KHBM
     LEFT JOIN (
          SELECT ORGNAME,
                 KHBM,
                 SUM(SKJE) SKJE
          FROM F_XSDZD_AB
          WHERE SUBSTR(F_XSDZD_AB.DJRQ,1,7) = TO_CHAR(ADD_MONTHS(SYSDATE,-1),'yyyy-mm')
          GROUP BY ORGNAME,KHBM ) CC
     ON AA.ORGNAME=CC.ORGNAME AND AA.KHBM=CC.KHBM
) m
ON A.ORGNAME = m.ORGNAME AND A.KHBM = m.KHBM
--包数吨数结算金额
LEFT JOIN (
     SELECT e.ORGNAME,
            e.KHBM,
            SUM(e.sl) BS,
            SUM(e.js) DS,
            f.JSJE,
            g.FKJE
     FROM F_XSDZD_AB e
     LEFT JOIN (
          SELECT ORGNAME,
                 KHBM,
                 SUM(JSJE) JSJE
          FROM F_XSDZD_AB
          WHERE SUBSTR(F_XSDZD_AB.djrq,1,7) = TO_CHAR(ADD_MONTHS(SYSDATE,-1),'yyyy-mm')
          GROUP BY ORGNAME,KHBM) f
     ON e.ORGNAME = f.ORGNAME AND e.KHBM = f.KHBM
     LEFT JOIN (
          SELECT ORGNAME,
                 KHBM,
                 SUM(FKJE) FKJE
          FROM F_XSDZD_AB
          WHERE SUBSTR(F_XSDZD_AB.djrq,1,7) = TO_CHAR(ADD_MONTHS(SYSDATE,-1),'yyyy-mm')
          GROUP BY ORGNAME,KHBM) g
           ON e.ORGNAME = g.ORGNAME AND e.KHBM = g.KHBM
          WHERE (e.WLBM LIKE '2%' OR E.WLBM IS NULL OR e.WLBM LIKE '7%')
     AND SUBSTR(e.DJRQ,1,7) = TO_CHAR(ADD_MONTHS(SYSDATE,-1),'yyyy-mm')
     AND E.blargessflag='N'
     GROUP BY e.ORGNAME,e.KHBM,f.JSJE,g.FKJE
) n
ON A.ORGNAME = n.ORGNAME AND A.KHBM = n.KHBM
--日期
LEFT JOIN (
     SELECT DISTINCT ORGNAME,
            KHBM,
            TO_CHAR(ADD_MONTHS(SYSDATE,-1),'yyyy-mm') DJRQ 
     FROM F_XSDZD_AB
) p
ON A.ORGNAME = p.ORGNAME AND A.KHBM = p.KHBM

LEFT JOIN 
(
     SELECT DISTINCT e.ORGNAME,
            e.KHBM,
            MAX(e.BS) XSSL
     FROM F_XSDZD e
     WHERE SUBSTR(E.djrq,1,7) = TO_CHAR(ADD_MONTHS(SYSDATE,-1),'yyyy-mm')
     GROUP BY e.ORGNAME,
            e.KHBM
     )Y
  ON A.ORGNAME = Y.ORGNAME AND A.KHBM = Y.KHBM   
where 
(NVL(m.QCJE,0)&lt;&gt;'0'
OR NVL(m.QCJE,0)&lt;&gt;'0'
OR NVL(m.SKJE,0)&lt;&gt;'0'
OR NVL(n.bs,0)&lt;&gt;'0'
OR NVL(n.ds,0)&lt;&gt;'0'
OR NVL(n.JSJE,0)&lt;&gt;'0'
OR NVL(n.FKJE,0)&lt;&gt;'0'
OR NVL(y.xssl,0)&lt;&gt;'0')
</sql>
    <limit>0</limit>
