      <schema_name />
    </partitioning>
    <connection>OA</connection>
    <sql>SELECT
C.LASTNAME SHENQR,--申请人
B.applyDate SHENQRQ,--申请日期
D.DEPARTMENTNAME SHENQBM,--申请部门
E.SUBCOMPANYDESC GSMC,--公司全称
E.SUBCOMPANYNAME GSJC,--公司简称
B.JHKSRQ||'至'||B.JHJZRQ BZRQ,--本周日期

A.WLMC, --物料名称
A.BYYS, --本月预算用量
A.XYYS, --下月预算用量
A.XXYYS, --下下月预算用量
A.PJRYL30, --30天累计日用量
A.PJRYL20, --20天累计平均日用量
A.PJRYL10, --10天累计平均日用量
A.BRJC, --今日仓库结存
A.ZTHT30, --30天内在途合同
A.WZTHT30, --30天外在途合同
A.NYTS30, --能用天数（结存+30天内在途合同）
A.NYTS, --能用天数（仓库结存）
A.TCTS, --本周头寸设置天数
A.CGJH, --本周采购计划
A.CGJHCS, --采购计划测算（根据本月预算）
A.CGJHCS2, --采购计划测算（根据近２个月预算）
A.CGJHCS20, --采购计划测算（根据累计20天日用量）
A.CGJHCS10, --采购计划测算（根据累计10天日用量）
A.YLXQL, --CRM排产计划原料需求量
A.QKSL, --缺口数量(KG)

B.BIANH, --流程编号
CASE WHEN H.STATUS LIKE '%归档%' OR H.currentnodetype = 3 THEN '已归档' ELSE H.STATUS END STATUS, --流程当前节点
H.CREATEDATE||' '||H.CREATETIME CJSJ --流程创建时间
FROM formtable_main_541_dt1 A --采购周明细表
LEFT JOIN formtable_main_541 B --采购周计划主表
ON A.MAINID = B.ID
LEFT JOIN HrmResource C --人力资源表
ON C.ID = B.applicant
LEFT JOIN hrmdepartment D --部门表
ON D.ID = B.applyDep
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = B.SPGS
LEFT JOIN workflow_requestbase H--工作流基本信息表
ON B.REQUESTID = H.REQUESTID
WHERE 1=1
AND H.currentnodetype &lt;&gt; 0 --不等于创建节点
AND E.SUBCOMPANYDESC||B.JHKSRQ||'至'||B.JHJZRQ||A.WLMC||H.CREATEDATE||' '||H.CREATETIME IN
(
SELECT GSMC||BZRQ||WLMC||CJSJ FROM
(
SELECT
E.SUBCOMPANYDESC GSMC,--公司全称
B.JHKSRQ||'至'||B.JHJZRQ BZRQ,--本周日期
A.WLMC, --物料名称
MAX(H.CREATEDATE||' '||H.CREATETIME) CJSJ --流程创建时间
FROM formtable_main_541_dt1 A --采购周明细表
LEFT JOIN formtable_main_541 B --采购周计划主表
ON A.MAINID = B.ID
LEFT JOIN HrmResource C --人力资源表
ON C.ID = B.applicant
LEFT JOIN hrmdepartment D --部门表
ON D.ID = B.applyDep
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = B.SPGS
LEFT JOIN workflow_requestbase H--工作流基本信息表
ON B.REQUESTID = H.REQUESTID
WHERE 1=1
AND H.currentnodetype &lt;&gt; 0 --不等于创建节点
GROUP BY E.SUBCOMPANYDESC,B.JHKSRQ||'至'||B.JHJZRQ,A.WLMC
)
)
</sql>
