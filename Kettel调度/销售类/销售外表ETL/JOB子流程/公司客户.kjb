    <entry>
      <name>创建视图公司每月客户SQL</name>
      <description />
      <type>SQL</type>
      <sql>
CREATE OR REPLACE VIEW V_GSMYKH(PK_GS,GSBM,GSMC,GSJC,PK_KH,KHBM,KHMC,PK_KHFL,YXZJH,HSDW,FPZT,HRRQ,HCRQ,QJ)
 AS
select b.pk_salesorg AS 公司主键,
       b.code as 公司编码,
       b.name as 公司名称,
       b.shortname as 公司简称,
       a.pk_customer as 客户主键,
       a.code as 客户编码,
       a.name as 客户名称,
       a.PK_CUSTCLASS as 客户基本分类,
       a.def9  as 有效证件号,
       d.name  as 核算单位,
       c.def9 as 分配状态,
       c.def10 as 划入日期，
       c.def11 AS 划出日期,
to_char(add_months(sysdate,-0),'yyyy-mm') QJ
  from bd_customer a
  left join bd_custsale c
    on a.pk_customer = c.pk_customer
  left join bd_defdoc d
  on c.def8=d.pk_defdoc
  left join org_salesorg b
    on c.pk_org = b.pk_salesorg
 where substr(c.def10,1,7)&lt;=to_char(add_months(sysdate,-0),'yyyy-mm')
 AND c.def9='Y'
 and b.pk_salesorg&lt;&gt;'0001A210000000036GW3'--澳宝
 and a.PK_CUSTCLASS&lt;&gt;'1001A410000000000K70' --内部客户</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename />
      <sendOneStatement>F</sendOneStatement>
      <connection>nc65_ncread</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>176</xloc>
      <yloc>256</yloc>
    </entry>
