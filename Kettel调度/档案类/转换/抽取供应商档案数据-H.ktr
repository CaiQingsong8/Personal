    <connection>nc65_ncread</connection>
    <sql>SELECT
A.CODE GYSBM,--供应商编码
A.NAME GYSMC,--供应商名称
J.code GYSFLBM,--供应商分类编码
J.name GYSFLMC,--供应商分类名称
A.taxpayerid TYXYDM,--统一信用代码
A.tel1 GYSSJ, --供应商手机
A.fax1 CZ,--传真
E.name GJMC,--国家名称
F.name SFMC,--省份名称
G.name CSMC,--城市名称
H.name XQMC,--县区名称
D.detailinfo XXDZ,--详细地址
I.name DQMC,--地区分类名称
B.user_name CJR,--创建人
A.creationtime CJSJ,--创建时间
C.user_name ZHXGR,--最后修改人
A.modifiedtime XGSJ,--最后修改时间
CASE WHEN A.enablestate = 1 THEN '未启用' WHEN A.enablestate = 2 THEN '已启用' WHEN A.enablestate = 3 THEN '已停用' ELSE '状态异常' END QYZT,--启用状态
A.pk_supplier GYSZJ, --供应商主键
K.NAME AS GYSSX ---供应商属性
FROM bd_supplier A --供应商基本信息表
LEFT JOIN sm_user B --用户表
ON A.creator = B.cuserid
LEFT JOIN sm_user C --用户表
ON A.modifier = C.cuserid
LEFT JOIN bd_address D --企业地址
ON A.corpaddress = D.pk_address
LEFT JOIN bd_countryzone E --国家区域表
ON D.country = E.pk_country 
LEFT JOIN bd_region F --行政区划表
ON D.province = F.pk_region
LEFT JOIN bd_region G --行政区划表
ON D.city = G.pk_region
LEFT JOIN bd_region H --行政区划表
ON D.vsection = H.pk_region
LEFT JOIN bd_areacl I --地区分类表
ON A.pk_areacl = I.pk_areacl
LEFT JOIN bd_supplierclass J --供应商基本分类表
ON A.pk_supplierclass = J.pk_supplierclass
left join BD_DEFDOC K --自定义档案
on a.def3=K.PK_DEFDOC
and K.PK_DEFDOCLIST='1001A210000000AJB6FH' --供应商属性：五金 原料 添加剂等
WHERE 1=1
AND A.DR = 0</sql>
