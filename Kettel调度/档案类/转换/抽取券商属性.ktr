    <connection>fbuser</connection>
    <sql>SELECT WLBM,WLMC,
CASE
          WHEN WLBM IN (1101020010, 1101050001, 1101050002, 1101050004) THEN
           'DDGS'
          WHEN WLBM IN (1102020001, 1104110001, 1102020002) THEN
           '菜粕'
          WHEN WLBM = '1102020003
' THEN
           '菜籽饼'
          WHEN WLBM IN (1102030010, 1102030013, 3100000002, 1102030014) THEN
           '大豆'
          WHEN WLBM = '1102030004' THEN
           '大豆磷脂油'
          WHEN WLBM IN (1101010002, 1101110009) THEN
           '大麦'
          WHEN WLBM IN (1201000002, 1201000004) THEN
           '蛋氨酸'
          WHEN WLBM IN (1111010004,
                        1208000010,
                        1212000001,
                        1500000001,
                        1500000003,
                        1500000023,
                        1500000026,
                        1500000032,
                        1500000033,
                        1202000044,
                        1500000008,
                        1500000031,
                        1500000034,
                        1500000035,
                        1500000037,
                        1500000038,
                        1500000039,
                        1500000040,
                        1500000041,
                        1500000042,
                        1500000043,
                        1500000044,
                        1500000045,
                        1500000046,
                        1500000047,
                        1500000048) THEN
           '动保产品'
          WHEN WLBM IN (1102030005,
                        1206000001,
                        1112010003,
                        1102030007,
                        1102030008
                        ) THEN
           '豆粕'
          WHEN WLBM = '1101110005' THEN
           '麸皮'
          WHEN WLBM = '1101030001' THEN
           '高粱'
          WHEN WLBM IN (1102090001, 1102090003) THEN
           '花生饼'
          WHEN WLBM = '1102090002' THEN
           '花生粕'
          WHEN WLBM IN (1109060005, 1109060008, 1109060006) THEN
           '鸡肉粉'
          WHEN WLBM = '1112040001' THEN
           '酱油糟'
          WHEN WLBM IN (1201000008, 1205000004, 1112010004, 1112030004) THEN
           '酵母水解物'
          WHEN WLBM IN (1102110001, 1102110002) THEN
           '葵花籽粕'
          WHEN WLBM IN (1201000001, 1201000023) THEN
           '赖氨酸'
          WHEN WLBM = '1203000020' THEN
           '磷酸二氢钙'
          WHEN WLBM IN (1202000005, 1202000014) THEN
           '氯化胆碱'
          WHEN WLBM = '1110040024' THEN
           '酶解虾浆'
          WHEN WLBM IN (1101020003, 1101020004) THEN
           '米糠'
          WHEN WLBM IN (1102120001, 1102120003, 1102120005, 1102120008) THEN
           '棉粕'
          WHEN WLBM = '1102120007' THEN
           '棉籽蛋白'
          WHEN WLBM IN (1101110003, 1101110012) THEN
           '面粉'
          WHEN WLBM = '1101130007' THEN
           '喷浆玉米皮'
          WHEN WLBM IN (1109070001, 1213000027) THEN
           '喷雾干燥鸡血球蛋白粉'
          WHEN WLBM = '1112030002' THEN
           '啤酒酵母粉'
          WHEN WLBM = '1202000008' THEN
           '肉猪多维'
          WHEN WLBM IN ('1108050001', '1108050003') THEN
           '乳清粉'
          WHEN WLBM = '1111010002' THEN
           '生物燃料'
          WHEN WLBM = '1202000017' THEN
           '水产通用多维'
          WHEN WLBM = '1110040020' THEN
           '水解鱼蛋白粉'
          WHEN WLBM = '1109030001' THEN
           '水解羽毛粉'
          WHEN WLBM = '1103050002' THEN
           '豌豆'
          WHEN WLBM IN
               (1202000001, 1202000003, 1202000004, 1202000011, 1202000023) THEN
           '维生素'
          WHEN WLBM = '1110030001' THEN
           '乌贼膏'
          WHEN WLBM IN (1110020002, 1110050001) THEN
           '虾粉'
          WHEN WLBM = '1110020003' THEN
           '虾膏'
          WHEN WLBM = '1110020004' THEN
           '虾头粉'
          WHEN WLBM IN (1101110001, 1101110004) THEN
           '小麦'
          WHEN WLBM IN (1110020005,
                        1110040017,
                        1110020007,
                        1110040003,
                        1110040004,
                        1110040005,
                        1110040006,
                        1110040009,
                        1110040010,
                        1110040012,
                        1110040018,
                        1110040019,
                        1110040023) THEN
           '鱼粉'
          WHEN WLBM = '1110040013' THEN
           '鱼排粉'
          WHEN WLBM IN (1110020006, 1110040015, 1110040016) THEN
           '鱼溶浆'
          WHEN WLBM IN (1110040001, 1110040002) THEN
           '鱼油'
          WHEN WLBM IN (1101130001,
                        1101130010,
                        1101130002,
                        1101130003,
                        1101130004,
                        1101130005,
                        1101130006,
                        1101130016) THEN
           '玉米'
          WHEN WLBM = '1101130008' THEN
           '玉米蛋白粉'
          WHEN WLBM = '1101130012' THEN
           '玉米淀粉渣'
          WHEN WLBM = '1101130009' THEN
           '玉米胚芽粕'
          WHEN WLBM LIKE '4%' THEN
           '袋子标签'
           WHEN WLBM LIKE '23%'THEN
             '动保产品'
WHEN WLBM IN ('1102030002','1102030003') THEN
    '豆油'
          ELSE
           '其他'
        END WLBQ
  FROM DA_WL

</sql>
