  <step>
    <name>临时表输入</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>OA</connection>
    <sql>SELECT
A.ID,
A.SCGS, --公司编码
B.SUBCOMPANYNAME GSJC, --生产公司,公司简称
B.SUBCOMPANYDESC GSMC,--公司全称
SCRQ, --生产日期
CPBM, --产品编码
CPMC, --产品名称
PFBM, --对应配方编码
PFMC, --对应配方名称
A.SCXMC, --生产线id
E.SCXMC, --生产线名称
A.MJBH, --模具编号
F.WYBS, --模具编号名称
CASE WHEN BC=0 THEN '一班' WHEN BC=1 THEN '二班' ELSE '未知' END BC, --班次
C.LASTNAME BZ, --班长
D.LASTNAME JS, --机手
PLS, --配方料数（吨）
RKS, --主机加工产量（吨）
KJRQ, --主机开机日期
KJSJ, --主机开机时间
TJRQ, --主机停机日期
TJSJ, --主机停机时间
CASE WHEN A.TJYY1=0 THEN '换模'
WHEN A.TJYY1=1 THEN '换品种'
WHEN A.TJYY1=2 THEN '设备故障'
WHEN A.TJYY1=3 THEN '人为失误'
WHEN A.TJYY1=4 THEN '满仓等待'
WHEN A.TJYY1=5 THEN '配方无法生产'
WHEN A.TJYY1=6 THEN '其他原因'
ELSE '' END TJYY1, --停机原因1
TJSJ1, --停机时间1（小时）
CASE WHEN A.TJYY2=0 THEN '换模'
WHEN A.TJYY2=1 THEN '换品种' 
WHEN A.TJYY2=2 THEN '设备故障' 
WHEN A.TJYY2=3 THEN '人为失误' 
WHEN A.TJYY2=4 THEN '满仓等待' 
WHEN A.TJYY2=5 THEN '配方无法生产' 
WHEN A.TJYY2=6 THEN '其他原因' 
ELSE '' END TJYY2,  --停机原因2
TJSJ2, --停机时间2（小时）
CASE WHEN A.TJYY3=0 THEN '换模' 
WHEN A.TJYY3=1 THEN '换品种' 
WHEN A.TJYY3=2 THEN '设备故障' 
WHEN A.TJYY3=3 THEN '人为失误' 
WHEN A.TJYY3=4 THEN '满仓等待' 
WHEN A.TJYY3=5 THEN '配方无法生产' 
WHEN A.TJYY3=6 THEN '其他原因' 
ELSE '' END TJYY3,  --停机原因3
TJSJ3, --停机时间3（小时）
A.MODEDATACREATEDATE||' '||A.MODEDATACREATETIME CJSJ
FROM UF_CAPACITYFILL A  --产能追踪表
LEFT JOIN HRMSUBCOMPANY B --分部表
ON B.ID = A.SCGS
LEFT JOIN HRMRESOURCE C --人力资源表
ON C.ID = TO_CHAR(SUBSTR(A.BZ,1,CASE WHEN INSTR(A.BZ,',') = 0 THEN 10 ELSE INSTR(A.BZ,',')-1 END))
LEFT JOIN HRMRESOURCE D --人力资源表
ON D.ID = TO_CHAR(SUBSTR(A.JS,1,CASE WHEN INSTR(A.JS,',') = 0 THEN 10 ELSE INSTR(A.JS,',')-1 END))
LEFT JOIN UF_PRODUCTION_LINE E --生产线表
ON E.ID=A.SCXMC
LEFT JOIN UF_MOLDFILE F --模具表
ON F.ID=A.MJBH
WHERE 1=1
AND SUBSTR(A.MODEDATACREATEDATE,1,10) >= TO_CHAR(SYSDATE-180,'YYYY-MM-DD')</sql>
    <limit>0</limit>
    <lookup />
