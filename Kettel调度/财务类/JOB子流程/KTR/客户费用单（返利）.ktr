    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>-- 客户费用单-取数时间从2020-11月份开始
SELECT DISTINCT SUBSTR(T1.dbilldate ,1,7) QJ --单据日期
        , T3.code xszzbm--财务组织
        , T3.name xszzmc--财务组织
        , T3.shortname xszzjc
        , T4.pk_billtypecode DJLXBM --单据类型
        , T4.billtypename DJLXMC --单据类型
        , T5.code KHBM--客户
        , T5.name KHMC--客户
        , T2.vbdef2 BMPK--部门pk
        , T6.NAME BMMC--部门名称
        , T8.name HSDW
        , T2.vbdef1 WLPK
        , T7.code WLBM--物料PK
        , T7.NAME WLMC--物料PK
        , T2.carsubid zj
        , T2.crowno HH
        , T2.NORIGARSUBMNY FLJE--返利金额
        , T2.NORIGARSUBMNY JTJE--计提金额
        , T2.NREDARSUBMNY DFJE--兑付金额
        , 'Y' SFQZ --是否取值
		, T8.pk_defdoc HSDWPK 
		, SUBSTR(T1.taudittime,1,7) AS SHRQ --审核日期
		,T2.FROWNOTE	AS BZ
	    ,T1.cordercustid as khpk
FROM so_arsub T1--销售费用单主表
LEFT JOIN so_arsub_b T2 --销售费用单子表
ON T1.carsubid = T2.carsubid
LEFT JOIN org_financeorg T3 --财务组织
ON T1.pk_org = T3.pk_financeorg 
LEFT JOIN bd_billtype T4 --单据类型
ON T1.ctrantypeid = T4.pk_billtypeid 
LEFT JOIN bd_customer T5 --客户基本信息
ON T1.cordercustid = T5.pk_customer 
LEFT JOIN org_dept_v T6 --部门信息
ON T2.vbdef2 = T6.pk_dept  
LEFT JOIN bd_material T7 --物料信息
ON T2.vbdef1 = T7.pk_material 
LEFT JOIN (SELECT A.PK_ORG,
                    C.PK_DEFDOC,
                    C.NAME ,
                    A.PK_CUSTOMER
           FROM bd_custsale A
           LEFT JOIN bd_defdoc C
           ON A.DEF8 = C.PK_DEFDOC ) T8 --取部门核算单位
ON T8.PK_ORG = T1.pk_org
AND T8.PK_CUSTOMER = T5.pk_customer
WHERE T1.DR='0' AND T2.DR='0'
AND SUBSTR(T1.dbilldate ,1,7)>= '2020-11'--TO_CHAR(add_months(sysdate, -3), 'YYYY-MM')

--and T3.code = '1024'
--and T5.CODE = 'K102110'

UNION ALL
--销售返利单,取数时间截止到2020-10月份
select DISTINCT substr(a.taudittime,0,7) qj,
       c.code xszzbm,
       c.name xszzmc,
       c.shortname xszzjc,
       f. pk_billtypecode djlxbm,
       f.billtypename djlxmc,
       d.code khbm,
       d.name khmc,
       a.vdef1 BMPK,
       T2.NAME BMMC,
       T3.NAME HSDW,
       e.Pk_Material WLPK,
       e.code wlbm,
       e.name wlmc,
       null zjh,
       null HH,
       b.nadjustmny flje,
       b.nadjustmny ,
       b.nadjustmny ,
       B. bexeflag SFQZ,
	   T3.pk_defdoc HSDWPK, 
	   SUBSTR(a.taudittime,1,7) AS SHRQ, --审核日期
	   NULL	AS BZ,
	   a.cordercustid as khpk
  from sr_settle a  
  left join sr_settle_b b
    on a.pk_settle = b.pk_settle
  left join org_salesorg c
    on a.cpolicyorgid = c.pk_salesorg
  left join bd_customer d
    on a.cordercustid = d.pk_customer
  left join bd_material e
    on b.cmaterialid = e.pk_material
  left join (select a.pk_plcy,b.pk_billtypecode,b.billtypename from sr_plcy a left join bd_billtype b
            on a.ctrantypeid =b.pk_billtypeid) f
  on a.cpolicyid =f.pk_plcy
  LEFT JOIN org_dept_v T2 --部门信息
    ON a.vdef1 = T2.pk_dept 
  LEFT JOIN bd_defdoc T3 --取部门核算单位
    ON T2.def2 = T3.pk_defdoc 
where a.dr='0'
   and b.dr='0'
   and a. fstatusflag ='3'
AND SUBSTR(a.taudittime ,1,7)&lt;='2020-10'</sql>
    <limit>0</limit>
