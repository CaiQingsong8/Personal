  <step>
    <name>临时表输入</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>ncread</connection>
    <sql>--产成品入库表
select distinct 
       b.cgeneralhid CCPZJ,
       a.code GSBM,
       a.name GSMC,
       A.SHORTNAME GSJC,
       y.name BMMC,
			 substr(b.dbilldate,1,4) NF,
       substr(b.dbilldate,1,7) RQ,
       substr(b.dbilldate,1,10) DJRQ,
			 SUBSTR(b.dbilldate,1,4)||'-'||TO_CHAR(TO_DATE(b.dbilldate,'YYYY-MM-DD HH24:MI:SS'),'IW') AS ZS,
			 b.vbillcode as djh,
       d.CODE SJFL,
       e.code wlflBM,
       e.name wlflMC,
       h.code cbdxbm,
       h.name cbdxmc,
       h1.code wlbm,
       h1.name wlmc,
       f.cgeneralbid btzj,
       T1.nplanputnum jhsl,
			 f.castunitid zdw, --单位
			 f.cunitid dw,--主单位
			 f1.CODE dwbm,--单位编码
			 f1.name dwmc,--单位名称
(CASE 
WHEN H.CODE LIKE '3%' and f1.name='千克' THEN F.nnum/1000
WHEN H.CODE LIKE '7%' THEN F.nassistnum 
ELSE F.nnum
END)RKSL      
  from org_stockorg a --组织_业务单元_库存组织
  left join ic_finprodin_h b --产成品入库单表头
    on b.pk_org= a.pk_stockorg
  left join org_dept y --组织_部门
    on b.cdptid=y.pk_dept 
  left join ic_finprodin_b f --产成品入库单表体
    on f.cgeneralhid =b.cgeneralhid 
	left join bd_measdoc f1
	on f1.pk_measdoc =f.cunitid
  left join bd_material h --物料基本信息（多版本）
    on f.cproductid=h.pk_material
  left join bd_material h1 --物料基本信息（多版本）
    on f.cmaterialvid=h1.pk_material
  left join bd_marbasclass d --物料基本分类
    on h.pk_marbasclass=d.pk_marbasclass
  left join bd_marbasclass e --物料基本分类
    on d.pk_parent=e.pk_marbasclass /*mm_pmo 流程生产订单，mm_mo 流程生产订单明细*/
  left join (select T2.nplanputnum ,T1.vbillcode,T2.cfirstmobid from mm_pmo T1 
                left join mm_mo T2
                on T2.cpmohid   = T1.cpmohid 
where t1.dr='0'
and t2.dr='0') T1 --取计划数量
    on f.vproductbatch = T1.vbillcode
    AND F.cfirstbillbid=T1.cfirstmobid
 where a.dr = '0'
   and b.dr = '0'
   AND F.DR='0'
AND b.dbilldate>=TO_CHAR(TRUNC(ADD_MONTHS(SYSDATE, -3)), 'YYYY-MM-DD HH24:MI:SS') 
   </sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
