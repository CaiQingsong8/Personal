  <step>
    <name>客户等级分类新老客户</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>select W.PK_KH,Q.KHMC,Q.KHCODE,Q.KHLB,Q.KHDJ,W.XLKH
 from    
(SELECT KHMC,PK_KH,KHCODE,KHLB,
CASE
WHEN KHLB = '鱼料'THEN (CASE WHEN YLXL >= 1000 THEN 'A'WHEN YLXL >= 800 THEN 'B'WHEN YLXL >= 500 THEN 'C'WHEN YLXL >= 200 THEN 'D'ELSE 'E'END)
WHEN KHLB = '虾蟹料'THEN (CASE WHEN XXLXL >= 500 THEN 'A'WHEN XXLXL >= 400 THEN 'B'WHEN XXLXL >= 250 THEN 'C'WHEN XXLXL >= 100 THEN 'D'ELSE 'E'END) 
WHEN KHLB = '猪料'THEN (CASE WHEN ZLXL >= 2400 THEN 'A'WHEN ZLXL >= 1800 THEN 'B'WHEN ZLXL >= 1200 THEN 'C'WHEN ZLXL >= 600 THEN 'D'ELSE 'E'END)
WHEN KHLB = '浓缩预混料'THEN (CASE WHEN NSYHLXL >= 480 THEN 'A'WHEN NSYHLXL >= 360 THEN 'B'WHEN NSYHLXL >= 240 THEN 'C'WHEN NSYHLXL >= 120 THEN 'D'ELSE 'E'END)
WHEN KHLB = '浓缩预混料'THEN (CASE WHEN NSXL >= 480 THEN 'A'WHEN NSXL >= 360 THEN 'B'WHEN NSXL >= 240 THEN 'C'WHEN NSXL >= 120 THEN 'D'ELSE 'E'END)

ELSE '' END KHDJ
FROM(
WITH AA AS
(
SELECT DISTINCT PK_KH,KHMC,KHCODE FROM F_SALES
WHERE (WLFLBM LIKE '21%' OR WLFLBM LIKE '22%')
AND SUBSTR(DBILLDATE,0,10) &lt;= to_char(add_months(sysdate,-0),'yyyy-mm-DD') AND SUBSTR(DBILLDATE,0，10)  >= TO_CHAR(ADD_MONTHS(SYSDATE,-12),'YYYY-MM-DD')
AND BLARGESSFLAG = 'N'
AND KHFLBM &lt;&gt; 'K2'
AND KHMC &lt;&gt; '东莞市年丰饲料有限公司'
AND KHMC &lt;&gt; '浙江澳凌水产种业科技有限公司'
AND GSMC NOT IN ('深圳市澳华农牧有限公司天津分公司','江苏红膏饲料有限公司', 
'攀枝花澳华饲料有限公司','营口澳华农牧科技有限公司', '深圳市澳华农牧有限公司长沙分公司',
'深圳市澳华农牧有限公司长沙分公司','江苏红膏饲料有限公司','河南澳华饲料有限公司')
),
BB AS
(
SELECT PK_KH,KHMC,KHCODE,SUM(TYNUM) YLXL FROM F_SALES
WHERE SJFLBM IN ('2201','2202','2203')--鱼料
AND SUBSTR(DBILLDATE,0,10) &lt;= to_char(add_months(sysdate,-0),'yyyy-mm-DD') AND SUBSTR(DBILLDATE,0，10)  >= TO_CHAR(ADD_MONTHS(SYSDATE,-12),'YYYY-MM-DD')
AND BLARGESSFLAG = 'N'
AND KHFLBM &lt;&gt; 'K2'
AND KHMC &lt;&gt; '东莞市年丰饲料有限公司'
AND KHMC &lt;&gt; '浙江澳凌水产种业科技有限公司'
AND GSMC NOT IN ('深圳市澳华农牧有限公司天津分公司','江苏红膏饲料有限公司', 
'攀枝花澳华饲料有限公司','营口澳华农牧科技有限公司', '深圳市澳华农牧有限公司长沙分公司',
'深圳市澳华农牧有限公司长沙分公司','江苏红膏饲料有限公司','河南澳华饲料有限公司')
GROUP BY PK_KH,KHMC,KHCODE

),
CC AS
(
SELECT PK_KH,KHMC,KHCODE,SUM(TYNUM) XXLXL FROM F_SALES
WHERE SJFLBM IN ('2204','2205')--虾蟹料
AND SUBSTR(DBILLDATE,0,10) &lt;= to_char(add_months(sysdate,-0),'yyyy-mm-DD') AND SUBSTR(DBILLDATE,0，10)  >= TO_CHAR(ADD_MONTHS(SYSDATE,-12),'YYYY-MM-DD')
AND BLARGESSFLAG = 'N'
AND KHFLBM &lt;&gt; 'K2'
AND KHMC &lt;&gt; '东莞市年丰饲料有限公司'
AND KHMC &lt;&gt; '浙江澳凌水产种业科技有限公司'
AND GSMC NOT IN ('深圳市澳华农牧有限公司天津分公司','江苏红膏饲料有限公司', 
'攀枝花澳华饲料有限公司','营口澳华农牧科技有限公司', '深圳市澳华农牧有限公司长沙分公司',
'深圳市澳华农牧有限公司长沙分公司','江苏红膏饲料有限公司','河南澳华饲料有限公司')
GROUP BY PK_KH,KHMC,KHCODE
),
DD AS
(
SELECT PK_KH,KHMC,KHCODE,SUM(TYNUM) ZLXL FROM F_SALES
WHERE SJFLBM IN ('2101')--猪料
AND SUBSTR(DBILLDATE,0,10) &lt;= to_char(add_months(sysdate,-0),'yyyy-mm-DD') AND SUBSTR(DBILLDATE,0，10)  >= TO_CHAR(ADD_MONTHS(SYSDATE,-12),'YYYY-MM-DD')
AND BLARGESSFLAG = 'N'
AND KHFLBM &lt;&gt; 'K2'
AND KHMC &lt;&gt; '东莞市年丰饲料有限公司'
AND KHMC &lt;&gt; '浙江澳凌水产种业科技有限公司'
AND GSMC NOT IN ('深圳市澳华农牧有限公司天津分公司','江苏红膏饲料有限公司', 
'攀枝花澳华饲料有限公司','营口澳华农牧科技有限公司', '深圳市澳华农牧有限公司长沙分公司',
'深圳市澳华农牧有限公司长沙分公司','江苏红膏饲料有限公司','河南澳华饲料有限公司')
GROUP BY PK_KH,KHMC,KHCODE
),
EE AS
(
SELECT PK_KH,KHMC,KHCODE,SUM(TYNUM) NSYHLXL FROM F_SALES
WHERE SJFLBM IN ('2102')--浓缩预混料
AND SUBSTR(DBILLDATE,0,10) &lt;= to_char(add_months(sysdate,-0),'yyyy-mm-DD') AND SUBSTR(DBILLDATE,0，10)  >= TO_CHAR(ADD_MONTHS(SYSDATE,-12),'YYYY-MM-DD')
AND BLARGESSFLAG = 'N'
AND KHFLBM &lt;&gt; 'K2'
AND KHMC &lt;&gt; '东莞市年丰饲料有限公司'
AND KHMC &lt;&gt; '浙江澳凌水产种业科技有限公司'
AND GSMC NOT IN ('深圳市澳华农牧有限公司天津分公司','江苏红膏饲料有限公司', 
'攀枝花澳华饲料有限公司','营口澳华农牧科技有限公司', '深圳市澳华农牧有限公司长沙分公司',
'深圳市澳华农牧有限公司长沙分公司','江苏红膏饲料有限公司','河南澳华饲料有限公司')
GROUP BY PK_KH,KHMC,KHCODE
),
FF AS
(
SELECT PK_KH,KHMC,KHCODE,SUM(TYNUM) NSXL FROM F_SALES
WHERE SJFLBM IN ('2103')--NSYHL
AND SUBSTR(DBILLDATE,0,10) &lt;= to_char(add_months(sysdate,-0),'yyyy-mm-DD') AND SUBSTR(DBILLDATE,0，10)  >= TO_CHAR(ADD_MONTHS(SYSDATE,-12),'YYYY-MM-DD')
AND BLARGESSFLAG = 'N'
AND KHFLBM &lt;&gt; 'K2'
AND KHMC &lt;&gt; '东莞市年丰饲料有限公司'
AND KHMC &lt;&gt; '浙江澳凌水产种业科技有限公司'
AND GSMC NOT IN ('深圳市澳华农牧有限公司天津分公司','江苏红膏饲料有限公司', 
'攀枝花澳华饲料有限公司','营口澳华农牧科技有限公司', '深圳市澳华农牧有限公司长沙分公司',
'深圳市澳华农牧有限公司长沙分公司','江苏红膏饲料有限公司','河南澳华饲料有限公司')
GROUP BY PK_KH,KHMC,KHCODE
)
SELECT AA.PK_KH,AA.KHMC,AA.KHCODE,BB.YLXL,CC.XXLXL,DD.ZLXL,EE.NSYHLXL,FF.NSXL,
CASE WHEN 
GREATEST(nvl(BB.YLXL,0),nvl(CC.XXLXL,0),
nvl(DD.ZLXL,0),nvl(EE.NSYHLXL,0) )= nvl(BB.YLXL,0) THEN '鱼料'
WHEN 
GREATEST(nvl(BB.YLXL,0),nvl(CC.XXLXL,0),
nvl(DD.ZLXL,0),nvl(EE.NSYHLXL,0) )= nvl(CC.XXLXL,0) THEN '虾蟹料'
WHEN 
GREATEST(nvl(BB.YLXL,0),nvl(CC.XXLXL,0),
nvl(DD.ZLXL,0),nvl(EE.NSYHLXL,0) )= nvl(DD.ZLXL,0) THEN '猪料'
WHEN
GREATEST(nvl(BB.YLXL,0),nvl(CC.XXLXL,0),
nvl(DD.ZLXL,0),nvl(EE.NSYHLXL,0),nvl(FF.NSXL,0) )= nvl(FF.NSXL,0) THEN '浓缩预混料'
WHEN
GREATEST(nvl(BB.YLXL,0),nvl(CC.XXLXL,0),
nvl(DD.ZLXL,0),nvl(EE.NSYHLXL,0) )= nvl(EE.NSYHLXL,0) THEN '浓缩预混料'

ELSE '' END KHLB FROM AA
LEFT JOIN BB
ON AA.PK_KH = BB.PK_KH AND AA.KHMC = BB.KHMC
LEFT JOIN CC
ON AA.PK_KH = CC.PK_KH AND AA.KHMC = CC.KHMC
LEFT JOIN DD
ON AA.PK_KH = DD.PK_KH AND AA.KHMC = DD.KHMC
LEFT JOIN EE
ON AA.PK_KH = EE.PK_KH AND AA.KHMC = EE.KHMC
LEFT JOIN FF
ON AA.PK_KH = FF.PK_KH AND AA.KHMC = FF.KHMC
)--分级分类
)Q
left join 
(select PK_KH,CASE WHEN SUBSTR (RP_KHTHRQ.ZZTHRQ,1,4) =TO_CHAR(SYSDATE,'YYYY')
then '新客户'
        else '老客户' end XLKH
          FROM RP_KHTHRQ)W--  --每月新老客户名单
ON Q.PK_KH=W.PK_KH</sql>
    <limit>0</limit>
