,\n            \"ly2\": 155.5,\n            \"ly3\": 719.88,\n            \"ly4\": 778.6,\n            \"ly5\": 641,\n            \"ly6\": 724.62,\n            \"ly7\": 822.52,\n            \"ly8\": 779.34,\n            \"ly9\": 1171.74,\n            \"ly10\": 607.41,\n            \"ly11\": 501.7,\n            \"ly12\": 777.45,\n            \"lytotal\": 1885.43,\n            \"difftotal\": -1075.5,\n            \"yoyrate\": -57.04,\n            \"last2year\": 9440.4,\n            \"last3year\": 8998.4,\n            \"last4year\": 11440,\n            \"last5year\": 11681.29\n        },\n        {\n            \"dSubjectName\": \"收入\",\n            \"cy1\": 66530.99,\n            \"cy2\": 45298.7,\n            \"cy3\": 90582.29,\n            \"cy4\": 0,\n            \"cy5\": 0,\n            \"cy6\": 0,\n            \"cy7\": 0,\n            \"cy8\": 0,\n            \"cy9\": 0,\n            \"cy10\": 0,\n            \"cy11\": 0,\n            \"cy12\": 0,\n            \"cytotal\": 66530.99,\n            \"ly1\": 32033.08,\n            \"ly2\": 28963.05,\n            \"ly3\": 49873.59,\n            \"ly4\": 67157.24,\n            \"ly5\": 75109.74,\n            \"ly6\": 75429.63,\n            \"ly7\": 84316.16,\n            \"ly8\": 84117.39,\n            \"ly9\": 85199.44,\n            \"ly10\": 60550.79,\n            \"ly11\": 46331.09,\n            \"ly12\": 44473.16,\n            \"lytotal\": 32033.08,\n            \"difftotal\": 34497.92,\n            \"yoyrate\": 107.69,\n            \"last2year\": 665628.21,\n            \"last3year\": 761451.27,\n            \"last4year\": 745990.53,\n            \"last5year\": 784912.19\n        }\n    ],\n    \"columns\": [\n        {\n            \"title\": \"期间/税种\",\n            \"dataIndex\": \"dSubjectName\",\n            \"width\": 140,\n            \"izShow\": \"Y\",\n            \"sorter\": true\n        },\n        {\n            \"title\": \"2026年1月\",\n            \"dataIndex\": \"cy1\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2026年度\",\n            \"dataIndex\": \"cytotal\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"同期累计\",\n            \"dataIndex\": \"lytotal\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"累计变动\",\n            \"dataIndex\": \"difftotal\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"累计增幅\",\n            \"dataIndex\": \"yoyrate\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2025年1月\",\n            \"dataIndex\": \"ly1\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2024年度\",\n            \"dataIndex\": \"last2year\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2023年度\",\n            \"dataIndex\": \"last3year\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2022年度\",\n            \"dataIndex\": \"last4year\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2021年度\",\n            \"dataIndex\": \"last5year\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        }\n    ]\n}",
  "description" : null,
