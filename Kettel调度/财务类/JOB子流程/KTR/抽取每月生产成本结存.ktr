  <step>
    <name>获取每月生产成本结存</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>WITH SCCB 
AS 
(
SELECT T1.GSBM,T1.GSMC,T1.WLBM,T1.QJ,SUM(T1.BZCBJE) BZCBJE,SUM(T1.RLCBJE) RLCBJE,SUM(T1.PFCBJE) PFCBJE,SUM(T1.ZZFYJE)ZZFYJE FROM 
(
SELECT GSBM,GSMC,CBDXBM WLBM
--, HSYSBM BZCBBM,HSYSMC BZCBMC 包装物
,(SUM(CBJE)/CBDXSL)BZCBJE
, null RLCBJE
, null PFCBJE
, null ZZFYJE
, QJ FROM CB_TRCC
WHERE HSYSMC IN ('包装物')
AND (CBDX LIKE '2%')
AND QJ = TO_CHAR(ADD_MONTHS(SYSDATE,-1),'YYYY-mm')

GROUP BY GSBM , GSMC , CBDXBM , CBDXSL , QJ , null
union all
SELECT GSBM,GSMC,CBDXBM WLBM
, null
--, HSYSBM RLCBBM,HSYSMC RLCBMC 燃料
,(SUM(CBJE)/CBDXSL)CBJ
, null , null , QJ FROM CB_TRCC
WHERE HSYSMC IN ('燃料费用')
AND (CBDX LIKE '2%')
AND QJ = TO_CHAR(ADD_MONTHS(SYSDATE,-1),'YYYY-mm')

GROUP BY GSBM , GSMC , CBDXBM , CBDXSL , QJ , null
union all
SELECT GSBM,GSMC,CBDXBM WLBM
, null , null
--, '02' HSYSBM ,'配方料' HSYSMC 
, (SUM(CBJE)/CBDXSL)PFCB
, null
, QJ  FROM CB_TRCC
WHERE 1=1
AND (CBDX LIKE '21%' OR CBDX LIKE '22%')
AND HSYSBM LIKE '02%'
AND HSYSBM &lt;&gt; '0203'
AND QJ = TO_CHAR(ADD_MONTHS(SYSDATE,-1),'YYYY-mm')

GROUP BY GSBM, GSMC, CBDXBM, CBDXSL,QJ,null
union all
SELECT GSBM,GSMC,CBDXBM WLBM
,null , null,null
--,'01' HSYSBM,'制造费用' HSYSMC,
,(SUM(CBJE)/CBDXSL)PFCB
,QJ FROM CB_TRCC
WHERE 1=1
AND (CBDX LIKE '21%' OR CBDX LIKE '22%')
AND HSYSBM LIKE '01%' AND HSYSBM &lt;&gt; '0105'

AND QJ = TO_CHAR(ADD_MONTHS(SYSDATE,-1),'YYYY-mm')


GROUP BY GSBM, GSMC, CBDXBM,CBDXSL, QJ,null
) T1 group by T1.GSBM, T1.GSMC, T1.WLBM,T1.QJ
),
--  配方成本BOM
 AA 
 AS 
(SELECT A.GSBM,A.PFCB,A.NF,A.YF,A.WLDLBM,A.WLXLBM,A.CPBM,B.RKSL,A.PFCB*B.RKSL JE FROM 
(
SELECT DISTINCT  A.GSBM ,SUM(A.JE) PFCB,SUBSTR(A.QJ,0,4) NF , SUBSTR(A.QJ,6,2) YF,B.WLDLBM,B.WLXLBM,A.CPBM FROM
(
SELECT DISTINCT A.GSBM,A.GSMC,A.CPBM,A.CLBM,A.SL CLZSL,A.SL*NVL(B.JCCB,0) JE,A.QJ FROM CB_BOMCF A
LEFT JOIN
(
---结存成本
SELECT DISTINCT GSBM,WLBM,
DECODE((NVL(jcsl,0)+NVL(BYRK,0)),0,0,(NVL(jcsl,0)*NVL(JCDJ,0)+NVL(BYHYFRKJE,0))/(NVL(jcsl,0)+NVL(BYRK,0)))JCCB FROM 
(
SELECT GSBM,WLBM,SUM(JCDJ)JCDJ,SUM(JCSL)JCSL,SUM(BYRK)BYRK,SUM(BYHYFRKJE)BYHYFRKJE FROM
(
(SELECT GSBM,WLBM,NULL JCDJ,case when wlbm IN ('3100000001','3100000009','3100000017','3400000002','3400000006','3400000007','3400000008','3400000009','3400000010','3400000011','3400000012','3400000013','3400000014','3400000015','3400000016','3400000018','3400000022','3400000025','3400000026','3400000027','3400000028','3400000029','3400000030','3400000031','3400000055','3400000056','3400000057','3400000058')
THEN 0
ELSE BYHYFRKJE
END BYHYFRKJE,NULL JCSL,case when wlbm IN ('3100000001','3100000009','3100000017','3400000002','3400000006','3400000007','3400000008','3400000009','3400000010','3400000011','3400000012','3400000013','3400000014','3400000015','3400000016','3400000018','3400000022','3400000025','3400000026','3400000027','3400000028','3400000029','3400000030','3400000031','3400000055','3400000056','3400000057','3400000058')
THEN 0
ELSE BYRK
END BYRK FROM V_CG_KCCBGZ)
UNION ALL 
(SELECT DISTINCT gsbm,wlbm,
jcdj,
NULL BYHYFRKJE,
SL jcsl,NULL BYRKFROM FROM CG_QCJZJC
)
)
GROUP BY GSBM,WLBM
)
ORDER BY GSBM,WLBM
---结存成本
) B
ON A.GSBM=B.GSBM
AND A.CLBM=B.WLBM
WHERE 1=1
AND A.CLBM NOT LIKE '4%'
)A
LEFT JOIN (SELECT WL.WLPK,FL.FLBM3 WLDLBM,FL.FLBM4 WLXLBM,WL.WLZJM,WL.WLMC,WL.WLBM FROM DA_WL WL
LEFT JOIN DA_WLJBFL FL
ON WL.FLPK = FL.FLZJ
)B
ON A.CPBM=B.WLBM
WHERE 1=1
AND SUBSTR(A.QJ,0,7)=TO_CHAR(ADD_MONTHS(SYSDATE,-1),'YYYY-mm')

GROUP BY SUBSTR(A.QJ,0,4),SUBSTR(A.QJ,6,2) ,B.WLDLBM,B.WLXLBM,A.CPBM, A.GSBM 
)A
LEFT JOIN KC_CCPRK1 B
ON B.WLBM = A.CPBM AND B.GSBM = A.GSBM AND B.RQ = A.NF||'-'||A.YF
WHERE 1=1
)
-------------------------------------------------------------------
SELECT T1.GSBM,T1.GSMC,T1.WLBM,T1.QJ,T1.BZCBJE,T1.RLCBJE,T1.PFCBJE,T1.ZZFYJE,T2.PFCBBOM
FROM SCCB T1
LEFT JOIN 
(SELECT A.NF,A.YF,A.GSBM,A.CPBM WLBM,SUM(JE)/SUM(RKSL) PFCBBOM 
FROM AA A 
group by A.NF, A.YF, A.GSBM,A.CPBM) T2
ON T2.GSBM = T1.GSBM AND T2.WLBM = T1.WLBM AND T2.NF||'-'||T2.YF = T1.QJ



</sql>
    <limit>0</limit>
