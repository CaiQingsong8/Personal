  <step>
    <name>临时表输入</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>IFB</connection>
    <sql>select substr(temp.issueDate,1,10) fbrq,
       temp.billCode zbbm,
       temp.gsbm,
       temp.bidName zbxm,
       temp.bidCompanyName gsmc,
       temp.xqzzbm,
       temp.reqOrgName xqzzmc,
       temp.wlbm,
       temp.puInvName wlmc,
       temp.gysbm,
       temp.supplierName gysmc,
       if(psqb.id is null, null, ifnull(if(psqb.tenderer_price is null, psqb.pu_agent_price, psqb.tenderer_price), 0) +
                                 IFNULL(psqb.freight_price, 0))           bjdj,
       psqb.delivery_type                                                 jhfs,
       su.name                                                            pbr,
       if(temp.bizStatus = '99', '已流标', if(psqb.id is null, '未报价', if(ifnull(ptd.decision_num, 0) > 0, '已中标', '未中标'))) sfzb,
       ptd.decision_num                                                   zbsl,
       if(ptd.decisioner_id is null, null, temp.puUnit) wldw,
       temp.puUserName ybr,
	   pet.proposal_desc PBJYSM
from (
         select pbd.*, pitd.supplierId, pitd.supplierName, pitd.puUserId, pitd.puUserName, pitd.gysbm
         from (
                  SELECT pbd.id,
                         pbdb.id         pbdbId,
                         pbd.issue_date  issueDate,
                         pbd.bill_code   billCode,
                         pbd.name        bidName,
                         pbd.tenderee_id bidCompanyId,
                         sc.name         bidCompanyName,
                         sc.code gsbm,
                         pbdb.req_org_id reqOrgId,
                         sc2.name        reqOrgName,
                         sc2.code xqzzbm,
                         pbdb.pu_inv_id  puInvId,
                         pi.name         puInvName,
                         pi.code wlbm,
                         sd.label        puUnit,
                         pbd.biz_status  bizStatus
                  FROM pu_bid_doc pbd
                           LEFT JOIN sys_corp sc ON pbd.tenderee_id = sc.id
                           left join pu_bid_doc_b pbdb on pbd.id = pbdb.bid_doc_id
                           left join sys_dict sd on sd.value = pbdb.pu_unit
                           left join sys_corp sc2 on pbdb.req_org_id = sc2.id
                           left join pu_inv pi on pi.id = pbdb.pu_inv_id
                  where pbd.del_flag = '0' and pbd.def1 = '1'
                    and pbdb.del_flag = '0'
                    and pbd.biz_status in ('6', '9', '99')
              ) pbd
                  left join (
             select distinct pitd.bid_doc_id,
                             pitd.supplier_id supplierId,
                             bc.name          supplierName,
                             bc.code gysbm,
                             pi.id            invId,
                             su.id            puUserId,
                             su.name          puUserName
             from pu_invitation_to_bid pitd
                      left join bd_cubasdoc bc on bc.id = pitd.supplier_id
                      left join sys_user su on su.id = pitd.user_id
                      left join pu_supplier_list psl on psl.supplier_id = pitd.supplier_id
                      left join pu_inv pi on pi.inv_id = psl.inv_id
         ) pitd on pitd.bid_doc_id = pbd.id and pitd.invId = pbd.puInvId
     ) temp
         left join (
    select psqb.id,
           psqb.bid_doc_b_id,
           psqb.tenderer_price,
           psqb.pu_agent_price,
           psqb.freight_price,
           psqb.delivery_type,
           psqb.remarks,
           psq.tenderer_id
    from pu_sup_quotation_b psqb
             left join pu_sup_quotation psq on psqb.sup_quotation_id = psq.id
) psqb on psqb.bid_doc_b_id = temp.pbdbId and psqb.tenderer_id = temp.supplierId
         left join pu_tender_decision ptd on ptd.sup_quotation_b_id = psqb.id
         left join sys_user su on su.id = ptd.decisioner_id
		 left join pu_evaluation_tender pet on pet.sup_quotation_b_id = psqb.id</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
