      <schema_name />
    </partitioning>
    <connection>NC</connection>
    <sql>SELECT
	A.frozenflag DJBJ,/*冻结标志*/
	A.code KHBM,/*客户编码*/
	A.custstate KHZT,/*0=外部单位，1=内部单位*/
	A.enablestate QYZT,/*客户启用状态:1=未启用，2=已启用，3=已停用*/
	A.name KHMC,/*客户名称*/
	A.shortname KHJC,/*客户简称*/
	C.def8 DWPK,/*单位PK*/
	D.code DWBM,/*单位编码*/
CASE WHEN d.name IS NULL THEN b.shortname ELSE d.name 
	END DWMC,/*核算单位，单位名称*/
	C.def9 FPZT,/*分配状态*/
	A.pk_customer KHPK,/*客户PK*/
CASE
	WHEN A.ename IS NULL THEN
	A.code ELSE A.ename 
	END KHTJBM,/*客户统计编码*/
	C.def5 JJZPK,/*聚焦镇PK*/
	E.name JJZMC,/*聚焦镇名称*/
	C.respperson YWYPK,/*业务员PK*/
	F.name YWY,/*业务员姓名*/
	G.name QYJL,/*区域经理姓名*/
	H.NAME BMMC,/*专管部门名称*/
	M.NAME SJBM,/*上级部门名称*/
	B.pk_org XSZZPK,/*销售组织PK*/
	B.code XSZZBM /*销售组织编码*/,
SYSDATE AS UPDATE_TIME 	
FROM
	bd_customer A /*客户基本信息*/
	LEFT JOIN bd_custsale C /*客户销售信息*/
	ON a.pk_customer = c.pk_customer
	LEFT JOIN bd_defdoc D /*自定义档案*/
	ON c.def8 = d.pk_defdoc
	LEFT JOIN org_salesorg B /*组织_业务单元_销售组织*/
	ON c.pk_org = b.pk_salesorg
	LEFT JOIN bd_defdoc E /*自定义档案*/
	ON c.def5 = E.pk_defdoc
	LEFT JOIN bd_psndoc F /*人员基本信息*/
	ON C.respperson = F.pk_psndoc
	LEFT JOIN bd_psndoc G /*人员基本信息*/
	ON C.DEF2 = G.pk_psndoc
	LEFT JOIN org_dept H /*组织_部门*/
	ON C.respdept = H.pk_dept
	LEFT JOIN org_dept M /*组织_部门*/
	ON H.pk_fatherorg = M.pk_dept 
WHERE c.def9 = 'Y' /*已分配客户*/
	AND b.pk_salesorg = '0001A21000000007NO70' /*所属销售组织为江门澳保*/
	AND F.name IS NOT NULL /*专管业务员不为空*/
	AND A.frozenflag = 'N' /*冻结标记为否*/
	AND A.enablestate = 2 /*已启用客户*/</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
