    <connection>OA</connection>
    <sql>SELECT
A.KEHMC,--客户名称
CASE WHEN A.KEHLB = 0 THEN '畜禽饲料客户'
WHEN A.KEHLB = 1 THEN '其他饲料客户' 
WHEN A.KEHLB = 2 THEN '虾蟹料' 
WHEN A.KEHLB = 3 THEN '高档膨化料' 
WHEN A.KEHLB = 4 THEN '普通膨化料' 
WHEN A.KEHLB = 5 THEN '沉水鱼料' 
WHEN A.KEHLB = 6 THEN '猪料'
WHEN A.KEHLB = 7 THEN '禽料'
ELSE ''END KEHLB,--客户类别
A.SHENQRQ,--申请日期
A.ZUICHKRQ,--最迟还款日期
CASE WHEN A.SHIFYHK = 0 THEN '是' ELSE '否'END SHIFYHK,--是否已还款
C.LASTNAME SHENQR,--申请人
E.SUBCOMPANYNAME GSJC,--公司简称
E.SUBCOMPANYDESC GSMC,--公司全称
D.DEPARTMENTNAME SHENQBM,--申请部门
F.JOBTITLENAME ZHIW,--职务
A.BIANH,--流程编号
C.LASTNAME QIANKDBR,--欠款担保人
A.BENCHK,--本次货款
A.TIHQQK,--提货前欠款
A.TIHHQK,--提货后欠款
A.KEHED,--客户额度
A.CHAOCED,--超出额度
A.DANBXX,--担保信息
A.DANBHKSJ,--担保还款时间
A.HUANKJE,--还款金额
A.SHIJHKRQ,--实际还款日期
B.STATUS --流程当前节点
FROM formtable_main_56 A --临时欠款流程
LEFT JOIN workflow_requestbase B --工作流请求基本信息表
ON A.REQUESTID = B.REQUESTID
LEFT JOIN HrmResource C --人力资源表
ON C.ID = A.SHENQR
LEFT JOIN hrmdepartment D --部门表
ON D.ID = A.SHENQBM
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = A.SUOSGS
LEFT JOIN hrmjobtitles F --岗位表
ON F.ID = A.ZHIW
LEFT JOIN HrmResource G --人力资源表
ON G.ID = A.QIANKDBR
WHERE (B.STATUS = '财务经理确认回款' OR B.STATUS = '归档') AND A.SHENQRQ >= '2018-01-10'</sql>
    <limit>0</limit>
