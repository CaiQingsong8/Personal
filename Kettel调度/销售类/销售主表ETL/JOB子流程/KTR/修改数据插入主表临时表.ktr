  <order>
    <hop>
      <from>抽取修改数据</from>
      <to>插入主表临时表</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>获取更新时间变量</from>
      <to>抽取修改数据</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>抽取修改数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT DISTINCT substr(so_saleorder_b.dbilldate,1,10)  dbilldate,  --订单日期
                substr(so_saleorder_b.dbilldate,1,4)  dbilldate_year, --年
                substr(so_saleorder_b.dbilldate,6,2)  dbilldate_month, --月
                so_saleorder.csaleorderid    csaleorderid,--订单主键
                so_saleorder.fstatusflag     ddzt,  --审核状态
                bd_billtype.billtypename     billtypename,--单据类型名称
                so_saleorder.vbillcode        vbillcode,     --单据号
                so_saleorder.vdef20           ceyy,   --超额原因 
                so_saleorder_b.nastnum        nastnum, --数量包
                bd_measdoc2.name              fdw,  --辅单位
                so_saleorder_b.nnum           nnum, --主数量吨
                bd_measdoc1.name              zdw,  --主单位
                so_saleorder_b.norigtaxmny    jshj, --价税合计
                so_saleorder_b.crowno         crowno,--行号
                bd_material.code            wlbm, --物料编码
                bd_material.name            wlmc, --物料名称
                bd_material.materialtype    wlxh, --物料型号
                bd_branddoc.name              wlpp, --物料品牌
                so_saleorder_b.csendstordocid ckzj, --发货仓库主键
                bd_stordoc.name               fhck, --发货仓库
                org_orgs.def1                 gsdq, --公司所属大区
                org_salesorg.code            gsbm, --公司编码
                org_salesorg.shortname        gsjc, --公司简称
                org_salesorg.name             gsmc, --公司名称     
                (CASE WHEN org_dept_v.name like '%事业部%'
                THEN org_dept_v.name
                ELSE org_salesorg.shortname 
                END) hsdw,--核算单位    
                bd_marbasclass.code           wlflbm, --物料小类编码
                bd_marbasclass1.code          sjflbm, --上级物料分类编码
                bd_marbasclass1.name          sjflmc, --上级物料分类名称
                bd_marbasclass.name           wlflmc, --物料小类名称
                bd_defdoc.name                fllb,  --5+2
                bd_defdoc1.name               jjzmc, --聚焦镇
                bd_defdoc1.code               jjzbm, --聚焦镇编码
                bd_defdoc2.name               xsdqmc, --销售大区名称
                bd_defdoc2.code               xsdqbm, --销售大区编码
                bd_psndoc.name                ywdb,   --业务代表
                bd_psndoc5.name               qyjl,--区域经理
                bd_psndoc6.name               dqjl,--大区经理
                bd_psndoc7.name               xsjl,--销售经理
                substr(bd_customer.def11, 1, 10) khkhrq,     --客户开户日期
                substr(bd_customer.def12, 1, 10) khthrq,     --客户提货日期
                 (CASE WHEN bd_material.code like '7%'
                THEN so_saleorder_b.nastnum
                ELSE so_saleorder_b.nnum
                END) * replace（bd_marbasclass.def1,'~','1') xsd,   --销售吨
                so_saleorder_b.blargessflag blargessflag,   --是否赠品
                so_buylargess.policy_code        xszcbm,--政策编码
                so_buylargess.policy_name        xszcmc,--政策名称
                bd_customer.code          khcode, --客户编码
                bd_customer.pk_customer   PK_KH, --客户主键
                bd_customer.name          khmc, --客户名称
                bd_customer.def9          yxzjh,  --有效证件号
                bd_custclass.code         khflbm, --客户分类编码
                bd_custclass.name         khflmc, --客户分类名称
                bd_psndoc.name            ywyxm,   --业务员姓名
                org_dept_v.name           xsmc, --销售部门名称
                substr(so_saleorder.creationtime,1,10) creationtime,--创建时间
                bd_marbasclass.def1              xsdxs, --销售吨系数
                bd_marbasclass.def2              scdxs, --生产吨系数
                so_saleorder_b.dr,
                 (CASE WHEN bd_material.code like '7%'
                THEN so_saleorder_b.nastnum
                ELSE so_saleorder_b.nnum
                END)                          TYNUM--统一使用吨为单位 
  FROM so_saleorder so_saleorder --订单主表
  LEFT JOIN bd_billtype bd_billtype --单据类型
    ON so_saleorder.ctrantypeid=bd_billtype.pk_billtypeid
  LEFT JOIN so_saleorder_b so_saleorder_b --订单子表
    ON so_saleorder.csaleorderid = so_saleorder_b.csaleorderid
  LEFT JOIN so_buylargess so_buylargess --买赠
    on so_saleorder_b.vbdef20=so_buylargess.pk_buylargess 
  LEFT JOIN bd_customer bd_customer --客户
    ON so_saleorder.ccustomerid = bd_customer.pk_customer
  LEFT JOIN  bd_custsale bd_custsale
    ON bd_customer.pk_customer=bd_custsale.pk_customer 
  LEFT JOIN (select a.code,a.name,c.def1,c.pk_org,A.pk_salesorg,A.shortname   from 

org_salesorg a
    left join bd_custsale c
    on c.PK_ORG=a.PK_ORG) org_salesorg
    ON so_saleorder.PK_ORG=org_salesorg.pk_salesorg
  LEFT JOIN (select a.code,a.name,c.def1,c.pk_org,C.pk_vid  from org_salesorg a
    left join org_orgs c
    on c.pk_vid=a.pk_vid) org_orgs 
    ON so_saleorder.PK_ORG=org_orgs.pk_org
  LEFT JOIN bd_custclass bd_custclass --客户分类
    ON bd_customer.pk_custclass = bd_custclass.pk_custclass
  LEFT JOIN bd_material bd_material --物料
    ON so_saleorder_b.cmaterialvid = bd_material.pk_material
  LEFT JOIN bd_stordoc bd_stordoc --仓库
    ON so_saleorder_b.csendstordocid = bd_stordoc.pk_stordoc
  LEFT JOIN bd_marbasclass bd_marbasclass --物料分类
    ON bd_material.pk_marbasclass =bd_marbasclass.pk_marbasclass
  LEFT JOIN bd_branddoc bd_branddoc  --品牌
    ON bd_material.pk_brand = bd_branddoc.pk_brand
  LEFT JOIN bd_marbasclass bd_marbasclass1 --上级分类
    ON bd_marbasclass.pk_parent =bd_marbasclass1.pk_marbasclass
  LEFT JOIN bd_psndoc bd_psndoc --自定义项1业务员
    ON so_saleorder.cemployeeid = bd_psndoc.pk_psndoc
  LEFT JOIN org_dept_v org_dept_v  --部门
    ON so_saleorder.cdeptvid = org_dept_v.pk_vid
  LEFT JOIN bd_defdoc bd_defdoc  --5+2
    ON bd_material.def1 = bd_defdoc.pk_defdoc
  LEFT JOIN bd_defdoc bd_defdoc1 --定义3聚焦镇
    ON so_saleorder.vdef3= bd_defdoc1.pk_defdoc
  LEFT JOIN bd_defdoc bd_defdoc2 --定义4销售大区名称
    ON so_saleorder.vdef4 = bd_defdoc2.pk_defdoc
  LEFT JOIN bd_defdoc bd_defdoc3  --定义5所属大区名称
    ON so_saleorder.vdef5 =bd_defdoc3.pk_defdoc
  LEFT JOIN bd_psndoc bd_psndoc5 --定义8区域经理
    ON so_saleorder.vdef8 = bd_psndoc5.pk_psndoc    
  LEFT JOIN bd_psndoc bd_psndoc6 --定义9大区经理
    ON so_saleorder.vdef9 = bd_psndoc6.pk_psndoc
  LEFT JOIN bd_psndoc bd_psndoc7 --定义7销售经理
    ON so_saleorder.vdef7 = bd_psndoc7.pk_psndoc
  LEFT JOIN bd_measdoc bd_measdoc1 
    ON so_saleorder_b.cunitid = bd_measdoc1.pk_measdoc
  LEFT JOIN bd_measdoc bd_measdoc2 
    ON so_saleorder_b.castunitid = bd_measdoc2.pk_measdoc


  WHERE  substr(so_saleorder.modifiedtime,1,10) >= '${updtime}'
  AND bd_marbasclass.CODE LIKE '2%'
  AND org_salesorg.code&lt;&gt;'1018'</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
