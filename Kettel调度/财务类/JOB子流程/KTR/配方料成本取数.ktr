    <connection>fbuser</connection>
    <sql>SELECT distinct a.gsbm,a.gsjc,a.gsmc,a.cbdxbm,a.qj,a.cbdxsl,a.DLBM,sum(a.dlcb)dlcb,sum(a.xlcb)xlcb,sum(a.hjcb)hjcb,sum(a.hfcb)hfcb,sum(a.dfcb)dfcb,sum(a.rlcb)rlcb,sum(a.rgcb)rgcb,sum(a.zjcb)zjcb,sum(a.zzcb)zzcb,sum(a.dldwcb)dldwcb,sum(a.zzcb)-sum(a.zjcb) fzjcb,b.clbm,b.clsl FROM (

SELECT GSBM,GSJC,GSMC,CBDXBM,QJ,SUM(CBDXSL)cbdxsl,SUBSTR(CBDXBM,0,4)DLBM,DLCB/SUM(CBDXSL)DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB FROM (

select distinct gsbm,gsjc,gsmc,

(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END)
cbdxbm,qj,cbdxsl,
sum(cbje)over(partition by qj,gsbm,gsjc,CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END) dlcb,
null xlcb,
null hjcb,
null hfcb,
NULL dfcb,
null rlcb,
NULL RGCB,
NULL ZJCB,
null zzcb,
null dldwcb
FROM cb_trcc
where hsysbm='0201'
and (cbdxbm like '5%' OR cbdxbm like '6%')
)
GROUP BY GSBM,GSJC,GSMC,CBDXBM,QJ,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB

union all

SELECT GSBM,GSJC,GSMC,CBDXBM,QJ,SUM(CBDXSL)cbdxsl,SUBSTR(CBDXBM,0,4)DLBM,DLCB,XLCB/SUM(CBDXSL)XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB FROM (
select distinct gsbm,gsjc,gsmc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END) cbdxbm,qj,cbdxsl,
null dlcb,
sum(cbje)over(partition by qj,gsbm,gsjc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END)) xlcb,
null hjcb,
null hfcb,
NULL dfcb,
null rlcb,
NULL RGCB,
NULL ZJCB,
null zzcb,
null dldwcb
FROM cb_trcc
where hsysbm='0202'
and  (cbdxbm like '5%' OR cbdxbm like '6%')
)
GROUP BY GSBM,GSJC,GSMC,CBDXBM,QJ,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB

union all
SELECT GSBM,GSJC,GSMC,CBDXBM,QJ,SUM(CBDXSL)cbdxsl,SUBSTR(CBDXBM,0,4)DLBM,DLCB,XLCB,HJCB/SUM(CBDXSL)HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB FROM (
select distinct gsbm,gsjc,gsmc,
(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END) cbdxbm,qj,cbdxsl,
null dlcb,
null xlcb,
sum(cbje)over(partition by qj,gsbm,gsjc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END)) hjcb,
null hfcb,
NULL dfcb,
null rlcb,
NULL RGCB,
NULL ZJCB,
null zzcb,
null dldwcb
FROM cb_trcc
where hsysbm='0204'
and  (cbdxbm like '5%' OR cbdxbm like '6%')
)
GROUP BY GSBM,GSJC,GSMC,CBDXBM,QJ,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB

union all

SELECT GSBM,GSJC,GSMC,CBDXBM,QJ,SUM(CBDXSL)cbdxsl,SUBSTR(CBDXBM,0,4)DLBM,DLCB,XLCB,HJCB,HFCB/SUM(CBDXSL)HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB FROM (
select distinct gsbm,gsjc,gsmc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END)cbdxbm,qj,cbdxsl,
null dlcb,
null xlcb,
null hjcb,
sum(cbje)over(partition by qj,gsbm,gsjc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END)) hfcb,
NULL dfcb,
null rlcb,
NULL RGCB,
NULL ZJCB,
null zzcb,
null dldwcb
FROM cb_trcc
where hsysbm='0205'
and  (cbdxbm like '5%' OR cbdxbm like '6%')
)
GROUP BY GSBM,GSJC,GSMC,CBDXBM,QJ,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB

union all
SELECT GSBM,GSJC,GSMC,CBDXBM,QJ,SUM(CBDXSL)cbdxsl,SUBSTR(CBDXBM,0,4)DLBM,DLCB,XLCB,HJCB,HFCB,DFcb/SUM(CBDXSL)DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB FROM (

select distinct gsbm,gsjc,gsmc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END) cbdxbm,qj,cbdxsl,
NULL dlCB,
null xlcb,
null hjcb,
null hfcb,
sum(cbje)over(partition by qj,gsbm,gsjc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END)) DFcb,
null rlcb,
NULL RGCB,
NULL ZJCB, null zzcb,null DLdwcb
FROM cb_trcc
where hsysbm='0102'
and  (cbdxbm like '5%' OR cbdxbm like '6%')
)
GROUP BY GSBM,GSJC,GSMC,CBDXBM,QJ,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB
  

union all

SELECT GSBM,GSJC,GSMC,CBDXBM,QJ,SUM(CBDXSL)cbdxsl,SUBSTR(CBDXBM,0,4)DLBM,DLCB,XLCB,HJCB,HFCB,DFCB,RLcb/SUM(CBDXSL)RLCB,RGCB,ZJCB,ZZCB,DLDWCB FROM (

select distinct gsbm,gsjc,gsmc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END) cbdxbm,qj,cbdxsl,
NULL dlCB,
null xlcb,
null hjcb,
null hfcb,
null dfcb,
sum(cbje)over(partition by qj,gsbm,gsjc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END)) RLcb,
NULL RGCB,
NULL ZJCB,
null zzcb,null DLdwcb
FROM cb_trcc
where hsysbm='0105'
and  (cbdxbm like '5%' OR cbdxbm like '6%')
)
GROUP BY GSBM,GSJC,GSMC,CBDXBM,QJ,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB

union all
SELECT GSBM,GSJC,GSMC,CBDXBM,QJ,SUM(CBDXSL)cbdxsl,SUBSTR(CBDXBM,0,4)DLBM,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB/SUM(CBDXSL)RGCB,ZJCB,ZZCB,DLDWCB FROM (

select distinct gsbm,gsjc,gsmc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END) cbdxbm,qj,cbdxsl,
NULL dlCB,
null xlcb,
null hjcb,
null hfcb,
null dfcb,
NULL RLCB,
sum(cbje)over(partition by qj,gsbm,gsjc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END)) RGCB,
NULL ZJCB,
null zzcb,NULL dldwcb
FROM cb_trcc
where hsysbm LIKE '0106%'
and  (cbdxbm like '5%' OR cbdxbm like '6%')
)
GROUP BY GSBM,GSJC,GSMC,CBDXBM,QJ,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB

union all

SELECT GSBM,GSJC,GSMC,CBDXBM,QJ,SUM(CBDXSL)cbdxsl,SUBSTR(CBDXBM,0,4)DLBM,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB/SUM(CBDXSL)ZJCB,ZZCB,DLDWCB FROM (

select distinct gsbm,gsjc,gsmc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END) cbdxbm,qj,cbdxsl,
NULL dlCB,
null xlcb,
null hjcb,
null hfcb,
null dfcb,
NULL RLCB,
NULL RGCB,
sum(cbje)over(partition by qj,gsbm,gsjc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END) ) ZJCB,
null zzcb,null DLdwcb
FROM cb_trcc
where hsysbm='0109'
and  (cbdxbm like '5%' OR cbdxbm like '6%')
)
GROUP BY GSBM,GSJC,GSMC,CBDXBM,QJ,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB
    
union all
SELECT GSBM,GSJC,GSMC,CBDXBM,QJ,SUM(CBDXSL)cbdxsl,SUBSTR(CBDXBM,0,4)DLBM,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZcb/SUM(CBDXSL)ZZCB,DLDWCB FROM (
select distinct gsbm,gsjc,gsmc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END)  cbdxbm,qj,cbdxsl,
null dlcb,
null xlcb,
null hjcb,
null hfcb, 
null dfcb, 
null rlcb,
NULL RGCB,
NULL ZJCB,
sum(cbje)over(partition by qj,gsbm,gsjc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END) ) ZZcb,
null DLdwcb
FROM cb_trcc
where hsysbm LIKE '01%'
and  (cbdxbm like '5%' OR cbdxbm like '6%')
)
GROUP BY GSBM,GSJC,GSMC,CBDXBM,QJ,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB

union all

SELECT GSBM,GSJC,GSMC,CBDXBM,QJ,SUM(CBDXSL)cbdxsl,SUBSTR(CBDXBM,0,4)DLBM,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLdwcb/SUM(CBDXSL)DLDWCB FROM (

select distinct gsbm,gsjc,gsmc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END) cbdxbm,qj,cbdxsl,
null dlcb,
null xlcb,
null hjcb,
null hfcb, 
null dfcb, null rlcb,
NULL RGCB,
NULL ZJCB,
null ZZcb,
sum(cbje)over(partition by qj,gsbm,gsjc,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END) ) dldwcb
FROM cb_trcc
where  (cbdxbm like '5%' OR cbdxbm like '6%')
)
GROUP BY GSBM,GSJC,GSMC,CBDXBM,QJ,DLCB,XLCB,HJCB,HFCB,DFCB,RLCB,RGCB,ZJCB,ZZCB,DLDWCB

)a


left join (SELECT GSBM,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END) RRR,QJ,CLBM,SUM(CLSL)CLSL FROM cb_trcc
  where clbm like '32%' 
  GROUP BY GSBM,(CASE WHEN CBDXBM LIKE '6%'
THEN SUBSTR(CBDXBM,15,10)
  ELSE CBDXBM
  END),QJ,CLBM
  ) b
on a.gsbm=b.gsbm
and a.cbdxbm=B.RRR
and a.qj=b.qj


GROUP BY a.gsbm,a.gsjc,a.gsmc,a.cbdxbm,a.DLBM,a.qj,a.cbdxsl,b.clbm,b.clsl



</sql>
