  <step>
    <name>抽取销售对账单澳保数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT 'saleinvoice' AS tag,
	   org.pk_org,          --公司主键
       org.CODE                                 orgcode,--公司编码
       org.name                                 orgname,--公司组织
	   c.pk_customer,    --客户主键
       c.code                                   khbm, --客户编码
       c.name                                   khmc,--客户姓名
       c.name                                   custname,--客户姓名：待删除
       d.pk_psndoc                              ywrypk, --业务员PK
       d.name                                   ywry, --业务员
       E.memo                                   BMMC,--部门
       substr(so_saleinvoice.dbilldate, 1, 10)  djrq,--单据日期
       substr(so_saleinvoice.dbilldate, 1, 7)  djyf,--单据月份
       bd_billtype.billtypename                 djlx,--订单类型
       so_saleinvoice_b.vfirstcode              djbh,--单据号
       m.materialmnecode                        cpbm,--产品编码
       n.name||' '||m.name                           cpmc,--物料品名
       m.code                                   wlbm,--物料编码
       m.materialspec                           wlgg, --物料规格
       so_saleinvoice_b.nastnum                 sl,     --数量
	   so_saleinvoice_b.nnum as  				JS,      --件数
       --decode(m.unitlength,0,0,so_saleinvoice_b.nastnum/m.unitlength) JS,      --件数
       so_saleinvoice_b.ntaxnetprice            jsdj, --结算单价
       so_saleinvoice_b.ntaxprice               hsdj, --含税单价
       so_saleinvoice_b.norigtaxnetprice        hsjj, --含税净价（主含税净价）
       so_saleinvoice_b.norigdiscount           zke, --折扣额
       (so_saleinvoice_b.nnum)*(so_saleinvoice_b.nqtorigtaxprice) kpje, --开票金额
       case when so_saleinvoice_b.blargessflag='Y'
       THEN 0
       ELSE so_saleinvoice_b.ntaxmny END         jsje,--结算金额
       '--'                                     ysbz,--应收备注
       0.00                                     skje,--收款金额
       so_saleinvoice_b.blargessflag            blargessflag,--赠品
       so_saleinvoice_b.csaleinvoicebid         bid,
       0.00                                     fkje,--返款金额
       '--'                                     DKGXR,
	   L2.CODE AS DLBM,
	   L2.NAME AS DLMC,
       so_saleinvoice_b.ts,
       --so_saleinvoice.csaleinvoiceid   as main_bill_pk,
       so_saleinvoice_b.csaleinvoicebid  as bill_pk
  from so_saleinvoice so_saleinvoice
  left join so_saleinvoice_b so_saleinvoice_b
    on so_saleinvoice_b.csaleinvoiceid = so_saleinvoice.csaleinvoiceid
  left join bd_billtype bd_billtype
    on so_saleinvoice.ctrantypeid = bd_billtype.pk_billtypeid
  left join bd_material m
    on so_saleinvoice_b.cmaterialid = m.pk_material
  left join bd_marbasclass L
    on m. pk_marbasclass=L.pk_marbasclass
  LEFT JOIN BD_MARBASCLASS L2
    ON L.PK_PARENT = L2.PK_MARBASCLASS
  LEFT JOIN BD_MARBASCLASS L3
    ON L2.PK_PARENT = L3.PK_MARBASCLASS
  left join bd_branddoc n
    on m.pk_brand = n.pk_brand
  left join org_orgs org
    on so_saleinvoice_b.pk_org = org.pk_org
  left join bd_customer c
    on so_saleinvoice.cinvoicecustid = c.pk_customer
  LEFT JOIN  bd_custsale bd_custsale
    ON c.pk_customer=bd_custsale.pk_customer
    AND bd_custsale.PK_ORG=org.pk_org
  left join bd_psndoc d
    on bd_custsale.respperson  =d.pk_psndoc
  LEFT JOIN org_dept E
    ON so_saleinvoice_b.cdeptid=E.pk_dept
 where so_saleinvoice.dr = 0
   and so_saleinvoice_b.dr = 0
   AND org.code='1030'
   AND so_saleinvoice.dbilldate>=to_char(trunc(add_months(trunc(sysdate), -3),'mm'),'YYYY-MM-DD HH24:MI:SS')
   and  l3.CODE ='23'


union all
--应收单数据，仅包含直接在应收系统做应收单的部分，不含期初
SELECT 'recbill' AS tag,
	   org.pk_org,          --公司主键
       org.CODE                                 orgcode,--公司编码
       org.name                                 orgname,--公司组织
	   c.pk_customer,    --客户主键
       c.code                                   khbm, --客户编码
       c.name                                   khmc,--客户姓名
       c.name                                   custname,--客户姓名：待删除
       d.pk_psndoc                              ywrypk, --业务员PK
       d.name ywry,
       E.memo BMMC,
       substr(ar_recbill.billdate, 1, 10) djrq,
       substr(ar_recbill.billdate, 1, 7)  djyf,--单据月份
       bd_billtype.billtypename djlx,
       ar_recbill.billno djbh,
       m.code cpbm,
       n.name||' '||m.name CPMC,
       m.code wlbm,
       m.materialspec                           wlgg, --物料规格
       0 sl,
       0 js,
       0 jsdj,
       0 hsdj,
       0 hsjj,
       0.00 zke,
       0.00 kpje,
       ar_recitem.local_money_de jsje,
       ar_recitem.def1 ysbz,
       0.00 skje,
       'N' blargessflag,
       ar_recitem.pk_recitem bid，
       0.00 fkje,
       '--'                                     DKGXR,
	   L2.CODE AS DLBM,
	   L2.NAME AS DLMC,
       ar_recitem.ts,
       --ar_recbill.pk_recbill  as main_bill_pk,
        ar_recitem.pk_recitem as bill_pk
  from ar_recbill ar_recbill
  left join ar_recitem ar_recitem
    on ar_recitem.pk_recbill = ar_recbill.pk_recbill
  left join bd_billtype bd_billtype
    on ar_recbill.pk_tradetypeid = bd_billtype.pk_billtypeid
  left join bd_material m
    on ar_recitem.material = m.pk_material
  left join bd_marbasclass L
    on m. pk_marbasclass=L.pk_marbasclass
  LEFT JOIN BD_MARBASCLASS L2
    ON L.PK_PARENT = L2.PK_MARBASCLASS
  LEFT JOIN BD_MARBASCLASS L3
    ON L2.PK_PARENT = L3.PK_MARBASCLASS
  left join bd_branddoc n
    on m.pk_brand = n.pk_brand
  left join org_orgs org
    on ar_recitem.pk_org = org.pk_org
  left join bd_customer c
    on ar_recitem.customer = c.pk_customer
  LEFT JOIN  bd_custsale bd_custsale
    ON c.pk_customer=bd_custsale.pk_customer
    AND bd_custsale.PK_ORG=org.pk_org
   left join bd_psndoc d
    on bd_custsale.respperson=d.pk_psndoc
   left join org_dept E
    ON ar_recitem.pk_deptid =E.pk_dept
where ar_recbill.dr = 0
and ar_recitem.dr = 0
AND org.code='1030'
AND ar_recbill.billdate>=to_char(trunc(add_months(trunc(sysdate), -3),'mm'),'YYYY-MM-DD HH24:MI:SS')
and ar_recitem.objtype='0'
and ar_recbill.src_syscode='0'
--and  l3.CODE ='23'


union all
--应收单数据，仅包含直接在应收系统做应收单的部分，不含期初
SELECT 
       'recbill1' AS tag,
	   org.pk_org,          --公司主键
       org.CODE                                 orgcode,--公司编码
       org.name                                 orgname,--公司组织
	   c.pk_customer,    --客户主键
       c.code                                   khbm, --客户编码
       c.name                                   khmc,--客户姓名
       c.name                                   custname,--客户姓名：待删除
       d.pk_psndoc                              ywrypk, --业务员PK
       d.name ywry,
       e.memo bmmc,
       substr(ar_recbill.billdate, 1, 10) djrq,
       substr(ar_recbill.billdate, 1, 7)  djyf,--单据月份
       bd_billtype.billtypename djlx,
       ar_recbill.billno djbh,
       NULL cpbm,
       NULL cpmc,
       NULL wlbm,
       NULL WLGG,
       0 sl,
       0 js,
       0 jsdj,
       0 hsdj,
       0 hsjj,
       0.00 zke,
       0.00 kpje,
       ar_recitem.local_money_de jsje,
       ar_recitem.def1 ysbz,
       0.00 skje,
       'N' blargessflag,
       NULL bid,
       ar_recitem.local_money_de fkje,
       '--'                                     DKGXR,
	   L2.CODE AS DLBM,
	   L2.NAME AS DLMC,
       ar_recitem.ts,
       ar_recitem.pk_recitem   as bill_pk --这里用主表的主键且去重   
  from ar_recbill ar_recbill
  left join ar_recitem ar_recitem
    on ar_recitem.pk_recbill = ar_recbill.pk_recbill
  left join bd_billtype bd_billtype
    on ar_recbill.pk_tradetypeid = bd_billtype.pk_billtypeid
  left join bd_material m
    on ar_recitem.material = m.pk_material
  left join bd_marbasclass L
    on m. pk_marbasclass=L.pk_marbasclass
  LEFT JOIN BD_MARBASCLASS L2
    ON L.PK_PARENT = L2.PK_MARBASCLASS
  LEFT JOIN BD_MARBASCLASS L3
    ON L2.PK_PARENT = L3.PK_MARBASCLASS
  left join bd_branddoc n
    on m.pk_brand = n.pk_brand
  left join org_orgs org
    on ar_recitem.pk_org = org.pk_org
  left join bd_customer c
    on ar_recitem.customer = c.pk_customer
  LEFT JOIN  bd_custsale bd_custsale
    ON c.pk_customer=bd_custsale.pk_customer
    AND bd_custsale.PK_ORG=org.pk_org
   left join bd_psndoc d
    on bd_custsale.respperson  =d.pk_psndoc
   left join org_dept E
    ON ar_recitem.pk_deptid =E.pk_dept
where ar_recbill.dr = '0'
and ar_recitem.dr = '0'
--and  L3.CODE ='23'
AND org.code='1030'
AND ar_recbill.billdate>=to_char(trunc(add_months(trunc(sysdate), -3),'mm'),'YYYY-MM-DD HH24:MI:SS')
and ar_recitem.objtype='0'
and ar_recbill.src_syscode='3'
and ar_recbill.pk_tradetype&lt;&gt;'D0'


union all
SELECT 'gatherbill' AS tag,
	   org.pk_org,          --公司主键
       org.CODE                                 orgcode,--公司编码
       org.name                                 orgname,--公司组织
	   c.pk_customer,    --客户主键
       c.code                                   khbm, --客户编码
       c.name                                   khmc,--客户姓名
       c.name                                   custname,--客户姓名：待删除
       d.pk_psndoc     ywrypk, --业务员PK
       d.name ywyr,
       E.memo BMMC,
       substr(ar_gatherbill.billdate, 1, 10) djrq,
       substr(ar_gatherbill.billdate, 1, 7)  djyf,--单据月份
        bd_billtype.billtypename djlx,
        ar_gatherbill.billno djbh,
       '--' cpbm,
       '--' cpmc,
       '--' wlbm,
       '--' WLGG,
       0.00 sl,
       0.00 js,
       0.00 jsdj,
       0.00 hsdj,
       0.00 hsjj,
       0.00 zke,
       0.00 kpje,
       0.00 jsje,
       bd_balatype.name||'；'||ar_gatheritem.def1 ysbz,
       ar_gatheritem.local_money_cr skje,
        '-' blargessflag,
       ar_gatheritem.pk_gatheritem bid,
       0.00 fkje,
         CASE WHEN L.NAME IS NULL
         THEN '本人'
           ELSE ar_gatheritem.DEF5||'('||l.NAME||')'
             END DKGXR,
	  '--' dlbm,
	  '--' dlmc,
       ar_gatheritem.ts,
       --ar_gatherbill.pk_gatherbill    as main_bill_pk,
        ar_gatheritem.pk_gatheritem  as bill_pk
  from ar_gatherbill ar_gatherbill
  left join ar_gatheritem ar_gatheritem
    on ar_gatheritem.pk_gatherbill = ar_gatherbill.pk_gatherbill
  left join bd_balatype bd_balatype
    on ar_gatheritem.pk_balatype=bd_balatype.pk_balatype
  left join bd_billtype bd_billtype
    on ar_gatherbill.pk_tradetypeid = bd_billtype.pk_billtypeid
  left join org_orgs org
    on ar_gatheritem.pk_org = org.pk_org
  left join bd_customer c
    on ar_gatheritem.customer = c.pk_customer
  LEFT JOIN  bd_custsale bd_custsale
    ON c.pk_customer=bd_custsale.pk_customer
    AND bd_custsale.PK_ORG=org.pk_org
   LEFT JOIN bd_defdoc l
    ON ar_gatheritem.def4=l.pk_defdoc
   left join bd_psndoc d
    on bd_custsale.respperson  =d.pk_psndoc
   left join org_dept E
    ON ar_gatheritem.pk_deptid =E.pk_dept
where ar_gatherbill.dr=0
and ar_gatheritem.dr=0
and ar_gatheritem.objtype = 0
   AND org.code='1030'
   AND ar_gatherbill.billdate>=to_char(trunc(add_months(trunc(sysdate), -3),'mm'),'YYYY-MM-DD HH24:MI:SS')</sql>
