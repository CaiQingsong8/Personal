  <step>
    <name>抽取主数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>

WITH TEMP AS (
SELECT  PK_ORG,
		ORGCODE,
		ORGNAME,
		PK_CUSTOMER,
        KHBM,
		KHMC,
		YWRYPK,
		YWRY,
        BMMC,
        DJYF,
		ROW_NUMBER() OVER(PARTITION BY ORGNAME,KHBM ORDER BY DJYF DESC) AS RN,
        (SUM(JSJE) OVER(PARTITION BY ORGNAME,KHBM)-SUM(SKJE) OVER(PARTITION BY ORGNAME,KHBM)) AS QCJE,
		0 AS JSJE,
		0 AS SKJE,
		0 AS FKJE,
		0 AS ZBS,
		0 AS ZDS,
		0 AS BS,
		0 AS DS,
		0 AS ZSBS,
		0 AS ZSDS,
		0 AS ZSDBBS,
		0 AS ZSDBDS
FROM F_XSDZD
WHERE DJYF &lt; TO_CHAR(ADD_MONTHS(SYSDATE,-1),'yyyy-mm')
)
,TEMP2 AS(
SELECT  PK_ORG,
		ORGCODE,
		ORGNAME,
		PK_CUSTOMER,
        KHBM,
		KHMC,
		YWRYPK,
		YWRY,
        BMMC,
		NULL AS BMMC1,
        DJYF,
        QCJE,
		JSJE,
		SKJE,
		FKJE,
		ZBS,
		ZDS,
		BS,
		DS,
		ZSBS,
		ZSDS,
		ZSDBBS,
		ZSDBDS
FROM TEMP
WHERE RN=1
UNION ALL
SELECT  PK_ORG,
		ORGCODE,
		MAX(ORGNAME) AS ORGNAME,
		PK_CUSTOMER,
        KHBM,
		MAX(KHMC) AS KHMC,
		MAX(YWRYPK) AS YWRYPK,
		MAX(YWRY) AS YWRY,
		NULL AS BMMC,
		MAX(BMMC) AS BMMC1,
		DJYF,
		0 AS QCJE,
        SUM(JSJE) JSJE,
        SUM(SKJE) SKJE,
        SUM(FKJE) FKJE,
		SUM(BS)   ZBS,
		SUM(DS)   ZDS,
        SUM(CASE WHEN blargessflag='N' THEN BS ELSE 0 END) AS BS,
        SUM(CASE WHEN blargessflag='N' THEN DS ELSE 0 END) AS DS,
        SUM(CASE WHEN blargessflag='Y' AND WLFLBM2&lt;&gt;'23' THEN BS ELSE 0 END) AS ZSBS,
        SUM(CASE WHEN blargessflag='Y' AND WLFLBM2&lt;&gt;'23'  THEN DS ELSE 0 END) AS ZSDS,
        SUM(CASE WHEN blargessflag='Y' AND WLFLBM2='23' THEN BS ELSE 0 END) AS ZSDBBS,
        SUM(CASE WHEN blargessflag='Y' AND WLFLBM2='23'  THEN DS ELSE 0 END) AS ZSDBDS
FROM F_XSDZD
WHERE DJYF = TO_CHAR(ADD_MONTHS(SYSDATE,-1),'yyyy-mm')
GROUP BY PK_ORG,ORGCODE,PK_CUSTOMER,KHBM,DJYF
)
SELECT TO_CHAR(ADD_MONTHS(SYSDATE,-1),'yyyy-mm') AS CKYF,
	MAX(DJYF) AS DJYF,
	PK_ORG,
	ORGCODE,
	MAX(ORGNAME) AS ORGNAME,
	B.GSDH,
	PK_CUSTOMER,
    KHBM,
	YWRYPK,
	MAX(YWRY) AS YWRY,
	MAX(KHMC) AS KHMC,
	COALESCE(MAX(BMMC1),MAX(BMMC)) AS BMMC,
	SUM(QCJE) AS QCJE,
	SUM(JSJE) AS JSJE,
	SUM(SKJE) AS SKJE,
	SUM(FKJE) AS FKJE,
	SUM(ZBS)   AS ZBS,
	SUM(ZDS)   AS ZDS,
	SUM(BS)   	AS BS,
	SUM(DS)   	AS DS,
	SUM(ZSBS)   AS ZSBS,
	SUM(ZSDS)   AS ZSDS,
	SUM(ZSDBBS) AS ZSDBBS,
	SUM(ZSDBDS) AS ZSDBDS,
	CASE WHEN SUM(abs(qcje)+abs(JSJE)+abs(SKJE)+abs(FKJE)+abs(ZBS))=0 THEN 1 ELSE 0 END AS DR,
	TO_CHAR(SYSDATE,'YYYY-MM-DD HH24:MI:SS')		AS UPDTIME
FROM TEMP2 A
LEFT JOIN (
	SELECT GSBM,MAX(GSDH) AS GSDH
	FROM BD_GSDH
	GROUP BY GSBM
)B
ON A.ORGCODE=B.GSBM
GROUP BY PK_ORG,ORGCODE,PK_CUSTOMER,KHBM,YWRYPK,B.GSDH

</sql>
