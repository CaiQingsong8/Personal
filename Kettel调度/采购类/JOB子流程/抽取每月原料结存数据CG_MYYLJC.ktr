  <step>
    <name>获取原料当天成本CG_MYYLJC</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>SELECT A.GSBM,A.GSMC,to_char(add_months(sysdate,-1),'yyyy-mm') QJ,
       CASE WHEN A.WLBM LIKE '34%' AND A.GSBM='1001'
                THEN NULL
            ELSE A.WLBM
           END WLBM,A.WLMC,A.GSJC,A.WLSX,A.class_code1,A.class_name1,
       NVL(P1.BYRK,0)+
		NVL(P2.BYRK,0)+NVL(P3.BYRK,0) as BYRK,
       NVL(k1.BYCK,0)+
		NVL(k2.BYCK,0)+NVL(k3.BYCK,0) as BYCK,
       case when NVL(k1.BYCK,0)+NVL(k2.BYCK,0)=0 then 0 else round((NVL(k1.BYCKJE,0)+NVL(k2.BYCKJE,0))/ (NVL(k1.BYCK,0)+NVL(k2.BYCK,0)),4) end AS CKDJ,--销售出库使用单价
       F2.QCJC,
       CASE WHEN F2.QCJC=0 THEN 0 ELSE ROUND(F2.QCJCJE/F2.QCJC,4) END AS QCJCDJ,
       F2.QCJCJE,
       F2.QMJC,
       F2.QCJC+NVL(P1.BYRK,0)+NVL(P2.BYRK,0)+NVL(P3.BYRK,0)-( NVL(k1.BYCK,0)+NVL(k2.BYCK,0)+NVL(k3.BYCK,0)) AS QMJC1,
       CASE WHEN F2.QMJC=0 THEN 0 ELSE ROUND(F2.QMJCJE/F2.QMJC,4) END AS QMJCDJ,
       F2.QMJCJE,


       round(NVL(I.YCSL,0)*1,3) YSYL
/*
--NVL(P.BYRK,0)*1+NVL(P1.BYRK,0)*1+NVL(P.CCPRK,0)*1 BYRK,
--NVL(K.BYCK,0)*1+NVL(K1.BYCK,0)*1+NVL(H.BYCK,0)*1 BYCK,
--NVL(E.BYRK,0)*1+NVL(E1.BYRK,0)*1+NVL(E2.CCPRK,0)*1+NVL(F2.QCSJ,0)*1-NVL(F.BYCK,0)*1-NVL(F1.BYCK,0)*1-NVL(H1.BYCK,0)*1 QMJC,
--NVL(E.BYRK,0)*1+NVL(E1.BYRK,0)*1+NVL(E2.CCPRK,0)*1+NVL(F2.QCSJ,0)*1-NVL(F.BYCK,0)*1-NVL(F1.BYCK,0)*1-NVL(H1.BYCK,0)*1+ NVL(K.BYCK,0)*1+NVL(K1.BYCK,0)*1- NVL(P.BYRK,0)*1-NVL(P1.BYRK,0)*1-NVL(P.CCPRK,0)*1 QCJC
--,round(NVL(I.YCSL1,0)*1,3) YSYL_old

MERGE INTO CG_MYYLJC A
USING (
    -- 这里放你原来的 K1、F1、F2 联合查询（去掉 A 表）
    SELECT
        A0.QJ,
        A0.GSBM,
        A0.WLBM,
        case when K.cksl=0 then 0 else ROUND(K.ckje / K.cksl, 4) end as CKDJ,
        F2.QMJC,
        CASE WHEN F2.QMJC = 0 THEN 0 ELSE ROUND(F2.QMJCJE / F2.QMJC, 4) END AS QMJCDJ,
        F2.QMJCJE,
        F1.QCJC,
        CASE WHEN F1.QCJC = 0 THEN 0 ELSE ROUND(F1.QCJCJE / F1.QCJC, 4) END AS QCJCDJ,
        F1.QCJCJE
    FROM CG_MYYLJC A0
             LEFT JOIN (
        SELECT
            SUBSTR(CKRQ,1,7) AS QJ, GSBM, WLBM,
            SUM(CKJE) as ckje ,
			SUM(SL)  AS cksl
        FROM F_QTCKD
        WHERE CKRQ >= TO_CHAR(ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -36), 'YYYY-MM') || '-01'
          AND CKRQ &lt;= TO_CHAR(LAST_DAY(ADD_MONTHS(SYSDATE, -1)), 'YYYY-MM-DD')
        GROUP BY SUBSTR(CKRQ,1,7), GSBM, WLBM
    ) K ON A0.GSBM = K.GSBM AND A0.WLBM = K.WLBM AND A0.QJ = K.QJ
             LEFT JOIN (
        SELECT kjqj AS QJ, GSBM, WLBM, SUM(JE) AS QMJCJE, SUM(zsl) AS QMJC
        FROM CG_CHYMJCB
        WHERE kjqj &lt;= TO_CHAR(ADD_MONTHS(SYSDATE, -1), 'YYYY-MM')
        GROUP BY GSBM, WLBM, kjqj
    ) F2 ON A0.GSBM = F2.GSBM AND A0.WLBM = F2.WLBM AND A0.QJ = F2.QJ
             LEFT JOIN (
        SELECT
            TO_CHAR(ADD_MONTHS(TO_DATE(kjqj, 'YYYY-MM'), 1), 'YYYY-MM') AS QJ,
            GSBM, WLBM,
            SUM(JE) AS QCJCJE,
            SUM(zsl) AS QCJC
        FROM CG_CHYMJCB
        GROUP BY GSBM, WLBM, kjqj
    ) F1 ON A0.GSBM = F1.GSBM AND A0.WLBM = F1.WLBM AND A0.QJ = F1.QJ
    where A0.QJ>=TO_CHAR(ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -36), 'YYYY-MM')
		and a0.wlbm is not null
and (K.cksl IS NOT NULL
   OR F2.QMJC IS NOT NULL
   OR F1.QCJC IS NOT NULL)
) SRC
ON (A.QJ = SRC.QJ AND A.GSBM = SRC.GSBM AND A.WLBM = SRC.WLBM)
WHEN MATCHED THEN
    UPDATE SET
               A.CKDJ = SRC.CKDJ,
               A.QMJC = SRC.QMJC,
               A.QMJCDJ = SRC.QMJCDJ,
               A.QMJCJE = SRC.QMJCJE,
               A.QCJC = SRC.QCJC,
               A.QCJCDJ = SRC.QCJCDJ,
               A.QCJCJE = SRC.QCJCJE;

*/


FROM
--公司、物料
(select A.GSBM,d.CORP_NAME GSMC,A.WLBM,b.MATERIAL_NAME WLMC,b.MATERIAL_ATTRIBUTE WLSX
 ,case when b.class_code1 is null and b.class_code4='3'  then '3'
       when b.class_code2='1'  and b.class_code4='12' then  '3'
       when b.class_code2='1'  then  '1'
       when b.class_code2='4'  then  '4'
       else b.class_code1 end as class_code1
 ,case when b.class_code1 is null and b.class_code4 in('3','12')  then '添加剂'
       when b.class_code2='1'  and b.class_code4='12' then  '添加剂'
       when b.class_code2='1'  then  '原料'
       when b.class_code2='4'  then  '包装物'
       when b.class_code1='4' then '外袋配件'  else b.class_name1
end as class_name1
,d.CORP_SNAME GSJC
 from  (
           SELECT GSBM,WLBM
           FROM F_CGZB
           WHERE SFJC='N'
		   and djrq>=to_char(add_months(sysdate,-4),'yyyy-mm')
             --AND( WLBM  LIKE '6%' OR WLBM LIKE '2%')
           GROUP BY GSBM,WLBM
           UNION
           SELECT GSBM,WLBM
           FROM KC_CCPRK1_CK
           where RQ>=to_char(add_months(sysdate,-4),'yyyy-mm')
             --AND( WLBM  LIKE '6%' OR WLBM LIKE '2%')
             --AND CKMC LIKE '%配料%'
           GROUP BY GSBM,WLBM
           UNION
           SELECT GSBM,WLBM
           FROM CG_CHYMJCB
           where kjqj>=to_char(add_months(sysdate,-4),'yyyy-mm')
             --AND( WLBM  LIKE '6%' OR WLBM LIKE '2%')
             --AND CKMC LIKE '%配料%'
           GROUP BY GSBM,WLBM
       ) A
           LEFT JOIN DIM_MATERIAL B
                     ON A.WLBM=B.MATERIAL_CODE

           LEFT JOIN DIM_UNIT D
                     ON A.GSBM=D.CORP_CODE
                         AND D.ORG_TYPE='公司'


) a


--期初库存
    LEFT JOIN
(
    SELECT  GSBM,WLBM
         ,SUM(case when kjqj=to_char(add_months(sysdate,-2),'yyyy-mm') then JE else 0 end )  as QCJCJE
         ,SUM(case when kjqj=to_char(add_months(sysdate,-2),'yyyy-mm') then zsl else 0 end ) as QCJC


         ,SUM(case when kjqj=to_char(add_months(sysdate,-1),'yyyy-mm') then JE else 0 end )  as QMJCJE
         ,SUM(case when kjqj=to_char(add_months(sysdate,-1),'yyyy-mm') then zsl else 0 end ) as QMJC

    FROM CG_CHYMJCB
    WHERE kjqj>= to_char(add_months(sysdate,-2),'yyyy-mm')
      and  kjqj&lt;= to_char(add_months(sysdate,-1),'yyyy-mm')
    group by GSBM,WLBM

) F2
ON A.GSBM = F2.GSBM AND A.WLBM = F2.WLBM

--本月预计用量
    LEFT JOIN
(
    SELECT YCRQ, GSBM,CLBM,max(WLSX) as WLSX,SUM(YCSL)+SUM(YCDJGSL) YCSL FROM
        (
            SELECT B.*,NVL(REPLACE(YCXL,' ',''),0)*NVL(B.SL,0) YCSL,NVL(REPLACE(YCDJGSL,' ',''),0)*NVL(B.SL,0) YCDJGSL,A.YCRQ
            FROM YC_XSJH A
                     LEFT JOIN (SELECT * FROM CB_BOMCF A
                                                  LEFT JOIN CG_WLSX B
                                                            ON A.CLBM=B.WLBM
                                WHERE A.QJ=to_char(sysdate,'YYYY-mm'))B
                               ON A.SCGSBM=B.GSBM
                                   AND A.CPBM=B.CPBM
            WHERE B.GSBM IS NOT NULL
              AND SUBSTR(A.YCRQ,1,7)=to_char(sysdate,'YYYY-mm')
        )
    WHERE 1=1
    GROUP BY GSBM,CLBM,YCRQ
)I
ON A.GSBM = I.GSBM AND A.WLBM = I.CLBM

    -----入库
--本月其他入库
    LEFT JOIN
(SELECT  GSBM,WLBM,SUM(ZSL) BYRK
 FROM F_QTRKD
 WHERE SUBSTR(RQ,1,7) = to_char(add_months(sysdate,-1),'yyyy-mm')
 and djlx&lt;&gt;'转库入库'
   --AND (CKMC LIKE '%配料%' )
 GROUP BY GSBM,WLBM
) P1
ON A.GSBM = P1.GSBM AND A.WLBM = P1.WLBM

--本月采购入库
    LEFT JOIN
(SELECT  GSBM,WLBM,SUM(SSZSL) BYRK
 FROM F_CGRKD
 WHERE SUBSTR(RKRQ,1,7) = to_char(add_months(sysdate,-1),'yyyy-mm')
   --AND (CKMC LIKE '%配料%' )
 GROUP BY GSBM,WLBM
) P2
ON A.GSBM = P2.GSBM AND A.WLBM = P2.WLBM
/*
--本月产成品入库
    LEFT JOIN
(SELECT  GSBM,CBDXBM,SUM(RKSL) BYRK
 FROM KC_CCPRK
 WHERE SUBSTR(DJRQ,1,7) = to_char(add_months(sysdate,-1),'yyyy-mm')

 GROUP BY GSBM,CBDXBM
) P3
ON A.GSBM = P3.GSBM AND A.WLBM = P3.CBDXBM
*/
--本月产成品入库1
    LEFT JOIN
(SELECT  GSBM,WLBM,SUM(RKSL) BYRK
 FROM KC_CCPRK1_CK
 WHERE SUBSTR(DJRQ,1,7) = to_char(add_months(sysdate,-1),'yyyy-mm')

 GROUP BY GSBM,WLBM
) P3
ON A.GSBM = P3.GSBM AND A.WLBM = P3.WLBM

    -----出库
--本月其他出库
    LEFT JOIN
(SELECT  GSBM,WLBM,SUM(SL) BYCK,SUM(CKJE)  AS BYCKJE
 FROM F_QTCKD
 WHERE CKRQ >= TO_CHAR(ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -1), 'YYYY-MM') || '-01'
   AND CKRQ &lt;= TO_CHAR(LAST_DAY(ADD_MONTHS(SYSDATE, -1)), 'YYYY-MM-DD')
   and billtypename&lt;&gt;'转库出库'
  -- AND (CKMC LIKE '%配料%' )
 GROUP BY GSBM,WLBM) K1
ON A.GSBM = K1.GSBM AND A.WLBM = K1.WLBM

--本月材料出库
    LEFT JOIN
(SELECT  GSBM,WLBM,SUM(ZSL) BYCK,SUM(CKJE)  AS BYCKJE

 FROM F_CLCKD
 WHERE CKRQ >= TO_CHAR(ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -1), 'YYYY-MM') || '-01'
   AND CKRQ &lt;= TO_CHAR(LAST_DAY(ADD_MONTHS(SYSDATE, -1)), 'YYYY-MM-DD')
   --AND (CKMC LIKE '%配料%' )
 GROUP BY GSBM,WLBM
) K2
ON A.GSBM = K2.GSBM AND A.WLBM = K2.WLBM

--本月销售出库
    LEFT JOIN
(SELECT  GSBM,WLBM,SUM(ZSL) BYCK
 FROM F_XSCKD
 WHERE DJRQ >= TO_CHAR(ADD_MONTHS(TRUNC(SYSDATE, 'MM'), -1), 'YYYY-MM') || '-01'
   AND DJRQ &lt;= TO_CHAR(LAST_DAY(ADD_MONTHS(SYSDATE, -1)), 'YYYY-MM-DD')
   --AND (CKMC LIKE '%配料%' )
 GROUP BY GSBM,WLBM)K3
ON A.GSBM = K3.GSBM AND A.WLBM = K3.WLBM

</sql>
