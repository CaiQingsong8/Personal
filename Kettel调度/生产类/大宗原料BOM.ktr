    </GUI>
  </step>
  <step>
    <name>插入本周数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>NC</connection>
    <sql>SELECT DISTINCT SUBSTR(TO_CHAR(SYSDATE,'YYYY-MM-DD'),1,4)||'-'||TO_CHAR(SYSDATE,'IW') AS ZS,A.*,B.DLBM,B.DLMC FROM 
(
SELECT GSBM,GSMC,pfh,CPBM,CPMC,CLBM,
CASE WHEN CPCL&lt;&gt;'1'
  THEN CLZSL/CPCL
    ELSE CLZSL
      END SL FROM 
(
SELECT DISTINCT GSBM,
                GSMC,
                pfh,
                BSWLBM CPBM,
                BSWLMC CPMC,
                BSZSL CPCL,
                (CASE
                  WHEN DLBM IS NULL and DZ IS NOT NULL THEN   --袋子
                   DZ
                  WHEN DLBM IS NULL and DZ IS NULL and xlbm is not null THEN  --添加剂小料
                   XLBM
                  WHEN DLBM IS NULL and DZ IS NULL and xlbm is null THEN  --小料中的小料
                   CLBM
                  else
                   dlbm                                                   --大料配方材料
                end) CLBM,
                
                (CASE
                  WHEN DLZSL IS NULL and DZSL IS NOT NULL THEN           --袋子数量
                   DZSL
                  WHEN DLZSL IS NULL and DZSL IS NULL AND XLZSL IS NOT NULL THEN 
                   (XLZSL * DLBXZSL / XLBSZSL)*(BSZSL/DLBSZSL)  --3*1/1/1.5 1.5吨耗量  210*135/240/1.5
                  WHEN DLZSL IS NULL and DZSL IS NULL AND XLZSL IS NULL THEN
                   CLZSL * XLBXZSL / CLBSZSL
                  else
                   dlZSL*BSZSL/DLBSZSL
                end) clZSL

  from (
  
  
  SELECT distinct A.GSBM,
                        A.GSMC,
                        A.BSWLBM,
                        A.BSWLMC,
                        A.BSZSL,
                        A.pfh,
                        B.BSZSL DLBSZSL,
                        (CASE
                          WHEN (B.WLBM LIKE '32%' OR B.WLBM LIKE '39%' OR
                               B.WLBM LIKE '33%') THEN
                           B.BXZSL
                          WHEN (B.WLBM IN ('3100000013',
                                           '3100000001',
                                           '3100000017',
                                           '3100000009',
                                           '3100000018') AND B.GSBM = '1007') THEN
                           B.BXZSL
                        
                          WHEN (B.WLBM = '3100000001' AND B.GSBM = '1008') THEN
                           B.BXZSL
                        
                          WHEN (B.WLBM IN ('3100000013', '3100000001') AND
                               B.GSBM = '1002') THEN
                           B.BXZSL
                        
                          WHEN (B.WLBM IN ('3100000001', '3100000002') AND
                               B.GSBM = '1001') THEN
                           B.BXZSL
                        
                          ELSE
                           NULL
                        END) DLBXZSL,
                        
                        C.BSZSL XLBSZSL,
                        
                        (CASE
                          WHEN (C.WLBM LIKE '32%' OR C.WLBM LIKE '39%' OR
                               C.WLBM LIKE '33%' OR C.WLBM LIKE '34%') THEN
                           C.BXZSL
                          ELSE
                           NULL
                        END) XLBXZSL,
                        
                        D.BSZSL CLBSZSL,
                        
                        (CASE
                          WHEN A.WLBM LIKE '5%' THEN
                           NULL
                          ELSE
                           A.WLBM
                        END) DZ,
                        
                        (CASE
                          WHEN A.WLBM LIKE '5%' THEN
                           NULL
                          ELSE
                           A.BXZSL
                        END) DZSL,
                        
                        (CASE
                          WHEN (B.WLBM LIKE '32%' OR B.WLBM LIKE '39%' OR
                               B.WLBM LIKE '33%') THEN
                           NULL
                          WHEN (B.WLBM IN ('3100000013',
                                           '3100000001',
                                           '3100000017',
                                           '3100000009',
                                           '3100000018') AND B.GSBM = '1007') THEN
                           NULL
                        
                          WHEN (B.WLBM = '3100000001' AND B.GSBM = '1008') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000013', '3100000001') AND
                               B.GSBM = '1002') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000001', '3100000002') AND
                               B.GSBM = '1001') THEN
                           NULL
                          ELSE
                           B.WLBM
                        END) DLBM,
                        
                        (CASE
                          WHEN (B.WLBM LIKE '32%' OR B.WLBM LIKE '39%' OR
                               B.WLBM LIKE '33%') THEN
                           NULL
                          WHEN (B.WLBM IN ('3100000013',
                                           '3100000001',
                                           '3100000017',
                                           '3100000009',
                                           '3100000018') AND B.GSBM = '1007') THEN
                           NULL
                          WHEN (B.WLBM = '3100000001' AND B.GSBM = '1008') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000013', '3100000001') AND
                               B.GSBM = '1002') THEN
                           NULL
                        
                          WHEN (B.WLBM IN ('3100000001', '3100000002') AND
                               B.GSBM = '1001') THEN
                           NULL
                          ELSE
                           B.BXZSL
                        END) DLZSL,
                        
                        (CASE
                          WHEN C.WLBM LIKE '3%' AND C.WLBM NOT LIKE '34%' THEN
                           NULL
                          ELSE
                           C.WLBM
                        END) XLBM,
                        
                        (CASE
                          WHEN C.WLBM LIKE '3%' AND C.WLBM NOT LIKE '34%' THEN
                           NULL
                          ELSE
                           C.BXZSL
                        END) XLZSL,
                        
                        D.WLBM  CLBM,
                        D.BXZSL CLZSL
          FROM (select a2.code          gsbm,
                       A2.NAME          GSMC, --计划组织编码
                       a2.shortname     gsjc, --计划组织姓名
                       a1.code          bswlbm, --主表物料编码
                       a1.name          bswlmc, --主表物料名称
                       a4.hnparentnum   bszsl, --bom主表主数量
                       a4.hversion      bsbm, --bom主表版本
                       a3.name          bszdw, --bom主表物料主单位
                       b1.code          wlbm, --bom附表物料编码
                       b1.name          wlmc, --bom附表物料名称
                       b1.materialtype  wlxh, -- 型号
                       b2.nitemnum      bxzsl, --bom附表主数量
                       a4.hfversiontype, --版本类型
                       a4.hbdefault, --是否默认
                       a4.hvdef1  pfh --配方号
                  from bd_bom a4 --bom主表
                  left join org_orgs_v a2 --计划组织
                    on a4.pk_org = a2.pk_org
                  left join bd_material a1 --物料信息
                    on a4.hcmaterialid = a1.pk_material
                  left join bd_measdoc a3 --单位
                    on a4.hcmeasureid = a3.pk_measdoc
                  left join bd_bom_b b2 --bom附表
                    on a4.cbomid = b2.cbomid
                  left join bd_material b1 --物料信息
                    on b2.cmaterialid = b1.pk_material
                 where a4.dr = '0'
                   AND B2.DR='0'
                 --   AND a4. hvdef3='1001A2100000007TZY0S' --代工
                   AND  a4.hbdefault='Y'
                   AND A4.fbillstatus='1'
                   AND a1.code LIKE '2%'
                   AND A4.hfversiontype='1'
                    AND   b1.code   NOT LIKE '38%'
           --     AND A1.CODE='2202030010'
             --    AND a2.code='1012'
                ) A
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                     AND B2.DR='0'
                   -- AND a4. hvdef3='1001A2100000007TZY0S' --代工
                       AND a4.hbdefault='Y'
                       AND A4.fbillstatus='1'
                       AND A4.hfversiontype='1'
                       AND a1.code LIKE '5%'
                --     AND A1.CODE='5202030014'
                    ) B
            ON A.WLBM = B.BSWLBM
           AND A.GSBM = B.GSBM
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码         
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                      --  AND a4. hvdef3='1001A2100000007TZY0S' --代工
                       AND  a4.hbdefault='Y'
                       AND A4.fbillstatus='1'
                       AND A4.hfversiontype='1'
                                AND a1.code LIKE '3%'
                       ) C
            ON B.WLBM = C.BSWLBM
           AND B.GSBM = C.GSBM
           AND A.GSBM = C.GSBM
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码        
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                     --  AND a4. hvdef3='1001A2100000007TZY0S' --代工
                       AND  a4.hbdefault='Y'
                       AND A4.fbillstatus='1'
                       AND A4.hfversiontype='1'
                       AND a1.code LIKE '3%'
                       ) D
            ON C.WLBM = D.BSWLBM
           AND C.GSBM = D.GSBM
         
           )
 where (CASE
         WHEN DLBM IS NULL and DZ IS NOT NULL THEN
          DZ
         WHEN DLBM IS NULL and DZ IS NULL and xlbm is not null THEN
          XLBM
         WHEN DLBM IS NULL and DZ IS NULL and xlbm is null THEN
          CLBM
         else
          dlbm
       end) is not null
   /*    AND 
       (CASE
         WHEN DLBM IS NULL and DZ IS NOT NULL THEN
          DZ
         WHEN DLBM IS NULL and DZ IS NULL and xlbm is not null THEN
          XLBM
         WHEN DLBM IS NULL and DZ IS NULL and xlbm is null THEN
          CLBM
         else
          dlbm
       end) NOT LIKE '4%'*/
   
 ORDER BY GSBM,GSMC,BSWLBM
)


UNION ALL


---------------------------------------------------------------------------------
SELECT DISTINCT GSBM,GSMC,PFH,BSWLBM CPBM,BSWLMC CPMC,
CASE WHEN BXZSL IS NOT NULL
THEN WLBM  ---2开头的材料
WHEN DLBXZSL1 IS NOT NULL
THEN WLBM1 --3开头的材料
WHEN XLBXZSL2 IS NOT NULL
THEN WLBM2 --5开头的材料
WHEN BXZSL3 IS NOT NULL
THEN WLBM3 --32开头的材料
END CLBM,

CASE WHEN BXZSL IS NOT NULL
THEN BXZSL  ---2开头的材料
WHEN DLBXZSL1 IS NOT NULL
THEN DLBXZSL1 --3开头的材料
WHEN XLBXZSL2 IS NOT NULL
THEN XLBXZSL2 --5开头的材料
WHEN BXZSL3 IS NOT NULL
THEN BXZSL3 --32开头的材料
END SL


  FROM
  
(  
  SELECT 
A.GSBM,A.GSMC,A.GSJC,A.PFH,A.BSWLBM,A.BSWLMC,A.BSZSL,
  A.WLBM,A.WLMC,
  CASE WHEN A.WLBM LIKE '38%'
    THEN NULL
      ELSE A.BXZSL
       END BXZSL,
       
       B.BSWLBM BSWLBM1,
       B.BSWLMC BSWLMC1,
       B.BSZSL BSZSL1,
       B.WLBM WLBM1,
       B.WLMC WLMC1,
       CASE WHEN B.WLBM LIKE '5%'
         THEN NULL
           ELSE B.BXZSL
             END DLBXZSL1,
           
            --------------- 
               B1.BSWLBM BSWLBM2,
               B1.BSWLMC BSWLMC2,
               B1.BSZSL BSZSL2,
               B1.WLBM WLBM2,
               B1.WLMC WLMC2,
       CASE WHEN B1.WLBM LIKE '32%'
         THEN NULL
           ELSE B1.BXZSL
             END XLBXZSL2,
       ------------------      
               C.BSWLBM BSWLBM3,
               C.BSWLMC BSWLMC3,
               C.BSZSL BSZSL3,
               C.WLBM WLBM3,
               C.WLMC WLMC3,
               C.BXZSL BXZSL3
             
          FROM (
          select a2.code          gsbm,
                       A2.NAME          GSMC, --计划组织编码
                       a2.shortname     gsjc, --计划组织姓名
                       a1.code          bswlbm, --主表物料编码
                       a1.name          bswlmc, --主表物料名称
                       a4.hnparentnum   bszsl, --bom主表主数量
                       a4.hversion      bsbm, --bom主表版本
                       a3.name          bszdw, --bom主表物料主单位
                       b1.code          wlbm, --bom附表物料编码
                       b1.name          wlmc, --bom附表物料名称
                       b1.materialtype  wlxh, -- 型号
                       b2.nitemnum      bxzsl, --bom附表主数量
                       a4.hfversiontype, --版本类型
                       a4.hbdefault, --是否默认
                       a4.hvdef1  pfh --配方号
                  from bd_bom a4 --bom主表
                  left join org_orgs_v a2 --计划组织
                    on a4.pk_org = a2.pk_org
                  left join bd_material a1 --物料信息
                    on a4.hcmaterialid = a1.pk_material
                  left join bd_measdoc a3 --单位
                    on a4.hcmeasureid = a3.pk_measdoc
                  left join bd_bom_b b2 --bom附表
                    on a4.cbomid = b2.cbomid
                  left join bd_material b1 --物料信息
                    on b2.cmaterialid = b1.pk_material
                 where a4.dr = '0'
                   AND B2.DR='0'
                   AND  a4.hbdefault='Y'
                   AND A4.fbillstatus='1'
                   AND a1.code LIKE '2%'
                   AND A4.hfversiontype='1'
             --   AND A1.CODE='2102030075'
            --    AND a2.code='1013'
                AND   b1.code  LIKE '38%'
                ) A
          LEFT JOIN (
          
          select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           case when  a1.code like '38%'
                             THEN a4.hnparentnum/1000
                               ELSE
                           a4.hnparentnum END   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           case when  a1.code like '38%'
                             THEN '吨'
                               ELSE
                           a3.name   end       bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                            -- AND a4. hvdef3='1001A2100000007TZY0S' --代工
                       AND a4.hbdefault='Y'
                       AND A4.fbillstatus='1'
                       AND A4.hfversiontype='1'
                         AND (a1.code LIKE '5%' OR a1.code LIKE '38%')
                --     AND A1.CODE='5202030014'
                       
                       
               --      AND A1.CODE='3800000003'
                    ) B
            ON A.WLBM = B.BSWLBM
           AND A.GSBM = B.GSBM
             LEFT JOIN (
          
          select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name         bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                                 -- AND a4. hvdef3='1001A2100000007TZY0S' --代工
                       AND a4.hbdefault='Y'
                       AND A4.fbillstatus='1'
                       AND A4.hfversiontype='1'
                       AND (a1.code LIKE '5%')
             --        AND A1.CODE='5204020039'
                    ) B1
            ON B.WLBM = B1.BSWLBM
           AND B.GSBM = B1.GSBM
           
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码         
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                             -- AND a4. hvdef3='1001A2100000007TZY0S' --代工
                       AND a4.hbdefault='Y'
                       AND A4.fbillstatus='1'
                       AND A4.hfversiontype='1'
                                AND (a1.code LIKE '3%' OR  a1.code LIKE '5%')
                       ) C
            ON B1.WLBM = C.BSWLBM
           AND B1.GSBM = C.GSBM
           AND A.GSBM = C.GSBM
          LEFT JOIN (select a2.code          gsbm,
                           A2.NAME          GSMC, --计划组织编码        
                           a2.shortname     gsjc, --计划组织姓名
                           a1.code          bswlbm, --主表物料编码
                           a1.name          bswlmc, --主表物料名称
                           a4.hnparentnum   bszsl, --bom主表主数量
                           a4.hversion      bsbm, --bom主表版本
                           a3.name          bszdw, --bom主表物料主单位
                           b1.code          wlbm, --bom附表物料编码
                           b1.name          wlmc, --bom附表物料名称
                           b1.materialtype  wlxh, -- 型号
                           b2.nitemnum      bxzsl, --bom附表主数量
                           a4.hfversiontype, --版本类型
                           a4.hbdefault --是否默认
                    
                      from bd_bom a4 --bom主表
                      left join org_orgs_v a2 --计划组织
                        on a4.pk_org = a2.pk_org
                      left join bd_material a1 --物料信息
                        on a4.hcmaterialid = a1.pk_material
                      left join bd_measdoc a3 --单位
                        on a4.hcmeasureid = a3.pk_measdoc
                      left join bd_bom_b b2 --bom附表
                        on a4.cbomid = b2.cbomid
                      left join bd_material b1 --物料信息
                        on b2.cmaterialid = b1.pk_material
                     where a4.dr = '0'
                      AND B2.DR='0'
                                 -- AND a4. hvdef3='1001A2100000007TZY0S' --代工
                       AND a4.hbdefault='Y'
                       AND A4.fbillstatus='1'
                       AND A4.hfversiontype='1'
                       AND a1.code LIKE '3%'
                       ) D
            ON C.WLBM = D.BSWLBM
           AND C.GSBM = D.GSBM
         )
) A
LEFT JOIN 
(
SELECT A.CODE WLBM,A.NAME WLMC,C.CODE DLBM,C.NAME DLMC FROM BD_MATERIAL A
LEFT JOIN bd_marbasclass B
ON A.pk_marbasclass=B.pk_marbasclass 
LEFT JOIN bd_marbasclass C
ON B.pk_parent =C.pk_marbasclass 
WHERE C.CODE LIKE '2%'
) B
ON A.CPBM=B.WLBM


 </sql>
