    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>fbuser</connection>
    <sql>SELECT KHMC,YXZJH,YLXL,XXLXL,ZLXL,NSYHLXL,KHLB,to_char(sysdate,'yyyy-mm')rq,
CASE
WHEN KHLB = '鱼料'THEN (CASE WHEN YLXL >= 1000 THEN 'A'WHEN YLXL >= 800 THEN 'B'WHEN YLXL >= 500 THEN 'C'WHEN YLXL >= 200 THEN 'D'ELSE 'E'END)
WHEN KHLB = '虾蟹料'THEN (CASE WHEN XXLXL >= 500 THEN 'A'WHEN XXLXL >= 400 THEN 'B'WHEN XXLXL >= 250 THEN 'C'WHEN XXLXL >= 100 THEN 'D'ELSE 'E'END) 
WHEN KHLB = '猪料'THEN (CASE WHEN ZLXL >= 200 THEN 'A'WHEN ZLXL >= 150 THEN 'B'WHEN ZLXL >= 100 THEN 'C'WHEN ZLXL >= 50 THEN 'D'ELSE 'E'END)
WHEN KHLB = '浓缩预混料'THEN (CASE WHEN NSYHLXL >= 40 THEN 'A'WHEN NSYHLXL >= 30 THEN 'B'WHEN NSYHLXL >= 20 THEN 'C'WHEN NSYHLXL >= 10 THEN 'D'ELSE 'E'END)
ELSE '' END KHDJ
FROM (
WITH AA AS
(
SELECT DISTINCT YXZJH,KHMC FROM F_SALES
WHERE (WLFLBM LIKE '21%' OR WLFLBM LIKE '22%')
AND DBILLDATE &lt;= TO_CHAR(SYSDATE,'YYYY-MM-DD') AND DBILLDATE >= TO_CHAR(ADD_MONTHS(SYSDATE,-12),'YYYY-MM-DD')
AND BLARGESSFLAG = 'N'
AND KHFLBM &lt;&gt; 'K2'
AND KHMC &lt;&gt; '东莞市年丰饲料有限公司'
AND KHMC &lt;&gt; '浙江澳凌水产种业科技有限公司'
AND GSMC NOT IN ('深圳市澳华农牧有限公司天津分公司','江苏红膏饲料有限公司', 
'攀枝花澳华饲料有限公司','营口澳华农牧科技有限公司', '深圳市澳华农牧有限公司长沙分公司',
'深圳市澳华农牧有限公司长沙分公司','江苏红膏饲料有限公司','河南澳华饲料有限公司')
),
BB AS
(
SELECT YXZJH,KHMC,SUM(TYNUM) YLXL FROM F_SALES
WHERE SJFLBM IN ('2201','2202','2203')--鱼料
AND DBILLDATE &lt;= TO_CHAR(SYSDATE,'YYYY-MM-DD') AND DBILLDATE >= TO_CHAR(ADD_MONTHS(SYSDATE,-12),'YYYY-MM-DD')
AND BLARGESSFLAG = 'N'
AND KHFLBM &lt;&gt; 'K2'
AND KHMC &lt;&gt; '东莞市年丰饲料有限公司'
AND KHMC &lt;&gt; '浙江澳凌水产种业科技有限公司'
AND GSMC NOT IN ('深圳市澳华农牧有限公司天津分公司','江苏红膏饲料有限公司', 
'攀枝花澳华饲料有限公司','营口澳华农牧科技有限公司', '深圳市澳华农牧有限公司长沙分公司',
'深圳市澳华农牧有限公司长沙分公司','江苏红膏饲料有限公司','河南澳华饲料有限公司')
GROUP BY YXZJH,KHMC
),
CC AS
(
SELECT YXZJH,KHMC,SUM(TYNUM) XXLXL FROM F_SALES
WHERE SJFLBM IN ('2204','2205')--虾蟹料
AND DBILLDATE &lt;= TO_CHAR(SYSDATE,'YYYY-MM-DD') AND DBILLDATE >= TO_CHAR(ADD_MONTHS(SYSDATE,-12),'YYYY-MM-DD')
AND BLARGESSFLAG = 'N'
AND KHFLBM &lt;&gt; 'K2'
AND KHMC &lt;&gt; '东莞市年丰饲料有限公司'
AND KHMC &lt;&gt; '浙江澳凌水产种业科技有限公司'
AND GSMC NOT IN ('深圳市澳华农牧有限公司天津分公司','江苏红膏饲料有限公司', 
'攀枝花澳华饲料有限公司','营口澳华农牧科技有限公司', '深圳市澳华农牧有限公司长沙分公司',
'深圳市澳华农牧有限公司长沙分公司','江苏红膏饲料有限公司','河南澳华饲料有限公司')
GROUP BY YXZJH,KHMC
),
DD AS
(
SELECT YXZJH,KHMC,SUM(TYNUM) ZLXL FROM F_SALES
WHERE SJFLBM IN ('2101')--猪料
AND DBILLDATE &lt;= TO_CHAR(SYSDATE,'YYYY-MM-DD') AND DBILLDATE >= TO_CHAR(ADD_MONTHS(SYSDATE,-12),'YYYY-MM-DD')
AND BLARGESSFLAG = 'N'
AND KHFLBM &lt;&gt; 'K2'
AND KHMC &lt;&gt; '东莞市年丰饲料有限公司'
AND KHMC &lt;&gt; '浙江澳凌水产种业科技有限公司'
AND GSMC NOT IN ('深圳市澳华农牧有限公司天津分公司','江苏红膏饲料有限公司', 
'攀枝花澳华饲料有限公司','营口澳华农牧科技有限公司', '深圳市澳华农牧有限公司长沙分公司',
'深圳市澳华农牧有限公司长沙分公司','江苏红膏饲料有限公司','河南澳华饲料有限公司')
GROUP BY YXZJH,KHMC
),
EE AS
(
SELECT YXZJH,KHMC,SUM(TYNUM) NSYHLXL FROM F_SALES
WHERE SJFLBM IN ('2102')--浓缩预混料
AND DBILLDATE &lt;= TO_CHAR(SYSDATE,'YYYY-MM-DD') AND DBILLDATE >= TO_CHAR(ADD_MONTHS(SYSDATE,-12),'YYYY-MM-DD')
AND BLARGESSFLAG = 'N'
AND KHFLBM &lt;&gt; 'K2'
AND KHMC &lt;&gt; '东莞市年丰饲料有限公司'
AND KHMC &lt;&gt; '浙江澳凌水产种业科技有限公司'
AND GSMC NOT IN ('深圳市澳华农牧有限公司天津分公司','江苏红膏饲料有限公司', 
'攀枝花澳华饲料有限公司','营口澳华农牧科技有限公司', '深圳市澳华农牧有限公司长沙分公司',
'深圳市澳华农牧有限公司长沙分公司','江苏红膏饲料有限公司','河南澳华饲料有限公司')
GROUP BY YXZJH,KHMC
)
SELECT AA.YXZJH,AA.KHMC,BB.YLXL,CC.XXLXL,DD.ZLXL,EE.NSYHLXL,
CASE WHEN 
GREATEST(nvl(BB.YLXL,0),nvl(CC.XXLXL,0),
nvl(DD.ZLXL,0),nvl(EE.NSYHLXL,0) )= BB.YLXL THEN '鱼料'
WHEN 
GREATEST(nvl(BB.YLXL,0),nvl(CC.XXLXL,0),
nvl(DD.ZLXL,0),nvl(EE.NSYHLXL,0) )= CC.XXLXL THEN '虾蟹料'
WHEN 
GREATEST(nvl(BB.YLXL,0),nvl(CC.XXLXL,0),
nvl(DD.ZLXL,0),nvl(EE.NSYHLXL,0) )= DD.ZLXL THEN '猪料'
WHEN
GREATEST(nvl(BB.YLXL,0),nvl(CC.XXLXL,0),
nvl(DD.ZLXL,0),nvl(EE.NSYHLXL,0) )= EE.NSYHLXL THEN '浓缩预混料'
ELSE '' END KHLB FROM AA
LEFT JOIN BB
ON AA.YXZJH = BB.YXZJH AND AA.KHMC = BB.KHMC
LEFT JOIN CC
ON AA.YXZJH = CC.YXZJH AND AA.KHMC = CC.KHMC
LEFT JOIN DD
ON AA.YXZJH = DD.YXZJH AND AA.KHMC = DD.KHMC
LEFT JOIN EE
ON AA.YXZJH = EE.YXZJH AND AA.KHMC = EE.KHMC
)</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
