}
================================
import resp

if (body?.monthDt) { body.monthDt = body.monthDt.split(",") }
if (body?.Corp) { body.Corp = body.Corp.split(",") }


var Corp = body?.Corp ? body.Corp.toString() : ""
var thisYear = body?.monthDt ? Integer.parseInt(body.monthDt[0].substring(0, 4)) : 2026
var thisMonth = body?.monthDt ? Integer.parseInt(body.monthDt[0].substring(5, 7)) : 4
var lastYear = thisYear - 1
var last2Year= thisYear - 2
var last3Year= thisYear - 3
var last4Year= thisYear - 4
var last5Year= thisYear - 5




list = db.FRCK.select("""

WITH
    #{body?.monthDt} AS param_month1,
    substr(param_month1, 1, 7) AS param_month,
    substr(param_month, 1, 4) AS this_year,
    substr(param_month, 6, 2) AS this_month_str,
    toInt32(this_month_str) AS this_month_int,
    toString(toInt32(this_year) - 1) AS last_year,
    toString(toInt32(this_year) - 2) AS last2_year,
    toString(toInt32(this_year) - 3) AS last3_year,
    toString(toInt32(this_year) - 4) AS last4_year,
    toString(toInt32(this_year) - 5) AS last5_year,
temp as(
    select
        d_subject_name,
        -- 本年各月（最多12列，按月份动态有值）
        round(sumIf(f_creditamount, years = this_year AND months = '01') / 10000, 2) as cy1,
        round(sumIf(f_creditamount, years = this_year AND months = '02') / 10000, 2) as cy2,
        round(sumIf(f_creditamount, years = this_year AND months = '03') / 10000, 2) as cy3,
        round(sumIf(f_creditamount, years = this_year AND months = '04') / 10000, 2) as cy4,
        round(sumIf(f_creditamount, years = this_year AND months = '05') / 10000, 2) as cy5,
        round(sumIf(f_creditamount, years = this_year AND months = '06') / 10000, 2) as cy6,
        round(sumIf(f_creditamount, years = this_year AND months = '07') / 10000, 2) as cy7,
        round(sumIf(f_creditamount, years = this_year AND months = '08') / 10000, 2) as cy8,
        round(sumIf(f_creditamount, years = this_year AND months = '09') / 10000, 2) as cy9,
        round(sumIf(f_creditamount, years = this_year AND months = '10') / 10000, 2) as cy10,
        round(sumIf(f_creditamount, years = this_year AND months = '11') / 10000, 2) as cy11,
        round(sumIf(f_creditamount, years = this_year AND months = '12') / 10000, 2) as cy12,
        -- 本年累计
        round(sumIf(f_creditamount, years = this_year AND toInt32(months) <= this_month_int) / 10000, 2) as cytotal,
        -- 去年各月
        round(sumIf(f_creditamount, years = last_year AND months = '01') / 10000, 2) as ly1,
        round(sumIf(f_creditamount, years = last_year AND months = '02') / 10000, 2) as ly2,
        round(sumIf(f_creditamount, years = last_year AND months = '03') / 10000, 2) as ly3,
        round(sumIf(f_creditamount, years = last_year AND months = '04') / 10000, 2) as ly4,
        round(sumIf(f_creditamount, years = last_year AND months = '05') / 10000, 2) as ly5,
        round(sumIf(f_creditamount, years = last_year AND months = '06') / 10000, 2) as ly6,
        round(sumIf(f_creditamount, years = last_year AND months = '07') / 10000, 2) as ly7,
        round(sumIf(f_creditamount, years = last_year AND months = '08') / 10000, 2) as ly8,
        round(sumIf(f_creditamount, years = last_year AND months = '09') / 10000, 2) as ly9,
        round(sumIf(f_creditamount, years = last_year AND months = '10') / 10000, 2) as ly10,
        round(sumIf(f_creditamount, years = last_year AND months = '11') / 10000, 2) as ly11,
        round(sumIf(f_creditamount, years = last_year AND months = '12') / 10000, 2) as ly12,
        -- 去年同期累计
        round(sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int) / 10000, 2) as lytotal,
        -- 累计变动 = 本年累计 - 去年同期
        round(
            sumIf(f_creditamount, years = this_year AND toInt32(months) <= this_month_int) / 10000 -
            sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int) / 10000
        , 2) as difftotal,
        -- 累计增幅
        round(
            if(sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int) = 0, 0,
               100 * (sumIf(f_creditamount, years = this_year AND toInt32(months) <= this_month_int) -
                      sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int)) /
               sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int)
            )
        , 2) as yoyrate,
        --历史年分
        round(sumIf(f_creditamount, years = last2_year ) / 10000, 2) as last2year,
        round(sumIf(f_creditamount, years = last3_year ) / 10000, 2) as last3year,
        round(sumIf(f_creditamount, years = last4_year ) / 10000, 2) as last4year,
        round(sumIf(f_creditamount, years = last5_year ) / 10000, 2) as last5year
    from dwd_gl_balance
    <where>
        1=1
        AND years >= last5_year
        AND d_subject_code like '2221%'
        AND rn = 1
        AND months <> '00'
        <if test="body?.Corp != null and body?.Corp != ''">
            AND d_corp_code IN (#{body?.Corp})
        </if>
    </where>

    group by d_subject_name

    union all

    -- 合计行
    select
        '合计' as d_subject_name,
           -- 本年各月（最多12列，按月份动态有值）
        round(sumIf(f_creditamount, years = this_year AND months = '01') / 10000, 2) as cy1,
        round(sumIf(f_creditamount, years = this_year AND months = '02') / 10000, 2) as cy2,
        round(sumIf(f_creditamount, years = this_year AND months = '03') / 10000, 2) as cy3,
        round(sumIf(f_creditamount, years = this_year AND months = '04') / 10000, 2) as cy4,
        round(sumIf(f_creditamount, years = this_year AND months = '05') / 10000, 2) as cy5,
        round(sumIf(f_creditamount, years = this_year AND months = '06') / 10000, 2) as cy6,
        round(sumIf(f_creditamount, years = this_year AND months = '07') / 10000, 2) as cy7,
        round(sumIf(f_creditamount, years = this_year AND months = '08') / 10000, 2) as cy8,
        round(sumIf(f_creditamount, years = this_year AND months = '09') / 10000, 2) as cy9,
        round(sumIf(f_creditamount, years = this_year AND months = '10') / 10000, 2) as cy10,
        round(sumIf(f_creditamount, years = this_year AND months = '11') / 10000, 2) as cy11,
        round(sumIf(f_creditamount, years = this_year AND months = '12') / 10000, 2) as cy12,
        -- 本年累计
        round(sumIf(f_creditamount, years = this_year AND toInt32(months) <= this_month_int) / 10000, 2) as cytotal,
        -- 去年各月
        round(sumIf(f_creditamount, years = last_year AND months = '01') / 10000, 2) as ly1,
        round(sumIf(f_creditamount, years = last_year AND months = '02') / 10000, 2) as ly2,
        round(sumIf(f_creditamount, years = last_year AND months = '03') / 10000, 2) as ly3,
        round(sumIf(f_creditamount, years = last_year AND months = '04') / 10000, 2) as ly4,
        round(sumIf(f_creditamount, years = last_year AND months = '05') / 10000, 2) as ly5,
        round(sumIf(f_creditamount, years = last_year AND months = '06') / 10000, 2) as ly6,
        round(sumIf(f_creditamount, years = last_year AND months = '07') / 10000, 2) as ly7,
        round(sumIf(f_creditamount, years = last_year AND months = '08') / 10000, 2) as ly8,
        round(sumIf(f_creditamount, years = last_year AND months = '09') / 10000, 2) as ly9,
        round(sumIf(f_creditamount, years = last_year AND months = '10') / 10000, 2) as ly10,
        round(sumIf(f_creditamount, years = last_year AND months = '11') / 10000, 2) as ly11,
        round(sumIf(f_creditamount, years = last_year AND months = '12') / 10000, 2) as ly12,
        -- 去年同期累计
        round(sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int) / 10000, 2) as lytotal,
        -- 累计变动 = 本年累计 - 去年同期
        round(
            sumIf(f_creditamount, years = this_year AND toInt32(months) <= this_month_int) / 10000 -
            sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int) / 10000
        , 2) as difftotal,
        -- 累计增幅
        round(
            if(sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int) = 0, 0,
               100 * (sumIf(f_creditamount, years = this_year AND toInt32(months) <= this_month_int) -
                      sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int)) /
               sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int)
            )
        , 2) as yoyrate,
        --历史年分
        round(sumIf(f_creditamount, years = last2_year ) / 10000, 2) as last2year,
        round(sumIf(f_creditamount, years = last3_year ) / 10000, 2) as last3year,
        round(sumIf(f_creditamount, years = last4_year ) / 10000, 2) as last4year,
        round(sumIf(f_creditamount, years = last5_year ) / 10000, 2) as last5year
    from dwd_gl_balance
    <where>
        1=1
        AND years >= last5_year
        AND d_subject_code like '2221%'
        AND rn = 1
        AND months <> '00'
        <if test="body?.Corp != null and body?.Corp != ''">
            AND d_corp_code IN (#{body?.Corp})
        </if>
    </where> 

    union all

    -- 收入
    select
        '收入' as d_subject_name,
           -- 本年各月（最多12列，按月份动态有值）
        round(sumIf(f_creditamount, years = this_year AND months = '01') / 10000, 2) as cy1,
        round(sumIf(f_creditamount, years = this_year AND months = '02') / 10000, 2) as cy2,
        round(sumIf(f_creditamount, years = this_year AND months = '03') / 10000, 2) as cy3,
        round(sumIf(f_creditamount, years = this_year AND months = '04') / 10000, 2) as cy4,
        round(sumIf(f_creditamount, years = this_year AND months = '05') / 10000, 2) as cy5,
        round(sumIf(f_creditamount, years = this_year AND months = '06') / 10000, 2) as cy6,
        round(sumIf(f_creditamount, years = this_year AND months = '07') / 10000, 2) as cy7,
        round(sumIf(f_creditamount, years = this_year AND months = '08') / 10000, 2) as cy8,
        round(sumIf(f_creditamount, years = this_year AND months = '09') / 10000, 2) as cy9,
        round(sumIf(f_creditamount, years = this_year AND months = '10') / 10000, 2) as cy10,
        round(sumIf(f_creditamount, years = this_year AND months = '11') / 10000, 2) as cy11,
        round(sumIf(f_creditamount, years = this_year AND months = '12') / 10000, 2) as cy12,
        -- 本年累计
        round(sumIf(f_creditamount, years = this_year AND toInt32(months) <= this_month_int) / 10000, 2) as cytotal,
        -- 去年各月
        round(sumIf(f_creditamount, years = last_year AND months = '01') / 10000, 2) as ly1,
        round(sumIf(f_creditamount, years = last_year AND months = '02') / 10000, 2) as ly2,
        round(sumIf(f_creditamount, years = last_year AND months = '03') / 10000, 2) as ly3,
        round(sumIf(f_creditamount, years = last_year AND months = '04') / 10000, 2) as ly4,
        round(sumIf(f_creditamount, years = last_year AND months = '05') / 10000, 2) as ly5,
        round(sumIf(f_creditamount, years = last_year AND months = '06') / 10000, 2) as ly6,
        round(sumIf(f_creditamount, years = last_year AND months = '07') / 10000, 2) as ly7,
        round(sumIf(f_creditamount, years = last_year AND months = '08') / 10000, 2) as ly8,
        round(sumIf(f_creditamount, years = last_year AND months = '09') / 10000, 2) as ly9,
        round(sumIf(f_creditamount, years = last_year AND months = '10') / 10000, 2) as ly10,
        round(sumIf(f_creditamount, years = last_year AND months = '11') / 10000, 2) as ly11,
        round(sumIf(f_creditamount, years = last_year AND months = '12') / 10000, 2) as ly12,
        -- 去年同期累计
        round(sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int) / 10000, 2) as lytotal,
        -- 累计变动 = 本年累计 - 去年同期
        round(
            sumIf(f_creditamount, years = this_year AND toInt32(months) <= this_month_int) / 10000 -
            sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int) / 10000
        , 2) as difftotal,
        -- 累计增幅
        round(
            if(sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int) = 0, 0,
               100 * (sumIf(f_creditamount, years = this_year AND toInt32(months) <= this_month_int) -
                      sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int)) /
               sumIf(f_creditamount, years = last_year AND toInt32(months) <= this_month_int)
            )
        , 2) as yoyrate,
        --历史年分
        round(sumIf(f_creditamount, years = last2_year ) / 10000, 2) as last2year,
        round(sumIf(f_creditamount, years = last3_year ) / 10000, 2) as last3year,
        round(sumIf(f_creditamount, years = last4_year ) / 10000, 2) as last4year,
        round(sumIf(f_creditamount, years = last5_year ) / 10000, 2) as last5year
    from dwd_gl_balance
    <where>
        1=1
        AND years >= last5_year
        AND d_subject_code like '6001%'
        AND rn = 1
        AND months <> '00'
        <if test="body?.Corp != null and body?.Corp != ''">
            AND d_corp_code IN (#{body?.Corp})
        </if>
    </where> 
)
select 
    d_subject_name,
    cy1,
    cy2,
    cy3,
    cy4,
    cy5,
    cy6,
    cy7,
    cy8,
    cy9,
    cy10,
    cy11,
    cy12,
    cytotal,
    ly1,
    ly2,
    ly3,
    ly4,
    ly5,
    ly6,
    ly7,
    ly8,
    ly9,
    ly10,
    ly11,
    ly12,
    lytotal,
    difftotal,
    yoyrate,
    last2year,
    last3year,
    last4year,
    last5year
from temp    
order by multiIf(
        d_subject_name = '合计', 80,
        d_subject_name = '收入', 99,1
    )
""")

// 月份名称
var monthNames = ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月']

// 动态生成columns
var columns = []
columns.push({ title: '期间/税种', dataIndex: 'dSubjectName', width: 140, izShow: 'Y',sorter: true })

// 本年各月列（只展示到当前月）
var mi
for (mi in range(1, thisMonth)) {
    columns.push({ title: thisYear.toString() + '年' + monthNames.get(mi-1), dataIndex: 'cy' + mi.toString(), align: 'right', izShow: 'Y' })
}
// 本年累计
columns.push({ title: thisYear.toString() + '年度', dataIndex: 'cytotal', align: 'right', izShow: 'Y' })
// 去年同期累计
columns.push({ title:'同期累计', dataIndex: 'lytotal', align: 'right', izShow: 'Y' })

// 变动和增幅
columns.push({ title: '累计变动', dataIndex: 'difftotal', align: 'right', izShow: 'Y' })
columns.push({ title: '累计增幅', dataIndex: 'yoyrate', align: 'right', izShow: 'Y' })
// 去年各月列（只展示到当前月）
var li
for (li in range(1, thisMonth)) {
    columns.push({ title: lastYear.toString() + '年' + monthNames.get(li-1), dataIndex: 'ly' + li.toString(), align: 'right', izShow: 'Y' })
}
// 历史年份累计
columns.push({ title: last2Year.toString() + '年度', dataIndex: 'last2year', align: 'right', izShow: 'Y' })
columns.push({ title: last3Year.toString() + '年度', dataIndex: 'last3year', align: 'right', izShow: 'Y' })
columns.push({ title: last4Year.toString() + '年度', dataIndex: 'last4year', align: 'right', izShow: 'Y' })
columns.push({ title: last5Year.toString() + '年度', dataIndex: 'last5year', align: 'right', izShow: 'Y' })

return resp.json({
    data: list,
    columns: columns
})