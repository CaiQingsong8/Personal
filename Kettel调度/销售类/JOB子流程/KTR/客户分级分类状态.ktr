    </partitioning>
    <connection>aohuafr</connection>
    <sql>SELECT  YXZJH,KHMC,GSMC,QJ,PK_GS,PK_KH
FROM BD_GSKH
WHERE TO_CHAR(ADD_MONTHS(SYSDATE,-1),'YYYY-MM')= QJ 
ORDER BY YXZJH
</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema />
