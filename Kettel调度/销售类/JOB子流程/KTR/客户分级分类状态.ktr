    </GUI>
  </step>
  <step>
    <name>取客户等级</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>aohuafr</connection>
    <sql>SELECT  F_SALES.YXZJH,
        (CASE WHEN SUBSTR (RP_KHTHRQ2.zzthrq,1,4) = TO_CHAR(SYSDATE,'YYYY')  THEN '新客户'
        else '老客户' end )XLKH,
        SUM(F_SALES.xsd) ZXSD,
        to_char(add_months(sysdate,-1),'yyyy-mm') QJ,
        SYSDATE  ts
FROM F_SALES,RP_KHTHRQ2
WHERE  (F_SALES.DBILLDATE BETWEEN to_char(add_months(sysdate,-12),'yyyy-mm-dd') AND to_char(sysdate,'yyyy-mm-dd')) 
AND (F_SALES.SJFLBM LIKE '22__' OR F_SALES.SJFLBM LIKE'21__') 
AND F_SALES.YXZJH=RP_KHTHRQ2.YXZJH
GROUP BY F_SALES.YXZJH, (CASE WHEN SUBSTR (RP_KHTHRQ2.zzthrq,1,4) = TO_CHAR(SYSDATE,'YYYY')  THEN '新客户'
                        else '老客户' end )
ORDER BY F_SALES.YXZJH</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema />
    <remotesteps>
