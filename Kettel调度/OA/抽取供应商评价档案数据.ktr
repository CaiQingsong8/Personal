      <schema_name />
    </partitioning>
    <connection>OA</connection>
    <sql>SELECT A.* FROM
(
SELECT
gysbm, --供应商编码
gysmc, --供应商名称
CASE WHEN gyslx = 0 THEN '经销商' ELSE '生产商' END GYSLX, --供应商类型
gysdz, --供应商地址
zcdz, --注册地址
zczj, --注册资金（万元）
yhzh, --银行账号
khyh, --开户银行
ylbm, --原料编码
zygyyltymc, --主要供应原料通用名称
zgyylspmc, --主供应原料商品名称
cygyyltymc, --次要供应原料通用名称
cgyylspmc, --次供应原料商品名称
scxkz, --生产许可证
cppzwh, --产品批准文号
gmpzs, --GMP证书
jkdjzh, --进口登记证号
qtzz, --其他证照
lxr, --联系人
lxdh, --联系电话
gddh, --固定电话
cz, --传真
qq, --QQ号
email, --E-mail
zch, --三证合一注册号
cpzl, --产品质量（合格率）
zpzzbbl, --主品种中标比例
swfwzl, --商务服务质量
htjslyxy, --合同及时履约信誉
kqzc, --货款支持
hydw, --行业地位
CASE WHEN sfscs = 0 THEN '是' ELSE '否' END SFSCS, --是否为生产商
CASE WHEN jyxkzz = 0 THEN '有效' ELSE '无效' END JYXKZZ, --经营许可资质有效性
modedatacreater, --创建人
modedatacreatedate||' '||modedatacreatetime CJSJ --创建日期
FROM uf_gyspj
) A
INNER JOIN
(
SELECT gysbm, --供应商编码
MAX(modedatacreatedate||' '||modedatacreatetime) CJSJ --创建日期
FROM uf_gyspj
GROUP BY GYSBM
) B
ON A.GYSBM = B.GYSBM AND A.CJSJ = B.CJSJ</sql>
    <limit>0</limit>
    <lookup />
