    <connection>nc65_ncread</connection>
    <sql>WITH AA AS --分析名单
(
SELECT DISTINCT B.NAME GSMC FROM so_saleorder A
LEFT JOIN org_salesorg B
ON A.pk_org = B.pk_salesorg
WHERE 1=1
AND SUBSTR(A.dbilldate,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')
),
BA AS --本月累计正常销售订单
(
SELECT B.NAME GSMC,COUNT(A.vbillcode) LJXSDD_0 FROM so_saleorder A
LEFT JOIN org_salesorg B
ON A.pk_org = B.pk_salesorg
WHERE 1=1
AND A.DR = 0
AND SUBSTR(A.dbilldate,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')
GROUP BY B.NAME
),
BB AS --昨日正常销售订单
(
SELECT B.NAME GSMC,COUNT(A.vbillcode) XSDD_0 FROM so_saleorder A
LEFT JOIN org_salesorg B
ON A.pk_org = B.pk_salesorg
WHERE 1=1
AND A.DR = 0
AND SUBSTR(A.dbilldate,1,10) = TO_CHAR(SYSDATE-1,'YYYY-MM-DD')
GROUP BY B.NAME
),
BC AS --本月累计删除销售订单
(
SELECT B.NAME GSMC,COUNT(A.vbillcode) LJXSDD_1 FROM so_saleorder A
LEFT JOIN org_salesorg B
ON A.pk_org = B.pk_salesorg
WHERE 1=1
AND A.DR &lt;&gt; 0
AND SUBSTR(A.dbilldate,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')
GROUP BY B.NAME
),
BD AS --昨日删除销售订单
(
SELECT B.NAME GSMC,COUNT(A.vbillcode) XSDD_1 FROM so_saleorder A
LEFT JOIN org_salesorg B
ON A.pk_org = B.pk_salesorg
WHERE 1=1
AND A.DR &lt;&gt; 0
AND SUBSTR(A.dbilldate,1,10) = TO_CHAR(SYSDATE-1,'YYYY-MM-DD')
GROUP BY B.NAME
),
CA AS --本月累计正常销售出库单
(
SELECT B.NAME GSMC,COUNT(A.vbillcode) LJXSCKD_0 FROM ic_saleout_h A
LEFT JOIN org_stockorg B
ON A.pk_org = B.pk_stockorg
WHERE 1=1
AND A.DR = 0
AND SUBSTR(A.dbilldate,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')
GROUP BY B.NAME
),
CB AS --昨日正常销售出库单
(
SELECT B.NAME GSMC,COUNT(A.vbillcode) XSCKD_0 FROM ic_saleout_h A
LEFT JOIN org_stockorg B
ON A.pk_org = B.pk_stockorg
WHERE 1=1
AND A.DR = 0
AND SUBSTR(A.dbilldate,1,10) = TO_CHAR(SYSDATE-1,'YYYY-MM-DD')
GROUP BY B.NAME
),
CC AS--本月累计删除销售出库单
(
SELECT B.NAME GSMC,COUNT(A.vbillcode) LJXSCKD_1 FROM ic_saleout_h A
LEFT JOIN org_stockorg B
ON A.pk_org = B.pk_stockorg
WHERE 1=1
AND A.DR &lt;&gt; 0
AND SUBSTR(A.dbilldate,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')
GROUP BY B.NAME
),
CD AS--昨日删除销售出库单
(
SELECT B.NAME GSMC,COUNT(A.vbillcode) XSCKD_1 FROM ic_saleout_h A
LEFT JOIN org_stockorg B
ON A.pk_org = B.pk_stockorg
WHERE 1=1
AND A.DR &lt;&gt; 0
AND SUBSTR(A.dbilldate,1,10) = TO_CHAR(SYSDATE-1,'YYYY-MM-DD')
GROUP BY B.NAME
),
CE AS --超过3天后修改的销售出库单
(
SELECT B.NAME GSMC,COUNT(A.vbillcode) XGCKD FROM ic_saleout_h A
LEFT JOIN org_stockorg B
ON A.pk_org = B.pk_stockorg
WHERE 1=1
AND A.DR = 0
AND SUBSTR(A.dbilldate,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')
AND TO_DATE(SUBSTR(A.modifiedtime,1,10),'YYYY-MM-DD')-TO_DATE(SUBSTR(A.creationtime,1,10),'YYYY-MM-DD') > 3
GROUP BY B.NAME
),
DA AS--本月累计正常地磅单
(
SELECT B.NAME GSMC,COUNT(A.billno) LJDBD_0 FROM db_xsdbfull_h A
LEFT JOIN org_salesorg B
ON A.pk_org = B.pk_salesorg
WHERE 1=1
AND A.DR = 0
AND SUBSTR(dbilldate,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')
GROUP BY B.NAME
),
DB AS--昨日正常地磅单
(
SELECT B.NAME GSMC,COUNT(A.billno) DBD_0 FROM db_xsdbfull_h A
LEFT JOIN org_salesorg B
ON A.pk_org = B.pk_salesorg
WHERE 1=1
AND A.DR = 0
AND SUBSTR(dbilldate,1,10) = TO_CHAR(SYSDATE-1,'YYYY-MM-DD')
GROUP BY B.NAME
),
DC AS--本月累计删除地磅单
(
SELECT B.NAME GSMC,COUNT(A.billno) LJDBD_1 FROM db_xsdbfull_h A
LEFT JOIN org_salesorg B
ON A.pk_org = B.pk_salesorg
WHERE 1=1
AND A.DR &lt;&gt; 0
AND SUBSTR(dbilldate,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')
GROUP BY B.NAME
),
DD AS --昨日删除销售地磅单
(
SELECT B.NAME GSMC,COUNT(A.billno) DBD_1 FROM db_xsdbfull_h A
LEFT JOIN org_salesorg B
ON A.pk_org = B.pk_salesorg
WHERE 1=1
AND A.DR &lt;&gt; 0
AND SUBSTR(dbilldate,1,10) = TO_CHAR(SYSDATE-1,'YYYY-MM-DD')
GROUP BY B.NAME
),
EE AS --异常调价次数，指同一个公司同一个渠道同一个客户同一个产品在一个月内调价次数超过1次的次数
(
SELECT GSMC,COUNT(GSMC) TJCS FROM
(
SELECT XSZJ GSMC,QDLX,KHBM,KHMC,WLBM,WLMC,COUNT(WLBM) SL FROM
(
SELECT
B.vbillcode DJH,--单据号
C.NAME XSZJ,--销售组织
D.name QDLX,--渠道类型
E.CODE KHBM,--客户编码
E.NAME KHMC,--客户名称
F.CODE WLBM,--产品编码
F.NAME WLMC,--产品名称
A.nbasepriceadd ZK,--新基准折扣加成
SUBSTR(B.dmakedate,1,10) ZDRQ,--制单日期
SUBSTR(B.creationtime,1,10) CJSJ,--创建时间
SUBSTR(B.dadjustpricedate,1,10) TJRQ,--调价日期
SUBSTR(B.dbegindate,1,10) SXRQ--生效日期
FROM prm_adjdiscount_b A --基准折扣调整单子实体
LEFT JOIN prm_adjdiscount B --基准折扣调整单主实体
ON A.pk_adjdiscount = B.pk_adjdiscount
LEFT JOIN org_salesorg C --销售组织
ON B.pk_org = C.pk_salesorg
LEFT JOIN bd_channeltype D--渠道类型
ON A.pk_channeltype = D.pk_type
LEFT JOIN bd_customer E--客户基本信息
ON A.pk_customer = E.pk_customer
LEFT JOIN bd_material_v F--物料基本信息
ON A.pk_material = F.pk_material
WHERE 1=1
AND A.DR = 0
AND B.DR = 0
AND E.CODE IS NOT NULL
AND SUBSTR(B.dbegindate,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')
)
WHERE 1=1
GROUP BY XSZJ,QDLX,KHBM,KHMC,WLBM,WLMC
HAVING COUNT(WLBM) > 1
)
GROUP BY GSMC
)
SELECT
AA.GSMC,--公司名称
BA.LJXSDD_0,--本月累计正常销售订单
BB.XSDD_0,--昨日销售订单
BC.LJXSDD_1,--本月累计删除销售订单
BD.XSDD_1,--昨日删除销售订单
CA.LJXSCKD_0,--本月累计正常销售出库单
CB.XSCKD_0,--昨日销售订单
CC.LJXSCKD_1,--本月累计删除销售出库单
CD.XSCKD_1,--昨日删除销售出库单
CE.XGCKD,--超过3天后修改的销售出库单
DA.LJDBD_0,--本月累计正常地磅单
DB.DBD_0,--昨日正常地磅单
DC.LJDBD_1,--本月累计删除销售地磅单
DD.DBD_1,--昨日删除销售地磅单
EE.TJCS --异常调价次数
FROM AA
LEFT JOIN BA
ON AA.GSMC = BA.GSMC
LEFT JOIN BB
ON AA.GSMC = BB.GSMC
LEFT JOIN BC
ON AA.GSMC = BC.GSMC
LEFT JOIN BD
ON AA.GSMC = BD.GSMC
LEFT JOIN CA
ON AA.GSMC = CA.GSMC
LEFT JOIN CB
ON AA.GSMC = CB.GSMC
LEFT JOIN CC
ON AA.GSMC = CC.GSMC
LEFT JOIN CD
ON AA.GSMC = CD.GSMC
LEFT JOIN CE
ON AA.GSMC = CE.GSMC
LEFT JOIN DA
ON AA.GSMC = DA.GSMC
LEFT JOIN DB
ON AA.GSMC = DB.GSMC
LEFT JOIN DC
ON AA.GSMC = DC.GSMC
LEFT JOIN DD
ON AA.GSMC = DD.GSMC
LEFT JOIN EE
ON AA.GSMC = EE.GSMC</sql>
