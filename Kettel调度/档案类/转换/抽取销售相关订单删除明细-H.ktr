    <connection>nc65_ncread</connection>
    <sql>SELECT '销售订单' DJLX,B.NAME GSMC,SUBSTR(DBILLDATE,1,10) DJRQ,A.vbillcode DJH,C.NAME KHMC,A.CREATIONTIME CJSJ,A.modifiedtime XGSJ,D.user_name XGR FROM so_saleorder A
LEFT JOIN org_salesorg B
ON A.pk_org = B.pk_salesorg
LEFT JOIN bd_customer C
ON A.ccustomerid = C.pk_customer
LEFT JOIN sm_user D
ON A.modifier = D.cuserid
WHERE 1=1
AND A.DR &lt;&gt; 0
AND SUBSTR(A.dbilldate,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')

UNION ALL

SELECT '销售出库单' DJLX,B.NAME GSMC,SUBSTR(DBILLDATE,1,10) DJRQ,A.vbillcode DJH,C.NAME KHMC,A.CREATIONTIME CJSJ,A.modifiedtime XGSJ,D.user_name XGR FROM ic_saleout_h A
LEFT JOIN org_stockorg B
ON A.pk_org = B.pk_stockorg
LEFT JOIN bd_customer C
ON A.ccustomerid = C.pk_customer
LEFT JOIN sm_user D
ON A.modifier = D.cuserid
WHERE 1=1
AND A.DR &lt;&gt; 0
AND SUBSTR(A.dbilldate,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')

UNION ALL

SELECT DISTINCT '销售地磅单' DJLX,B.NAME GSMC,SUBSTR(DBILLDATE,1,10) DJRQ,A.billno DJH,C.NAME KHMC,A.CREATIONTIME CJSJ,A.modifiedtime XGSJ,D.user_name XGR FROM db_xsdbfull_h A
LEFT JOIN org_salesorg B
ON A.pk_org = B.pk_salesorg
LEFT JOIN db_xsdbfull_b CA
ON A.pk_xsdbfull_h = CA.pk_xsdbfull_h
LEFT JOIN bd_customer C
ON CA.pk_customer = C.pk_customer
LEFT JOIN sm_user D
ON A.creator = D.cuserid
WHERE 1=1
AND A.DR &lt;&gt; 0
AND SUBSTR(dbilldate,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')</sql>
