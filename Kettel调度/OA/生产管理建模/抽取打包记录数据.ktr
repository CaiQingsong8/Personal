  <step>
    <name>临时表输入</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>OA</connection>
    <sql>SELECT
A.ID,--数据ID
B.SUBCOMPANYNAME GSJC,--公司简称
B.SUBCOMPANYDESC GSMC,--公司全称
A.SCRQ,--生产日期
A.WLBM,--物料编码
A.WLMC,--物料名称
A.PFBM,--对应配方编码
A.PFMC,--对应配方名称
A.SCXMC SCXPK,--生产线PK
D.SCXMC,--生产线名称
A.MJBH MJPK,--模具PK
E.MJBH,--模具编号
E.YSB,--压缩比
E.LJ,--粒径
A.JHSL,--计划数量
A.RKSL,--入库数量
A.YSSC,--预设时产
F.LASTNAME BZ,--班长
G.LASTNAME JS,--机手
C.LASTNAME CJR,--创建人
A.Modedatacreatedate||' '||A.Modedatacreatetime CJSJ --创建时间
FROM uf_cprkjl A
LEFT JOIN hrmsubcompany B --分部表
ON B.ID = A.SCGS
LEFT JOIN HrmResource C --人力资源表
ON C.ID = A.Modedatacreater
LEFT JOIN uf_production_line D --生产线档案
ON A.SCXMC = D.ID
LEFT JOIN uf_Moldfile E --模具档案
ON A.MJBH = E.ID
LEFT JOIN HrmResource F --人力资源表、班长
ON F.ID = TO_CHAR(SUBSTR(A.BZ,1,CASE WHEN INSTR(A.BZ,',') = 0 THEN 10 ELSE INSTR(A.BZ,',')-1 END))
LEFT JOIN HrmResource G --人力资源表、机手
ON G.ID = TO_CHAR(SUBSTR(A.JS,1,CASE WHEN INSTR(A.JS,',') = 0 THEN 10 ELSE INSTR(A.JS,',')-1 END))</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
