  <step>
    <name>抽取采购入库单数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT DISTINCT
        A.CGENERALHID                   CGENERALHID,  --入库单表头主键
        SUBSTR(A.CREATIONTIME,1,10)     CJRQ,         --创建日期
        SUBSTR（A.DBILLDATE,1,10)        DJRQ,        --单据日期
        SUBSTR(B.DBIZDATE,1,10)         RKRQ,         --入库日期
        A.PK_ORG                        PK_ORG,       --采购组织主键
        A.CDPTID                        CDPTID,       --采购部门主键
        H.NAME                          CGBMMC,       --采购部门名称
        A.VBILLCODE                     VBILLCODE,    --单据号
        B.VSOURCEBILLCODE               LYDJH,        --来源单据号 
        B.vfirstbillcode                YTDJH,        --源头单据号
        B.NSHOULDNUM                    YSZSL,        --应收主数量
        B.NNUM                          SSZSL,        --实收主数量
        B.NORIGTAXMNY                   RKJE,         --入库金额
        D.CODE                          WLBM,         --物料编码
        D.NAME                          WLMC,         --物料名称
        B.NORIGTAXPRICE                 RKDJ,         --入库单价
        E.CODE                          GSBM,         --公司编码
        E.NAME                          GSMC,         --公司名称（基地）
        C.CODE                          GYSBM,        --供应商编码
        C.NAME                          GYSMC,        --供应商名称
        F.NAME                          CKMC,         --仓库名称  
        G.BILLTYPENAME                  CRKLX,        --出入库类型
        M.CODE                          WLFLBM,       --物料分类编码
	    M.NAME                          WLFLMC,       --物料分类名称
	    N.CODE                          SJWLFLBM,     --上级物料分类编码
	    N.NAME                          SJWLFLMC      --上级物料分类名称
FROM IC_PURCHASEIN_H A
LEFT JOIN IC_PURCHASEIN_B B
     ON A.CGENERALHID = B.CGENERALHID
LEFT JOIN ORG_PURCHASEORG E
     ON A.PK_ORG_V = E.PK_VID
LEFT JOIN BD_SUPPLIER C
     ON A.CVENDORID = C.PK_SUPPLIER
LEFT JOIN BD_MATERIAL D
ON B.CMATERIALVID=D.PK_MATERIAL
LEFT JOIN BD_STORDOC F
ON A.CWAREHOUSEID=F.PK_STORDOC
LEFT JOIN BD_BILLTYPE G
ON A.CTRANTYPEID=G.PK_BILLTYPEID
LEFT JOIN ORG_DEPT H
ON A.CDPTID = H.PK_DEPT
LEFT JOIN BD_MARBASCLASS M
     ON D.PK_MARBASCLASS=M.PK_MARBASCLASS
LEFT JOIN BD_MARBASCLASS N
     ON M.PK_PARENT=N.PK_MARBASCLASS
WHERE A.MODIFIEDTIME >= '${cgupdtime}'
AND A.DR = 0
AND B.DR = 0
</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
