  <step>
    <name>临时表输入</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>ncread</connection>
    <sql>SELECT  T2.CODE                      GSBM--           公司编码
        ,T2.NAME                     GSMC--           公司名称
        ,substr(T1.dbizdate,0,10)    DJRQ--            业务日期
        ,T4.billtypename             CRKLX--           出入库类型
        ,T5.billtypename             DJLX--            单据类型
        ,T1.vbillcode                DJH--             单据号
        ,T8.NAME                     CK--              仓库
        ,T3.CODE                     WLBM--            物料编码
        ,T3.NAME                     WLMC--           物料名称
        ,       (CASE
                  WHEN T3.code LIKE '7%' THEN T1.ninassistnum  ELSE T1.ninnum 
                END) RKZSL, --入库主数量
                (CASE
                  WHEN T3.code LIKE '7%' THEN T1.ninnum ELSE  T1.ninassistnum
                END) RKFSL, --入库辅数量
                (CASE
                  WHEN T3.code LIKE '7%' THEN T1.noutassistnum   ELSE T1.noutnum  
                END) CKZSL, --出库主数量
                (CASE
                  WHEN T3.code LIKE '7%' THEN T1.noutnum  ELSE  T1.noutassistnum 
                END) CKFSL, --出库辅数量
                (CASE
                  WHEN T3.code LIKE '7%' THEN T7.name ELSE  T6.name
                END) ZDW, --主单位
                (CASE WHEN T3.code LIKE '7%' THEN T6.name ELSE T7.name
                    END) FDW --辅单位
        ,T9.CODE                     BMBM--           部门编码
        ,T9.NAME                    BMMC--           部门名称
        ,T10.KHBM                    --           客户编码
        ,T10.KHMC                    --           客户名称
        ,T10.KHJBFLBM                --           客户基本分类编码
        ,T10.KHJBFLMC                --           客户基本分类名称
        ,T11.GYSBM                   --           供应商编码
        ,T11.GYSMC                   --           供应商名称
        ,T11.GYSJBFLBM               --           供应商基本分类编码
        ,T11.GYSJBFLMC               --           供应商基本分类名称
FROM ic_flow T1 --库存流水表
inner JOIN org_stockorg T2 --组织档案
ON T2.pk_stockorg = T1.pk_org
inner JOIN bd_material T3 --物料档案
ON T3.pk_material  = T1.cmaterialvid
inner JOIN bd_billtype  T4 --单据类型
ON T4.pk_billtypeid  = T1.ctrantypeid 
inner JOIN bd_billtype  T5 --单据类型
ON T5.pk_billtypeid  = T1.cbilltypecode 
inner JOIN bd_measdoc T6 --计量单位
ON T6.pk_measdoc = T1.cunitid 
inner JOIN bd_measdoc T7 --计量单位
ON T7.pk_measdoc = T1.castunitid 
inner JOIN bd_stordoc T8 -- 仓库
ON T8.pk_stordoc  = T1.cwarehouseid
left JOIN org_dept T9 --部门
ON T9.pk_dept = t1.cdptid 
left JOIN 
(SELECT A.pk_customer , A.CODE KHBM,A.NAME KHMC ,B.CODE KHJBFLBM ,B.NAME KHJBFLMC FROM bd_customer A --客户
        LEFT JOIN bd_custclass B --客户基本分类
        ON B.pk_custclass = A.pk_custclass
) T10 --客户
ON T10.pk_customer = T1.ccustomerid
left JOIN 
(SELECT A.pk_supplier,A.CODE GYSBM,A.NAME GYSMC,B.CODE GYSJBFLBM,B.NAME GYSJBFLMC FROM bd_supplier A --供应商
        LEFT JOIN bd_supplierclass B -- 供应商基本分类
        ON B.pk_supplierclass  = A.pk_supplierclass 
) T11 --供应商
ON T11.pk_supplier  = T1.cvendorid
WHERE 1=1
AND T1.DR = 0
AND T1.dbizdate IS NOT NULL　

</sql>
    <limit>0</limit>
