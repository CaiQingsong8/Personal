    <connection>nc65_ncread</connection>
    <sql>WITH AA AS
(
SELECT QYZT,KHPK,KHBM,KHMC,YWYPK,YWYXM,HSDW,HSDWPK,SUBSTR(DJRQ,1,10) ZHTHRQ,YWYPK||MAX(DJRQ) PD FROM
(
SELECT
QYZT,
KHPK,
KHBM,
KHMC,
YWYPK,
YWYXM,
CASE WHEN HSDW LIKE '%事业部' THEN HSDW ELSE GSMC END HSDW,
CASE WHEN HSDW LIKE '%事业部' THEN HSDWPK ELSE GSPK END HSDWPK,
DJRQ
FROM
(
SELECT 
B.enablestate QYZT,--启用状态
B.pk_customer KHPK,--客户PK
B.code KHBM,--客户编码
B.name KHMC,--客户名称
C.pk_psndoc YWYPK,--业务员PK
C.name YWYXM,--业务员姓名
D.name GSMC,
D.DEF2 GSPK,
CASE WHEN E.DEF2 IS NOT NULL THEN E.name ELSE F.name END HSDW,
CASE WHEN E.DEF2 IS NOT NULL THEN E.DEF2 ELSE E.pk_dept END HSDWPK,
A.dbilldate DJRQ, --单据日期
FROM so_saleorder A --销售订单主表
LEFT JOIN bd_customer B --客户基本信息
ON A.ccustomerid=B.pk_customer
LEFT JOIN bd_psndoc C --人员基本信息
ON A.cemployeeid=C.pk_psndoc
LEFT JOIN org_orgs_v D --组织_版本信息
ON A.pk_org = D.pk_org
LEFT JOIN org_dept_v E --组织_部门版本信息
ON A.cdeptvid = E.pk_vid
LEFT JOIN bd_defdoc F
ON E.DEF2 = F.pk_defdoc
WHERE A.DR = 0
AND D.name &lt;&gt; '淮安市澳宝生物科技有限公司'
AND D.name &lt;&gt; '江门市澳保生物科技有限公司'
)
)
WHERE SUBSTR(DJRQ,1,10) >= '2017-01-01'
GROUP BY QYZT,KHPK,KHBM,KHMC,YWYPK,YWYXM,HSDW,HSDWPK,SUBSTR(DJRQ,1,10)
),
BB AS
(
SELECT cemployeeid||MAX(DBILLDATE) PD FROM so_saleorder --销售订单主表
WHERE SUBSTR(DBILLDATE,1,10) >= '2017-01-01'
AND pk_org &lt;&gt; '0001A210000000036GW3'
AND pk_org &lt;&gt; '0001A21000000007NO70'
GROUP BY cemployeeid
)
SELECT AA.QYZT,AA.KHPK,AA.KHBM,AA.KHMC,AA.YWYPK,AA.YWYXM,AA.HSDW,AA.HSDWPK,AA.ZHTHRQ FROM AA
RIGHT JOIN BB
ON AA.PD = BB.PD</sql>
