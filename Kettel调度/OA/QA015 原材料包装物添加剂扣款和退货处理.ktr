      <schema_name />
    </partitioning>
    <connection>OA</connection>
    <sql>select
e.SUBCOMPANYDESC gsmc    --所属公司
,e.SUBCOMPANYname gsjc    --公司简称	     --	审批公司
,a.bianh	     --	编号
,d.lastname shenqr	     --	申请人
,c.DEPARTMENTNAME shenqbm	     --	申请部门
,a.shenqrq	     --	申请日期
,a.cghth	     --	采购合同号
,a.cgrkdh	     --	采购入库单号
,case when f.wlbm is null then a.WLBM_FR else f.wlbm end wlbm 	     --	物料编码
,case when f.wlmc is null then a.wlmc_fr else f.wlmc end wlmc     --物料名称
,a.gysbm	     --	供应商编码
,a.gysmc	     --	供应商名称
,a.cqh	     --	车(船)号
,a.dhrq	     --	到货日期
,a.scrq	     --	生产日期
,case a.wllb when 0 then '大原料'
when 1 then '小原料'
when 2 then '包装袋'
when 3 then '标签' end wllb--	物料类别
,a.bhgsl	     --	不合格数量（吨）
,a.bhgyy	     --	不合格原因
,case when a.cljg=0 then '扣款处理'
when a.cljg=1  then '退货' end cljg--	处理结果
,a.kkfs	     --	扣款方式（元/吨）
,a.kkzje	     --	扣款总金额（元）
,a.zjms	     --	质检描述与结论
,a.sccj	     --	生产厂家
,a.ponczy   --PONC值（元）
,H.CREATEDATE||' '||H.CREATETIME CJSJ --流程创建时间
from formtable_main_411 a
left join HrmResource d
on a.shenqr=d.id
left join hrmdepartment c
on a.shenqbm=c.id
left join hrmsubcompany e
on a.spgs=e.id
left join uf_nccpda f
on a.wlbm=f.id
left join workflow_requestbase H
on a.requestid = H.requestid
where H.currentnodetype = 3     --3是归档状态


</sql>
    <limit>0</limit>
