================================
import resp

if (body?.monthDt) { body.monthDt = body.monthDt.split(",") }
if (body?.Corp) { body.Corp = body.Corp.split(",") }

var thisYear = body?.monthDt ? Integer.parseInt(body.monthDt[0].substring(0, 4)) : 2026

list = db.FRCK.select("""
WITH
    #{body?.monthDt} AS param_month1,
    substr(param_month1, 1, 7) AS param_month,
    substr(param_month, 1, 4) AS this_year,
    toString(toInt32(this_year) - 9) AS start_year
select
    d_subject_name,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-9)) / 10000, 2) as y0,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-8)) / 10000, 2) as y1,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-7)) / 10000, 2) as y2,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-6)) / 10000, 2) as y3,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-5)) / 10000, 2) as y4,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-4)) / 10000, 2) as y5,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-3)) / 10000, 2) as y6,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-2)) / 10000, 2) as y7,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-1)) / 10000, 2) as y8,
    round(sumIf(f_creditamount, years = this_year) / 10000, 2)                      as y9,
    round(sum(f_creditamount) / 10000, 2) as total
from dwd_gl_balance
<where>
    1=1
    AND years BETWEEN start_year AND this_year
    AND d_subject_code like '2221%'
    AND rn = 1
    AND months <> '00'
    <if test="body?.Corp != null and body?.Corp != ''">
        AND d_corp_code IN (#{body?.Corp})
    </if>
</where>
group by d_subject_name
union all

-- 合计行
select
    '合计' as d_subject_name,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-9)) / 10000, 2) as y0,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-8)) / 10000, 2) as y1,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-7)) / 10000, 2) as y2,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-6)) / 10000, 2) as y3,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-5)) / 10000, 2) as y4,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-4)) / 10000, 2) as y5,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-3)) / 10000, 2) as y6,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-2)) / 10000, 2) as y7,
    round(sumIf(f_creditamount, years = toString(toInt32(this_year)-1)) / 10000, 2) as y8,
    round(sumIf(f_creditamount, years = this_year) / 10000, 2)                      as y9,
    round(sum(f_creditamount) / 10000, 2) as total
from dwd_gl_balance
<where>
    1=1
    AND years BETWEEN start_year AND this_year
    AND d_subject_code like '2221%'
    AND rn = 1
    AND months <> '00'
    <if test="body?.Corp != null and body?.Corp != ''">
        AND d_corp_code IN (#{body?.Corp})
    </if>
</where>
order by d_subject_name

""")

var y0 = (thisYear - 9).toString() + '年'
var y1 = (thisYear - 8).toString() + '年'
var y2 = (thisYear - 7).toString() + '年'
var y3 = (thisYear - 6).toString() + '年'
var y4 = (thisYear - 5).toString() + '年'
var y5 = (thisYear - 4).toString() + '年'
var y6 = (thisYear - 3).toString() + '年'
var y7 = (thisYear - 2).toString() + '年'
var y8 = (thisYear - 1).toString() + '年'
var y9 = thisYear.toString() + '年'

var columns = []
columns.push({ title: '实缴税费', dataIndex: 'dSubjectName', width: 160, izShow: "Y" })
columns.push({ title: y0, dataIndex: 'y0', align: 'right', izShow: "Y" })
columns.push({ title: y1, dataIndex: 'y1', align: 'right', izShow: "Y" })
columns.push({ title: y2, dataIndex: 'y2', align: 'right', izShow: "Y" })
columns.push({ title: y3, dataIndex: 'y3', align: 'right', izShow: "Y" })
columns.push({ title: y4, dataIndex: 'y4', align: 'right', izShow: "Y" })
columns.push({ title: y5, dataIndex: 'y5', align: 'right', izShow: "Y" })
columns.push({ title: y6, dataIndex: 'y6', align: 'right', izShow: "Y" })
columns.push({ title: y7, dataIndex: 'y7', align: 'right', izShow: "Y" })
columns.push({ title: y8, dataIndex: 'y8', align: 'right', izShow: "Y" })
columns.push({ title: y9, dataIndex: 'y9', align: 'right', izShow: "Y" })
columns.push({ title: '合计', dataIndex: 'total', align: 'right', izShow: "Y" })

return resp.json({
    data: list,
    columns: columns
})