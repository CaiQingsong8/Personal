  <step>
    <name>抽取取转正人员</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT
    t3.CODE gsbm ,
    t3.name gsmc,
	bd_psndoc.pk_psndoc RYPK ,--人员pk,
    bd_psndoc.code rybm,--人员编码,
    bd_psndoc.name xm,--姓名,
    t_3.ssbmmc BM,--部门,
    t2.postname  GW,--岗位,
    hi_psnorg.begindate RZRQ,--入职日期,
    bd_psndoc.glbdef17 ZZRQ,--转正日期,
    t1.name ZJSJ --直接上级
FROM
    hi_psnorg hi_psnorg
    INNER JOIN hi_psnjob hi_psnjob ON hi_psnorg.pk_psnorg = hi_psnjob.pk_psnorg
    INNER JOIN bd_psndoc bd_psndoc ON hi_psnorg.pk_psndoc = bd_psndoc.pk_psndoc
    INNER JOIN org_corp org_corp ON hi_psnjob.pk_hrorg = org_corp.pk_corp
    LEFT JOIN bd_psndoc t1 ON hi_psnjob.jobglbdef4 = t1.pk_psndoc
    LEFT JOIN om_post t2 ON t2.pk_post = hi_psnjob.pk_post
	--LEFT JOIN hi_psndoc_trial T3 ON T3.pk_psnorg  = hi_psnorg.pk_psnorg 试用记录
    LEFT OUTER JOIN (
        SELECT DISTINCT
            t1.code ssbmbm,
            t1.name ssbmmc,
                CASE
                    WHEN t2.name IS NULL THEN t1.name
                    WHEN t2.name IS NOT NULL THEN (
                        CASE
                            WHEN t2.name = (
                                CASE
                                    WHEN t3.name IS NULL THEN (
                                        CASE
                                            WHEN t2.name IS NULL THEN t1.name
                                            WHEN t2.name IS NOT NULL THEN t2.name
                                        END
                                    )
                                    WHEN t3.name IS NOT NULL THEN t3.name
                                END
                            ) THEN t1.name
                            ELSE t2.name
                        END
                    )
                END
            ejbm,
                CASE
                    WHEN t3.name IS NULL THEN (
                        CASE
                            WHEN t2.name IS NULL THEN t1.name
                            WHEN t2.name IS NOT NULL THEN t2.name
                        END
                    )
                    WHEN t3.name IS NOT NULL THEN t3.name
                END
            yjbm,
            t1.pk_dept bmpk
        FROM
            org_dept t1
            LEFT OUTER JOIN org_dept t2 ON t1.pk_fatherorg = t2.pk_dept
            LEFT OUTER JOIN org_dept t3 ON t2.pk_fatherorg = t3.pk_dept
            LEFT OUTER JOIN org_orgs t4 ON t4.pk_org = t1.pk_org
        WHERE
            1 = 1
    ) t_3 ON hi_psnjob.pk_dept = t_3.bmpk
    LEFT JOIN org_orgs t3 ON t3.pk_org  = bd_psndoc.pk_org
WHERE 1=1
    AND (
        hi_psnjob.endflag = 'N'
    ) AND (
        hi_psnjob.ismainjob = 'Y'
    ) AND (
        hi_psnjob.lastflag = 'Y'
    ) AND (
        hi_psnorg.indocflag = 'Y'
    ) AND (
        hi_psnorg.psntype = '0'
    ) AND (
        hi_psnorg.lastflag = 'Y'
    ) AND hi_psnorg.begindate >='2021' --只取大于2021年人员数据
</sql>
    <limit>0</limit>
