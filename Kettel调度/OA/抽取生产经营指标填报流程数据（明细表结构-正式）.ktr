    <connection>finereport_fbdbuser</connection>
    <sql>SELECT SCJD,YF,CPDL,FXZB,SZ FROM OA_SCJYZBMX_TEMP
UNION ALL
SELECT --自然吨产量
A.GSMC SCJD,
SUBSTR(A.DJRQ,1,7) YF,
CASE WHEN C.FLMC4 = '沉性膨化料' THEN '沉性膨化料'
WHEN C.FLMC3 = '猪饲料' THEN '畜料'
WHEN C.FLMC3 = '禽料' THEN '禽料'
WHEN C.FLMC3 = '普通膨化鱼料' OR C.FLMC3 = '高档膨化鱼料' THEN '浮性膨化料'
WHEN C.FLMC3 = '虾料' OR C.FLMC3 = '蟹料' THEN '颗粒虾蟹料'
WHEN C.FLMC3 = '浓缩/预混料' THEN '浓缩/预混料'
WHEN C.FLMC3 = '沉水鱼料' THEN '颗粒鱼料'
ELSE '其他料' END CPDL,
'自然吨产量' FXZB,
CAST(ROUND(SUM(
CASE WHEN A.CBDXBM LIKE '7%' THEN A.RKSL*SUBSTR(B.WLGG,1,2)/1000 ELSE A.RKSL END
),0) AS varchar(50)) SZ
FROM KC_CCPRK1 A
LEFT JOIN DA_WL B
ON A.WLBM = B.WLBM
LEFT JOIN DA_WLJBFL C
ON B.FLPK = C.FLZJ
WHERE 1=1
AND (A.WLBM LIKE '21%' OR A.WLBM LIKE '22%' OR A.CBDXBM LIKE '7%')
GROUP BY A.GSMC,SUBSTR(A.DJRQ,1,7),
CASE WHEN C.FLMC4 = '沉性膨化料' THEN '沉性膨化料'
WHEN C.FLMC3 = '猪饲料' THEN '畜料'
WHEN C.FLMC3 = '禽料' THEN '禽料'
WHEN C.FLMC3 = '普通膨化鱼料' OR C.FLMC3 = '高档膨化鱼料' THEN '浮性膨化料'
WHEN C.FLMC3 = '虾料' OR C.FLMC3 = '蟹料' THEN '颗粒虾蟹料'
WHEN C.FLMC3 = '浓缩/预混料' THEN '浓缩/预混料'
WHEN C.FLMC3 = '沉水鱼料' THEN '颗粒鱼料'
ELSE '其他料' END
UNION ALL
SELECT --标准吨产量
A.GSMC SCJD,
SUBSTR(A.DJRQ,1,7) YF,
CASE WHEN C.FLMC4 = '沉性膨化料' THEN '沉性膨化料'
WHEN C.FLMC3 = '猪饲料' THEN '畜料'
WHEN C.FLMC3 = '禽料' THEN '禽料'
WHEN C.FLMC3 = '普通膨化鱼料' OR C.FLMC3 = '高档膨化鱼料' THEN '浮性膨化料'
WHEN C.FLMC3 = '虾料' OR C.FLMC3 = '蟹料' THEN '颗粒虾蟹料'
WHEN C.FLMC3 = '浓缩/预混料' THEN '浓缩/预混料'
WHEN C.FLMC3 = '沉水鱼料' THEN '颗粒鱼料'
ELSE '其他料' END CPDL,
'标准吨产量' FXZB,
CAST(ROUND(SUM(
(CASE WHEN A.CBDXBM LIKE '7%' THEN A.RKSL*SUBSTR(B.WLGG,1,2)/1000 ELSE A.RKSL END)*NVL(B.SCDXS,0)*NVL(B.PZSCDXS,0)
),0) AS varchar(50)) SZ
FROM KC_CCPRK1 A
LEFT JOIN DA_WL B
ON A.WLBM = B.WLBM
LEFT JOIN DA_WLJBFL C
ON B.FLPK = C.FLZJ
WHERE 1=1
AND (A.WLBM LIKE '21%' OR A.WLBM LIKE '22%' OR A.CBDXBM LIKE '7%')
GROUP BY A.GSMC,SUBSTR(A.DJRQ,1,7),
CASE WHEN C.FLMC4 = '沉性膨化料' THEN '沉性膨化料'
WHEN C.FLMC3 = '猪饲料' THEN '畜料'
WHEN C.FLMC3 = '禽料' THEN '禽料'
WHEN C.FLMC3 = '普通膨化鱼料' OR C.FLMC3 = '高档膨化鱼料' THEN '浮性膨化料'
WHEN C.FLMC3 = '虾料' OR C.FLMC3 = '蟹料' THEN '颗粒虾蟹料'
WHEN C.FLMC3 = '浓缩/预混料' THEN '浓缩/预混料'
WHEN C.FLMC3 = '沉水鱼料' THEN '颗粒鱼料'
ELSE '其他料' END

UNION ALL  --总制造费（标准吨）

SELECT A.SCJD,A.YF,A.CPDL,'总制造费（标准吨）' FXZB,CAST(DECODE(B.CLBZD,0,0,ROUND(A.SZ*B.CLZRD/B.CLBZD,2))AS varchar(50)) SZ FROM OA_SCJYZBMX_TEMP A
LEFT JOIN SC_SCJYCLB B
ON A.SCJD = B.SCJD AND A.CPDL = B.CPDL AND A.YF = B.YF
WHERE 1=1
AND A.FXZB = '总制造费（自然吨）'</sql>
