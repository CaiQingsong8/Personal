    <connection>OA</connection>
    <sql>SELECT DISTINCT A.SQR,A.SQRQ,A.SQBM,A.GSMC,A.GSJC,A.SCJD,A.YF,A.CPDL,A.FXZB,A.SZ,A.BIANH,A.STATUS,A.CJSJ FROM
(
SELECT --搬运费
C.LASTNAME SQR,--申请人
B.applyDate SQRQ,--申请日期
D.DEPARTMENTNAME SQBM,--所属部门
E.SUBCOMPANYDESC GSMC,--公司全称
E.SUBCOMPANYNAME GSJC,--公司简称
F.SUBCOMPANYDESC SCJD,--生产基地
REPLACE(SUBSTR(G.YEARMONTH,1,4)||'-'||TO_CHAR(REPLACE(SUBSTR(G.YEARMONTH,6,2),'月',''),'00'),' ','') YF,--月份
CASE WHEN A.CPDL = 0 THEN '浮性膨化料'
WHEN A.CPDL = 1 THEN '颗粒虾蟹料'
WHEN A.CPDL = 2 THEN '颗粒鱼料'
WHEN A.CPDL = 3 THEN '畜料'
WHEN A.CPDL = 4 THEN '浓缩/预混料'
WHEN A.CPDL = 5 THEN '其他料'
WHEN A.CPDL = 6 THEN '沉性膨化料'
WHEN A.CPDL = 7 THEN '禽料'
ELSE '未知错误' END CPDL,--产品大类
'搬运费' FXZB,
A.BYF SZ,--搬运费
B.BIANH, --流程编号
H.STATUS, --流程当前节点
H.CREATEDATE||' '||H.CREATETIME CJSJ --流程创建时间
FROM formtable_main_232_dt1 A
LEFT JOIN formtable_main_232 B
ON A.MAINID = B.ID
LEFT JOIN HrmResource C --人力资源表
ON C.ID = B.applicant
LEFT JOIN hrmdepartment D --部门表
ON D.ID = B.applyDep
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = B.SUOSGS
LEFT JOIN hrmsubcompany F --分部表
ON F.ID = A.scjd
LEFT JOIN uf_yearmonth G--年月表
ON G.ID = A.yf
LEFT JOIN workflow_requestbase H--工作流基本信息表
ON B.REQUESTID = H.REQUESTID
WHERE 1=1
AND H.currentnodetype = 3 --等于归档节点

UNION ALL

SELECT --薪金
C.LASTNAME SQR,--申请人
B.applyDate SQRQ,--申请日期
D.DEPARTMENTNAME SQBM,--所属部门
E.SUBCOMPANYDESC GSMC,--公司全称
E.SUBCOMPANYNAME GSJC,--公司简称
F.SUBCOMPANYDESC SCJD,--生产基地
REPLACE(SUBSTR(G.YEARMONTH,1,4)||'-'||TO_CHAR(REPLACE(SUBSTR(G.YEARMONTH,6,2),'月',''),'00'),' ','') YF,--月份
CASE WHEN A.CPDL = 0 THEN '浮性膨化料'
WHEN A.CPDL = 1 THEN '颗粒虾蟹料'
WHEN A.CPDL = 2 THEN '颗粒鱼料'
WHEN A.CPDL = 3 THEN '畜料'
WHEN A.CPDL = 4 THEN '浓缩/预混料'
WHEN A.CPDL = 5 THEN '其他料'
WHEN A.CPDL = 6 THEN '沉性膨化料'
WHEN A.CPDL = 7 THEN '禽料'
ELSE '未知错误' END CPDL,--产品大类
'薪金' FXZB,
A.XJ SZ,--薪金
B.BIANH, --流程编号
H.STATUS, --流程当前节点
H.CREATEDATE||' '||H.CREATETIME CJSJ --流程创建时间
FROM formtable_main_232_dt1 A
LEFT JOIN formtable_main_232 B
ON A.MAINID = B.ID
LEFT JOIN HrmResource C --人力资源表
ON C.ID = B.applicant
LEFT JOIN hrmdepartment D --部门表
ON D.ID = B.applyDep
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = B.SUOSGS
LEFT JOIN hrmsubcompany F --分部表
ON F.ID = A.scjd
LEFT JOIN uf_yearmonth G--年月表
ON G.ID = A.yf
LEFT JOIN workflow_requestbase H--工作流基本信息表
ON B.REQUESTID = H.REQUESTID
WHERE 1=1
AND H.currentnodetype = 3 --等于归档节点

UNION ALL

SELECT --间接人工费
C.LASTNAME SQR,--申请人
B.applyDate SQRQ,--申请日期
D.DEPARTMENTNAME SQBM,--所属部门
E.SUBCOMPANYDESC GSMC,--公司全称
E.SUBCOMPANYNAME GSJC,--公司简称
F.SUBCOMPANYDESC SCJD,--生产基地
REPLACE(SUBSTR(G.YEARMONTH,1,4)||'-'||TO_CHAR(REPLACE(SUBSTR(G.YEARMONTH,6,2),'月',''),'00'),' ','') YF,--月份
CASE WHEN A.CPDL = 0 THEN '浮性膨化料'
WHEN A.CPDL = 1 THEN '颗粒虾蟹料'
WHEN A.CPDL = 2 THEN '颗粒鱼料'
WHEN A.CPDL = 3 THEN '畜料'
WHEN A.CPDL = 4 THEN '浓缩/预混料'
WHEN A.CPDL = 5 THEN '其他料'
WHEN A.CPDL = 6 THEN '沉性膨化料'
WHEN A.CPDL = 7 THEN '禽料'
ELSE '未知错误' END CPDL,--产品大类
'间接人工费' FXZB,
A.JJRGF SZ,--间接人工费
B.BIANH, --流程编号
H.STATUS, --流程当前节点
H.CREATEDATE||' '||H.CREATETIME CJSJ --流程创建时间
FROM formtable_main_232_dt1 A
LEFT JOIN formtable_main_232 B
ON A.MAINID = B.ID
LEFT JOIN HrmResource C --人力资源表
ON C.ID = B.applicant
LEFT JOIN hrmdepartment D --部门表
ON D.ID = B.applyDep
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = B.SUOSGS
LEFT JOIN hrmsubcompany F --分部表
ON F.ID = A.scjd
LEFT JOIN uf_yearmonth G--年月表
ON G.ID = A.yf
LEFT JOIN workflow_requestbase H--工作流基本信息表
ON B.REQUESTID = H.REQUESTID
WHERE 1=1
AND H.currentnodetype = 3 --等于归档节点

UNION ALL

SELECT --人工费小计
C.LASTNAME SQR,--申请人
B.applyDate SQRQ,--申请日期
D.DEPARTMENTNAME SQBM,--所属部门
E.SUBCOMPANYDESC GSMC,--公司全称
E.SUBCOMPANYNAME GSJC,--公司简称
F.SUBCOMPANYDESC SCJD,--生产基地
REPLACE(SUBSTR(G.YEARMONTH,1,4)||'-'||TO_CHAR(REPLACE(SUBSTR(G.YEARMONTH,6,2),'月',''),'00'),' ','') YF,--月份
CASE WHEN A.CPDL = 0 THEN '浮性膨化料'
WHEN A.CPDL = 1 THEN '颗粒虾蟹料'
WHEN A.CPDL = 2 THEN '颗粒鱼料'
WHEN A.CPDL = 3 THEN '畜料'
WHEN A.CPDL = 4 THEN '浓缩/预混料'
WHEN A.CPDL = 5 THEN '其他料'
WHEN A.CPDL = 6 THEN '沉性膨化料'
WHEN A.CPDL = 7 THEN '禽料'
ELSE '未知错误' END CPDL,--产品大类
'人工费小计' FXZB,
A.BYF+A.XJ+A.JJRGF SZ,--人工费小计
B.BIANH, --流程编号
H.STATUS, --流程当前节点
H.CREATEDATE||' '||H.CREATETIME CJSJ --流程创建时间
FROM formtable_main_232_dt1 A
LEFT JOIN formtable_main_232 B
ON A.MAINID = B.ID
LEFT JOIN HrmResource C --人力资源表
ON C.ID = B.applicant
