  <step>
    <name>上月/全年汇总客户流失状态 2</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>SELECT I.PK_KH,P.SYKHZT FROM (SELECT PK_KH FROM V_FENLEI VA
WHERE XSD= (SELECT MAX(XSD)
             FROM V_FENLEI
             WHERE PK_KH=VA.PK_KH))I
             
  LEFT JOIN
  
 (select 
  CASE WHEN A.PK_KH=B.PK_KH THEN '非流失'
   ELSE '流失'
     END SYKHZT,
  A.PK_KH
  FROM
  (select DISTINCT PK_KH from f_sales
WHERE PK_KH IN (SELECT DISTINCT PK_KH FROM BD_GSKH WHERE QJ=to_char(add_months(sysdate,-0),'yyyy-mm'))
AND SUBSTR(DBILLDATE,0,7)=to_char(add_months(sysdate,-1),'yyyy-mm')
  AND NVL(TYNUM,0)&lt;&gt;0
 
  GROUP BY PK_KH)A

  left join 
  (select DISTINCT PK_KH,SUM(TYNUM)AS XL FROM f_sales
  WHERE PK_KH IN (SELECT DISTINCT PK_KH FROM BD_GSKH WHERE QJ=to_char(add_months(sysdate,-0),'yyyy-mm'))
  AND SUBSTR(DBILLDATE,0,7)=to_char(add_months(sysdate,-0),'yyyy-mm')
 
  GROUP BY PK_KH)B 
  on A.PK_KH=B.PK_KH)P
  ON I.pk_kh=P.PK_KH
</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema />
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>去年/全年汇总客户流失状态</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>SELECT I.PK_KH,O.QNKHZT FROM (SELECT PK_KH FROM V_FENLEI VA
WHERE XSD= (SELECT MAX(XSD)
             FROM V_FENLEI
             WHERE PK_KH=VA.PK_KH))I
             LEFT JOIN
(select 
  CASE WHEN A.PK_KH=B.PK_KH THEN '非流失'
   ELSE '流失'
     END QNKHZT,
  A.PK_KH
  FROM
  (select DISTINCT PK_KH from f_sales
WHERE PK_KH IN (SELECT DISTINCT PK_KH FROM BD_GSKH WHERE QJ=to_char(add_months(sysdate,-0),'yyyy-mm'))
AND SUBSTR(DBILLDATE,0,7)=to_char(add_months(sysdate,-12),'yyyy-mm')
  AND NVL(TYNUM,0)&lt;&gt;0
 
  GROUP BY PK_KH)A

  left join 
  (select DISTINCT PK_KH,SUM(TYNUM)AS XL FROM f_sales
  WHERE PK_KH IN (SELECT DISTINCT PK_KH FROM BD_GSKH WHERE QJ=to_char(add_months(sysdate,-0),'yyyy-mm'))
  AND SUBSTR(DBILLDATE,0,7)=to_char(add_months(sysdate,-12),'yyyy-mm')
 
  GROUP BY PK_KH)B 
  on A.PK_KH=B.PK_KH)O
  on I.PK_KH=O.PK_KH
  </sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema />
    <remotesteps>
