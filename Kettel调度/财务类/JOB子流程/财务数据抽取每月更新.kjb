      <name>合并期初和凭证</name>
      <description />
      <type>SQL</type>
      <sql>CREATE OR REPLACE VIEW V_CWDCSJ(NF,KJQJ,FZYEBS, GSBM,GSMC,KJKMBM,KJKM,LJJFSE,LJDFSE,F1,F2,F11,F13,F5,F4,F14,F18,BMMC, RYXM,YHBM,YHMC,YHJC, KHBM, KHMC,NBKSBM,NBKSMC,WBKSBM,WBKSMC,GYSBM,GYSMC,XJZHBM,XJZHMC)
AS 
SELECT NF,KJQJ,FZYEBS,GSBM, GSMC,KJKMBM,KJKM,LJJFSE,LJDFSE,F1,F2,F11,F13,F5,F4,F14,F18,BMMC,RYXM,YHBM,YHMC, YHJC,KHBM, KHMC,NBKSBM,NBKSMC,WBKSBM,WBKSMC,GYSBM,GYSMC,XJZHBM,XJZHMC FROM V_CWPZ
WHERE KJQJ&lt;&gt;'00'
UNION ALL
SELECT * FROM V_CWQC</sql>
