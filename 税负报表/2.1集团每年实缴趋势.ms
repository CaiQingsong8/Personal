        \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2018年\",\n            \"dataIndex\": \"y2\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2019年\",\n            \"dataIndex\": \"y3\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2020年\",\n            \"dataIndex\": \"y4\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2021年\",\n            \"dataIndex\": \"y5\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2022年\",\n            \"dataIndex\": \"y6\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2023年\",\n            \"dataIndex\": \"y7\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2024年\",\n            \"dataIndex\": \"y8\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"2025年\",\n            \"dataIndex\": \"y9\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        },\n        {\n            \"title\": \"合计\",\n            \"dataIndex\": \"total\",\n            \"align\": \"right\",\n            \"izShow\": \"Y\"\n        }\n    ]\n}",
