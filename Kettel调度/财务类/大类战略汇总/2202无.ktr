    <connection>fbdbuser</connection>
    <sql>
SELECT A.CLBM,A.GSBM,A.NF,'无' zlpl,2202 DLBM,
SUM(A.SL*B.SLBL)SL,SUM(A.JE*b.JEBL)JE
FROM
(
SELECT CLBM,cbdx,gsbm,nf,SUM(SL)sl,SUM(JE)je FROM (
SELECT SUBSTR(QJ,1,4)NF,GSBM,
CASE WHEN CLBM='1102030008' OR  CLBM='1102030005' OR CLBM='1102030006' OR CLBM='1102030009'  OR CLBM='1102030007'
  THEN '101'
WHEN CLBM='1101130003' OR CLBM='1101130004' OR CLBM='1101130001' OR CLBM='1101130002' OR
  CLBM='1101130006' OR  CLBM='1101130005'
  THEN '102'
WHEN CLBM='1101050001' OR CLBM='1101050002' OR CLBM='1101020010'
  THEN '103'
WHEN CLBM='1102120005' OR CLBM='1102120008' OR CLBM='1102120003'
  THEN '104'
WHEN CLBM='1110040009' OR CLBM='1110040005' OR CLBM='1110040012' OR
     CLBM='1110040010' OR CLBM='1110040018' OR
     CLBM='1110040006' OR CLBM='1110040023' OR CLBM='1110040019' OR
     CLBM='1110040017'
  THEN '105'
WHEN CLBM='1102020001' OR CLBM='1102020002'
  THEN '106'
WHEN CLBM='1110020002' OR CLBM='1110020005' OR CLBM='1110020007' OR
     CLBM='1110050001'
  THEN '109'
  WHEN CLBM LIKE '32%'
  THEN '107'
  WHEN CLBM LIKE '6%'
  THEN '108'
    ELSE CLBM
      END CLBM,cbdx,
SUM(CLSL)SL,SUM(CBJE)JE FROM cb_trcc_ipo
WHERE CBDX LIKE '5%'
and hsysbm like '02%'
AND CBDX IN (
select distinct clbm from cb_trcc_ipo
where cbdx like '2%'
and clbm like '5%'
and zlplmc='无'
AND DLBM='2202'
--and cbdx in (2204010036,2204010037,2204010038,2204010039,2204010040,2204010041,2204010042,2204010043,2204010044,2204010045,2204010046,2204010050,2204010053,2204010059,2204010060,2204010061,2204010062,2204010063,2204010064,2204010065,2204010066,2204010067,2204010068,2204010069,2204010070,2204010071,2204010074,2204010075,2204010076,2204010077,2204010078,2204010079,2204010080,2204010081,2204010082,2204010083,2204010084,2204010085,2204010087,2204010088,2204010089,2204010090,2204010091,2204010092,2204010095,2204010096,2204010097,2204010098,2204010099,2204010100,2204010102,2204010103,2204010104,2204010105,2204010106,2204010107,2204010109,2204010110,2204010111,2204010112,2204010113,2204010114,2204010116,2204010117,2204010118,2204010119,2204010120,2204010121,2204010122,2204010123,2204010124,2204010125,2204010126,2204010127,2204010128,2204010129,2204010130,2204010131,2204010132,2204010133,2204010134,2204010135,2204010136,2204010137,2204010138,2204010139,2204010140,2204010141,2204010142,2204010143,2204010144,2204010145,2204010146,2204010147,2204010148,2204010149,2204010150,2204010151,2204010152,2204010153,2204010156,2204010157,2204010158,2204010159,2204010160,2204010161,2204010162,2204010163,2204010164,2204010165,2204010166,2204010167,2204010168,2204010169,2204010170,2204010172,2204010173,2204010174,2204010175,2204010176,2204010192,2204010193,2204010194,2204010195,2204010196,2204010199,2204010200,2204010203,2204010204,2204010205,2204010206,2204010207,2204010208,2204010209,2204010210,2204010211,2204010212,2204010213,2204010214,2204010215,2204010216,2204010217,2204010218,2204020050,2204020051,2204020052,2204020053,2204020054,2204030019,2204030020,2204030021,2204030022,2204060007,2204060008,2204140001,2204140002,2204140003,2204140004,2204140005,2204140006,2204140007
