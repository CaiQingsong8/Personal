    <connection>ncread</connection>
    <sql>select A.pk_marbasclass FLZJ,
       A.CODE           FLBM4,
       A.NAME           FLMC4,
       B.CODE           FLBM3,
       B.NAME           FLMC3,
       C.CODE           FLBM2,
       C.NAME           FLMC2,
       D.CODE           FLBM1,
       D.NAME           FLMC1,
       A.enablestate    FLZT
  from bd_marbasclass A
  LEFT JOIN bd_marbasclass B
    ON A.pk_parent = B.pk_marbasclass
  LEFT JOIN bd_marbasclass C
    ON B.pk_parent = C.pk_marbasclass
  LEFT JOIN bd_marbasclass D
    ON C.pk_parent = D.pk_marbasclass
WHERE A.DR='0'</sql>
    <limit>0</limit>
    <lookup />
