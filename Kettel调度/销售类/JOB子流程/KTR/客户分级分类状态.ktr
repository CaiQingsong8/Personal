  <step>
    <name>水产类是否流失</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>aohuafr</connection>
    <sql>SELECT YXZJH,
 CASE WHEN SUM(TYNUM)=0 THEN '流失'
 ELSE '非流失' end KHZT
FROM F_SALES
WHERE （SJFLBM LIKE '22__'） AND （DBILLDATE BETWEEN to_char(add_months(sysdate,-6),'yyyy-mm-dd') AND to_char(sysdate,'yyyy-mm-dd')）
GROUP BY YXZJH</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
