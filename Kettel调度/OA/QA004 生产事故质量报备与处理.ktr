      <schema_name />
    </partitioning>
    <connection>OA</connection>
    <sql>select
a.bianh    --编号
,b.lastname SHENQR   --申请人
,c.DEPARTMENTNAME shenqbm    --申请部门
,a.shenqrq    --申请日期
,e.SUBCOMPANYDESC gsmc    --所属公司
,e.SUBCOMPANYname gsjc    --公司简称
,case when a.cpbm is null then a.cpbm1 else a.cpbm end cpbm   --产品编码（停用）
,a.cpmc    --产品名称
,a.scds    --生产吨数
,a.sgjg    --事故描述
,a.cshg    --产生后果
,a.gcyj    --工厂应急处理方案
,case a.zyzrr when 0 then '原料仓管员' 
when 1 then '成品仓管员'
when 2 then '大料投料工'
when 3 then '叉车工'
when 4 then '巡仓工'
when 5 then '制粒工'
when 6 then '小料配料工'
when 7 then '小料投料工'
when 8 then '中控员'
when 9 then '打包工'
when 10 then '跟班质检员'
when 11 then '原料验收员'
when 12 then '配方师'
when 13 then '其他责任人'end zyzrr    --生产异常主要事故责任人
,a.qtzrr    --生产异常其他责任人
,case a.zyyy  when 0 then '原料使用错误'
when 1 then '窜仓'
when 2 then '添加剂错误'
when 3 then '岗位操作错误'
when 4 then '未按照流程清理'
when 5 then '标准需变更'
when 6 then '配方设计错误'
when 7 then '检修后未检查'
when 8 then '岗位交接错误'
when 9 then '设备故障'
when 10 then '新配方试验生产'
when 11 then '未按照标准生产'
when 12 then '经验生产'
when 13 then '过程未按照标准检查'
when 14 then '未按标准执行配方' end zyyy --生产异常主要原因
,a.qtyy    --生产异常其他原因
,f.scsgmc scsgzyyy    --生产事故主要原因
,a.scsgbh    --生产事故上级编号
,a.scsglb    --生产事故类别
,g.lastname dyfzr    --分子公司第一负责人
,case a.cpx when 0 then '虾蟹料线'
when 1 then '畜禽料线'
when 2 then '海特料线'
when 3 then '普鱼料线' end cpx--产品线
,case a.sfpfwt when 0 then '是' when 1 then '否' end sfpfwt   --是否属于配方问题
,a.ponc    --初判PONC值（元）
,H.CREATEDATE||' '||H.CREATETIME CJSJ --流程创建时间
from formtable_main_176 a
left join HrmResource b
on a.shenqr=b.id
left join hrmdepartment c
on a.shenqbm=c.id
left join hrmsubcompany e
on a.suosgs=e.id
left join uf_scsglx f  --生产事故类型
--on a.scsgzyyy ='2701_'||f.scsgbh
on substr(a.scsgzyyy,instr(a.scsgzyyy,'2701_')+5)=f.scsgbh
left join HrmResource g
on a.dyfzr=g.id
left join workflow_requestbase H
on a.requestid = H.requestid
where H.currentnodetype = 3     --3是归档状态</sql>
    <limit>0</limit>
