  <step>
    <name>抽取销售对账单数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT substr(so_saleinvoice.dbilldate, 1, 10)  query_date,--查询时间
       org.name                                 corp_name,--公司组织
       c.name                                   customer_name,--客户姓名
       c.code                                   customer_code, --客户编码
       d.name                                   salesman_name, --业务员
       E.memo                                   department_name,--部门
       substr(so_saleinvoice.dbilldate, 1, 10)  bill_date,--单据日期
       bd_billtype.billtypename                 bill_type,--订单类型
       so_saleinvoice_b.vfirstcode              bill_code,--单据号
       m.materialmnecode                        product_code,--产品编码
       n.name||' '||m.name                           material_brand_name,--物料品名
       m.code                                   material_code,--物料编码
CASE WHEN m.code LIKE '2%'
THEN so_saleinvoice_b.nastnum
ELSE so_saleinvoice_b.nnum
END quantity,                                       --数量
CASE WHEN m.code LIKE '2%'
THEN so_saleinvoice_b.nnum
ELSE so_saleinvoice_b.nastnum
END main_quantity,                                          --主数量

                                 
       so_saleinvoice_b.norignetprice            settle_unit_price,--结算单价
       so_saleinvoice_b.ntaxprice               tax_include_unit_price, --含税单价
       so_saleinvoice_b.norigdiscount           discount_amount, --折扣额
       (so_saleinvoice_b.nnum)*(so_saleinvoice_b.nqtorigtaxprice) invoice_amount, --开票金额
case when so_saleinvoice_b.blargessflag='Y'
THEN 0
ELSE so_saleinvoice_b.ntaxmny END                settle_amount,--结算金额
       '--'                                     receivable_remarks,--应收备注
       0.00                                     received_amount,--收款金额
       so_saleinvoice_b.blargessflag            gift_type,--赠品
       so_saleinvoice_b.csaleinvoicebid         sale_invoice_id，
       0.00                                     rebate_amount,--返款金额
       '--'                                    payer_relation
  from so_saleinvoice so_saleinvoice
  left join so_saleinvoice_b so_saleinvoice_b
    on so_saleinvoice_b.csaleinvoiceid = so_saleinvoice.csaleinvoiceid
  left join bd_billtype bd_billtype
    on so_saleinvoice.ctrantypeid = bd_billtype.pk_billtypeid
  left join bd_material m
    on so_saleinvoice_b.cmaterialid = m.pk_material
  left join bd_marbasclass l
    on m. pk_marbasclass=l.pk_marbasclass
  left join bd_branddoc n
    on m.pk_brand = n.pk_brand
  left join org_orgs org
    on so_saleinvoice_b.pk_org = org.pk_org
  left join bd_customer c
    on so_saleinvoice.cinvoicecustid = c.pk_customer
  LEFT JOIN  bd_custsale bd_custsale
    ON c.pk_customer=bd_custsale.pk_customer 
    AND bd_custsale.PK_ORG=org.pk_org
  left join bd_psndoc d
    on bd_custsale.respperson  =d.pk_psndoc
  LEFT JOIN org_dept E
    ON so_saleinvoice_b.cdeptid=E.pk_dept
 where so_saleinvoice.dr = 0
   and so_saleinvoice_b.dr = 0
   
   
union
--应收单数据，仅包含直接在应收系统做应收单的部分，不含期初
select substr(ar_recbill.billdate, 1, 10) query_date,
       org.name corp_name,
       c.name customer_name,
       c.code customer_code,
       d.name salesman_name,
       E.memo department_name,
       substr(ar_recbill.billdate, 1, 10) bill_date,
       bd_billtype.billtypename bill_type,
       ar_recbill.billno bill_code,
       m.code product_code,
        n.name||' '||m.name material_brand_name,
       m.code material_code,
       0 quantity,
       0 main_quantity,
       0 settle_unit_price,
       0 tax_include_unit_price,
       0.00 discount_amount,
       0.00 invoice_amount,
       ar_recitem.local_money_de settle_amount,
       ar_recitem.def1 receivable_remarks,
       0.00 received_amount,
       'N' gift_type,
       ar_recitem.pk_recitem sale_invoice_id，
       0.00 rebate_amount,
       '--'                                    payer_relation
  from ar_recbill ar_recbill
  left join ar_recitem ar_recitem
    on ar_recitem.pk_recbill = ar_recbill.pk_recbill
  left join bd_billtype bd_billtype
    on ar_recbill.pk_tradetypeid = bd_billtype.pk_billtypeid
  left join bd_material m
    on ar_recitem.material = m.pk_material
  left join bd_branddoc n
    on m.pk_brand = n.pk_brand
  left join org_orgs org
    on ar_recitem.pk_org = org.pk_org
  left join bd_customer c
    on ar_recitem.customer = c.pk_customer
  LEFT JOIN  bd_custsale bd_custsale
    ON c.pk_customer=bd_custsale.pk_customer 
    AND bd_custsale.PK_ORG=org.pk_org
   left join bd_psndoc d
    on bd_custsale.respperson=d.pk_psndoc
   left join org_dept E
    ON ar_recitem.pk_deptid =E.pk_dept
where ar_recbill.dr = 0   
and ar_recitem.dr = 0 
and ar_recitem.objtype='0'
and ar_recbill.src_syscode='0'

union
--应收单数据，仅包含直接在应收系统做应收单的部分，不含期初
select DISTINCT substr(ar_recbill.billdate, 1, 10) query_date,
       org.name corp_name,
       c.name customer_name,
       c.code customer_code,
       d.name salesman_name,
       e.memo department_name,
       substr(ar_recbill.billdate, 1, 10) bill_date,
       bd_billtype.billtypename bill_type,
       ar_recbill.billno bill_code,
       NULL product_code,
       NULL material_brand_name,
       NULL material_code,
       0 quantity,
       0 main_quantity,
       0 settle_unit_price,
       0 tax_include_unit_price,
       0.00 discount_amount,
       0.00 invoice_amount,
       sum(ar_recitem.local_money_de)OVER(PARTITION BY ar_recbill.billno,org.name,C.CODE, ar_recitem.def1)  settle_amount,
       ar_recitem.def1 receivable_remarks,
       0.00 received_amount,
       'N' gift_type,
       NULL sale_invoice_id,
       0.00 rebate_amount,
'--'                                    payer_relation
  from ar_recbill ar_recbill
  left join ar_recitem ar_recitem
    on ar_recitem.pk_recbill = ar_recbill.pk_recbill
  left join bd_billtype bd_billtype
    on ar_recbill.pk_tradetypeid = bd_billtype.pk_billtypeid
  left join bd_material m
    on ar_recitem.material = m.pk_material
  left join bd_branddoc n
    on m.pk_brand = n.pk_brand
  left join org_orgs org
    on ar_recitem.pk_org = org.pk_org
  left join bd_customer c
    on ar_recitem.customer = c.pk_customer
  LEFT JOIN  bd_custsale bd_custsale
    ON c.pk_customer=bd_custsale.pk_customer 
    AND bd_custsale.PK_ORG=org.pk_org
   left join bd_psndoc d
    on bd_custsale.respperson  =d.pk_psndoc
   left join org_dept E
    ON ar_recitem.pk_deptid =E.pk_dept
where ar_recbill.dr = 0   
and ar_recitem.dr = 0 
and ar_recitem.objtype='0'
and ar_recbill.src_syscode='3'
and ar_recbill.pk_tradetype&lt;&gt;'D0'


union
select substr(ar_gatherbill.billdate, 1, 10) query_date,
       org.name corp_name,
       c.name customer_name,
       c.code customer_code,
       d.name salesman_name,
       E.memo department_name,
       substr(ar_gatherbill.billdate, 1, 10) bill_date,
        bd_billtype.billtypename bill_type,
        ar_gatherbill.billno bill_code,
       '--' product_code,
       '--' material_brand_name,
       '--' material_code,
       0.00 quantity,
       0.00 main_quantity,
       0.00 settle_unit_price,
       0.00 tax_include_unit_price,
       0.00 discount_amount,
       0.00 invoice_amount,
       0.00 settle_amount,
       bd_balatype.name||'；'||ar_gatheritem.def1 receivable_remarks,
       ar_gatheritem.local_money_cr received_amount,
        '-' gift_type,
       ar_gatheritem.pk_gatheritem sale_invoice_id,
       0.00 rebate_amount,
         CASE WHEN L.NAME IS NULL
         THEN '本人'
           ELSE ar_gatheritem.DEF5||'('||l.NAME||')'
             END payer_relation
  from ar_gatherbill ar_gatherbill
  left join ar_gatheritem ar_gatheritem
    on ar_gatheritem.pk_gatherbill = ar_gatherbill.pk_gatherbill
  left join bd_balatype bd_balatype
    on ar_gatheritem.pk_balatype=bd_balatype.pk_balatype
  left join bd_billtype bd_billtype
    on ar_gatherbill.pk_tradetypeid = bd_billtype.pk_billtypeid
  left join org_orgs org
    on ar_gatheritem.pk_org = org.pk_org
  left join bd_customer c
    on ar_gatheritem.customer = c.pk_customer
  LEFT JOIN  bd_custsale bd_custsale
    ON c.pk_customer=bd_custsale.pk_customer 
    AND bd_custsale.PK_ORG=org.pk_org
   LEFT JOIN bd_defdoc l
    ON ar_gatheritem.def4=l.pk_defdoc
   left join bd_psndoc d
    on bd_custsale.respperson  =d.pk_psndoc
   left join org_dept E
    ON ar_gatheritem.pk_deptid =E.pk_dept
where ar_gatherbill.dr=0 
and ar_gatheritem.dr=0 
and ar_gatheritem.objtype = 0


union

select DISTINCT substr(ar_recbill.billdate, 1, 10) query_date,
       org.name corp_name,
       c.name customer_name,
       c.code customer_code,
       d.name salesman_name,
       E.memo department_name,
       substr(ar_recbill.billdate, 1, 10) bill_date,
       bd_billtype.billtypename bill_type,
       ar_recbill.billno bill_code,
       NULL product_code,
       NULL material_brand_name,
       NULL material_code,
       0 quantity,
       0 main_quantity,
       0 settle_unit_price,
       0 tax_include_unit_price,
       0.00 discount_amount,
       0.00 invoice_amount,
       0.00 settle_amount,
       ar_recitem.def1 receivable_remarks,
       0.00 received_amount,
       'N' gift_type,
       NULL sale_invoice_id,
     sum(ar_recitem.local_money_de)OVER(PARTITION BY ar_recbill.billno,org.name,C.CODE, ar_recitem.def1) rebate_amount,
       '--'                                    payer_relation
  from ar_recbill ar_recbill
  left join ar_recitem ar_recitem
    on ar_recitem.pk_recbill = ar_recbill.pk_recbill
  left join bd_billtype bd_billtype
    on ar_recbill.pk_tradetypeid = bd_billtype.pk_billtypeid
  left join bd_material m
    on ar_recitem.material = m.pk_material
  left join bd_branddoc n
    on m.pk_brand = n.pk_brand
  left join org_orgs org
    on ar_recitem.pk_org = org.pk_org
  left join bd_customer c
    on ar_recitem.customer = c.pk_customer
  LEFT JOIN  bd_custsale bd_custsale
    ON c.pk_customer=bd_custsale.pk_customer 
    AND bd_custsale.PK_ORG=org.pk_org
   left join bd_psndoc d
    on bd_custsale.respperson=d.pk_psndoc
   left join org_dept E
    ON ar_recitem.pk_deptid =E.pk_dept
where ar_recbill.dr = '0'   
and ar_recitem.dr = '0' 
and ar_recitem.objtype='0'
and ar_recbill.src_syscode='3'
and bd_billtype.pk_billtypecode like 'F0%'
order by customer_name,bill_date</sql>
