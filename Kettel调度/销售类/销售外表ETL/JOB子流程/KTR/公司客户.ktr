  <step>
    <name>获取公司每月客户</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT V_GSMYKH.*,org_orgs.def1 GSDQ  FROM V_GSMYKH
LEFT JOIN (select C.DEF1,c.pk_org,C.pk_vid  from org_salesorg a
    left join org_orgs c
    on c.pk_vid=a.pk_vid) org_orgs 
    ON V_GSMYKH.PK_GS=org_orgs.pk_org
where gsbm&lt;&gt;'1018'
AND GSBM&lt;&gt;'1030'
</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema />
