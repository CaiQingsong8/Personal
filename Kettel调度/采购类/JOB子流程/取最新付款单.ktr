  </order>
  <step>
    <name>抽取修改数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT A.SRC_SYSCODE LYXT,--来源系统 0=应收系统，1=应付系统，2=现金管理，3=销售系统，4=采购系统，5=资金结算，6=网上银行，8=票据管理，9=协同单据，10=信贷系统，12=项目管理，13=全面预算，16=内部交易，17=外部交换平台，18=资金计息，19=库存管理，20=合同，24=运输，104=资产管理，105=费用管理，7=付款排程，109=零售系统，113=进出口系统，114=CRM，115=信用证管理
       D.CODE GSBM,
       D.NAME GSMC,
       C.CODE GYSBM,--供应商编码
       C.NAME GYSMC,--供应商名称
       B.PURCHASEORDER CGDDH,--采购订单号
       B.DEF1 CGRKDH,--采购入库单号
       B.MONEY_DE FKJE,--付款金额
       B.INVOICENO CGFPH,--采购发票号
       B.NOTAX_DE WSJE, --无税金额
       SUBSTR(A.BILLDATE,0,10) RQ,--单据日期
       B.pk_tradetype AS JYLX,
       A.PK_PAYBILL ZJ --主键
  
  FROM AP_PAYBILL A
  LEFT JOIN AP_PAYITEM B
    ON A.PK_PAYBILL = B.PK_PAYBILL
  LEFT JOIN BD_SUPPLIER C
    ON B.SUPPLIER = C.PK_SUPPLIER
  LEFT JOIN ORG_FINANCEORG D
    ON A.PK_ORG = D.PK_FINANCEORG
WHERE A.DR = 0
AND B.DR = 0
</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
