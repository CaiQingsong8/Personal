  <step>
    <name>抽取付款确认书和销售对账单数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>-- 取19年-20年-06 应收款明细,非收款单数据 
SELECT DISTINCT
       orgname orgname,
       custname custname,
       khbm khbm,
       ywry ywry,
       djrq djrq,
       djlx djlx,
       djbh djbh,
       cpbm cpbm,
       wlbm wlbm,
       cpmc cpmc,
       BID BID
       ,bs bs,
       ds ds,
       jsdj jsdj,
       hsdj hsdj,
       zke zke,
       kpje kpje,
       jsje jsje,
       ysbz  ysbz,
       skje skje,
       CASE WHEN djbh like 'YD%' OR djbh like 'XD%'
            THEN NVL(kpje,0)-NVL(jsje, 0) 
         ELSE 0
            END ZKJE,
       DKGXR DKGXR,
       T2.GSBM
       
FROM F_XSDZD T1
LEFT JOIN (
SELECT GSMC,GSBM FROM BD_GSDH ) T2
ON T2.GSMC = T1.orgname
WHERE 1=1
AND SUBSTR(T1.DJRQ,1,4)>='2019' and SUBSTR(T1.DJRQ,1,7)&lt;='2020-06' 
---AND T1.SKJE = '0' -- 判断是否做了收款单
AND T1.KHBM LIKE 'K1%'
-------------------------------------
union 

-- 取小于19年的所有数据
SELECT DISTINCT
       orgname orgname,
       custname custname,
       khbm khbm,
       ywry ywry,
       djrq djrq,
       djlx djlx,
       djbh djbh,
       cpbm cpbm,
       wlbm wlbm,
       cpmc cpmc,
       BID BID
       ,bs bs,
       ds ds,
       jsdj jsdj,
       hsdj hsdj,
       zke zke,
       kpje kpje,
       jsje jsje,
       ysbz  ysbz,
       skje skje,
       CASE WHEN djbh like 'YD%' OR djbh like 'XD%'
            THEN NVL(kpje,0)-NVL(jsje, 0) 
         ELSE 0
            END ZKJE,
       DKGXR DKGXR,
       T2.GSBM
       
FROM F_XSDZD T1
LEFT JOIN (
SELECT GSMC,GSBM FROM BD_GSDH ) T2
ON T2.GSMC = T1.orgname
WHERE 1=1
AND ( SUBSTR(T1.DJRQ,1,4)&lt;'2019'  )
AND T1.KHBM LIKE 'K1%'

union 

-- 取大于2020年06月的所有数据
SELECT DISTINCT
       orgname orgname,
       custname custname,
       khbm khbm,
       ywry ywry,
       djrq djrq,
       djlx djlx,
       djbh djbh,
       cpbm cpbm,
       wlbm wlbm,
       cpmc cpmc,
       BID BID
       ,bs bs,
       ds ds,
       jsdj jsdj,
       hsdj hsdj,
       zke zke,
       kpje kpje,
       jsje jsje,
       ysbz  ysbz,
       skje skje,
       CASE WHEN djbh like 'YD%' OR djbh like 'XD%'
            THEN NVL(kpje,0)-NVL(jsje, 0) 
         ELSE 0
            END ZKJE,
       DKGXR DKGXR,
       T2.GSBM
       
FROM F_XSDZD T1
LEFT JOIN (
SELECT GSMC,GSBM FROM BD_GSDH ) T2
ON T2.GSMC = T1.orgname
WHERE 1=1
AND ( SUBSTR(T1.DJRQ,1,7)>'2020-06'  )
AND T1.KHBM LIKE 'K1%'

union 
-- 付款确认书数据
SELECT T1.GSMC , T1.KHMC , T1.KHBM , T1.YWYMC , T1.DJRQ , NULL , T1.DJH , NULL, NULL , NULL , NULL
        ,NULL, NULL ,NULL,NULL,NULL,NULL,NULL , T1.JSFS , T1.SKJE , NULL , 
CASE WHEN T1.GX='本人'
  THEN T1.GX
    ELSE T1.DKR||'('||T1.GX||')'
      END DKGXR,
null
FROM CW_FKQRS T1
WHERE 1=1
AND SUBSTR(T1.DJRQ,1,7) >= '2019-01'  AND SUBSTR(T1.DJRQ, 1,7) &lt;= '2020-06'

ORDER BY GSBM,YWRY,khbm,djrq,djbh

</sql>
