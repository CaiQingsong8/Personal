  <step>
    <name>获取公司去年前一个月客户</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>WITH AA AS(
SELECT YXZJH,GSDQ,KHMC,
 (CASE WHEN XSMC LIKE '%事业部' then xsmc
 else GSMC END) GSMC,
SUBSTR (TO_CHAR(ADD_MONTHS(SYSDATE,-2),'YYYY-MM-DD'),1,7 ) QJ --生成去年同期的上一个月
FROM F_SALES TA
WHERE DBILLDATE=(SELECT MAX(DBILLDATE)
                 FROM F_SALES 
                 WHERE YXZJH=TA.YXZJH
                  AND (SUBSTR(DBILLDATE,1,7) BETWEEN SUBSTR (TO_CHAR(ADD_MONTHS(SYSDATE,-4),'YYYY-MM-DD'),1,7 ) AND SUBSTR (TO_CHAR(ADD_MONTHS(SYSDATE,-2),'YYYY-MM-DD'),1,7 ))  --"-15是去年同期往前推3个月"，-13是去年同期往前一个月
                  AND F_SALES.GSJC &lt;&gt; '淮安澳宝'
                  AND F_SALES.KHFLBM='K1'
                  AND F_SALES.KHCODE&lt;&gt; '1006' --排除 东莞市年丰饲料有限公司
                  AND F_SALES.KHCODE&lt;&gt; 'K210363' --排除 (停用)浙江澳凌水产种业科技有限公司
                  AND F_SALES.KHCODE&lt;&gt; 'K108844' --排除 浙江澳凌水产种业科技有限公司
                  AND F_SALES.KHCODE&lt;&gt; 'K104907'-- 排除 怀集县骏彬畜牧发展有限公司               
                )
),
 BB AS(
SELECT  F_SALES.YXZJH,
        (CASE WHEN SUBSTR (RP_KHTHRQ.dbilldate,1,4) = TO_CHAR(ADD_MONTHS(SYSDATE,0),'YYYY')  THEN '新客户'
        else '老客户' end )XLKH,
        SUM(F_SALES.xsd) ZXSD,
        
        SYSDATE  ts
FROM F_SALES,RP_KHTHRQ

WHERE  (F_SALES.DBILLDATE_YEAR||'-'||F_SALES.DBILLDATE_MONTH BETWEEN to_char(add_months(sysdate,-13),'yyyy-mm') AND to_char(add_months(sysdate,-2),'yyyy-mm')) 

AND (F_SALES.SJFLBM LIKE '22__' OR F_SALES.SJFLBM LIKE'21__') 

AND F_SALES.YXZJH=RP_KHTHRQ.YXZJH

GROUP BY F_SALES.YXZJH, (CASE WHEN SUBSTR (RP_KHTHRQ.dbilldate,1,4) = TO_CHAR(ADD_MONTHS(SYSDATE,0),'YYYY')  THEN '新客户'
                        else '老客户' end )
ORDER BY F_SALES.YXZJH
)

SELECT DISTINCT AA.YXZJH,AA.GSDQ,AA.KHMC,AA.GSMC,AA.QJ,BB.YXZJH,BB.XLKH,BB.ZXSD,BB.TS FROM AA
LEFT JOIN BB
ON AA.YXZJH=BB.YXZJH</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
