    <connection>OA</connection>
    <sql>SELECT
DISTINCT
C.LASTNAME SHENQR,--申请人
B.applyDate SHENQRQ,--申请日期
D.DEPARTMENTNAME SHENQBM,--申请部门
E.SUBCOMPANYDESC GSMC,--公司全称
E.SUBCOMPANYNAME GSJC,--公司简称
A.PIH,-- 批号
A.JIANCRQ,-- 检测日期
A.SHENGCRQ,-- 生产日期 
A.PEIFRQ,-- 配方日期
A.CPBM,-- 产品编码
A.CHANPMC,-- 产品名称
A.CHANPLB,-- 产品类别
A.CHANPDH,-- 产品代号
A.CHANL,-- 产量/吨
A.SHUIFJC,-- 水分检测值
A.CDBJC,-- 粗蛋白检测值
A.SUOSTQCZF,-- 索氏提取法粗脂肪 （%）
A.SUANSJCZF,-- 酸水解粗脂肪 （%）
A.CUHFJC,-- 粗灰分
A.GAIJC,-- 钙   
A.ZONGLJC,-- 总磷 
A.LVHNJC,-- 氯化钠 
A.CUXWJC,-- 粗纤维 
A.PAND,-- 判定
A.BEIZ,-- 备注
A.SHUIFSDZ,-- 水分配方设定值%
A.CUDBSDZ,-- 粗蛋白配方设定值%
A.CUZFSDZ,-- 粗脂肪配方设定值%
A.CUHFSDZ,-- 粗灰分配方设定值%
A.GAISDZ,-- 钙配方设定值%
A.ZONGLSDZ,-- 总磷配方设定值%
A.LVHNSDZ,-- 氯化钠配方设定值%
A.CUXWSDZ,-- 粗纤维配方设定值%
A.CUDBPDZ1,-- 粗蛋白+判定值
A.CUDBPDZ2,-- 粗蛋白-判定值
A.GAIPDZ1,-- 钙+判定值
A.GAIPDZ2,-- 钙-判定值
A.ZONGLPDZ1,-- 总磷+判定值
A.ZONGLPDZ2,-- 总磷-判定值
B.BIANH, --流程编号
CASE WHEN H.STATUS LIKE '%归档%' THEN '归档'
WHEN H.STATUS IS NULL THEN '申请人发起'
ELSE H.STATUS END STATUS, --流程当前节点
H.CREATEDATE||' '||H.CREATETIME CJSJ --流程创建时间
FROM formtable_main_227_dt1 A --成品检测流程明细表
LEFT JOIN formtable_main_227 B --成品检测流程主表
ON A.MAINID = B.ID
LEFT JOIN HrmResource C --人力资源表
ON C.ID = B.applicant
LEFT JOIN hrmdepartment D --部门表
ON D.ID = B.applyDep
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = B.SUOSGS
LEFT JOIN workflow_requestbase H--工作流基本信息表
ON B.REQUESTID = H.REQUESTID
WHERE H.currentnodetype = 3

AND E.SUBCOMPANYDESC||A.PIH||A.JIANCRQ||A.SHENGCRQ||A.PEIFRQ||A.CPBM||H.CREATEDATE||' '||H.CREATETIME IN
(
SELECT GSMC||PH||JCRQ||SCRQ||PFRQ||CPBM||CJSJ FROM
(
SELECT
E.SUBCOMPANYDESC GSMC,--公司全称
A.PIH PH,-- 批号
A.JIANCRQ JCRQ,-- 检测日期
A.SHENGCRQ SCRQ,-- 生产日期 
A.PEIFRQ PFRQ,-- 配方日期
A.CPBM,-- 产品编码
MAX(H.CREATEDATE||' '||H.CREATETIME) CJSJ --流程创建时间
FROM formtable_main_227_dt1 A --成品检测流程明细表
LEFT JOIN formtable_main_227 B --成品检测流程主表
ON A.MAINID = B.ID
LEFT JOIN HrmResource C --人力资源表
ON C.ID = B.applicant
LEFT JOIN hrmdepartment D --部门表
ON D.ID = B.applyDep
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = B.SUOSGS
LEFT JOIN workflow_requestbase H--工作流基本信息表
ON B.REQUESTID = H.REQUESTID
WHERE 1=1
GROUP BY E.SUBCOMPANYDESC,A.PIH,A.JIANCRQ,A.SHENGCRQ,A.PEIFRQ,A.CPBM
)
)
</sql>
