    <connection>finereport_fbdbuser</connection>
    <sql>WITH BB AS    --单独处理应付、预收账款，需要先按客户进行累计，再选出每月累计额大于0的进行累加，作为应收账款，小于0的进行累加，作为预收账款
( SELECT NF,GSMC,GSBM,KJKMBM,KJKM,KHBM,KHMC,KJQJ,JFSE,DFSE,JDFSE,SUM(JDFSE) over(partition by NF,GSMC,KJKMBM,KJKM,KHBM,KHMC order by KJQJ)LJJDFSE
   FROM CW_DCSJ
  WHERE KJKMBM='1122'
)
SELECT DISTINCT NF,KJKMBM,KJKM,KHBM,KHMC,GSMC,GSBM FROM BB
WHERE NF>=to_char(add_months(sysdate,-13),'yyyy')   --应收账款


</sql>
