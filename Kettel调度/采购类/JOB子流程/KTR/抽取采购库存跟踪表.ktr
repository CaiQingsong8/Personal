  <step>
    <name>抽取采购库存跟踪数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>SELECT A.GSBM,A.GSMC,A.SJWLFLBM,A.SJWLFLMC,A.WLFLBM,A.WLFLMC,A.WLBM,A.WLMC,
       NVL(B.JRRK,0)*1 JRRK,
       NVL(C.JRJC,0)*1 JRJC,
       NVL(D.JRCK,0)*1 JRCK,
       NVL(E.BYRK,0)*1 BYRK,
       NVL(F.BYCK,0)*1 BYCK,
       NVL(G.SYZTSL,0)*1 SYZTSL,
       NVL(H.JQZTSL,0)*1 JQZTSL,
       NVL(I.YSYL,0)*1 YSYL,
       NVL(J.MRYL,0)*1 MRYL,
       NVL(K.AQTS,0)*1 AQTS
FROM
--公司、物料
(SELECT DISTINCT GSBM,GSMC,WLBM,WLMC,SJWLFLBM,SJWLFLMC,WLFLBM,WLFLMC
FROM F_CGZB
WHERE (WLBM LIKE '1%' OR WLBM LIKE '41%')
ORDER BY GSBM,GSMC) A

--今日入库
LEFT JOIN
(SELECT DISTINCT GSBM,GSMC,WLBM,WLMC,SUM(SSZSL) JRRK
FROM F_CGRKD
WHERE RKRQ = TO_CHAR(SYSDATE-1,'YYYY-MM-DD')
GROUP BY GSBM,GSMC,WLBM,WLMC) B
ON A.GSBM = B.GSBM AND A.WLBM = B.WLBM

--今日结存
LEFT JOIN
(SELECT GSBM,WLBM,SUM(JRJC) JRJC
FROM CG_JRJC
WHERE CKMC LIKE '%原料%'
GROUP BY GSBM,WLBM) C
ON A.GSBM = C.GSBM AND A.WLBM = C.WLBM

--今日出库
LEFT JOIN
(SELECT DISTINCT GSBM,WLBM,SUM(ZSL) JRCK
FROM F_CLCKD
WHERE CKRQ = TO_CHAR(SYSDATE-1,'YYYY-MM-DD')
GROUP BY GSBM,WLBM) D
ON A.GSBM = D.GSBM AND A.WLBM = D.WLBM

--本月入库
LEFT JOIN
(SELECT DISTINCT GSBM,WLBM,SUM(SSZSL) BYRK
FROM F_CGRKD
WHERE SUBSTR(RKRQ,1,7) = TO_CHAR(SYSDATE-1,'YYYY-MM')
GROUP BY GSBM,WLBM) E
ON A.GSBM = E.GSBM AND A.WLBM = E.WLBM

--本月出库
LEFT JOIN
(SELECT DISTINCT GSBM,WLBM,SUM(ZSL) BYCK
FROM F_CLCKD
WHERE SUBSTR(CKRQ,1,7) = TO_CHAR(SYSDATE-1,'YYYY-MM')
GROUP BY GSBM,WLBM) F
ON A.GSBM = F.GSBM AND A.WLBM = F.WLBM

--所有在途合同
LEFT JOIN 
(SELECT M.GSBM,M.WLBM,SUM(M.ZTSL) SYZTSL
FROM
( SELECT X.GSBM,X.WLBM,SUM(X.CGSL)/Z.RKDS-SUM(NVL(Y.SSZSL,0)) ZTSL
  FROM F_CGZB X
  LEFT JOIN F_CGRKD Y 
  ON X.WLBM = Y.WLBM AND X.GSBM = Y.GSBM AND X.DJBH = Y.LYDJH
  LEFT JOIN
(   SELECT AA.GSBM,AA.WLBM,AA.DJBH,COUNT(NVL(BB.LYDJH,0)) RKDS
    FROM F_CGZB AA
	LEFT JOIN F_CGRKD BB 
    ON AA.WLBM = BB.WLBM AND AA.GSBM = BB.GSBM AND AA.DJBH = BB.LYDJH
    GROUP BY AA.GSBM,AA.WLBM,AA.DJBH) Z
  ON X.WLBM = Z.WLBM AND X.GSBM = Z.GSBM AND X.DJBH = Z.DJBH
  WHERE X.SFGB = 'N'
  AND X.DJZT = '3'
  AND SUBSTR(X.DJRQ,1,10) >= TO_CHAR(ADD_MONTHS(SYSDATE-1,-12),'YYYY-MM-DD')
  GROUP BY  X.GSBM,X.WLBM,Z.RKDS) M
GROUP BY M.GSBM,M.WLBM) G
ON A.GSBM = G.GSBM AND A.WLBM = G.WLBM

--近30天在途合同
LEFT JOIN 
(SELECT N.GSBM,N.WLBM,SUM(N.ZTSL) JQZTSL
FROM
( SELECT O.GSBM,O.WLBM,SUM(O.CGSL)/Q.RKDS-SUM(NVL(P.SSZSL,0)) ZTSL
  FROM F_CGZB O
  LEFT JOIN F_CGRKD P
  ON O.WLBM = P.WLBM AND O.GSBM = P.GSBM AND O.DJBH = P.LYDJH
  LEFT JOIN
(   SELECT CC.GSBM,CC.WLBM,CC.DJBH,COUNT(NVL(DD.LYDJH,0)) RKDS
    FROM F_CGZB CC
    LEFT JOIN F_CGRKD DD 
    ON CC.GSBM = DD.GSBM AND CC.WLBM = DD.WLBM AND CC.DJBH = DD.LYDJH
    GROUP BY CC.GSBM,CC.WLBM,CC.DJBH,DD.LYDJH) Q
  ON O.GSBM = Q.GSBM AND O.WLBM = Q.WLBM AND O.DJBH = Q.DJBH
  WHERE O.SFGB = 'N'
  AND O.DJZT = '3'
  AND SUBSTR(O.DJRQ,1,10) >= TO_CHAR(SYSDATE-31,'YYYY-MM-DD')
  GROUP BY  O.GSBM,O.WLBM,Q.RKDS) N
GROUP BY N.GSBM,N.WLBM) H
ON A.GSBM = H.GSBM AND A.WLBM = H.WLBM

--本月预计用量
LEFT JOIN
(SELECT GSBM,WLBM,YSYL
FROM YS_WLYL
WHERE YSNF = TO_CHAR(SYSDATE-1,'YYYY')
AND YSYF = TO_CHAR(SYSDATE-1,'MM')) I
ON A.GSBM = I.GSBM AND A.WLBM = I.WLBM

--每日用量
LEFT JOIN
(SELECT GSBM,WLBM,ROUND(SUM(ZSL)/30,3) MRYL
FROM F_CLCKD
WHERE CKRQ >= TO_CHAR(SYSDATE-31,'YYYY-MM-DD')
GROUP BY GSBM,WLBM) J
ON A.GSBM = J.GSBM AND A.WLBM = J.WLBM

--安全天数
LEFT JOIN 
(SELECT GSBM,WLBM,AQTS
FROM CG_WLAQTS) K
ON A.GSBM = K.GSBM AND A.WLBM = K.WLBM</sql>
