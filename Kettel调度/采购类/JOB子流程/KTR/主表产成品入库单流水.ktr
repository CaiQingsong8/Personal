    <quoteString>N</quoteString>
    <sql>
DELETE FROM KC_CCPRK1 WHERE DJRQ >= TO_CHAR(TRUNC(ADD_MONTHS(SYSDATE, -3)), 'YYYY-MM-DD')</sql>
