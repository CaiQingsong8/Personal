  <step>
    <name>临时表输入</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>OA</connection>
    <sql>SELECT
	A.APPLICANT, --申请人
	A.APPLYDATE,--申请日期
	A.APPLYDEP,--申请部门
	A.BIANH, --编号
	A.GYSBM, --供应商编码
	A.GYSLX, --供应商类型
	A.GYSMC,--供应商名称
	A.HZSJ, --合作时间
	A.REQUESTID, --请求ID
	A.SQYFK, --申请应付款
	A.SUOSGS, --所属公司
	A.LCCJSJ --流程创建时间
FROM
	(
	SELECT
		A.APPLICANT, --申请人
		A.APPLYDATE, --申请日期
		A.APPLYDEP, --申请部门
		A.BIANH, --编号
		A.GYSBM, --供应商编码
		A.GYSLX, --供应商类型
		A.GYSMC, --供应商名称
		A.REQUESTID, --请求ID
		A.HZSJ, --合作时间
		A.SQYFK, --申请应付款
		A.SUOSGS, --所属公司
		B.CREATEDATE || ' ' || B.CREATETIME AS LCCJSJ --流程创建时间
	FROM
		formtable_main_215 A --预付款（定金）供应商资格申请单
		LEFT JOIN workflow_requestbase B --工作流请求基本信息表
		ON A.REQUESTID = B.REQUESTID 
	WHERE
		B.CURRENTNODETYPE = 3 --取已归档流程
	) A
	INNER JOIN (
	SELECT
		A.GYSBM,
		MAX( B.CREATEDATE || ' ' || B.CREATETIME ) AS LCCJSJ --如果一个供应商有多个额度取最新流程创建时间对应的那个额度
	FROM
		formtable_main_215 A
		LEFT JOIN workflow_requestbase B ON A.REQUESTID = B.REQUESTID 
	WHERE
		B.CURRENTNODETYPE = 3 --取已归档流程
	GROUP BY
		A.GYSBM 
	) B ON A.GYSBM = B.GYSBM 
	AND A.LCCJSJ = B.LCCJSJ</sql>
    <limit>0</limit>
