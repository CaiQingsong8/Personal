  <order>
    <hop>
      <from>抽取材料出库单数据</from>
      <to>插入材料出库单临时表</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>抽取材料出库单数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT DISTINCT
       A.CGENERALHID               CGENERALHID,  --材料出库单主键
       A.CORPOID                   GSZJ,         --公司主键
       SUBSTR(A.CREATIONTIME,1,10) CJRQ,         --创建日期
       SUBSTR(A.DBILLDATE,1,10)    DJRQ,         --单据日期
       SUBSTR(B.DBIZDATE,1,10)     CKRQ,         --出库日期
       C.CODE                      GSBM,         --公司编码
       C.NAME                      GSMC,         --公司名称
       C.SHORTNAME                 GSJC,         --公司简称
       M.NAME                      BMMC,         --部门名称
       G.BILLTYPENAME              CRKLX,        --出入库类型
       E.NAME                      CKMC,         --仓库名称
       D.CODE                      WLBM,         --物料编码
       D.NAME                      WLMC,         --物料名称
       B.NNUM                      ZSL,          --主数量
       B.NCOSTPRICE                DJ,           --单价
       B.NCOSTMNY                  CKJE,         --出库金额
       Y.CODE                      CBDXBM,       --成本对象编码
       Y.NAME                      CBDXMC,       --成本对象名称
       M.CODE                      WLFLBM,       --物料分类编码
       M.NAME                      WLFLMC,       --物料分类名称
       N.CODE                      SJWLFLBM,     --上级物料分类编码
       N.NAME                      SJWLFLMC,     --上级物料分类名称
       B.CROWNO                    CROWNO        --行号
FROM IC_MATERIAL_H A
LEFT JOIN org_dept M
ON A.cdptid=M.pk_dept
LEFT JOIN IC_MATERIAL_B B
ON A.CGENERALHID=B.CGENERALHID
LEFT JOIN ORG_STOCKORG C
ON A.CDRAWCALBODYOID=C.PK_STOCKORG
LEFT JOIN BD_MATERIAL D
ON B.CMATERIALVID=D.PK_MATERIAL
LEFT JOIN BD_STORDOC E
ON A.CWAREHOUSEID=E.PK_STORDOC
LEFT JOIN BD_MEASDOC F
ON B.CUNITID=F.PK_MEASDOC
LEFT JOIN BD_BILLTYPE G
ON A.CTRANTYPEID=G.PK_BILLTYPEID
LEFT JOIN bd_material Y
ON B.ccostobject=Y.PK_MATERIAL
LEFT JOIN BD_MARBASCLASS M
     ON D.PK_MARBASCLASS=M.PK_MARBASCLASS
LEFT JOIN BD_MARBASCLASS N
     ON M.PK_PARENT=N.PK_MARBASCLASS
WHERE  A.DR = 0
AND B.DR = 0
</sql>
    <limit>0</limit>
    <lookup>执行SQL脚本</lookup>
