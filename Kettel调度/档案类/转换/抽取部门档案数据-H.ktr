    <connection>nc65_ncread</connection>
    <sql>SELECT NDQMC AS DQMC, GSBM,GSMC,GSJC,BMPK,BMMC,BZ,QYZT FROM (
SELECT DQMC,GSBM,GSMC,GSJC,BMPK,BMMC,BZ,QYZT,
CASE GSMC 
WHEN '营口澳华农牧科技有限公司'  THEN 'NULL'
WHEN '惠州市澳华饲料有限公司'  THEN '华东大区'
WHEN '浙江澳凌水产种业科技有限公司'  THEN'华东大区'
WHEN '四会市澳华饲料有限公司'  THEN '华南大区'
WHEN '江门市澳华特种水产饲料有限公司'  THEN '华南大区'
WHEN '赣州澳华农牧有限公司'  THEN '华中大区'
WHEN '武汉澳华农牧科技有限公司'  THEN '华中大区'
WHEN '攀枝花澳华饲料有限公司'  THEN 'null'
WHEN '池州澳华生物科技有限公司'  THEN '华中大区'
WHEN '玉林市澳华农牧科技有限公司'  THEN '华南大区'
WHEN '浙江澳华饲料有限公司'  THEN '华东大区'
WHEN '深圳前海正信达贸易有限公司'  THEN '无'
WHEN '南京市澳华生物科技有限公司'  THEN '华东大区'
WHEN '四川澳华饲料有限公司'  THEN '华南大区'
WHEN '湛江市澳华水产饲料有限公司'  THEN '华南大区'
WHEN '江门市澳保生物科技有限公司'  THEN '华南大区'
WHEN '吉林省澳华来兴饲料有限公司'  THEN 'null'
WHEN '四会市澳联饲料有限公司'  THEN 'null'
WHEN '福建澳华农牧科技有限公司'  THEN '华东大区'
WHEN '惠州市澳源生物科技有限公司'  THEN '华东大区'
WHEN '衡阳市澳华生物科技有限公司'  THEN '华南大区'
WHEN '洛阳澳华饲料有限公司'  THEN '华中大区'
WHEN '深圳市澳华农牧有限公司长沙分公司'  THEN 'null'
WHEN '贵州澳华农牧科技有限公司'  THEN '华南大区'
WHEN '东莞市年丰饲料有限公司'  THEN 'null'
WHEN '荆州澳华农牧科技有限公司'  THEN '华中大区'
WHEN '深圳市澳华农牧有限公司天津分公司'  THEN 'null'
WHEN '越南澳华农牧科技有限公司'  THEN '无'
WHEN '江苏红膏饲料有限公司'  THEN 'null'
WHEN '江苏澳华生物科技研究院有限公司'  THEN '华东大区'
WHEN '武汉澳华农牧有限公司'  THEN '华中大区'
WHEN '香港澳华实业有限公司'  THEN '无'
WHEN '河北澳华生物科技有限公司'  THEN '无'
WHEN '益阳澳华农牧科技有限公司'  THEN '华中大区'
WHEN '岳阳澳华农牧科技有限公司'  THEN '华中大区'
WHEN '泰州市澳华农牧科技有限公司'  THEN '华东大区'
WHEN '吉林省澳华农牧有限公司'  THEN '华东大区'
WHEN '江门市澳华生物科技有限公司'  THEN '华南大区'
WHEN '广西澳华农牧科技有限公司'  THEN '华南大区'
WHEN '河南国森饲料有限公司'  THEN 'null'
WHEN '河南澳华饲料有限公司'  THEN 'null'
WHEN '江西澳华农牧科技有限公司'  THEN '华中大区'
WHEN '云南澳华生物技术有限公司'  THEN '华南大区'
WHEN '唐山市澳华生物科技有限公司'  THEN '华东大区'
WHEN '原本如食（深圳）贸易有限责任公司'  THEN '畜禽事业部'
WHEN '深圳市伟凝科技有限公司'  THEN '无'
WHEN '淮安市澳华农牧有限公司'  THEN '华东大区'
WHEN '湖南澳华农牧科技有限公司'  THEN '华中大区'
WHEN '湖南澳源生物科技有限公司'  THEN '华南大区'
WHEN '淮安市澳宝生物科技有限公司'  THEN '华东大区'
end as NDQMC
FROM (
SELECT
C.NAME DQMC,--大区名称
B.CODE GSBM，--销售组织编码
B.name GSMC，--销售组织名称
B.SHORTNAME GSJC,--销售组织简称
A.pk_vid BMPK,--部门主键
A.name BMMC,--部门名称
CASE WHEN A.memo IS NULL THEN B.name ELSE A.memo END BZ,--备注
CASE WHEN A.enablestate = 1 THEN '未启用'
WHEN A.enablestate = 2 THEN '已启用'
WHEN A.enablestate = 3 THEN '已停用'
ELSE '未知' END QYZT--启用状态
FROM org_dept A --部门
LEFT JOIN org_orgs B --组织
ON A.pk_org = B.pk_org
LEFT JOIN bd_defdoc C
ON B.def1 = C.pk_defdoc
WHERE 1=1))
</sql>
