    <connection>finereport_fbdbuser</connection>
    <sql>
SELECT A.CORP_PK
     ,MAX(B.CORP_CODE) AS GSBM
     ,MAX(B.CORP_NAME) AS GSMC
     ,MAX(B.CORP_NAME) AS ORGNAME

	 ,A.CLIENT_PK
     ,MAX(B.CLIENT_CODE) AS KHBM
     ,MAX(B.CLIENT_NAME) AS KHMC
     ,MAX(B.CLIENT_NAME) AS CUSTNAME

     ,MAX(B.SALESMAN_NAME) AS YWRY
     ,MAX(B.SALESMAN_PK) AS YWRYPK

     ,MAX(COALESCE(A.BMMC,A.BMMC1)) AS BMMC
     ,MAX(C.GSDH) AS GSDH
	 ,A.DJYF AS DJRQ



     ,TO_CHAR(SUM(QCJE)) AS QCJE
     ,SUM(QCJE) AS QCJE1
     ,SUM(QMJE) AS QMJE
     ,TO_CHAR(SUM(JSJE)) AS JSJE
     ,SUM(JSJE) AS JSJE1
     ,TO_CHAR(SUM(SKJE)) AS SKJE
     ,SUM(SKJE) AS SKJE1
     ,SUM(FKJE) AS FKJE
     ,SUM(ZBS)  AS ZBS
     ,SUM(ZDS)  AS ZDS
     ,TO_CHAR(SUM(BS)) 	AS BS
     ,SUM(BS) 	AS BS1
     ,TO_CHAR(SUM(DS)) 	AS DS
     ,SUM(DS) 	AS DS1
     ,SUM(ZSBS)	AS ZSBS
     ,SUM(ZSDS)	AS ZSDS
     ,SUM(ZSDBBS)	AS ZSDBBS
     ,SUM(ZSDBDS)	AS ZSDBDS
     ,CASE WHEN SUM(abs(qcje)+abs(JSJE)+abs(SKJE)+abs(FKJE)+abs(ZBS))=0 THEN 1 ELSE 0 END AS DR
     ,TO_CHAR(SYSDATE,'YYYY-MM-DD HH24:MI:SS')		AS UPDTIME
FROM (
--发生明细
         SELECT  PK_ORG AS CORP_PK,
                 PK_CUSTOMER AS CLIENT_PK,
                 MAX(BMMC) AS BMMC,
                 NULL AS BMMC1,
                 DJYF,
                 0 AS QCJE,
                 0 AS QMJE,
                 SUM(JSJE) JSJE,
                 SUM(SKJE) SKJE,
                 SUM(FKJE) FKJE,
                 SUM(BS)   ZBS,
                 SUM(DS)   ZDS,
                 SUM(CASE WHEN blargessflag='N' THEN BS ELSE 0 END) AS BS,
                 SUM(CASE WHEN blargessflag='N' THEN DS ELSE 0 END) AS DS,
                 SUM(CASE WHEN blargessflag='Y' AND WLFLBM2&lt;&gt;'23' THEN BS ELSE 0 END) AS ZSBS,
                 SUM(CASE WHEN blargessflag='Y' AND WLFLBM2&lt;&gt;'23'  THEN DS ELSE 0 END) AS ZSDS,
                 SUM(CASE WHEN blargessflag='Y' AND WLFLBM2='23' THEN BS ELSE 0 END) AS ZSDBBS,
                 SUM(CASE WHEN blargessflag='Y' AND WLFLBM2='23'  THEN DS ELSE 0 END) AS ZSDBDS
         FROM F_XSDZD
         WHERE DJYF =  TO_CHAR(ADD_MONTHS(SYSDATE,-1),'yyyy-mm')
		 AND RN=1
         GROUP BY PK_ORG,PK_CUSTOMER,DJYF
         UNION ALL
--期初期末余额
         SELECT  PK_ORG AS CORP_PK,
                 CUSTOMER AS CLIENT_PK,
                 NULL AS BMMC,
                 B.DEPT_NAME AS BMMC1,
                 YEARMTH AS DJYF,
                 SUM(BALANCE-MONEY_DE+MONEY_CR) AS QCJE,
                 SUM(BALANCE) AS QMJE,
                 0 AS JSJE,
                 0 AS SKJE,
                 0 AS FKJE,
                 0 AS ZBS,
                 0 AS ZDS,
                 0 AS BS,
                 0 AS DS,
                 0 AS ZSBS,
                 0 AS ZSDS,
                 0 AS ZSDBBS,
                 0 AS ZSDBDS
         FROM FIN_BALANCE A
         LEFT JOIN F_XSDZD_DEPT B
         on A.PK_ORG = B.CORP_PK
         AND A.CUSTOMER=B.CLIENT_PK
         WHERE YEARMTH =  TO_CHAR(ADD_MONTHS(SYSDATE,-1),'yyyy-mm')
         GROUP BY PK_ORG,CUSTOMER,YEARMTH,B.DEPT_NAME
     )A
LEFT JOIN DIM_CLIENT b
on a.CORP_PK=b.CORP_PK
and a.CLIENT_PK=b.CLIENT_PK
LEFT JOIN (
    SELECT GSBM,MAX(GSDH) AS GSDH
    FROM BD_GSDH
    GROUP BY GSBM
)C
ON B.CORP_CODE=C.GSBM
GROUP BY A.CORP_PK,A.CLIENT_PK,A.DJYF

</sql>
