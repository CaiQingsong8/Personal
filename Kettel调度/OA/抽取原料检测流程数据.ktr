    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>OA</connection>
    <sql>SELECT
DISTINCT
C.LASTNAME SHENQR,--申请人
B.applyDate SHENQRQ,--申请日期
D.DEPARTMENTNAME SHENQBM,--申请部门
E.SUBCOMPANYDESC GSMC,--公司全称
E.SUBCOMPANYNAME GSJC,--公司简称
A.PIH,-- 批号
A.JIANCRQ,-- 检测日期
A.DAOHRQ,-- 到货日期
A.CHEPH,--车牌号
A.WLBM,-- 物料编码
A.YUANLMC,-- 原料名称
A.GYSBM,-- 供应商编码
A.GONGYSMC,-- 供应商名称
A.SHENGCCD,-- 生产产地/厂家
A.SHUL,-- 数量/吨
A.SHUIFCDZ,-- 水分测定值
A.SHUIFBZZ,-- 水分标准值
A.CUDBCDZ,-- 粗蛋白测定值
A.CUDBBZZ,-- 粗蛋白标准值
A.CUHFCDZ,-- 粗灰分测定值
A.CUHFBZZ,-- 粗灰分标准值
A.CUZFCDZ,-- 粗脂肪测定值
A.CUZFBZZ,-- 粗脂肪标准值
A.ZHENDB,-- 真蛋白（%）
A.ZHENCDBB,-- 真粗蛋白比（%）
A.DANBRJD,-- 蛋白溶解度（%）
A.CUXW,-- 粗纤维 （%）
A.GAI,-- 钙 （%）
A.ZONGL,-- 总磷 （%）
A.LVHN,-- 氯化钠（%）
A.VBN,-- VBN（mg/100g）
A.ZA,-- 组胺（mg/100g）
A.PH,-- PH
A.DIANJ,-- 碘价（g/100g）
A.SUANJ,-- 酸价（KOH)/g
A.GUOYHZ,-- 过氧化值(mmol/kg)
A.BINGTBRW,-- 丙酮不容物（%）
A.RONGZ,-- 容重(g/L)
A.MEIBL,-- 霉变粒（%）
A.AFB,-- AFB1/ppb
A.DON,-- DON/ppb
A.ZEN,-- ZEN/ppb
A.MIANJ,-- 面筋（%）
A.NIANDDX,-- 粘度（断线/秒）
A.NIANDLW,-- 粘度（流完/秒）
A.BUWSL,-- 不完善粒（%）
A.OUTMS,-- 呕吐毒素(PPm)
A.YUMCMXT,-- 玉米赤霉烯硐（ppb)
A.HUANGQMDS,-- 黄曲霉毒素B1（ppb)
A.PAND,-- 判定
A.BEIZ,-- 备注
B.BIANH, --流程编号
CASE WHEN H.STATUS LIKE '%归档%' THEN '归档'
WHEN H.STATUS IS NULL THEN '申请人发起'
ELSE H.STATUS END STATUS, --流程当前节点
H.CREATEDATE||' '||H.CREATETIME CJSJ --流程创建时间
FROM formtable_main_226_dt1 A --原料检测流程明细表
LEFT JOIN formtable_main_226 B --原料检测流程主表
ON A.MAINID = B.ID
LEFT JOIN HrmResource C --人力资源表
ON C.ID = B.applicant
LEFT JOIN hrmdepartment D --部门表
ON D.ID = B.applyDep
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = B.SUOSGS
LEFT JOIN workflow_requestbase H--工作流基本信息表
ON B.REQUESTID = H.REQUESTID
WHERE H.currentnodetype = 3
AND SUBSTR(H.CREATEDATE,1,10) >= TO_CHAR(SYSDATE-15,'YYYY-MM-DD')</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
