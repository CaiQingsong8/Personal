  <step>
    <name>临时表输入</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>OA</connection>
    <sql>SELECT A.GSBM,A.GSMC,A.WLBM,A.WLMC,A.BJRQ,A.DCBJ,A.YF,A.TBR,A.ID,A.TBRY FROM
(
SELECT 
A.GSBM, --公司编码
A.GSMC, --公司名称
A.WLBM, --物料编码
A.WLMC, --物料名称
REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(A.BJRQ,' ',''),'-1-','-01-'),'-2-','-02-'),'-3-','-03-'),'-4-','-04-'),'-7','-07'),'-8','-08'),'-9','-09') BJRQ, --报价日期
A.DCBJ, --到厂报价
A.YF, --运费
D.LASTNAME TBR, --填报人
'无' ID,
'无' TBRY,
C.CREATEDATE||' '||C.CREATETIME CJSJ --流程创建时间
FROM formtable_main_147_dt1 A --流程明细表
LEFT JOIN formtable_main_147 B --流程主表
ON A.MAINID = B.ID
LEFT JOIN workflow_requestbase C --工作流请求基本信息表
ON B.REQUESTID = C.REQUESTID
LEFT JOIN HrmResource D --人力资源表
ON D.ID = B.SHENQR
LEFT JOIN hrmdepartment E --部门表
ON E.ID = B.SHENQBM
LEFT JOIN hrmsubcompany F --分部表
ON F.ID = B.SUOSGS
LEFT JOIN hrmjobtitles G --岗位表
ON G.ID = B.ZHIW
WHERE 1=1
AND C.currentnodetype = 3 --归档
AND A.BJRQ >= '2021-01-01'--2021年1月1日正式切换，2020年全量更新
) A
INNER JOIN
(
SELECT 
A.GSBM, --公司编码
A.WLBM, --物料编码
REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(A.BJRQ,' ',''),'-1-','-01-'),'-2-','-02-'),'-3-','-03-'),'-4-','-04-'),'-7','-07'),'-8','-08'),'-9','-09') BJRQ, --报价日期
MAX(C.CREATEDATE||' '||C.CREATETIME) CJSJ --流程创建时间
FROM formtable_main_147_dt1 A --流程明细表
LEFT JOIN formtable_main_147 B --流程主表
ON A.MAINID = B.ID
LEFT JOIN workflow_requestbase C --工作流请求基本信息表
ON B.REQUESTID = C.REQUESTID
LEFT JOIN HrmResource D --人力资源表
ON D.ID = B.SHENQR
LEFT JOIN hrmdepartment E --部门表
ON E.ID = B.SHENQBM
LEFT JOIN hrmsubcompany F --分部表
ON F.ID = B.SUOSGS
LEFT JOIN hrmjobtitles G --岗位表
ON G.ID = B.ZHIW
WHERE 1=1
AND C.currentnodetype = 3 --归档
AND A.BJRQ >= '2021-01-01'--2021年1月1日正式切换，2020年全量更新
GROUP BY A.GSBM,A.WLBM,REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(A.BJRQ,' ',''),'-1-','-01-'),'-2-','-02-'),'-3-','-03-'),'-4-','-04-'),'-7','-07'),'-8','-08'),'-9','-09')
) B
ON A.GSBM = B.GSBM AND A.WLBM = B.WLBM AND A.BJRQ = B.BJRQ AND A.CJSJ = B.CJSJ</sql>
    <limit>0</limit>
