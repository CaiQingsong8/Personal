    <connection>OA</connection>
    <sql>WITH AA AS(
SELECT 
B.SUBCOMPANYDESC DWQC --单位全称
,B.SUBCOMPANYNAME DWJC --单位简称
,COUNT(*) SBSL --设备数量
FROM WV_AM_ASSETS_STOCK A  --库存信息表
LEFT JOIN HRMSUBCOMPANY B  --分部表
ON A.SUBID=B.ID
LEFT JOIN WV_AM_ASSETS C  --资产信息表
ON A.ASSETSID=C.ID
LEFT JOIN WV_AM_TYPE D  --资产分类表
ON C.TYPEID=D.ID
WHERE D.CODE LIKE 'Z03%'
AND B.SUBCOMPANYNAME !='测试分部'
GROUP BY B.SUBCOMPANYDESC,B.SUBCOMPANYNAME
), BB AS(  --上月巡检数量
SELECT DWQC,STATUS,COUNT(STATUS) SL
FROM (
SELECT 
CASE WHEN B.STATUS=0 THEN '漏检' WHEN B.STATUS=1 THEN '正常' ELSE '其他' END STATUS --巡检状态
,C.CODE JH_CODE --巡检计划编码
,C.NAME JH_NAME --选就计划名称
,D.CODE SB_CODE  --设备编码
,E.NAME SB_NAME --设备名称
,A.START_DATE  --计划巡检时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC DWQC --单位全称
,COUNT(B.STATUS) XJXM  --巡检项目
FROM WV_EM_CHECK_RECORD A --巡检记录表
LEFT JOIN WV_EM_CHECK_RECORD_ITEM B  --巡检记录巡检项明细表
ON A.ID=B.RECORD_ID
LEFT JOIN WV_EM_CHECK_PLAN C --巡检计划表
ON A.PLAN_ID=C.ID
LEFT JOIN WV_AM_ASSETS_STOCK D  --库存信息表
ON A.STOCK_ID=D.ID
LEFT JOIN WV_AM_ASSETS E --资产基本信息表 
ON D.ASSETSID=E.ID
LEFT JOIN HRMRESOURCE F
ON C.EXECUTOR=F.ID
LEFT JOIN hrmsubcompany G  --分部表
ON F.SUBCOMPANYID1=G.ID
WHERE 1=1
AND A.END_DATE>=to_char(add_months(sysdate,-2),'yyyy-mm-dd')
AND A.END_DATE&lt;=to_char(add_months(sysdate,-1),'yyyy-mm-dd')
GROUP BY B.STATUS --巡检状态
,C.CODE  --巡检计划编码
,C.NAME  --选就计划名称
,D.CODE  --设备编码
,E.NAME  --设备名称
,A.START_DATE  --计划巡检时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC --单位全称
)
WHERE STATUS='正常'
GROUP BY DWQC,STATUS
ORDER BY DWQC
),CC AS (  --上月漏检数量
SELECT DWQC,STATUS,COUNT(STATUS) SL
FROM (
SELECT 
CASE WHEN B.STATUS=0 THEN '漏检' WHEN B.STATUS=1 THEN '正常' ELSE '其他' END STATUS --巡检状态
,C.CODE JH_CODE --巡检计划编码
,C.NAME JH_NAME --选就计划名称
,D.CODE SB_CODE  --设备编码
,E.NAME SB_NAME --设备名称
,A.START_DATE  --计划巡检时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC DWQC --单位全称
,COUNT(B.STATUS) XJXM
FROM WV_EM_CHECK_RECORD A --巡检记录表
LEFT JOIN WV_EM_CHECK_RECORD_ITEM B  --巡检记录巡检项明细表
ON A.ID=B.RECORD_ID
LEFT JOIN WV_EM_CHECK_PLAN C --巡检计划表
ON A.PLAN_ID=C.ID
LEFT JOIN WV_AM_ASSETS_STOCK D  --库存信息表
ON A.STOCK_ID=D.ID
LEFT JOIN WV_AM_ASSETS E --资产基本信息表 
ON D.ASSETSID=E.ID
LEFT JOIN HRMRESOURCE F
ON C.EXECUTOR=F.ID
LEFT JOIN hrmsubcompany G  --分部表
ON F.SUBCOMPANYID1=G.ID
WHERE 1=1 
AND A.END_DATE>=to_char(add_months(sysdate,-2),'yyyy-mm-dd')
AND A.END_DATE&lt;=to_char(add_months(sysdate,-1),'yyyy-mm-dd')
GROUP BY B.STATUS --巡检状态
,C.CODE   --巡检计划编码
,C.NAME  --选就计划名称
,D.CODE  --设备编码
,E.NAME  --设备名称
,A.START_DATE  --计划巡检时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC --单位全称
)
WHERE STATUS='漏检'
GROUP BY DWQC,STATUS
ORDER BY DWQC
), DD AS(  --本月巡检数量
SELECT DWQC,STATUS,COUNT(STATUS) SL
FROM (
SELECT 
CASE WHEN B.STATUS=0 THEN '漏检' WHEN B.STATUS=1 THEN '正常' ELSE '其他' END STATUS --巡检状态
,C.CODE JH_CODE --巡检计划编码
,C.NAME JH_NAME --选就计划名称
,D.CODE SB_CODE  --设备编码
,E.NAME SB_NAME --设备名称
,A.START_DATE  --计划巡检时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC DWQC --单位全称
,COUNT(B.STATUS) XJXM  --巡检项目
FROM WV_EM_CHECK_RECORD A --巡检记录表
LEFT JOIN WV_EM_CHECK_RECORD_ITEM B  --巡检记录巡检项明细表
ON A.ID=B.RECORD_ID
LEFT JOIN WV_EM_CHECK_PLAN C --巡检计划表
ON A.PLAN_ID=C.ID
LEFT JOIN WV_AM_ASSETS_STOCK D  --库存信息表
ON A.STOCK_ID=D.ID
LEFT JOIN WV_AM_ASSETS E --资产基本信息表 
ON D.ASSETSID=E.ID
LEFT JOIN HRMRESOURCE F
ON C.EXECUTOR=F.ID
LEFT JOIN hrmsubcompany G  --分部表
ON F.SUBCOMPANYID1=G.ID
WHERE 1=1
AND A.END_DATE>=to_char(add_months(sysdate,-1),'yyyy-mm-dd')
AND A.END_DATE&lt;=to_char(sysdate,'yyyy-mm-dd')
GROUP BY B.STATUS --巡检状态
,C.CODE  --巡检计划编码
,C.NAME  --选就计划名称
,D.CODE  --设备编码
,E.NAME  --设备名称
,A.START_DATE  --计划巡检时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC --单位全称
)
WHERE STATUS='正常'
GROUP BY DWQC,STATUS
ORDER BY DWQC
),EE AS (  --本月漏检数量
SELECT DWQC,STATUS,COUNT(STATUS) SL
FROM (
SELECT 
CASE WHEN B.STATUS=0 THEN '漏检' WHEN B.STATUS=1 THEN '正常' ELSE '其他' END STATUS --巡检状态
,C.CODE JH_CODE --巡检计划编码
,C.NAME JH_NAME --选就计划名称
,D.CODE SB_CODE  --设备编码
,E.NAME SB_NAME --设备名称
,A.START_DATE  --计划巡检时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC DWQC --单位全称
,COUNT(B.STATUS) XJXM  --巡检项目
FROM WV_EM_CHECK_RECORD A --巡检记录表
LEFT JOIN WV_EM_CHECK_RECORD_ITEM B  --巡检记录巡检项明细表
ON A.ID=B.RECORD_ID
LEFT JOIN WV_EM_CHECK_PLAN C --巡检计划表
ON A.PLAN_ID=C.ID
LEFT JOIN WV_AM_ASSETS_STOCK D  --库存信息表
ON A.STOCK_ID=D.ID
LEFT JOIN WV_AM_ASSETS E --资产基本信息表 
ON D.ASSETSID=E.ID
LEFT JOIN HRMRESOURCE F
ON C.EXECUTOR=F.ID
LEFT JOIN hrmsubcompany G  --分部表
ON F.SUBCOMPANYID1=G.ID
WHERE 1=1
AND A.END_DATE>=to_char(add_months(sysdate,-1),'yyyy-mm-dd')
AND A.END_DATE&lt;=to_char(sysdate,'yyyy-mm-dd')
GROUP BY B.STATUS --巡检状态
,C.CODE  --巡检计划编码
,C.NAME  --选就计划名称
,D.CODE  --设备编码
,E.NAME  --设备名称
,A.START_DATE  --计划巡检时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC --单位全称
)
WHERE STATUS='漏检'
GROUP BY DWQC,STATUS
ORDER BY DWQC
),FF AS(  --上月保养数量
SELECT DWQC,STATUS,COUNT(STATUS) SL
FROM (
SELECT 
CASE WHEN B.STATUS=0 THEN '漏保养' WHEN B.STATUS=1 THEN '正常' ELSE '其他' END STATUS --巡检状态
,C.CODE JH_CODE --巡检计划编码
,C.NAME JH_NAME --选就计划名称
,D.CODE SB_CODE  --设备编码
,E.NAME SB_NAME --设备名称
,A.START_DATE  --计划保养时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC DWQC --单位全称
,COUNT(B.STATUS) BYXM --保养项目
FROM WV_EM_UPKEEP_RECORD A --保养记录表
LEFT JOIN WV_EM_UPKEEP_RECORD_ITEM B  --保养记录要求明细表
ON A.ID=B.RECORD_ID
LEFT JOIN WV_EM_UPKEEP_PLAN C --保养计划表
ON A.PLAN_ID=C.ID
LEFT JOIN WV_AM_ASSETS_STOCK D  --库存信息表
ON A.STOCK_ID=D.ID
LEFT JOIN WV_AM_ASSETS E --资产基本信息表 
ON D.ASSETSID=E.ID
LEFT JOIN HRMRESOURCE F
ON C.EXECUTOR=F.ID
LEFT JOIN hrmsubcompany G  --分部表
ON F.SUBCOMPANYID1=G.ID
WHERE 1=1
AND A.END_DATE>=to_char(add_months(sysdate,-2),'yyyy-mm-dd')
AND A.END_DATE&lt;=to_char(add_months(sysdate,-1),'yyyy-mm-dd')
GROUP BY B.STATUS --保养状态 
,C.CODE  --保养计划编码
,C.NAME  --保养计划名称
,D.CODE  --设备编码
,E.NAME  --设备名称
,A.START_DATE  --计划巡检时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC --单位全称
)
WHERE STATUS='正常'
GROUP BY DWQC,STATUS
ORDER BY DWQC
),GG AS(  --上月漏保养数量
SELECT DWQC,STATUS,COUNT(STATUS) SL
FROM (
SELECT 
CASE WHEN B.STATUS=0 THEN '漏保养' WHEN B.STATUS=1 THEN '正常' ELSE '其他' END STATUS --巡检状态
,C.CODE JH_CODE --巡检计划编码
,C.NAME JH_NAME --选就计划名称
,D.CODE SB_CODE  --设备编码
,E.NAME SB_NAME --设备名称
,A.START_DATE  --计划保养时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC DWQC --单位全称
,COUNT(B.STATUS) BYXM --保养项目
FROM WV_EM_UPKEEP_RECORD A --保养记录表
LEFT JOIN WV_EM_UPKEEP_RECORD_ITEM B  --保养记录要求明细表
ON A.ID=B.RECORD_ID
LEFT JOIN WV_EM_UPKEEP_PLAN C --保养计划表
ON A.PLAN_ID=C.ID
LEFT JOIN WV_AM_ASSETS_STOCK D  --库存信息表
ON A.STOCK_ID=D.ID
LEFT JOIN WV_AM_ASSETS E --资产基本信息表 
ON D.ASSETSID=E.ID
LEFT JOIN HRMRESOURCE F
ON C.EXECUTOR=F.ID
LEFT JOIN hrmsubcompany G  --分部表
ON F.SUBCOMPANYID1=G.ID
WHERE 1=1
AND A.END_DATE>=to_char(add_months(sysdate,-2),'yyyy-mm-dd')
AND A.END_DATE&lt;=to_char(add_months(sysdate,-1),'yyyy-mm-dd')
GROUP BY B.STATUS --保养状态 
,C.CODE  --保养计划编码
,C.NAME  --保养计划名称
,D.CODE  --设备编码
,E.NAME  --设备名称
,A.START_DATE  --计划巡检时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC --单位全称
)
WHERE STATUS='漏保养'
GROUP BY DWQC,STATUS
ORDER BY DWQC
),HH AS(  --本月保养数量
SELECT DWQC,STATUS,COUNT(STATUS) SL
FROM (
SELECT 
CASE WHEN B.STATUS=0 THEN '漏保养' WHEN B.STATUS=1 THEN '正常' ELSE '其他' END STATUS --巡检状态
,C.CODE JH_CODE --巡检计划编码
,C.NAME JH_NAME --选就计划名称
,D.CODE SB_CODE  --设备编码
,E.NAME SB_NAME --设备名称
,A.START_DATE  --计划保养时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC DWQC --单位全称
,COUNT(B.STATUS) BYXM --保养项目
FROM WV_EM_UPKEEP_RECORD A --保养记录表
LEFT JOIN WV_EM_UPKEEP_RECORD_ITEM B  --保养记录要求明细表
ON A.ID=B.RECORD_ID
LEFT JOIN WV_EM_UPKEEP_PLAN C --保养计划表
ON A.PLAN_ID=C.ID
LEFT JOIN WV_AM_ASSETS_STOCK D  --库存信息表
ON A.STOCK_ID=D.ID
LEFT JOIN WV_AM_ASSETS E --资产基本信息表 
ON D.ASSETSID=E.ID
LEFT JOIN HRMRESOURCE F
ON C.EXECUTOR=F.ID
LEFT JOIN hrmsubcompany G  --分部表
ON F.SUBCOMPANYID1=G.ID
WHERE 1=1
AND A.END_DATE>=to_char(add_months(sysdate,-1),'yyyy-mm-dd')
AND A.END_DATE&lt;=to_char(sysdate,'yyyy-mm-dd')
GROUP BY B.STATUS --保养状态 
,C.CODE  --保养计划编码
,C.NAME  --保养计划名称
,D.CODE  --设备编码
,E.NAME  --设备名称
,A.START_DATE  --计划巡检时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC --单位全称
)
WHERE STATUS='正常'
GROUP BY DWQC,STATUS
ORDER BY DWQC
),II AS(  --本月漏保养数量
SELECT DWQC,STATUS,COUNT(STATUS) SL
FROM (
SELECT 
CASE WHEN B.STATUS=0 THEN '漏保养' WHEN B.STATUS=1 THEN '正常' ELSE '其他' END STATUS --巡检状态
,C.CODE JH_CODE --巡检计划编码
,C.NAME JH_NAME --选就计划名称
,D.CODE SB_CODE  --设备编码
,E.NAME SB_NAME --设备名称
,A.START_DATE  --计划保养时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC DWQC --单位全称
,COUNT(B.STATUS) BYXM --保养项目
FROM WV_EM_UPKEEP_RECORD A --保养记录表
LEFT JOIN WV_EM_UPKEEP_RECORD_ITEM B  --保养记录要求明细表
ON A.ID=B.RECORD_ID
LEFT JOIN WV_EM_UPKEEP_PLAN C --保养计划表
ON A.PLAN_ID=C.ID
LEFT JOIN WV_AM_ASSETS_STOCK D  --库存信息表
ON A.STOCK_ID=D.ID
LEFT JOIN WV_AM_ASSETS E --资产基本信息表 
ON D.ASSETSID=E.ID
LEFT JOIN HRMRESOURCE F
ON C.EXECUTOR=F.ID
LEFT JOIN hrmsubcompany G  --分部表
ON F.SUBCOMPANYID1=G.ID
WHERE 1=1
AND A.END_DATE>=to_char(add_months(sysdate,-1),'yyyy-mm-dd')
AND A.END_DATE&lt;=to_char(sysdate,'yyyy-mm-dd')
GROUP BY B.STATUS --保养状态 
,C.CODE  --保养计划编码
,C.NAME  --保养计划名称
,D.CODE  --设备编码
,E.NAME  --设备名称
,A.START_DATE  --计划巡检时间
,A.END_DATE  --计划完成时间
,A.ACT_END_DATE  --实际完成时间
,F.LASTNAME  --执行人
,G.SUBCOMPANYDESC --单位全称
)
WHERE STATUS='漏保养'
GROUP BY DWQC,STATUS
ORDER BY DWQC
)
SELECT 
AA.DWQC  --单位全称
,AA.DWJC  --单位简称
,AA.SBSL  --设备数量
,BB.SL SYXJSL  --上月巡检数量
,CC.SL SYLJSL  --上月漏检数量
,DD.SL XJSL  --本月巡检数量
,EE.SL LJSL  --本月漏检数量
,ROUND((NVL(DD.SL,0)+NVL(EE.SL,0))/NVL(AA.SBSL,0),2) JHXJCS --计划巡检次数
,ROUND(NVL(DD.SL,0)/NVL(AA.SBSL,0),2) SJXJCS --实际巡检次数
,ROUND(NVL(EE.SL,0)/NVL(AA.SBSL,0),2) SJLJCS --实际漏检次数
,FF.SL SYBYSL  --上月保养数量
,GG.SL SYLBYSL --上月漏保养数量
,HH.SL BYSL  --本月保养数量
,II.SL LBYSL --本月漏保养数量
,ROUND((NVL(HH.SL,0)+NVL(II.SL,0))/NVL(AA.SBSL,0),2) JHBYCS --计划保养次数
,ROUND(NVL(HH.SL,0)/NVL(AA.SBSL,0),2) SJBYCS --实际保养次数
,ROUND(NVL(II.SL,0)/NVL(AA.SBSL,0),2) SJLBYCS --实际漏保养次数
FROM AA 
LEFT JOIN BB
ON AA.DWQC=BB.DWQC
LEFT JOIN CC
ON AA.DWQC=CC.DWQC
LEFT JOIN DD
ON AA.DWQC=DD.DWQC
LEFT JOIN EE
ON AA.DWQC=EE.DWQC
LEFT JOIN FF
ON AA.DWQC=FF.DWQC
LEFT JOIN GG
ON AA.DWQC=GG.DWQC
LEFT JOIN HH
ON AA.DWQC=HH.DWQC
LEFT JOIN II
ON AA.DWQC=II.DWQC
</sql>
