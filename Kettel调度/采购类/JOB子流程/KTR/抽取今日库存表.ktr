  <order>
    <hop>
      <from>抽取主数据</from>
      <to>插入主表临时表</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>抽取主数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread_master</connection>
    <sql>SELECT 
X.GSBM            GSBM,
X.GSMC            GSMC,
X.CK            CKMC,
X.WLBM          WLBM,
X.WLMC          WLMC,
A.NONHANDNUM    JRJC,
X.ZDW
--SUBSTR(A.tupdatetime,1,10) JCRQ
FROM  IC_ONHANDNUM A
LEFT JOIN 
(
  SELECT B.PK_ONHANDDIM,
         C.NAME GSMC,
         C.CODE GSBM,
         D.NAME CK,
         E.WLBM,
         E.WLMC,
         E.DW ZDW
  FROM IC_ONHANDDIM B
  LEFT JOIN ORG_STOCKORG C
       ON C.PK_STOCKORG =B.PK_ORG
  LEFT JOIN BD_STORDOC D
       ON B.CWAREHOUSEID=D.PK_STORDOC
  LEFT JOIN (
select  A.PK_MATERIAL,A.CODE WLBM,A.NAME WLMC,B.NAME DW from bd_material a
left join bd_measdoc b
on a.pk_measdoc=B.pk_measdoc
) E
       ON B.CMATERIALVID=E.PK_MATERIAL
WHERE B.DR='0'
)X 
     ON A.PK_ONHANDDIM=X.PK_ONHANDDIM
WHERE A.DR='0'</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema />
