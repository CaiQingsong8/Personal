  <step>
    <name>抽取修改数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT DISTINCT
       A.VBILLCODE                  DJBH,      --单据号
       A.PK_ORDER,                             --订单主键 
       A.CREATIONTIME               CJSJ,      --创建时间
       H.BILLTYPENAME               DDLX,      --订单类型           
       E.CODE                       GSBM,      --公司编码
       E.NAME                       GSMC,      --公司名称（基地）
       E.SHORTNAME                  GSJC,      --公司简称
	   F.NAME                       DDFZR,     --订单负责人
       SUBSTR(B.DBILLDATE，1，10）         DJRQ,      --订单日期 
       SUBSTR(B.DBILLDATE，1，4）            DJRQ_YEAR, --年
       SUBSTR(B.DBILLDATE，6，2）            DJRQ_MONTH,--月
       SUBSTR(B.DPLANARRVDATE, 0, 10) JHDHRQ,  --计划到货日期
       A1.NAME                      FKXYMC,    --付款协议名称
       A2.PAYMENTDAY                ZQTS,      --账期天数（协议付款天数）
       A3.NAME                      FKSD,      --付款时点 
       D.CODE                       GYSBM,     --供应商编码
       D.NAME                       GYSMC,     --供应商名称
       D.pk_supplierclass           GYSFLZJ,   --供应商分类主键
       C.CODE                       WLBM,      --物料编码
       C.NAME                       WLMC,      --物料名称（材料名称）
       C.NAME                       WLXH,      --物料型号
       B.PK_ORDER_B              PK_ORDER_B,   --表体主键
       B.NNUM                       CGSL,      --采购数量（订单数量）
       B.NQTORIGPRICE               CGDJ,      --采购单价（订单单价）
       B.NTAXMNY                    CGJE,      --采购金额
       M.CODE                      WLFLBM,       --物料分类编码
	   M.NAME                      WLFLMC,       --物料分类名称
	   N.CODE                      SJWLFLBM,     --上级物料分类编码
	   N.NAME                      SJWLFLMC,     --上级无聊分类名称
       B.BSTOCKCLOSE               SFGB,         --是否关闭
       B.bstockclose               RKGB,         --入库关闭
       A.FORDERSTATUS              DJZT,         --单据状态
       B.CROWNO                    CROWNO        --行号      
FROM PO_ORDER A
LEFT JOIN BD_PAYMENT A1
     ON A.PK_PAYTERM = A1.PK_PAYMENT
LEFT JOIN PO_ORDER_PAYMENT A2
     ON A.PK_ORDER = A2.PK_ORDER
LEFT JOIN BD_PAYPERIOD A3
     ON A2.PK_PAYPERIOD = A3.PK_PAYPERIOD
LEFT JOIN PO_ORDER_B B
     ON A.PK_ORDER = B.PK_ORDER
LEFT JOIN BD_MATERIAL C
     ON B.PK_SRCMATERIAL = C.PK_MATERIAL
LEFT JOIN BD_SUPPLIER D
     ON B.PK_SUPPLIER = D.PK_SUPPLIER
LEFT JOIN ORG_PURCHASEORG E
     ON A.PK_ORG_V = E.PK_VID
LEFT JOIN BD_BILLTYPE H
    ON A.CTRANTYPEID=H.PK_BILLTYPEID
LEFT JOIN (SELECT PK_DEFDOC,NAME FROM BD_DEFDOC) F
     ON A.VDEF1 = F.PK_DEFDOC
LEFT JOIN BD_MARBASCLASS M
     ON C.PK_MARBASCLASS=M.PK_MARBASCLASS
LEFT JOIN BD_MARBASCLASS N
     ON M.PK_PARENT=N.PK_MARBASCLASS
WHERE A.DR = 0
AND B.DR = 0
and A.bislatest='Y'
AND A.MODIFIEDTIME >='${cgupdtime}'
</sql>
    <limit>0</limit>
