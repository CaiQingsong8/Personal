    <sql>SELECT B.pk_org,C.CODE AS GSBM,C.name GSMC
,D.pk_supplier,D.CODE GYSBM,D.NAME GYSMC
,B.vbillcode CRDJH,a.crowno CRDJHH,A.vsourcebillcode DHDJH
,A.vfirstbillcode CDDJH
,SUBSTR(B.dbilldate,1,10) DJRQ
,E.NAME CKMC,G.CODE WLBM
,G.NAME WLMC,A.nnum RKZSL,A.norigtaxmny RKJE
,CASE WHEN B.modifiedtime IS NULL THEN B.creationtime ELSE B.modifiedtime END GXSJ
,F.CGDBD,F.SHRQ,F.SJXM,F.CPH,F.SJHM
,A.TS
,A.DR AS DR_B
,B.DR
,TO_CHAR(SYSDATE,'YYYY-MM-DD HH24:MI:SS')		AS UPDTIME
FROM ic_purchasein_b A--采购入库单表体,
LEFT JOIN ic_purchasein_h B --采购入库单表头
ON A.cgeneralhid = B.cgeneralhid
LEFT JOIN org_stockorg C--组织_业务单元_库存组织版本信息
ON B.pk_org = C.pk_stockorg
LEFT JOIN bd_supplier D--供应商基本信息
ON B.cvendorid = D.pk_supplier
LEFT JOIN bd_stordoc E --仓库
ON B.cwarehouseid = E.pk_stordoc
LEFT JOIN bd_material G --物料基本信息（多版本）
ON A.cmaterialvid = G.pk_material
LEFT JOIN
(
SELECT DISTINCT C.NAME GSMC,A.arriveno DJH,B.billno CGDBD,SUBSTR(B.dbilldate,1,10) SHRQ,B.drivername SJXM,D.vehiclelicense CPH,B.driverphone SJHM,A.pk_material FROM db_cgdb_b A--采购地磅单表体
LEFT JOIN db_cgdb_h B --采购地磅单表头
ON A.pk_cgdb_h = B.pk_cgdb_h
LEFT JOIN org_purchaseorg C --组织_业务单元_采购组织
ON B.pk_org = C.pk_purchaseorg
LEFT JOIN dm_vehicle D --车辆定义
ON B.carno = D.cvehicleid
WHERE 1=1
AND A.DR = 0
AND B.DR = 0
) F
ON C.name = F.GSMC AND A.vsourcebillcode = F.DJH AND A.cmaterialvid = F.pk_material
WHERE 1=1
--AND A.DR = 0
--AND B.DR = 0


</sql>
