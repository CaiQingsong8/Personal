    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT
    A.enablestate QYZT,--启用状态
    A.pk_defdoc JJZPK,--聚焦镇PK
    A.code JJZBM,--聚焦镇编码
    A.name JJZMC,--聚焦镇名称
    A.def1 ZZPK,--镇长PK
    B.name ZZXM,--镇长姓名
    A.def2 ZXDL,--主销大类
    A.def3 HSDWPK,--核算单位PK
    C.name HSDW,--核算单位名称
    A.def4 SCRL,--市场容量
    A.def5 ZDGZ,--重点关注
    A.memo BZ --备注
FROM bd_defdoc A --自定义档案表
LEFT JOIN bd_psndoc B --人员基本信息
ON A.def1 = B.pk_psndoc
LEFT JOIN bd_defdoc C --自定义档案表
ON A.def3 = C.pk_defdoc
WHERE A.pk_defdoclist = '1001A410000000000NJ9' --自定义档案维护（聚焦镇）
ORDER BY A.code</sql>
    <limit>0</limit>
    <lookup />
