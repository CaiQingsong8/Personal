      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread</connection>
    <sql>SELECT A.enablestate KHZT,--客户状态
       A.frozenflag DJBJ,--冻结标记
       A.code KHBM,--客户编码
       A.name KHMC,--客户名称
       A.shortname KHJC,--客户简称
       CASE WHEN A.ename IS NULL THEN A.code ELSE A.ename END KHTJBM,--客户统计编码
       B.code KHJBFL,--客户基本分类
       A.custprop KHLX,--客户类型
       C.code DQFLBM,--地区分类编码
       C.name DQFL,--地区分类名称
       A.tel1 KHSJ,--客户手机
       A.tel2 KHGH,--客户固话
      substr(A.def11, 1, 10) khkhrq,     --客户开户日期
       E1.NAME KHSX, --客户属性
       A.taxpayerid NSSBM,--纳税识别码
       A.def10 ZJDZ,--证件地址
     A.pk_customer KHPK, --客户PK
     C.pk_areacl DQFLPK,
       D.jydz JYDZ,
       case when D.SF IS NULL
         THEN SUBSTR(C.name,1,3)
           ELSE D.SF
     END jysf,
     E.HSDWPK,
     E.HSDW,
    -- CASE WHEN E.BM LIKE '%事业部%'
      -- THEN  E.BM
        -- ELSE  E.gsmc
          -- END HSDW, 
     E.gsbm SQGSBM,
     E.gsmc SQGSMC,
     E.SCQYBM,
     E.SCQYMC,
     E.SCQYPK,
     E.YWY,
     E.YWYPK,
     E.QYJL,
     E.XSJL,
     E.YWYJJZPK,
     E.ywyjjz,
     E.YWYBMMCPK,
     E.YWYBMMC

FROM bd_customer A --客户基本信息表
LEFT JOIN bd_custclass B --客户基本分类表
ON A.pk_custclass = B.pk_custclass
LEFT JOIN bd_areacl C --地区分类表
ON A.pk_areacl = C.pk_areacl
LEFT JOIN  bd_defdoc E1
    ON A.def14=e1.pk_defdoc
LEFT JOIN (select a.pk_address,b.name sf,c.name||a.detailinfo jydz from bd_address a 
left join bd_region b
on a.province=b.pk_region 
left join bd_region c
on a.city =c.pk_region) D
ON A.corpaddress=D.pk_address
left join (
SELECT a.pk_customer,b.name bm,c.code GSBM,C.NAME GSMC,SCQYBM,SCQYMC,SCQYPK,y.name ywy,y2.name qyjl,Y1.YWYJJZPK,y1.ywyjjz,Y1.YWYBMMCPK,Y1.YWYBMMC,y4.name xsjl,A.respperson YWYPK

, BDEF.PK_DEFDOC as HSDWPK
, BDEF.NAME AS HSDW

 FROM bd_custsale a

LEFT JOIN bd_defdoc BDEF ON A.DEF8 = BDEF.PK_DEFDOC

 LEFT JOIN org_dept b
  ON a.respdept =b.pk_dept
LEFT JOIN org_salesorg c
ON a.pk_org=c.pk_salesorg
left join (
        SELECT code SCQYBM,name SCQYMC,pk_defdoc SCQYPK  
        FROM bd_defdoc
        WHERE pk_defdoclist = '1001A210000000C5QCHU') T4
on a.def12 = T4.SCQYPK
left join bd_psndoc y
on a.respperson =y.pk_psndoc
left join 
(select distinct C.pk_defdoc YWYJJZPK,c.name ywyjjz,a.pk_psndoc,B1.pk_dept YWYBMMCPK,B1.NAME ywyBMMC
--, b.pk_org
 from bd_psndoc a
left join hi_psnjob b
on a.pk_psndoc=b.pk_psndoc
LEFT JOIN org_dept B1
ON B.pk_dept=B1.pk_dept  
left join bd_defdoc c
on b.jobglbdef2=c.pk_defdoc
where c.name is not null
and b.enddate is null and b.poststat = 'Y'
and b.pk_org &lt;&gt; '0001A21000000007NO70'--排除江门澳保和淮安澳保
and b.pk_org &lt;&gt; '0001A210000000036GW3'
AND A.DR='0'
AND B.DR='0'
AND C.DR='0') y1
on y.pk_psndoc=y1.pk_psndoc 
--and a.pk_org = y1.pk_org
left join bd_psndoc y2
on a.def2=y2.pk_psndoc
left join bd_psndoc y4
on a.def4=y4.pk_psndoc
WHERE a.def9='Y'
--and substr(nvl(a.def11,0),1,10)>=TO_CHAR(sysdate,'yyyy-MM-dd')
--and substr(nvl(a.def10,0),1,10)&lt;=TO_CHAR(sysdate,'yyyy-MM-dd')
and a.dr='0'
) E
ON A.pk_customer=E.pk_customer
WHERE 1 = 1
--and A.enablestate='2'   --启用
--AND A.frozenflag='N'  --冻结</sql>
