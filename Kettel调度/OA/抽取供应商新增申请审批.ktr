    <connection>OA</connection>
    <sql>select  fm.requestid --请求id
	,gongysmc ---供应商名称
    ,yb ---邮编
    ,fddbr ---法定代表人
    ,frlxdh ---法人联系电话
    ,chuanz ---传真号码
    ,lianxr ---联系人
    ,lianxdh ---联系电话
    ,email ---Email
    ,qymc ---企业名称
    ,'生产企业' as gyslx ---供应商类型
    ,qydz ---企业地址
    ,zcdz ---注册地址
    ,zczj ---注册资金
    ,yhzh ---银行账号
    ,khyh ---开户银行
    ,gmp ---GMP证书
    ,jkspdjzh ---进口商品登记证号
    ,shengcxkz ---生产许可证
    ,nassbh ---纳税人识别号
    ,qtzz ---其他证照
    ,gddh ---固定电话
    ,lxr1 ---联系人
    ,lxdh1 ---联系电话
    ,cz ---传真
    ,emai1 ---Email
    ,qq ---QQ
    ,fmdt1.ylbm ---主要供应原料编码
    ,fmdt1.ylmc ---主要供应原料
    ,fmdt1.ylsymc ---物料商用名称
    ,fmdt1.cppzwh ---产品批准文号
    ,wr.currentnodetype              ---当前节点类型:0创建1批准2提交3归档
	,CASE WHEN wr.currentnodetype=0 THEN '创建' 
		  WHEN wr.currentnodetype=1 THEN '批准' 
		  WHEN wr.currentnodetype=2 THEN '提交'
		  WHEN wr.currentnodetype=3 THEN '归档' END AS LCJD
from formtable_main_33 fm
left join formtable_main_33_dt1 fmdt1 on fm.id = fmdt1.mainid
left join workflow_requestbase wr on fm.requestid = wr.requestid

union all


select  fm.requestid --请求id
	,gongysmc ---供应商名称
    ,yb ---邮编
    ,fddbr ---法定代表人
    ,frlxdh ---法人联系电话
    ,chuanz ---传真号码
    ,lianxr ---联系人
    ,lianxdh ---联系电话
    ,email ---Email
    ,qymc ---企业名称
    ,'经销商'  as gyslx ---供应商类型
    ,qydz ---企业地址
    ,zcdz ---注册地址
    ,zczj ---注册资金
    ,yhzh ---银行账号
    ,khyh ---开户银行
    ,gmp ---GMP证书
    ,jkspdjzh ---进口商品登记证号
    ,shengcxkz ---生产许可证
    ,null as nassbh ---纳税人识别号
    ,qtzz ---其他证照
    ,gddh ---固定电话
    ,lxr1 ---联系人
    ,lxdh1 ---联系电话
    ,cz ---传真
    ,emai1 ---Email
    ,qq ---QQ
    ,fmdt1.ylbm ---主要供应原料编码
    ,fmdt1.ylmc ---主要供应原料
    ,fmdt1.ylsymc ---物料商用名称
    ,fmdt1.cppzwh ---产品批准文号
    ,wr.currentnodetype              ---当前节点类型:0创建1批准2提交3归档
	,CASE WHEN wr.currentnodetype=0 THEN '创建' 
		  WHEN wr.currentnodetype=1 THEN '批准' 
		  WHEN wr.currentnodetype=2 THEN '提交'
		  WHEN wr.currentnodetype=3 THEN '归档' END AS LCJD
from formtable_main_370 fm
left join formtable_main_370_dt1 fmdt1 on fm.id = fmdt1.mainid
left join workflow_requestbase wr on fm.requestid = wr.requestid</sql>
    <limit>0</limit>
