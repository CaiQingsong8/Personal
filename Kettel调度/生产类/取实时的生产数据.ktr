  <step>
    <name>取生产计划成品预测数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>SELECT XSZJ,WLBM,CASE WHEN SCJH&lt;=0 THEN 0
ELSE SCJH END SCJH FROM
(
SELECT XSZJ,WLBM,--NVL(SCBY,0),NVL(SC30,0),NVL(SC20,0),NVL(SC10,0),NVL(SC5,0),
ROUND((NVL(SCBY,0)+NVL(SC30,0)+NVL(SC20,0)+NVL(SC10,0)+NVL(SC5,0))/5,2)SCJH
 FROM 
(WITH AA AS --全部信息
 (SELECT DISTINCT XSZJ, WLBM, WLMC, WLXH, WLGG, DL
    FROM (SELECT DISTINCT A.XSZJ, A.WLBM, B.WLMC, B.WLXH, B.WLGG, C.FLMC3 DL
            FROM XS_XSDD A
            LEFT JOIN DA_WL B
              ON A.WLBM = B.WLBM
            LEFT JOIN DA_WLJBFL C
              ON B.FLPK = C.FLZJ
           WHERE 1 = 1
             AND (C.FLBM3 LIKE '21%' OR C.FLBM3 LIKE '22%')
             AND DJRQ >= TO_CHAR(SYSDATE - 180, 'YYYY-MM-DD')
          UNION ALL
          SELECT DISTINCT A.XSZJ, A.WLBM, A.WLMC, A.WLXH, A.WLGG, C.FLMC3 DL
            FROM DA_WLXSXX A
            LEFT JOIN DA_WL B
              ON A.WLBM = B.WLBM
            LEFT JOIN DA_WLJBFL C
              ON B.FLPK = C.FLZJ
           WHERE 1 = 1
             AND (A.DLBM LIKE '21%' OR A.DLBM LIKE '22%')
             AND SUBSTR(A.CJSJ, 1, 10) >= TO_CHAR(SYSDATE - 90, 'YYYY-MM-DD'))
   WHERE 1 = 1 
   --${if(len(GSMC) == 0, "", "and XSZJ IN ('" + GSMC + "')") }
   ORDER BY XSZJ, WLBM),
BA AS --下单数量
 (SELECT A.WLBM, A.WLMC, A.WLXH, A.XSZJ, SUM(A.ZSL) ZSL0
    FROM CRM_XSYDD A
   WHERE 1 = 1
     AND A.THRQ IS NOT NULL
     AND A.THRQ >= TO_CHAR(SYSDATE-20,'YYYY-MM-DD')
     AND A.DJLY &lt;&gt; 'NC'
 --  ${if(len(GSMC) == 0, "", "and A.XSZJ IN ('" + GSMC + "')") }
  -- ${if(len(KHMC) == 0, "", "and A.KHMC IN ('" + KHMC + "')") }
--   ${if(len(CXRQ) == 0, "", "and A.THRQ &lt;='" + CXRQ + "'")}
       AND (A.DJZT = '已确认' or A.DJZT = '待确认')
   GROUP BY A.WLBM, A.WLMC, A.WLXH, A.XSZJ),
BB AS --已提交数量
 (SELECT A.WLBM, A.WLMC, A.WLXH, A.XSZJ, SUM(A.ZSL) ZSL1
    FROM CRM_XSYDD A
   WHERE 1 = 1
     AND A.THRQ IS NOT NULL
     AND A.THRQ >= TO_CHAR(SYSDATE-20,'YYYY-MM-DD')
     AND A.DJLY &lt;&gt; 'NC'
 --  ${if(len(GSMC) == 0, "", "and A.XSZJ IN ('" + GSMC + "')") }
  -- ${if(len(KHMC) == 0, "", "and A.KHMC IN ('" + KHMC + "')") }
  -- ${if(len(CXRQ) == 0, "", "and A.THRQ &lt;='" + CXRQ + "'")}
   
     AND A.DJZT = '已提交'
   GROUP BY A.WLBM, A.WLMC, A.WLXH, A.XSZJ),
CC AS --已审核数量
 (SELECT A.WLBM, A.WLMC, A.WLXH, A.XSZJ, SUM(A.ZSL) ZSL2
    FROM CRM_XSYDD A
   WHERE 1 = 1
     AND A.THRQ IS NOT NULL
     AND A.THRQ >= TO_CHAR(SYSDATE-20,'YYYY-MM-DD')
     AND A.DJLY &lt;&gt; 'NC'
     AND (A.DJZT = '审核中' OR A.DJZT = '已审核')
--   ${if(len(GSMC) == 0, "", "and A.XSZJ IN ('" + GSMC + "')") }
 --  ${if(len(KHMC) == 0, "", "and A.KHMC IN ('" + KHMC + "')") }
 --  ${if(len(CXRQ) == 0, "", "and A.THRQ &lt;='" + CXRQ + "'")}
    
   GROUP BY A.WLBM, A.WLMC, A.WLXH, A.XSZJ),
DD AS --待发货数量
 (SELECT A.WLBM, A.WLMC, A.WLXH, A.XSZJ, SUM(A.ZSL) ZSL3
    FROM CRM_XSYDD A
   WHERE 1 = 1
     AND A.THRQ IS NOT NULL
     AND A.THRQ >= TO_CHAR(SYSDATE-20,'YYYY-MM-DD')
     AND A.DJLY &lt;&gt; 'NC'
 --  ${if(len(GSMC) == 0, "", "and A.XSZJ IN ('" + GSMC + "')") }
 --  ${if(len(KHMC) == 0, "", "and A.KHMC IN ('" + KHMC + "')") }
 --  ${if(len(CXRQ) == 0, "", "and A.THRQ &lt;='" + CXRQ + "'")}
     AND A.DJZT = '待发货'
   GROUP BY A.WLBM, A.WLMC, A.WLXH, A.XSZJ),
   
QB AS --所有下单数量
 (SELECT A.WLBM,A.WLXH, A.XSZJ, SUM(A.ZSL) ZSL
    FROM CRM_XSYDD A
   WHERE 1 = 1
     AND A.THRQ IS NOT NULL
     AND A.THRQ >= TO_CHAR(SYSDATE-20,'YYYY-MM-DD')
     AND A.DJLY &lt;&gt; 'NC'
 --  ${if(len(GSMC) == 0, "", "and A.XSZJ IN ('" + GSMC + "')") }
  -- ${if(len(KHMC) == 0, "", "and A.KHMC IN ('" + KHMC + "')") }
  -- ${if(len(CXRQ) == 0, "", "and A.THRQ &lt;='" + CXRQ + "'")}
   
     AND (A.DJZT = '已提交' OR A.DJZT = '待发货' OR A.DJZT = '审核中' OR A.DJZT = '已审核' OR A.DJZT = '已确认' or A.DJZT = '待确认')
   GROUP BY A.WLBM, A.WLXH, A.XSZJ),   

EE AS --现存量
 (SELECT A.GSMC XSZJ,
         C.FLMC3 DL,
         B.WLGG,
         A.WLBM,
         SUM(JRJC) JRJC,
         (SUM(JRJC) * 1000 / SUBSTR(B.WLGG, 1, INSTR(B.WLGG, '千') - 1)) JCFSL
    FROM CG_JRJC A
    LEFT JOIN DA_WL B
      ON A.WLBM = B.WLBM
    LEFT JOIN DA_WLJBFL C
      ON B.FLPK = C.FLZJ
   WHERE A.CKMC LIKE '%成品%'
     AND A.WLBM LIKE '2%'
   GROUP BY A.GSMC, A.WLBM, C.FLMC3, B.WLGG),
FF AS --去年本月销量
 (SELECT A.XSZJ, A.WLBM, SUM(A.ZSL) QNBYXL --本月销量
    FROM XS_XSDD A --销售主表
    LEFT JOIN DA_KH D --客户主表
      ON A.KHPK = D.KHPK
   WHERE 1 = 1
  -- ${if(len(GSMC) == 0, "", "and A.XSZJ IN ('" + GSMC + "')") }
 --  ${if(len(KHMC) == 0, "", "and A.KHMC IN ('" + KHMC + "')")}
     AND SUBSTR(DJRQ, 1, 7) = TO_CHAR(ADD_MONTHS(SYSDATE, -12), 'YYYY-MM')
     AND A.SFZP = 'N' --是否赠品为否
     AND D.KHJBFL &lt;&gt; 'K2'
   GROUP BY A.XSZJ, A.WLBM),
FA AS --去年次月销量
 (SELECT A.XSZJ, A.WLBM, SUM(A.ZSL) QNCYXL --次月销量
    FROM XS_XSDD A --销售主表
    LEFT JOIN DA_KH D --客户主表
      ON A.KHPK = D.KHPK
   WHERE 1 = 1 
   --${if(len(GSMC) == 0, "", "and A.XSZJ IN ('" + GSMC + "')") }
 -- ${if(len(KHMC) == 0, "", "and A.KHMC IN ('" + KHMC + "')")}
     AND SUBSTR(DJRQ, 1, 7) = TO_CHAR(ADD_MONTHS(SYSDATE, -11), 'YYYY-MM')
     AND A.SFZP = 'N' --是否赠品为否
     AND D.KHJBFL &lt;&gt; 'K2'
   GROUP BY A.XSZJ, A.WLBM),
GG AS --最近30天销量
 (SELECT A.XSZJ, A.WLBM, SUM(A.ZSL) XL30 --最近30天销量
    FROM XS_XSDD A --销售主表
    LEFT JOIN DA_KH D --客户主表
      ON A.KHPK = D.KHPK
   WHERE 1 = 1 
   AND DJRQ >= TO_CHAR(SYSDATE - 30, 'YYYY-MM-DD')
     AND A.SFZP = 'N' --是否赠品为否
     AND D.KHJBFL &lt;&gt; 'K2'
   --${if(len(GSMC) == 0, "", "and A.XSZJ IN ('" + GSMC + "')") }
   --${if(len(KHMC) == 0, "", "and A.KHMC IN ('" + KHMC + "')")}
     
   GROUP BY A.XSZJ, A.WLBM),
HH AS --最近20天销量
 (SELECT A.XSZJ, A.WLBM, SUM(A.ZSL) XL20 --最近20天销量
    FROM XS_XSDD A --销售主表
    LEFT JOIN DA_KH D --客户主表
      ON A.KHPK = D.KHPK
   WHERE 1 = 1 
   --${if(len(GSMC) == 0, "", "and A.XSZJ IN ('" + GSMC + "')") }
  -- ${if(len(KHMC) == 0, "", "and A.KHMC IN ('" + KHMC + "')")}
   
     AND DJRQ >= TO_CHAR(SYSDATE - 20, 'YYYY-MM-DD')
     AND A.SFZP = 'N' --是否赠品为否
     AND D.KHJBFL &lt;&gt; 'K2'
   GROUP BY A.XSZJ, A.WLBM),
LL AS --最近10天销量
 (SELECT A.XSZJ, A.WLBM, SUM(A.ZSL) XL10 --最近10天销量
    FROM XS_XSDD A --销售主表
    LEFT JOIN DA_KH D --客户主表
      ON A.KHPK = D.KHPK
   WHERE 1 = 1 
   --${if(len(GSMC) == 0, "", "and A.XSZJ IN ('" + GSMC + "')") }
 --  ${if(len(KHMC) == 0, "", "and A.KHMC IN ('" + KHMC + "')")
   
     AND DJRQ >= TO_CHAR(SYSDATE - 10, 'YYYY-MM-DD')
     AND A.SFZP = 'N' --是否赠品为否
     AND D.KHJBFL &lt;&gt; 'K2'
   GROUP BY A.XSZJ, A.WLBM),
MM AS --最近5天销量
 (SELECT A.XSZJ, A.WLBM, SUM(A.ZSL) XL5 --最近5天销量
    FROM XS_XSDD A --销售主表
    LEFT JOIN DA_KH D --客户主表
      ON A.KHPK = D.KHPK
   WHERE 1 = 1
        --${if(len(GSMC) == 0,"","and A.XSZJ IN ('" + GSMC + "')")}
        --${if(len(KHMC) == 0,"","and A.KHMC IN ('" + KHMC + "')")}
     AND DJRQ >= TO_CHAR(SYSDATE - 5, 'YYYY-MM-DD')
     AND A.SFZP = 'N' --是否赠品为否
     AND D.KHJBFL &lt;&gt; 'K2'
   GROUP BY A.XSZJ, A.WLBM),
NN AS --销售预算
 (SELECT GSMC XSZJ,
         CPBM WLBM,
         SUM(NVL(REPLACE(YCXL, ' ', ''), 0)) +
         SUM(NVL(REPLACE(YCDJGSL, ' ', ''), 0)) YCXL
    FROM yc_xsjh
   WHERE 1 = 1
     AND YCRQ = TO_CHAR(SYSDATE, 'YYYY-MM')
   GROUP BY GSMC, CPBM),
NB AS --代工数量
(
SELECT GYSMC XSZJ,WLBM,WLMC,SUM(KRKSL) KRKSL FROM CG_CPDGSL
GROUP BY GYSMC,WLBM,WLMC
),
NC AS --最近15天代工出库量
(
SELECT A.XSZJ,A.WLBM,
SUM(A.ZSL) DGXL15 --最近15天销量
FROM XS_XSDD A --销售主表
LEFT JOIN DA_KH D --客户主表
ON A.KHPK = D.KHPK
WHERE 1=1
AND DJRQ >= TO_CHAR(SYSDATE-15,'YYYY-MM-DD')
--AND A.SFZP = 'N' --是否赠品为否
AND D.KHJBFL = 'K2'
GROUP BY A.XSZJ,A.WLBM
),
NA AS
 (SELECT * FROM YS_SCJGTS)
SELECT AA.XSZJ,
       AA.WLBM,
       AA.WLMC,
       AA.WLXH,
       AA.WLGG,
       AA.DL,
       EE.JRJC,
       EE.JCFSL,
       BA.ZSL0,
       QB.ZSL,
       BB.ZSL1,
       CC.ZSL2,
       DD.ZSL3,
       FF.QNBYXL,
       FA.QNCYXL,
       GG.XL30,
       HH.XL20,
       LL.XL10,
       MM.XL5,
       NN.YCXL,
       NA.JGTS,
       NVL((NVL(NN.YCXL,0)/30+NVL(NC.DGXL15,0)/15)*NA.JGTS,0)-CASE WHEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)>0
THEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)
ELSE 0
END
+
CASE WHEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)&lt;0
THEN NVL(QB.ZSL,0)+NVL(NB.KRKSL,0)-NVL(EE.JRJC,0)
ELSE 0
END
 SCBY,
       NVL((NVL(GG.XL30,0)/30+NVL(NC.DGXL15,0)/15)*NA.JGTS,0)-CASE WHEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)>0
THEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)
ELSE 0
END
+
CASE WHEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)&lt;0
THEN NVL(QB.ZSL,0)+NVL(NB.KRKSL,0)-NVL(EE.JRJC,0)
ELSE 0
END
 SC30,
       NVL((NVL(HH.XL20,0)/20+NVL(NC.DGXL15,0)/15)*NA.JGTS,0)-CASE WHEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)>0
THEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)
ELSE 0
END
+
CASE WHEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)&lt;0
THEN NVL(QB.ZSL,0)+NVL(NB.KRKSL,0)-NVL(EE.JRJC,0)
ELSE 0
END SC20,
       NVL((NVL(LL.XL10,0)/10+NVL(NC.DGXL15,0)/15)*NA.JGTS,0)-CASE WHEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)>0
THEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)
ELSE 0
END
+
CASE WHEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)&lt;0
THEN NVL(QB.ZSL,0)+NVL(NB.KRKSL,0)-NVL(EE.JRJC,0)
ELSE 0
END SC10,
       NVL((NVL(MM.XL5,0)/5+NVL(NC.DGXL15,0)/15)*NA.JGTS,0)-CASE WHEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)>0
THEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)
ELSE 0
END
+
CASE WHEN NVL(EE.JRJC,0)-NVL(QB.ZSL,0)-NVL(NB.KRKSL,0)&lt;0
THEN NVL(QB.ZSL,0)+NVL(NB.KRKSL,0)-NVL(EE.JRJC,0)
ELSE 0
END SC5
  FROM AA
  LEFT JOIN BA
    ON AA.XSZJ = BA.XSZJ
   AND AA.WLBM = BA.WLBM
  LEFT JOIN QB
    ON AA.XSZJ = QB.XSZJ
   AND AA.WLBM = QB.WLBM 
  LEFT JOIN BB
    ON AA.XSZJ = BB.XSZJ
   AND AA.WLBM = BB.WLBM
  LEFT JOIN CC
    ON AA.XSZJ = CC.XSZJ
   AND AA.WLBM = CC.WLBM
  LEFT JOIN DD
    ON AA.XSZJ = DD.XSZJ
   AND AA.WLBM = DD.WLBM
  LEFT JOIN EE
    ON AA.XSZJ = EE.XSZJ
   AND AA.WLBM = EE.WLBM
  LEFT JOIN FF
    ON AA.XSZJ = FF.XSZJ
   AND AA.WLBM = FF.WLBM
  LEFT JOIN FA
    ON AA.XSZJ = FA.XSZJ
   AND AA.WLBM = FA.WLBM
  LEFT JOIN GG
    ON AA.XSZJ = GG.XSZJ
   AND AA.WLBM = GG.WLBM
  LEFT JOIN HH
    ON AA.XSZJ = HH.XSZJ
   AND AA.WLBM = HH.WLBM
  LEFT JOIN LL
    ON AA.XSZJ = LL.XSZJ
   AND AA.WLBM = LL.WLBM
  LEFT JOIN MM
    ON AA.XSZJ = MM.XSZJ
   AND AA.WLBM = MM.WLBM
  LEFT JOIN NN
    ON AA.XSZJ = NN.XSZJ
   AND AA.WLBM = NN.WLBM
  LEFT JOIN NA
    ON AA.XSZJ = NA.XSZJ
   AND AA.WLBM = NA.WLBM
  LEFT JOIN NC
    ON AA.XSZJ = NC.XSZJ
   AND AA.WLBM = NC.WLBM
LEFT JOIN NB
    ON AA.XSZJ = NB.XSZJ
   AND AA.WLBM = NB.WLBM
 WHERE 1 = 1
--${if(len(DL) == 0,"","and AA.DL IN ('" + DL + "')")}
--${if(len(WLBM) == 0,"","and AA.WLBM IN ('" + WLBM + "')")}
 ORDER BY AA.XSZJ, AA.WLBM
 )
--WHERE WLBM='2103100003'
--GROUP BY XSZJ,WLBM
)</sql>
