    <quoteString>N</quoteString>
    <sql>DELETE FROM DZYLBOM WHERE ZS=(SELECT SUBSTR(TO_CHAR(SYSDATE,'YYYY-MM-DD'),1,4)||'-'||TO_CHAR(SYSDATE,'IW') AS ZS FROM DUAL)

</sql>
    <set_params>N</set_params>
    <insert_field />
    <update_field />
    <delete_field />
    <read_field />
    <arguments>
    </arguments>
    <cluster_schema />
