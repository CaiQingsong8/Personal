  </step>
  <step>
    <name>采购成本占比</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>nc65_ncread_master</connection>
    <sql>

SELECT h.vbillcode
     ,b.crowno
	 ,case when me.name='千克' then  round(b.nnum/1000,5) else b.nmny end as nnum
	 ,case when me.name='千克' then round(b.nprice*1000,5) else b.nprice end as nprice
	 ,b.nmny
     ,case when me.name='千克' then '吨' else me.name end as measdoc_nname


     ,H.caccountperiod
     ,H.dbilldate
     ,b.dbilldate as dbilldate_b
     ,O.CODE AS CORP_CODE
     ,O.NAME AS CORP_NAME
     ,s.CODE AS stordoc_code
     ,s.NAME AS stordoc_name
     ,d.CODE AS dept_code
     ,d.NAME AS dept_name
     ,bill.billtypename
     ,p.name as stordoc_person
     ,p2.name as using_person

     ,m2.name  as product_name--产品线
     ,m1.def16 as material_block --物料板块
     ,mc4.code AS Formula_code1
     ,mc4.name AS Formula_NAME1
     ,m1c4.code AS material_code1
     ,m1c4.name AS material_name1
     ,m1.materialtype
     ,m1.materialspec



     ,m.code as Formula_code
     ,m.name as Formula_name
	 ,M1.pk_material as material_pk
     ,m1.code as material_code
     ,m1.name as material_name

     ,b.nnum as nastnum
	 ,b.nprice as price
	 ,me.name as measdoc_name
     ,b.dr as dr_b
     ,h.dr
     ,H.cbillid
     ,B.cbill_bid
     ,b.ts as ts_b
     ,h.ts
     ,TO_CHAR(SYSDATE,'YYYY-MM-DD HH24:MI:SS')		AS UPDTIME
/*
,mc.code
,mc.name
,mc2.code
,mc2.name
,mc3.code
,mc3.name
*/

FROM ia_i6bill H
         LEFT JOIN ia_i6bill_b B
                   ON H.cbillid =b.cbillid
         LEFT JOIN org_stockorg O
                   ON H.cstockorgid =O.pk_stockorg
         LEFT JOIN bd_stordoc s
                   ON H.cstordocid =s.pk_stordoc
         LEFT JOIN org_dept d
                   ON H.cdeptid  =d.pk_dept
         LEFT JOIN bd_billtype bill
                   ON H.ctrantypeid  =bill.pk_billtypeid
         LEFT JOIN bd_psndoc p
                   ON H.cstordocmanid   =p.pk_psndoc
         LEFT JOIN bd_psndoc p2
                   ON H.cpsnid   =p2.pk_psndoc
         LEFT JOIN bd_measdoc me
                   ON b.cunitid    =me.pk_measdoc
--配方料
         LEFT JOIN bd_material_V m
                   ON b.ccostobjid   =m.pk_source
         LEFT JOIN bd_marbasclass mc
                   ON m.pk_marbasclass   =mc.pk_marbasclass
         LEFT JOIN bd_marbasclass mc2
                   ON mc.pk_parent    =mc2.pk_marbasclass
         LEFT JOIN bd_marbasclass mc3
                   ON mc2.pk_parent    =mc3.pk_marbasclass
         LEFT JOIN bd_marbasclass mc4
                   ON mc3.pk_parent    =mc4.pk_marbasclass

--原料
         LEFT JOIN bd_material_V m1
                   ON b.cinventoryid    =m1.pk_source
         LEFT JOIN bd_marbasclass m1c
                   ON m1.pk_marbasclass   =m1c.pk_marbasclass
         LEFT JOIN bd_marbasclass m1c2
                   ON m1c.pk_parent    =m1c2.pk_marbasclass
         LEFT JOIN bd_marbasclass m1c3
                   ON m1c2.pk_parent    =m1c3.pk_marbasclass
         LEFT JOIN bd_marbasclass m1c4
                   ON m1c3.pk_parent    =m1c4.pk_marbasclass
         LEFT JOIN bd_prodline m2
                   ON m1.pk_prodline     =m2.pk_prodline
where b.TS> ?
  AND mc4.code='5'  --配方
  AND m1c4.code&lt;&gt;'2' --去除回机料


</sql>
    <limit>0</limit>
    <lookup>获取上次更新时间</lookup>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
