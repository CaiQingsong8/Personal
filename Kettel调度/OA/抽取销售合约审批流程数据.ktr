    <connection>OA</connection>
    <sql>SELECT * FROM
(
SELECT
A.KHBM,
REPLACE(REPLACE(REPLACE(A.KEHMC,' ',''),'(','（'),')','）') KHMC,--客户名称
CASE WHEN A.HEYLX = 0 THEN '购销合同'
WHEN A.HEYLX = 1 THEN '补充合同'
WHEN A.HEYLX = 2 THEN '其他约定'
WHEN A.HEYLX = 3 THEN '动保合同'
WHEN A.HEYLX = 4 THEN '购销免签申请'
ELSE '未定义类型' END HEYLX,--合约类型
A.SHENQRQ,--申请日期
CASE WHEN A.HEYND = 0 THEN '2016年度'
WHEN A.HEYND = 1 THEN '2017年度'
WHEN A.HEYND = 2 THEN '2018年度'
WHEN A.HEYND = 3 THEN '2019年度'
WHEN A.HEYND = 4 THEN '2020年度'
WHEN A.HEYND = 5 THEN '2021年度'
WHEN A.HEYND = 6 THEN '2022年度'
WHEN A.HEYND = 7 THEN '2023年度'
WHEN A.HEYND = 8 THEN '2024年度'
WHEN A.HEYND = 9 THEN '2025年度'
WHEN A.HEYND = 10 THEN '2026年度'
WHEN A.HEYND = 11 THEN '2027年度'
WHEN A.HEYND = 12 THEN '2028年度'

WHEN A.HEYND IS NULL THEN '2019年度'
ELSE '未定义年度' END HEYND,--是否已还款
A.HETKSRQ,--合同开始日期
A.HETJSRQ,--合同结束日期
A.YUSNHDQK,--与上年核对情况
A.YUQHY,--预签合约
A.ZHENGSHY,--正式合约
C.LASTNAME SHENQR,--申请人
G.LASTNAME YEWY,--业务员
E.SUBCOMPANYNAME GSJC,--公司简称
E.SUBCOMPANYDESC GSMC,--公司全称
H.SUBCOMPANYDESC SPGS,--客户所属公司
D.DEPARTMENTNAME SHENQBM,--申请部门
F.JOBTITLENAME ZHIW,--职务
A.BIANH,--流程编号
convtomultilang(b.status,7) AS STATUS, --流程当前节点
CASE B.currentnodetype WHEN '0' THEN '创建' WHEN '1' THEN '批准' WHEN '2' THEN '提交' WHEN '3' THEN '归档' ELSE '未知' END AS LCZT,
CASE M.nodename WHEN '~`~`7 归档`~`8 file`~`~' THEN '归档' WHEN '~`~`7 归档`~`8 file`~`9 歸檔`~`~' THEN '归档' ELSE M.nodename END AS JDMC,
L.CREATEDATE||' '||L.CREATETIME CJSJ --流程创建时间
FROM formtable_main_7 A --XS005 销售合约审批
LEFT JOIN workflow_requestbase B --工作流请求基本信息表
ON A.REQUESTID = B.REQUESTID
LEFT JOIN workflow_nodebase M
ON B.currentnodeid = M.id
LEFT JOIN HrmResource C --人力资源表
ON C.ID = A.SHENQR
LEFT JOIN hrmdepartment D --部门表
ON D.ID = A.SHENQBM
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = A.SUOSGS
LEFT JOIN hrmjobtitles F --岗位表
ON F.ID = A.ZHIW
LEFT JOIN HrmResource G --人力资源表
ON G.ID = A.YEWY
LEFT JOIN hrmsubcompany H --分部表
ON H.ID = A.SHENPGS
LEFT JOIN workflow_requestbase L--工作流基本信息表
ON A.REQUESTID = L.REQUESTID
)
WHERE 1=1
AND KHMC||HEYLX||HEYND||SPGS||CJSJ IN
(
SELECT DISTINCT KHMC||HEYLX||HEYND||SPGS||CJSJ FROM
(
SELECT
A.KHBM,
REPLACE(REPLACE(REPLACE(A.KEHMC,' ',''),'(','（'),')','）') KHMC,--客户名称
CASE WHEN A.HEYLX = 0 THEN '购销合同'
WHEN A.HEYLX = 1 THEN '补充合同'
WHEN A.HEYLX = 2 THEN '其他约定'
WHEN A.HEYLX = 3 THEN '动保合同'
WHEN A.HEYLX = 4 THEN '购销免签申请'
ELSE '未定义类型' END HEYLX,--合约类型
CASE WHEN A.HEYND = 0 THEN '2016年度'
WHEN A.HEYND = 1 THEN '2017年度'
WHEN A.HEYND = 2 THEN '2018年度'
WHEN A.HEYND = 3 THEN '2019年度'
WHEN A.HEYND = 4 THEN '2020年度'
WHEN A.HEYND = 5 THEN '2021年度'
WHEN A.HEYND = 6 THEN '2022年度'
WHEN A.HEYND = 7 THEN '2023年度'
WHEN A.HEYND = 8 THEN '2024年度'
WHEN A.HEYND = 9 THEN '2025年度'
WHEN A.HEYND = 10 THEN '2026年度'
WHEN A.HEYND = 11 THEN '2027年度'
WHEN A.HEYND = 12 THEN '2028年度'
WHEN A.HEYND IS NULL THEN '2019年度'
ELSE '未定义年度' END HEYND,
H.SUBCOMPANYDESC SPGS,--客户所属公司
MAX(L.CREATEDATE||' '||L.CREATETIME) CJSJ --流程创建时间
FROM formtable_main_7 A --XS005 销售合约审批
LEFT JOIN workflow_requestbase B --工作流请求基本信息表
ON A.REQUESTID = B.REQUESTID
LEFT JOIN workflow_nodebase M
ON B.currentnodeid = M.id
LEFT JOIN HrmResource C --人力资源表
ON C.ID = A.SHENQR
LEFT JOIN hrmdepartment D --部门表
ON D.ID = A.SHENQBM
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = A.SUOSGS
LEFT JOIN hrmjobtitles F --岗位表
ON F.ID = A.ZHIW
LEFT JOIN HrmResource G --人力资源表
ON G.ID = A.YEWY
LEFT JOIN hrmsubcompany H --分部表
ON H.ID = A.SHENPGS
LEFT JOIN workflow_requestbase L--工作流基本信息表
ON A.REQUESTID = L.REQUESTID
WHERE 1=1
AND B.STATUS &lt;&gt; '申请人发起'
GROUP BY A.KHBM,REPLACE(REPLACE(REPLACE(A.KEHMC,' ',''),'(','（'),')','）'),A.HEYLX,A.HEYND,H.SUBCOMPANYDESC
)
)
AND STATUS &lt;&gt; '申请人发起'
AND STATUS IS NOT NULL</sql>
