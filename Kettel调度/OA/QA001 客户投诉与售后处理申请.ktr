    </partitioning>
    <connection>OA</connection>
    <sql>SELECT
a.bianh,         --编号
C.LASTNAME SHENQR,--申请人
A.applyDate,--申请日期
D.DEPARTMENTNAME SHENQBM,--申请部门
E.SUBCOMPANYDESC GSMC,--责任公司全称
E.SUBCOMPANYNAME GSJC,--责任公司简称
F.SUBCOMPANYDESC SSGS,--所属公司
H.CREATEDATE||' '||H.CREATETIME CJSJ, --流程创建时间
a.khbm,     --客户编码
a.khmc,      --客户名称
case a.sscpx when 0 then '鱼料产品线'
when 0 then '海特料产品线'
when 0 then '虾蟹料产品线'
when 0 then '畜禽料产品线' end sscpx,  --产品线
b.tccpbm,   --产品编码
b.cpmc,      --产品名称
case a.tscpdl when 0 then '饲料'
when 1 then '动保产品' end tscpdl,   --投诉产品大类
a.scrq,      --生产日期
b.tscpbs,        --投诉产品包数
a.wtyy,         --问题原因
a.wtyyfl,        --问题原因分类（初步分析）
a.tsnr,          --投诉内容
I.lastname,      --首要责任部门负责人
a.tsnr,          --投诉内容
a.poncz         --PONC值
FROM formtable_main_514 A
right join formtable_main_514_dt1 b
on a.id=b.mainid
LEFT JOIN HrmResource C --人力资源表
ON C.ID = A.applicant
LEFT JOIN hrmdepartment D --部门表
ON D.ID = A.applyDep
LEFT JOIN hrmsubcompany E --分部表
ON E.ID = A.spgs
LEFT JOIN hrmsubcompany F --分部表
ON F.ID = A.suosgs
LEFT JOIN workflow_requestbase H--工作流基本信息表
ON A.REQUESTID = H.REQUESTID
left join HrmResource I
on I.id=to_char(case when INSTR(A.zrbmfzrcbfx,',') = 0 then A.zrbmfzrcbfx else SUBSTR(A.zrbmfzrcbfx,1,INSTR(A.zrbmfzrcbfx,',')) end)
where H.currentnodetype = 3     --3是归档状态</sql>
