  <step>
    <name>抽取销售对账单汇总数据</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>SELECT
A.corp_name,
A.customer_code,
A.customer_name,
A.salesman_name,
A.department_name,
B.corp_code,
B.corp_phone,
ifnull(m.opening_amount,0) opening_amount,
ifnull(m.collected_amount,0) collected_amount,
p.bill_date,
ifnull(n.quantity,0) packet_num,
ifnull(n.main_quantity,0) tonnage_num,
ifnull(Y.quantity,0) sales_volume,
ifnull(n.settle_amount,0) settle_amount,
ifnull(n.rebate_amount,0) rebate_amount

FROM
(SELECT DISTINCT corp_name,customer_code,customer_name,salesman_name,department_name
FROM tmc_sales_statement ) A
-- 公司电话
LEFT JOIN 
(SELECT DISTINCT corp_code,corp_phone,corp_name FROM tmc_cust_corp_phone) B
ON A.corp_name = B.corp_name
-- 期初收款
LEFT JOIN (
     SELECT DISTINCT AA.corp_name,
                     AA.customer_code,
                     BB.opening_amount,
                     CC.collected_amount
     FROM tmc_sales_statement AA
     LEFT JOIN (
          select corp_name, customer_code,sum(settle_amount)-sum(received_amount)  AS opening_amount
					FROM tmc_sales_statement
					where SUBSTR(bill_date,1,7) &lt; left(date_add(now(),interval-1 month),7)
					group by corp_name, customer_code
                ) BB
     ON AA.corp_name=BB.corp_name AND AA.customer_code=BB.customer_code
     LEFT JOIN (
          select corp_name, customer_code, sum(received_amount)  AS collected_amount
					FROM tmc_sales_statement
					where SUBSTR(bill_date,1,7) = left(date_add(now(),interval-1 month),7)
					group by corp_name, customer_code
					) CC
     ON AA.corp_name=CC.corp_name AND AA.customer_code=CC.customer_code
) m
ON A.corp_name = m.corp_name AND A.customer_code = m.customer_code
-- 包数吨数结算金额
LEFT JOIN (
     SELECT e.corp_name,
            e.customer_code,
            SUM(e.quantity) quantity,
            SUM(e.main_quantity) main_quantity,
            f.settle_amount,
            g.rebate_amount
     FROM tmc_sales_statement e
     LEFT JOIN (
          select corp_name, customer_code, sum(settle_amount)  AS settle_amount
					FROM tmc_sales_statement
					where SUBSTR(bill_date,1,7) = left(date_add(now(),interval-1 month),7)
					group by corp_name, customer_code) f
     ON e.corp_name = f.corp_name AND e.customer_code = f.customer_code
     LEFT JOIN (
          select corp_name, customer_code, sum(rebate_amount)  AS rebate_amount
					FROM tmc_sales_statement
					where SUBSTR(bill_date,1,7) = left(date_add(now(),interval-1 month),7)
					group by corp_name, customer_code) g
           ON e.corp_name = g.corp_name AND e.customer_code = g.customer_code
          WHERE 1=1
-- (e.WLBM LIKE '2%' OR E.WLBM IS NULL OR e.WLBM LIKE '7%')
     AND SUBSTR(e.bill_date,1,7) = left(date_add(now(),interval-1 month),7)
     AND E.gift_type='N'
     GROUP BY e.corp_name,e.customer_code,f.settle_amount,g.rebate_amount
) n
ON A.corp_name = n.corp_name AND A.customer_code = n.customer_code
-- 日期
LEFT JOIN (
     SELECT DISTINCT corp_name,
            customer_code,
            left(date_add(now(),interval-1 month),7) bill_date 
     FROM tmc_sales_statement
) p
ON A.corp_name = p.corp_name AND A.customer_code = p.customer_code
LEFT JOIN 
(
     select corp_name, customer_code, max(quantity)  AS quantity
					FROM tmc_sales_statement
					where SUBSTR(bill_date,1,7) = left(date_add(now(),interval-1 month),7)
					group by corp_name, customer_code
     )Y
  ON A.corp_name = Y.corp_name AND A.customer_code = Y.customer_code   
where 
(ifnull(m.opening_amount,0)&lt;&gt;'0'
OR ifnull(m.opening_amount,0)&lt;&gt;'0'
OR ifnull(m.collected_amount,0)&lt;&gt;'0'
OR ifnull(n.quantity,0)&lt;&gt;'0'
OR ifnull(n.main_quantity,0)&lt;&gt;'0'
OR ifnull(n.settle_amount,0)&lt;&gt;'0'
OR ifnull(n.rebate_amount,0)&lt;&gt;'0'
OR ifnull(y.quantity,0)&lt;&gt;'0')</sql>
