  </step>
  <step>
    <name>获取采购库存跟踪综合表</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>SELECT TO_CHAR(SYSDATE,'YYYY-MM-DD') AS YWRQ,A.CORP_PK,A.GSBM,A.GSMC,A.SJWLFLBM,A.SJWLFLMC,A.WLFLBM,A.WLFLMC,A.WLSX,A.WLBK,A.MATERIAL_PK,A.WLBM,A.WLMC,A.GSJC,A.CGSL,A.CGSL15,A.CGSL30,A.RKSL,A.SYRK,A.BYRK,A.JRRK,A.ZRRK,A.RKSL10,A.RKSL15,A.RKSL20,A.RKSL30,A.CKSL,A.CKJE,A.CKDJ,A.JRCK,A.ZRCK,A.BYCK,A.JQCK90,JQCK180
,A.JQCK30,A.JQCKJE30,DECODE(nvl(A.JQCKDJ30,0),0,A.JCDJ) AS JQCKDJ30,A.JQCK20,A.JQCK10,A.SYCK,A.QNTQCK,A.DSYCK,A.JQZTSL,A.JQZTSL15,A.JQZTSL30,A.WLZTSL30,A.MRYL30,A.MRYL20,A.MRYL,A.MRYL10,A.CGJE,A.CGJE15,A.CGJE30,A.YF,A.RKJE,A.RKJEHYF,A.BYRKJE,A.JRRKJE,A.BYRKJE15,A.BYRKJE30,A.JQZTJE,A.JQZTJE15,A.JQZTJE30,A.CGDJ,A.RKDJ,A.RKDJHYF,A.JQZTDJ,A.JQZTDJ15,A.JQZTDJ30,A.JQZTDJ1,A.JQZTDJA,A.JQZTDJ15A,A.JQZTDJ30A
	 ,A.JRJC,A.LL_JRJC,A.PLC_JRJC
	 --,A.JRJC,NVL(A.JRJC,0)*NVL(A.JCDJ,0) AS JRJCJE,A.LL_JRJC,NVL(A.LL_JRJC,0)*NVL(A.JCDJ,0) AS LL_JRJCJE,A.PLC_JRJC,NVL(A.PLC_JRJC,0)*NVL(A.JCDJ,0) AS PLC_JRJCJE   
	 ,A.QCJC,A.QCJCDJ,A.QCJCJE,A.JCSL,A.JCDJ,A.JCJE,A.YSYL,A.YSYL15,A.AQTS,A.ZXBJ,A.ZXBJRQ,A.QKSL
	 ,NVL(A.QKSL,0)*NVL(A.ZXBJ,0) AS QKJE
	 ,A.YCSL,A.YCDJGSL,A.YCSL_1,A.YCSL_2,A.YCSL_SC,A.YCSL_SC1,A.YCSL_SC2
     ,ROUND(DECODE(ZXBJ,0,JQZTDJ1,CASE WHEN QKSL>0 AND YCSL>0 THEN (JCDJ*jrjc+JQZTJE30+ QKSL*ZXBJ )/YCSL WHEN (jrjc+JQZTSL30)>0 THEN (JCDJ*jrjc+JQZTJE30)/(jrjc+JQZTSL30) ELSE NULL END ),3) AS YCJJ
	 ,ROUND(decode(A.JQCK180,0,'0',A.JRJC/A.JQCK180*180),3) SYTS
	 
--用预测均价乘以本月出库 求和 再除以 本月出库 可以计算所选公司的使用均价
FROM (
         SELECT A.CORP_PK,A.GSBM,A.GSMC,A.SJWLFLBM,A.SJWLFLMC,A.WLFLBM,A.WLFLMC,A.WLSX,A.WLBK,A.MATERIAL_PK,A.WLBM,A.WLMC,A.GSJC
/*CGSL 就是购买的材料，但不一定立马送到，实际送到的就是SSZSL也叫入库数量，没有入库的就叫JQZTSL，消耗的是入库数量，这一部分叫CKSL或者使用数量，剩下的就是JCSL，也就是结存数量*/
--采购+入库+在途+库存 数量 库存=总入库-总出库
              --采购数量
              ,NVL(B.CGSL,0)			AS CGSL
              ,NVL(B.CGSL15,0)		AS CGSL15
              ,NVL(B.CGSL30,0) 		AS CGSL30
              --入库数量
              ,NVL(B.RKSL,0)+NVL(B1.RKSL,0)			AS RKSL
              ,NVL(B.SYRK,0)+NVL(B1.SYRK,0)			AS SYRK
              ,NVL(B.BYRK,0)+NVL(B1.BYRK,0)			AS BYRK
              ,NVL(B.JRRK,0)+NVL(B1.JRRK,0)			AS JRRK
              ,NVL(B.ZRRK,0)+NVL(B1.ZRRK,0)			AS ZRRK
              ,NVL(B.RKSL10,0)+NVL(B1.RKSL10,0)		AS RKSL10
              ,NVL(B.RKSL15,0)+NVL(B1.RKSL15,0)		AS RKSL15
              ,NVL(B.RKSL20,0)+NVL(B1.RKSL20,0)		AS RKSL20
              ,NVL(B.RKSL30,0)+NVL(B1.RKSL30,0)		AS RKSL30
              --出库数量（也称为用量）
              ,NVL(C.CKSL,0) 				AS CKSL 
              ,NVL(C.CKJE,0) 				AS CKJE 
			  ,ROUND(CASE WHEN NVL(C.CKSL,0)=0 THEN 0 ELSE  NVL(C.CKJE,0) /NVL(C.CKSL,0) END,3) AS CKDJ
			  
              ,NVL(C.JRCK,0) 				AS JRCK
              ,NVL(C.ZRCK,0) 				AS ZRCK
              ,NVL(C.BYCK,0) 				AS BYCK
              ,NVL(C.JQCK180,0) 			AS JQCK180 --最近180天出库		  
              ,NVL(C.JQCK90,0) 			AS JQCK90 --最近90天出库
              ,NVL(C.JQCK30,0) 			AS JQCK30 --最近30天出库
              ,NVL(C.JQCKJE30,0) 		AS JQCKJE30 --最近30天出库金额
			  ,ROUND(CASE WHEN NVL(C.JQCK30,0)=0 THEN 0 ELSE  NVL(C.JQCKJE30,0) /NVL(C.JQCK30,0) END,3) AS JQCKDJ30
			  
              ,NVL(C.JQCK20,0) 			AS JQCK20 --最近20天出库
              ,NVL(C.JQCK10,0) 			AS JQCK10 --最近10天出库
              ,NVL(C.SYCK,0) 				AS SYCK
              ,NVL(C.QNTQCK,0) 			AS QNTQCK
              ,NVL(C.DSYCK,0) 			AS DSYCK--大上月出库
              --库存数量=总入库-总出库

              --近期在途数量
              ,NVL(B.JQZTSL,0)		AS JQZTSL
              --,NVL(B.JQZTSL1,0)		AS JQZTSL1
              ,NVL(B.JQZTSL15,0)	AS JQZTSL15
              ,NVL(B.JQZTSL30,0)	AS JQZTSL30
              ,NVL(B.JQZTSL,0)-NVL(B.JQZTSL30,0)	AS WLZTSL30 ---30天外在途数量
              --每日用量
             /*来自其他出库单，待确认*/
              ,NVL(C.MRYL30,0) 			AS MRYL30
              ,NVL(C.MRYL20,0) 			AS MRYL20
              ,NVL(C.MRYL20,0) 			AS MRYL
              ,NVL(C.MRYL10,0) 			AS MRYL10

--采购+入库+在途+库存 金额 库存=总入库-总出库
              ,NVL(B.CGJE,0)			AS CGJE		--含运费
              ,NVL(B.CGJE15,0)		AS CGJE15
              ,NVL(B.CGJE30,0)		AS CGJE30
              ,NVL(B.YF,0)				AS YF

              ,NVL(B.RKJE,0)			AS RKJE
              ,NVL(B.RKJEHYF,0)		AS RKJEHYF
              --下面的入库金额均含运费，如需要不含运费，请参看BB表的逻辑
              ,NVL(B.BYRKJE,0)		AS BYRKJE
              ,NVL(B.JRRKJE,0)		AS JRRKJE
              ,NVL(B.BYRKJE15,0)	AS BYRKJE15
              ,NVL(B.BYRKJE30,0)	AS BYRKJE30

              ,DECODE(NVL(B.JQZTSL,0),0,0,NVL(B.JQZTJE,0))		AS JQZTJE
              ,DECODE(NVL(B.JQZTSL15,0),0,0,NVL(B.JQZTJE15,0))	AS JQZTJE15
              ,DECODE(NVL(B.JQZTSL30,0),0,0,NVL(B.JQZTJE30,0))	AS JQZTJE30

              --采购+入库+在途+库存  单价 库存=总入库-总出库
              ,NVL(B.CGDJ,0)			AS CGDJ 		--含运费

              ,NVL(B.RKDJ,0)			AS RKDJ
              ,NVL(B.RKDJHYF,0)		AS RKDJHYF

              ,DECODE(NVL(JQZTSL,0),0,0,NVL(JQZTJE,0)/NVL(JQZTSL,0))	AS JQZTDJ
              ,DECODE(NVL(JQZTSL15,0),0,0,NVL(JQZTJE15,0)/NVL(JQZTSL15,0))	AS JQZTDJ15
              ,DECODE(NVL(JQZTSL30,0),0,0,NVL(JQZTJE30,0)/NVL(JQZTSL30,0))	AS JQZTDJ30

/*JQZTDJ1=（今日结存数量*结存单价+在途金额）/（今日结存数量+在途数量）*/
              ,ROUND(DECODE(NVL(JQZTSL30,0)+NVL(D.JRJC,0),0,0,(NVL(JQZTJE30,0)+NVL(D.JRJC,0)* DECODE((NVL(D2.QCJC,0)+NVL(B.BYRK,0)),0,0,(NVL(D2.QCJCJE,0)+NVL(B.BYRKJE,0))/(NVL(D2.QCJC,0)+NVL(B.BYRK,0))))/(NVL(JQZTSL30,0)+NVL(D.JRJC,0))),3)	AS JQZTDJ1


/*JQZTDJA是错误的  主要区别就是JQZTDJ统计范围：当采购数量-入库数量&lt;0 + 入库关闭=关闭  两者只要满足其一就不统计 而JQZTDJA则只需要判断入库关闭=关闭 ，有些订单没办法手动关闭，所以前者更保险*/
              ,ROUND(DECODE(NVL(JQZTSLA,0),0,0,NVL(JQZTJEA,0)/NVL(JQZTSLA,0)),2)	AS JQZTDJA
              ,ROUND(DECODE(NVL(JQZTSL15A,0),0,0,NVL(JQZTJE15A,0)/NVL(JQZTSL15A,0)),2)	AS JQZTDJ15A
              ,ROUND(DECODE(NVL(JQZTSL30A,0),0,0,NVL(JQZTJE30A,0)/NVL(JQZTSL30A,0)),2)	AS JQZTDJ30A




/*来自材料出库单，待确认
		,ROUND(NVL(E.SYSL10,0) /10	,2)			AS MRYL10
		,ROUND(NVL(E.SYSL20,0) /20	,2)			AS MRYL20
		,ROUND(NVL(E.SYSL30,0) /30	,2)			AS MRYL30
*/
--结存
              ,NVL(D.JRJC,0) 				AS JRJC
              ,NVL(D.PLC_JRJC,0) 			AS PLC_JRJC
              ,NVL(D.LL_JRJC,0) 			AS LL_JRJC

              ,NVL(D2.QCJC,0) 			AS QCJC
              ,NVL(D2.QCJCDJ,0) 			AS QCJCDJ
              ,NVL(D2.QCJCJE,0) 			AS QCJCJE

              ,NVL(D2.QCJC,0)+NVL(B.BYRK,0)     AS JCSL
/*JCDJ=（期初结存金额+本月入库金额）/（期初结存数量+本月入库数量）*/
              ,ROUND(DECODE((NVL(D2.QCJC,0)+NVL(B.BYRK,0)),0,0,(NVL(D2.QCJCJE,0)+NVL(B.BYRKJE,0))/(NVL(D2.QCJC,0)+NVL(B.BYRK,0))),3) AS JCDJ
              ,NVL(D2.QCJCJE,0)+NVL(B.BYRKJE,0) AS JCJE

--安全天数
              ,NVL(G.AQTS,0) 				AS AQTS
--最新报价
              ,NVL(I.ZXBJ,0)              AS ZXBJ --最新报价
			  ,i.bjrq as ZXBJRQ --最新报价日期
			  
--预算用量
              ,NVL(F.YSYL,0) 				AS YSYL
              ,NVL(F.YSYL15,0) 			AS YSYL15
--预测
              ,NVL(H.YCSL,0) 				AS YCSL --预测用量
              ,NVL(H.YCDJGSL,0) 				AS YCDJGSL --预测代加工用量
              ,NVL(H.YCSL_1,0) 				AS YCSL_1 --下月预测用量  
              ,NVL(H.YCSL_2,0) 				AS YCSL_2 --下下月预测用量  
			  
              ,NVL(H.YCSL_SC,0) 				AS YCSL_SC --预测生产用量
              ,NVL(H.YCSL_SC1,0) 				AS YCSL_SC1 --下月预测生产用量
              ,NVL(H.YCSL_SC2,0) 				AS YCSL_SC2 --下下月预测生产用量
			  
              ,CASE WHEN NVL(I.ZXBJ,0)=0 THEN 0
                    WHEN  NVL(H.YCSL,0)-NVL(D.JRJC,0) 	-NVL(B.JQZTSL30,0)	&lt;0 THEN 0
                    ELSE   NVL(H.YCSL,0)-NVL(D.JRJC,0) 	-NVL(B.JQZTSL30,0)	 END  AS QKSL --缺口数量


         FROM
--公司、物料
(
    SELECT A.GSBM,D.CORP_NAME AS GSMC,D.CORP_SNAME AS GSJC,A.WLBM,B.MATERIAL_NAME AS WLMC,B.CLASS_CODE4 AS SJWLFLBM,B.CLASS_NAME4 AS SJWLFLMC,B.CLASS_CODE6 AS WLFLBM,B.CLASS_NAME6 AS WLFLMC,b.MATERIAL_ATTRIBUTE as WLSX,CASE WHEN B.MATERIAL_BLOCK IS NULL THEN B.MATERIAL_ATTRIBUTE||'未分类' ELSE B.MATERIAL_BLOCK END as wlbk,B.MATERIAL_PK,D.CORP_PK
    FROM (
             SELECT GSBM,WLBM
             FROM F_CGZB
             WHERE SFJC='N'
             GROUP BY GSBM,WLBM
             UNION
             SELECT GSBM,WLBM
             FROM CG_JRJC
             GROUP BY GSBM,WLBM
UNION
SELECT A.SCGSBM AS GSBM,CLBM AS WLBM
FROM YC_XSJH A
 LEFT JOIN CB_BOMCF B
ON A.SCGSBM=B.GSBM
 AND A.CPBM=B.CPBM
WHERE SUBSTR(YCRQ,1,7)=TO_CHAR(SYSDATE,'YYYY-MM')
GROUP BY SCGSBM,CLBM
         ) A
             LEFT JOIN DIM_MATERIAL B
                       ON A.WLBM=B.MATERIAL_CODE

             LEFT JOIN DIM_UNIT D
                       ON A.GSBM=D.CORP_CODE
                           AND D.ORG_TYPE='公司'
    WHERE (A.WLBM LIKE '1%' OR A.WLBM LIKE '4%' OR A.WLBM LIKE '31%' OR A.WLBM LIKE '34%')
) A
---入库数量 入库金额  入库单价采购数量 采购金额 采购单价 在途数量 在途金额 在途单价
    LEFT JOIN
(
    SELECT
        AA.GSBM
         ,AA.WLBM
         --数量
         ,SUM(AA.CGSL)																AS CGSL
         ,SUM(AA.CGSL15)															AS CGSL15
         ,SUM(AA.CGSL30)															AS CGSL30

         ,SUM(BB.RKSL)																AS RKSL
         ,SUM(BB.JRRK)																AS JRRK
         ,SUM(BB.ZRRK)																AS ZRRK
         ,SUM(BB.BYRK)																AS BYRK
         ,SUM(BB.SYRK)																AS SYRK
         ,SUM(BB.DSYRK)																AS DSYRK
         ,SUM(BB.RKSL10)															AS RKSL10
         ,SUM(BB.RKSL15)															AS RKSL15
         ,SUM(BB.RKSL20)															AS RKSL20
         ,SUM(BB.RKSL30)															AS RKSL30


         ,SUM(CASE WHEN RKGB='Y' THEN 0  WHEN  NVL(AA.CGSL,0)-NVL(BB.RKSL,0)&lt;0 THEN 0 ELSE NVL(AA.CGSL,0)-NVL(BB.RKSL,0) END)		AS JQZTSL
         ,SUM(CASE WHEN NVL(AA.CGSL15,0)-NVL(BB.RKSL15,0)&lt;0 THEN 0
                   WHEN RKGB = 'Y' THEN 0
                   ELSE NVL(AA.CGSL15,0)-NVL(BB.RKSL15,0) END)AS JQZTSL15
         ,SUM(CASE WHEN NVL(AA.CGSL30,0)-NVL(BB.RKSL30,0)&lt;0 THEN 0
                   WHEN RKGB = 'Y' THEN 0
                   ELSE NVL(AA.CGSL30,0)-NVL(BB.RKSL30,0) END)AS JQZTSL30

         ,SUM(CASE WHEN RKGB='Y' THEN 0  ELSE NVL(AA.CGSL,0)-NVL(BB.RKSL,0) END)		AS JQZTSLA
         ,SUM(CASE WHEN RKGB = 'Y' THEN 0
                   ELSE NVL(AA.CGSL15,0)-NVL(BB.RKSL15,0) END)AS JQZTSL15A
         ,SUM(CASE WHEN RKGB = 'Y' THEN 0
                   ELSE NVL(AA.CGSL30,0)-NVL(BB.RKSL30,0) END)AS JQZTSL30A
         --金额
         ,SUM(AA.CGJE)																AS CGJE		--含运费
         ,SUM(AA.CGJE15)															AS CGJE15
         ,SUM(AA.CGJE30)															AS CGJE30
         ,SUM(AA.YF)																	AS YF			--运费 没太大用

         ,SUM(BB.RKJE)																AS RKJE
         ,SUM(BB.RKJEHYF)														    AS RKJEHYF
         --下面的入库金额均含运费，如需要不含运费，请参看子表B的逻辑
         ,SUM(BB.BYRKJE)															AS BYRKJE
         ,SUM(BB.JRRKJE)															AS JRRKJE
         ,SUM(BB.BYRKJE15)														AS BYRKJE15
         ,SUM(BB.BYRKJE30)														AS BYRKJE30

         ,SUM(CASE WHEN RKGB='Y' THEN 0  WHEN  NVL(AA.CGSL,0)-NVL(BB.RKSL,0)&lt;0 THEN 0 ELSE NVL(AA.CGJE,0)-NVL(BB.RKJEHYF,0) END )				AS JQZTJE
         ,SUM(CASE WHEN RKGB='Y' THEN 0  WHEN  NVL(AA.CGSL15,0)-NVL(BB.RKSL15,0)&lt;0 THEN 0 ELSE NVL(AA.CGJE15,0)-NVL(BB.BYRKJE15,0)END)			AS JQZTJE15
         ,SUM(CASE WHEN RKGB='Y' THEN 0  WHEN  NVL(AA.CGSL30,0)-NVL(BB.RKSL30,0)&lt;0 THEN 0 ELSE NVL(AA.CGJE30,0)-NVL(BB.BYRKJE30,0)END)			AS JQZTJE30
         ,SUM(NVL(AA.CGJE,0)-NVL(BB.RKJEHYF,0))				AS JQZTJEA
         ,SUM(NVL(AA.CGJE15,0)-NVL(BB.BYRKJE15,0))			AS JQZTJE15A
         ,SUM(NVL(AA.CGJE30,0)-NVL(BB.BYRKJE30,0))			AS JQZTJE30A

         --单价
         ,ROUND(CASE WHEN SUM(AA.CGSL)=0 THEN 0 ELSE SUM(AA.CGJE)/SUM(AA.CGSL) END ,2)    				AS CGDJ		--含运费
         ,ROUND(CASE WHEN SUM(BB.RKSL)=0 THEN 0 ELSE SUM(BB.RKJE)/SUM(BB.RKSL) END,2) 					AS RKDJ
         ,ROUND(CASE WHEN SUM(BB.RKSL)=0 THEN 0 ELSE SUM(BB.RKJEHYF)/SUM(BB.RKSL ) END ,2) 			AS RKDJHYF


    FROM
        (
            SELECT
                GSBM
                 ,DJRQ
                 ,WLBM
                 ,GYSBM
                 ,DJBH
                 ,RKGB
                 ,HTLX
                 ,SUM(CASE WHEN RKGB='N' THEN CGSL ELSE 0 END ) AS CGSL
                 ,SUM( CASE WHEN TO_DATE (SUBSTR(JHDHRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE-0,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 15  AND RKGB='N' THEN CGSL ELSE 0 END  ) AS CGSL15
                 ,SUM( CASE WHEN TO_DATE (SUBSTR(JHDHRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE-0,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 30 AND RKGB='N' THEN CGSL ELSE 0 END  ) AS CGSL30
                 ,SUM(CASE WHEN RKGB='N' THEN TO_NUMBER(YF) ELSE 0 END ) AS YF
                 ,SUM(CASE WHEN RKGB='N' THEN CGJE ELSE 0 END ) AS CGJE
                 ,SUM( CASE WHEN TO_DATE (SUBSTR(JHDHRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE-0,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 15 AND RKGB='N'  THEN CGJE ELSE 0 END  ) AS CGJE15
                 ,SUM( CASE WHEN TO_DATE (SUBSTR(JHDHRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE-0,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 30  AND RKGB='N'  THEN CGJE ELSE 0 END  ) AS CGJE30
            --,ROUND(CASE WHEN SUM(CGSL)=0 THEN 0 ELSE SUM(CGJE)/SUM(CGSL) END,2)    AS CGDJ---同一订单号采购吨位不同单价也不同，所以加权平均求最终的单价
            --,MAX(CGDJ) AS CGDJ1
            FROM
                F_CGZBHYF
            WHERE SFJC = 'N'
              AND HTLX&lt;&gt;'基差合同'
            --AND RKGB='N'  --如果不对这里就放开
            GROUP BY
                GSBM
                   ,DJRQ
                   ,WLBM
                   ,GYSBM
                   ,DJBH
                   ,RKGB
                   ,HTLX
/*
            SELECT
                GSBM
                 ,DJRQ
                 ,WLBM
                 ,GYSBM
                 ,DJBH
                 ,RKGB
                 ,HTLX
--近30和近期15指标即使一年以外的订单未关闭也取0，即范围在365天前~未来30天或15天
             ,SUM(CASE WHEN RKGB='N' THEN CGSL ELSE 0 END ) AS CGSL
             ,SUM( CASE WHEN TO_DATE (SUBSTR(JHDHRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE-0,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 15  AND JHDHRQ>=TO_CHAR(SYSDATE-365,'YYYY-MM-DD') AND RKGB='N' THEN CGSL ELSE 0 END  ) AS CGSL15
             ,SUM( CASE WHEN TO_DATE (SUBSTR(JHDHRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE-0,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 30 AND RKGB='N' AND JHDHRQ>=TO_CHAR(SYSDATE-365,'YYYY-MM-DD')
                            THEN CGSL ELSE 0 END  ) AS CGSL30
             ,SUM(CASE WHEN RKGB='N' THEN TO_NUMBER(YF) ELSE 0 END ) AS YF
             ,SUM(CASE WHEN RKGB='N' THEN CGJE ELSE 0 END ) AS CGJE
             ,SUM( CASE WHEN TO_DATE (SUBSTR(JHDHRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE-0,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 15 AND JHDHRQ>=TO_CHAR(SYSDATE-365,'YYYY-MM-DD') AND RKGB='N'  THEN CGJE ELSE 0 END  ) AS CGJE15
             ,SUM( CASE WHEN TO_DATE (SUBSTR(JHDHRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE-0,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 30  AND JHDHRQ>=TO_CHAR(SYSDATE-365,'YYYY-MM-DD') AND RKGB='N'  THEN CGJE ELSE 0 END  ) AS CGJE30


            --,ROUND(CASE WHEN SUM(CGSL)=0 THEN 0 ELSE SUM(CGJE)/SUM(CGSL) END,2)    AS CGDJ---同一订单号采购吨位不同单价也不同，所以加权平均求最终的单价
            --,MAX(CGDJ) AS CGDJ1
            FROM
                F_CGZBHYF
            WHERE SFJC = 'N'
              AND HTLX&lt;&gt;'基差合同'
            --AND RKGB='N'  --如果不对这里就放开
            GROUP BY
                GSBM
                   ,DJRQ
                   ,WLBM
                   ,GYSBM
                   ,DJBH
                   ,RKGB
                   ,HTLX*/
        ) AA
            LEFT JOIN (
            SELECT
                YTDJH
                 ,WLBM
                 ,GSBM
                 ,GYSBM
                 ,SUM(RKJE)  AS RKJE
                 ,SUM(CGHYFJE)  AS RKJEHYF
                 ,SUM(CASE WHEN SUBSTR(RKRQ,1,7) = TO_CHAR(SYSDATE,'YYYY-MM') THEN CGHYFJE ELSE 0 END ) AS BYRKJE
                 ,SUM(CASE WHEN RKRQ=TO_CHAR(SYSDATE,'YYYY-MM-DD') THEN CGHYFJE ELSE 0 END ) AS JRRKJE
                 ,SUM(CASE WHEN TO_DATE (SUBSTR(RKRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE-0,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 15 THEN CGHYFJE ELSE 0 END  ) AS BYRKJE15
                 ,SUM(CASE WHEN TO_DATE (SUBSTR(RKRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE-0,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 30 THEN CGHYFJE ELSE 0 END  ) AS BYRKJE30


                 ,SUM( SSZSL ) AS RKSL
                 ,SUM(CASE WHEN RKRQ=TO_CHAR(SYSDATE,'YYYY-MM-DD') THEN SSZSL ELSE 0 END )   AS JRRK
                 ,SUM(CASE WHEN RKRQ=TO_CHAR(SYSDATE-1,'YYYY-MM-DD') THEN SSZSL ELSE 0 END ) AS ZRRK
                 ,SUM(CASE WHEN SUBSTR(RKRQ,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')THEN SSZSL ELSE 0 END ) AS BYRK
                 ,SUM(CASE WHEN SUBSTR(RKRQ,1,7)=TO_CHAR(add_months(sysdate,-1),'YYYY-MM') THEN SSZSL ELSE 0 END  ) AS SYRK
                 ,SUM(CASE WHEN SUBSTR(RKRQ,1,7)=TO_CHAR(add_months(sysdate,-2),'YYYY-MM') THEN SSZSL ELSE 0 END  ) AS DSYRK
                 ,SUM(CASE WHEN TO_DATE (SUBSTR(RKRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 10 THEN SSZSL ELSE 0 END  ) AS RKSL10
                 ,SUM(CASE WHEN TO_DATE (SUBSTR(RKRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 15 THEN SSZSL ELSE 0 END  ) AS RKSL15
                 ,SUM(CASE WHEN TO_DATE (SUBSTR(RKRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 20 THEN SSZSL ELSE 0 END  ) AS RKSL20
                 ,SUM(CASE WHEN TO_DATE (SUBSTR(RKRQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 30 THEN SSZSL ELSE 0 END  ) AS RKSL30
                 ,ROUND(CASE WHEN SUM(SSZSL)=0 THEN 0 ELSE SUM(RKJE)/SUM(SSZSL) END,2) AS RKDJ
                 ,ROUND(CASE WHEN SUM(SSZSL)=0 THEN 0 ELSE SUM(CGHYFJE)/SUM(SSZSL) END,2) AS CGHYFDJ
                 ,MAX(CGHYFDJ) AS CGHYFDJ1
            FROM F_CGRKDHYF
            GROUP BY
                YTDJH
                   ,WLBM
                   ,GSBM
                   ,GYSBM
        ) BB
                      ON 	AA.GSBM = BB.GSBM
                          AND AA.WLBM = BB.WLBM
                          AND AA.DJBH = BB.YTDJH
                          AND AA.GYSBM=BB.GYSBM
    ---AND AA.RKGB='N'  /*测试：在关联时入库关闭的不在统计  不对再调整 2024-01-02 李艳玉 问题*/
    GROUP BY AA.GSBM,AA.WLBM



)B
ON A.GSBM = B.GSBM AND A.WLBM = B.WLBM
---来料仓入库数量
    LEFT JOIN (
    select GSBM,WLBM
         ,SUM(ZSL) AS RKSL
         ,SUM(CASE WHEN RQ=TO_CHAR(SYSDATE,'YYYY-MM-DD') THEN ZSL ELSE 0 END )   AS JRRK
         ,SUM(CASE WHEN RQ=TO_CHAR(SYSDATE-1,'YYYY-MM-DD') THEN ZSL ELSE 0 END ) AS ZRRK
         ,SUM(CASE WHEN SUBSTR(RQ,1,7) = TO_CHAR(SYSDATE,'YYYY-MM')THEN ZSL ELSE 0 END ) AS BYRK
         ,SUM(CASE WHEN SUBSTR(RQ,1,7)=TO_CHAR(add_months(sysdate,-1),'YYYY-MM') THEN ZSL ELSE 0 END  ) AS SYRK
         ,SUM(CASE WHEN SUBSTR(RQ,1,7)=TO_CHAR(add_months(sysdate,-2),'YYYY-MM') THEN ZSL ELSE 0 END  ) AS DSYRK
         ,SUM(CASE WHEN TO_DATE (SUBSTR(RQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 10 THEN ZSL ELSE 0 END  ) AS RKSL10
         ,SUM(CASE WHEN TO_DATE (SUBSTR(RQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 15 THEN ZSL ELSE 0 END  ) AS RKSL15
         ,SUM(CASE WHEN TO_DATE (SUBSTR(RQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 20 THEN ZSL ELSE 0 END  ) AS RKSL20
         ,SUM(CASE WHEN TO_DATE (SUBSTR(RQ,1,10),'YYYY-MM-DD') - TO_DATE (TO_CHAR(SYSDATE,'YYYY-MM-DD') ,'YYYY-MM-DD')&lt;= 30 THEN ZSL ELSE 0 END  ) AS RKSL30
    from F_QTRKD
    where djlx='客户来料入库'
    GROUP BY GSBM,WLBM
)B1
              ON A.GSBM = B1.GSBM AND A.WLBM = B1.WLBM

    --出库数量
    LEFT JOIN
(
--出库也称为用量
    SELECT GSBM,WLBM
         ,SUM(CKSL)  AS CKSL
         ,SUM(CKJE)  AS CKJE
         ,SUM(JRCK)  AS JRCK
         ,SUM(ZRCK)  AS ZRCK
         ,SUM(BYCK)  AS BYCK
         ,SUM(SYCK)  AS SYCK
         ,SUM(QNTQCK)  AS QNTQCK
         ,SUM(DSYCK)  AS DSYCK --大上月出库

		 ,SUM(JQCK180) AS JQCK180
         ,SUM(JQCK90) AS JQCK90
         ,SUM(JQCK30) AS JQCK30
         ,SUM(JQCKJE30) AS JQCKJE30
		 
         ,SUM(JQCK20) AS JQCK20
         ,SUM(JQCK10) AS JQCK10

         ,ROUND(SUM(JQCK30)/30,2) AS MRYL30
         ,ROUND(SUM(JQCK20)/20,2) AS MRYL20
         ,ROUND(SUM(JQCK10)/10,2) AS MRYL10
    FROM
        (
            SELECT  GSBM,WLBM
                 ,SUM(NVL(SL,0))	AS CKSL
                 ,SUM(NVL(CKJE,0))	AS CKJE
                 ,SUM(CASE WHEN  CKRQ= TO_CHAR(SYSDATE,'YYYY-MM-DD') THEN TO_NUMBER(NVL(SL,0)) ELSE 0 END)  AS JRCK
                 ,SUM(CASE WHEN  CKRQ= TO_CHAR(SYSDATE-1,'YYYY-MM-DD') THEN TO_NUMBER(NVL(SL,0)) ELSE 0 END)  AS ZRCK
                 ,SUM(CASE WHEN SUBSTR(CKRQ,1,7) = TO_CHAR(SYSDATE,'YYYY-MM') THEN TO_NUMBER(NVL(SL,0)) ELSE 0 END)  AS BYCK
                 ,SUM(CASE WHEN SUBSTR(CKRQ,1,7) = to_char(add_months(sysdate,-1),'yyyy-mm') THEN TO_NUMBER(NVL(SL,0)) ELSE 0 END)  AS SYCK
                 ,SUM(CASE WHEN SUBSTR(CKRQ,1,7) = to_char(add_months(sysdate,-12),'yyyy-mm') THEN TO_NUMBER(NVL(SL,0)) ELSE 0 END)  AS QNTQCK
                 ,SUM(CASE WHEN SUBSTR(CKRQ,1,7) = to_char(add_months(sysdate,-2),'yyyy-mm') THEN TO_NUMBER(NVL(SL,0)) ELSE 0 END)  AS DSYCK
             ,SUM(CASE WHEN SUBSTR(CKRQ,1,10) > TO_CHAR(SYSDATE-180,'YYYY-MM-DD')
							  THEN TO_NUMBER(NVL(SL,0)) END) AS JQCK180
                 ,SUM(CASE WHEN SUBSTR(CKRQ,1,10) > TO_CHAR(SYSDATE-90,'YYYY-MM-DD')
                               --AND SUBSTR(CKRQ,1,10) &lt;= TO_CHAR(SYSDATE,'YYYY-MM-DD')
                               THEN TO_NUMBER(NVL(SL,0)) ELSE 0 END)  AS JQCK90
                 ,SUM(CASE WHEN SUBSTR(CKRQ,1,10) > TO_CHAR(SYSDATE-30,'YYYY-MM-DD')
                               --AND SUBSTR(CKRQ,1,10) &lt;= TO_CHAR(SYSDATE,'YYYY-MM-DD')
                               THEN TO_NUMBER(NVL(SL,0)) ELSE 0 END)  AS JQCK30
                 ,SUM(CASE WHEN SUBSTR(CKRQ,1,10) > TO_CHAR(SYSDATE-30,'YYYY-MM-DD')
                               --AND SUBSTR(CKRQ,1,10) &lt;= TO_CHAR(SYSDATE,'YYYY-MM-DD')
                               THEN TO_NUMBER(NVL(CKJE,0)) ELSE 0 END)  AS JQCKJE30		   	   
                 ,SUM(CASE WHEN SUBSTR(CKRQ,1,10) > TO_CHAR(SYSDATE-20,'YYYY-MM-DD')
                               --AND SUBSTR(CKRQ,1,10) &lt;= TO_CHAR(SYSDATE,'YYYY-MM-DD')
                               THEN TO_NUMBER(NVL(SL,0)) ELSE 0 END)  AS JQCK20
                 ,SUM(CASE WHEN SUBSTR(CKRQ,1,10) > TO_CHAR(SYSDATE-10,'YYYY-MM-DD')
                               --AND SUBSTR(CKRQ,1,10) &lt;= TO_CHAR(SYSDATE,'YYYY-MM-DD')
                               THEN TO_NUMBER(NVL(SL,0)) ELSE 0 END)  AS JQCK10

            FROM F_QTCKD
            WHERE CKRQ >= TO_CHAR(SYSDATE-366,'YYYY-MM-DD')
            --OR SUBSTR(CKRQ,1,7)=to_char(add_months(sysdate,-12),'yyyy-mm')
            --这里考虑出库取最近三个月 如果不对 放开 另外采购数量只计算开启的订单  出库没这个字段但是要考虑是否受影响
            GROUP BY GSBM,WLBM


        )
    GROUP BY GSBM,WLBM
) C
ON A.GSBM = C.GSBM AND A.WLBM = C.WLBM


--今日结存
    LEFT JOIN
(
    SELECT GSBM,WLBM
         ,SUM(CASE WHEN CKMC LIKE '%来料%' THEN TO_NUMBER(JRJC) ELSE 0 END) AS LL_JRJC
         ,SUM(CASE WHEN CKMC LIKE '%原料%' OR CKMC LIKE '%包%' OR CKMC LIKE '%半成%'   OR CKMC LIKE '%来料%' THEN TO_NUMBER(JRJC)  ELSE 0 END) AS JRJC
         ,SUM(CASE WHEN CKMC LIKE '%配料%'  THEN TO_NUMBER(JRJC) ELSE 0 END) AS PLC_JRJC
    FROM CG_JRJC
    GROUP BY GSBM,WLBM
) D
ON A.GSBM = D.GSBM AND A.WLBM = D.WLBM
--期初结存单价&amp;数量
    LEFT JOIN
(
    SELECT GSBM,WLBM,round(case when sum(nvl(sl,0))&lt;&gt;0 then sum(JCJE)/sum(nvl(sl,0)) end,4) AS QCJCDJ,sum(SL) AS QCJC,sum(jcje) as QCJCJE
    FROM CG_QCJZJC
    WHERE jcdj IS NOT NULL
    group by GSBM,WLBM
) D2
ON A.GSBM = D2.GSBM AND A.WLBM = D2.WLBM

--预计用量 15&amp;30
    LEFT JOIN
(SELECT GSBM,WLBM,YSYL,YSYL*0.5 AS YSYL15
 FROM YS_WLYL
 WHERE YSNF = TO_CHAR(SYSDATE-1,'YYYY')
   AND YSYF = TO_CHAR(SYSDATE-1,'MM')) F
ON A.GSBM = F.GSBM AND A.WLBM = F.WLBM

--安全天数
    LEFT JOIN
(SELECT GSBM,WLBM,AQTS
 FROM CG_WLAQTS) G
ON A.GSBM = G.GSBM AND A.WLBM = G.WLBM
    /*
    WHERE ABS(NVL(B.CGSL,0))+ABS(NVL(B.RKSL,0))+ABS(NVL(C.CKSL,0))>0
    ORDER BY A.GSBM,A.WLBM
    */

--预测数量
    LEFT JOIN (
	SELECT
		B.GSBM
		,MAX(GSMC) AS GSMC,B.CLBM,MAX(B.WLSX) AS WLSX
		,SUM(NVL(YCXL*B.SL,0)) 		YCSL
		,SUM(NVL(YCDJGSL*B.SL,0)) 	YCDJGSL
		,SUM(NVL(YCXL_1*B.SL,0)) 	YCSL_1
		,SUM(NVL(YCXL_2*B.SL,0)) 	YCSL_2
		,SUM(NVL(YCXL_SC*B.SL,0)) 	YCSL_SC
		,SUM(NVL(YCXL_SC1*B.SL,0)) 	YCSL_SC1
		,SUM(NVL(YCXL_SC2*B.SL,0)) 	YCSL_SC2
	FROM (
	SELECT     SCGSBM
		,CPBM
		,SUM(YCXL)+SUM(YCDJGSL) 		AS YCXL
		,SUM(YCDJGSL) 					as YCDJGSL
		,SUM(YCXL_1)+SUM(YCDJGSL_1) 	AS YCXL_1
		,SUM(YCXL_2)+SUM(YCDJGSL_2) 	AS YCXL_2
		,SUM(YCXL_SC)+SUM(YCDJGSL) 	 	AS YCXL_SC
		,SUM(YCXL_SC1)+SUM(YCDJGSL_1)	AS YCXL_SC1
		,SUM(YCXL_SC2)+SUM(YCDJGSL) 	AS YCXL_SC2
	
	FROM (
			SELECT
				SCGSBM
				,CPBM
				,case when YCRQ=to_char(sysdate,'YYYY-mm') then  nvl(TO_NUMBER(REPLACE(YCXL,' ','')),0)  else 0 end  					AS YCXL
				,case when YCRQ=to_char(sysdate,'YYYY-mm') then  nvl(TO_NUMBER(REPLACE(YCDJGSL,' ','')),0)  else 0 end  				AS YCDJGSL
				,case when YCRQ=to_char(ADD_MONTHS(sysdate, 1),'YYYY-mm') then  nvl(TO_NUMBER(REPLACE(YCXL,' ','')),0)  else 0 end  	AS YCXL_1
				,case when YCRQ=to_char(ADD_MONTHS(sysdate, 1),'YYYY-mm') then  nvl(TO_NUMBER(REPLACE(YCDJGSL,' ','')),0)  else 0 end  	AS YCDJGSL_1
				,case when YCRQ=to_char(ADD_MONTHS(sysdate, 2),'YYYY-mm') then  nvl(TO_NUMBER(REPLACE(YCXL,' ','')),0) else 0 end  		AS YCXL_2
				,case when YCRQ=to_char(ADD_MONTHS(sysdate, 2),'YYYY-mm') then  nvl(TO_NUMBER(REPLACE(YCDJGSL,' ','')),0)  else 0 end  	AS YCDJGSL_2
				,case when YCRQ=to_char(sysdate,'YYYY-mm') then  YCXL_SC  else 0 end  				 AS YCXL_SC
				,case when YCRQ=to_char(ADD_MONTHS(sysdate, 1),'YYYY-mm') then  YCXL_SC  else 0 end  AS YCXL_SC1
				,case when YCRQ=to_char(ADD_MONTHS(sysdate, 2),'YYYY-mm') then  YCXL_SC  else 0 end  AS YCXL_SC2
	
	
			FROM YC_XSJH
			WHERE YCRQ >=to_char(sysdate,'YYYY-mm')
			and YCRQ &lt;=to_char(ADD_MONTHS(sysdate, 2),'YYYY-mm')
		)
	GROUP BY
		SCGSBM
		,CPBM
		)A
			LEFT JOIN (
		SELECT A.GSBM,A.GSMC,A.CPBM,A.CLBM,NVL(A.SL,0) AS SL,B.WLSX
		FROM CB_BOMCF A
				LEFT JOIN CG_WLSX B
						ON A.CLBM=B.WLBM
		WHERE A.QJ=to_char(sysdate,'YYYY-MM')
		AND GSBM IS NOT NULL
	)B
					ON A.SCGSBM=B.GSBM
						AND A.CPBM=B.CPBM
	GROUP BY GSBM,CLBM
) H
ON A.GSBM = H.GSBM AND A.WLBM = H.CLBM
---最新报价
    LEFT JOIN (
SELECT GSBM,WLBM,bjrq,row_number() over (partition by  GSBM,WLBM order by bjrq desc) as rn 
,DCBJ/1000 ZXBJ
FROM CG_WLBJ T
WHERE YEARMTH>=TO_CHAR(SYSDATE-31,'YYYY-MM')
and bjrq>TO_CHAR(SYSDATE-31,'YYYY-MM-DD')
) I
              ON I.RN=1
and A.WLBM = I.WLBM
                  AND A.GSBM=I.GSBM
     ) A</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema />
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>448</xloc>
      <yloc>317</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
</transformation>
