  <step>
    <name>获取其他入库单成本拆分</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>finereport_fbdbuser</connection>
    <sql>SELECT RQ,GSBM,GSMC,WLBM,SUM(NNUM)NNUM,DJ,CPYLCB,CPDZCB,CPRLCB,CPRGCB,CPFZJCB,CPZJCB,CPQTCB FROM
(SELECT RQ,GSBM,GSMC,WLBM,NNUM,DJ,CPYLCB,CPDZCB,CPRLCB,CPRGCB,CPFZJCB,CPZJCB,
CASE WHEN CPYLCB IS NULL
THEN NULL
ELSE (DJ-NVL(CPDZCB,0)-NVL(CPRLCB,0)-NVL(CPRGCB,0)-NVL(CPFZJCB,0)-NVL(CPZJCB,0)-NVL(CPYLCB,0)) 
END CPQTCB FROM 
(
SELECT DISTINCT A.RQ,A.GSBM,A.GSMC,A.WLBM,A.NNUM,a.dj,
CASE WHEN B.CBDXSL>'0'
 THEN B.dLcb
   ELSE  C.CPYLCB
    END CPYLCB,
CASE WHEN B.CBDXSL>'0'
 THEN B.dzcb
   ELSE  C.CPDZCB
    END CPDZCB,
CASE WHEN B.CBDXSL>'0'
 THEN B.rlcb
   ELSE  C.CPRLCB
    END CPRLCB,
CASE WHEN B.CBDXSL>'0'
 THEN B.rgcb
   ELSE  C.CPRGCB
    END CPRGCB,
CASE WHEN B.CBDXSL>'0'
 THEN NVL(B.zzcb,0)-NVL(B.zjcb,0)-NVL(B.rgcb,0)-NVL(B.rlcb,0)
   ELSE  C.cpfzjcb
    END cpfzjcb,
CASE WHEN B.CBDXSL>'0'
 THEN B.zjcb
   ELSE  C.cpzjcb
    END cpzjcb

 FROM CB_QTRK A

LEFT JOIN cb_cpcb B
ON A.RQ=B.QJ
AND A.GSBM=B.GSBM
AND A.WLBM=B.cbdxbm


LEFT JOIN (
 SELECT A.RQ , A.GSBM , A.WLBM ,decode(SUM(A.CPYLCBHJ),0,1,SUM(A.CPYLCBHJ))/decode(SUM(NNUM),0,1,SUM(NNUM)) CPYLCB , A.CPDZCB , A.CPRLCB , A.CPRGCB , A.CPFZJCB ,A.CPZJCB , A.CPQTCB 
FROM (select A.* , A.CPYLCB * A.NNUM  CPYLCBHJ FROM cb_jccb a 
inner join (select gsbm,wlbm,max(rq) rq from cb_jccb group by gsbm,wlbm)b on a.gsbm=b.gsbm and a.wlbm=b.wlbm and a.rq=b.rq
-- WHERE A.wlbm='2101010027'
--AND A.GSBM='1007'
) A 
group by A.RQ ,A.GSBM, A.WLBM, A.CPDZCB, A.CPRLCB, A.CPRGCB, 
A.CPFZJCB, A.CPZJCB, A.CPQTCB   ---结存成本
 ) C
ON A.GSBM=C.GSBM
AND A.WLBM=C.WLBM

where A.rq=to_char(add_months(trunc(sysdate),-1),'yyyy-mm')
)
)
WHERE GSBM&lt;&gt;'1030'
AND GSBM&lt;&gt;'1018'
GROUP BY RQ,GSBM,GSMC,WLBM,DJ,CPYLCB,CPDZCB,CPRLCB,CPRGCB,CPFZJCB,CPZJCB,CPQTCB





</sql>
    <limit>0</limit>
    <lookup />
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
