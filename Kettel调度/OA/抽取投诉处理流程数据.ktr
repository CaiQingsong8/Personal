  <step>
    <name>临时表输入</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>OA</connection>
    <sql>SELECT
A.ID,--数据ID
A.REQUESTID,--流程ID
A.SHENQRQ RQ,--申请日期
D.DEPARTMENTNAME BMMC,--申请部门
F.Jobtitlename ZW,--职务
A.BIANH BH,--流程编号
E.SUBCOMPANYDESC GSMC,--所属公司
C.LASTNAME XM,--申请人
A.KHMC,--客户名称
A.THL,--退货率
A.TSSL,--投诉数量
A.YXTHSL,--允许退货数量
REPLACE(A.PFJE,',','') PFJE,--赔付金额
CASE WHEN A.SFSP = 0 THEN '需要' WHEN A.SFSP = 1 THEN '不需要' ELSE '未知' END SFSP ,--是否需生产公司审批
K.SUBCOMPANYDESC SPGS,--审批公司
A.TSCP,--产品名称
G.TSLBMC,--投诉类别
A.TSXM,--投诉项目
CASE WHEN A.CLFA = 0 THEN '允许退货' WHEN A.CLFA = 1 THEN '赔付' ELSE '其他' END CLFA,--处理方案
A.SCRQ,--生产日期
A.QTSM,--其他说明
H.TSLBMC TSLBMCQR,--确认投诉类别
A.TSXMQR,--确认投诉项目
CASE WHEN A.CPBM IS NULL THEN A.CPBM1 WHEN length(A.CPBM) = 10 THEN A.CPBM ELSE B.WLBM END CPBM, --产品编码
CASE WHEN L.STATUS IS NULL THEN '申请人发起' ELSE L.STATUS END STATUS , --流程当前节点
L.CREATEDATE||' '||L.CREATETIME CJSJ, --流程创建时间
A.WTMS,--问题描述
A.YYFX --原因分析
FROM formtable_main_172 A --投诉流程表单
LEFT JOIN uf_nccpda B --物料档案表单
ON A.CPBM = B.ID
LEFT JOIN HrmResource C --人员表
ON A.SHENQR = C.ID
LEFT JOIN hrmdepartment D --部门表
ON A.SHENQBM = D.ID
LEFT JOIN hrmsubcompany E --分部表
ON A.SUOSGS = E.ID
LEFT JOIN HrmJobTitles F --人力资源岗位表
ON F.ID = A.ZHIW
LEFT JOIN uf_TSLBJXM G -- 投诉类别表
ON G.ID = A.TSLB
LEFT JOIN uf_TSLBJXM H -- 投诉类别表
ON H.ID = A.TSLBQR
LEFT JOIN hrmsubcompany K --分部表
ON A.SPGS = K.ID
LEFT JOIN workflow_requestbase L--工作流基本信息表
ON A.REQUESTID = L.REQUESTID
WHERE 1=1
AND A.SHENQRQ >= '2019-09-11'
AND (L.STATUS LIKE '%归档%' or L.STATUS = '出口12')</sql>
    <limit>0</limit>
